  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Melt 50g butter in a large saucepan (about 20cm across), add 1 finely chopped medium onion and cook gently over a medium heat for 5 minutes, until softened but not browned.",
      "timer_seconds": 300,
      "ingredients_used": [
        "c1852a3d-7bd7-5311-be96-f469fbb15e3e",
        "5e655b92-7d60-59de-ab20-4cccb2aad0b9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Stir in 3 split cardamom pods, ¼ tsp turmeric, 1 small cinnamon stick and 2 bay leaves, then cook for 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "ea4028d1-c303-5fb6-b0d5-3d129673f938",
        "60b32d28-e4e8-5db6-b2d5-591a3ba43045",
        "4da26ffc-f51e-5307-b1f0-7a1459844fb5"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Tip in 450g basmati rice and stir until it is all well coated in the spicy butter.",
      "ingredients_used": [
        "c1852a3d-7bd7-5311-be96-f469fbb15e3e",
        "2f72c140-77e5-50c1-974c-4f929f22861f"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Pour in 1 liter chicken or fish stock, add ½ teaspoon salt and bring to the boil, stir once to release any rice from the bottom of the pan. Cover with a close-fitting lid, reduce the heat to low and leave to cook very gently for 12 minutes.",
      "timer_seconds": 720,
      "ingredients_used": [
        "2f72c140-77e5-50c1-974c-4f929f22861f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Meanwhile, bring some water to the boil in a large shallow pan. Add 750g un-dyed smoked haddock fillet and simmer for 4 minutes, until the fish is just cooked. Lift it out onto a plate and leave until cool enough to handle.",
      "timer_seconds": 240,
      "ingredients_used": [
        "782cfea7-443d-58eb-b0e5-ed29f231d6bf"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Hard-boil 3 eggs for 8 minutes.",
      "timer_seconds": 480,
      "ingredients_used": [
        "2077dc20-6e95-54b8-a64f-e4bd886e959c"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Flake the fish, discarding any skin and bones. Drain the eggs, cool slightly, then peel and chop.",
      "ingredients_used": [
        "2077dc20-6e95-54b8-a64f-e4bd886e959c"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Uncover the rice and remove the bay leaves, cinnamon stick and cardamom pods if you wish to. Gently fork in the fish and the chopped eggs, cover again and return to the heat for 2-3 minutes, or until the fish has heated through.",
      "timer_seconds": 180,
      "ingredients_used": [
        "ea4028d1-c303-5fb6-b0d5-3d129673f938",
        "4da26ffc-f51e-5307-b1f0-7a1459844fb5",
        "2f72c140-77e5-50c1-974c-4f929f22861f",
        "2077dc20-6e95-54b8-a64f-e4bd886e959c"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Gently stir in almost all the 3 tbsp chopped fresh parsley, and season with a little salt and black pepper to taste. Serve scattered with the remaining parsley and garnished with 1 lemon, cut into wedges.",
      "ingredients_used": [
        "3d5fde13-6727-5784-bff6-9f6cb4a2cbc7",
        "2deeba20-724f-5500-987e-a749f057b371"
      ]
    }
  ],
