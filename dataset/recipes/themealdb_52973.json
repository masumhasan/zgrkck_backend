  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in a large pot. Add the onion and cook until translucent.",
      "ingredients_used": [
        "963428a0-6922-555a-bdcf-be624ca937c9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Drain the soaked chickpeas and add them to the pot together with the vegetable stock. Bring to the boil, then reduce the heat and cover. Simmer for 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "60fdadd8-60e1-5aaa-bf99-54561826e635",
        "9daad9d0-8bff-5bc4-8dc0-eb68b2966aca"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In the meantime toast the cumin in a small ungreased frying pan, then grind them in a mortar. Add the garlic and salt and pound to a fine paste.",
      "ingredients_used": [
        "907e802e-95a3-55e2-89aa-7818f923070c",
        "466a26ec-3446-56e8-ac78-b8592521a032",
        "689013e8-490e-5f84-99d4-a129ea3120fe"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the paste and the harissa to the soup and simmer until the chickpeas are tender, about 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "60fdadd8-60e1-5aaa-bf99-54561826e635"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Season to taste with salt, pepper and lemon juice and serve hot.",
      "ingredients_used": [
        "689013e8-490e-5f84-99d4-a129ea3120fe",
        "9a04f7f2-4324-5481-8946-8c6b0e943a98"
      ]
    }
  ],
