  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add 2 ½ cups water, 1 can coconut milk to a 4 QT heavy bottomed pot. Bring to a boil over medium-high heat.",
      "ingredients_used": [
        "69e3df89-1c8a-54fa-bda0-c21130d55f8c",
        "e42c6a49-dbed-512a-bcdf-a1568850c8f2",
        "ad27576e-fc9e-5b67-9ec9-73aa97e7ed9b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Meanwhile, add 1 cup cornmeal and 1 ½ cup water to a large mixing cup and whisk until smooth.",
      "ingredients_used": [
        "69e3df89-1c8a-54fa-bda0-c21130d55f8c",
        "b48c0c7a-d14a-50ad-ba2d-4ecc982b47c5"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Once the pot begins to boil, whisk in cornmeal mixture and continue to whisk for about 1 minute, ensuring there are no lumps. Reduce heat to low and cover with a tight fitting lid.",
      "timer_seconds": 60,
      "ingredients_used": [
        "b48c0c7a-d14a-50ad-ba2d-4ecc982b47c5"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cook over low heat for 15-20 minutes, stirring occasionally. When there is about 5 minutes left, stir in vanilla extract, cinnamon, nutmeg, and all-spice. Remove from heat and sweeten with condensed milk.",
      "ingredients_used": [
        "e42c6a49-dbed-512a-bcdf-a1568850c8f2",
        "3fc39bf4-183b-5ebd-8541-8e8cc64a95cd",
        "ff981fe1-1db7-5e87-91fe-9a72dcf2fec9",
        "1341d01b-f477-5bdb-9c41-25f2dab69115",
        "ad27576e-fc9e-5b67-9ec9-73aa97e7ed9b"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Serve and enjoy."
    }
  ],
