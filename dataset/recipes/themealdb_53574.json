  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "All materials must be in room temperature"
    },
    {
      "step_number": 2,
      "instruction": "Dissolve yeast with lukewarm (37C) milk and sugar",
      "temperature": {
        "value": 37,
        "unit": "celsius"
      },
      "ingredients_used": [
        "96d6f69e-252b-5799-a100-4ebc23f3363e",
        "565238e8-d38b-577b-aece-946b04025a2a",
        "db114cba-4ccc-573c-b59c-55c883d8081b",
        "d051e6cd-0a9e-5fb2-8346-ef17f81c72bb"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add about half of the quantity of flour, mixed with salt",
      "ingredients_used": [
        "1ea693a2-4ad8-5bee-81b7-9c23ffa76c79",
        "dc000e91-f27e-5be0-bf7b-9aadf3ce8e40"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Beat the mixture for a short time. Sprinkle with a little flour , cover the bowl with a towel and place in a warm place to rise for ca 1 hour",
      "timer_seconds": 3600,
      "ingredients_used": [
        "dc000e91-f27e-5be0-bf7b-9aadf3ce8e40"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add additional flour, cardamom",
      "ingredients_used": [
        "f45544ca-e0fb-517e-ad7b-dd65fe78823b",
        "dc000e91-f27e-5be0-bf7b-9aadf3ce8e40"
      ]
    },
    {
      "step_number": 6,
      "instruction": "add melted butter. Beat egg and leave ca 1 teaspoon for spreading.Add other beaten egg in to the dough",
      "ingredients_used": [
        "71e5f0ae-f66f-5d2b-9616-1456991bd499",
        "0e450fcf-ca22-5de3-8c50-e29fefdb71ce"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Knead the dough properly, until it separates from the bowl."
    },
    {
      "step_number": 8,
      "instruction": "Sprinkle with a little flour , cover the bowl with a towel and place in a warm place to rise for ca 1 hour until dough is doubled in size.",
      "timer_seconds": 3600,
      "ingredients_used": [
        "dc000e91-f27e-5be0-bf7b-9aadf3ce8e40"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Roll the dough to a square and put in center quark. Turn edges on to the quark and roll again carefully  to a rectangle.",
      "ingredients_used": [
        "e5ff7fd0-783d-5d05-8fe2-d9cfe3e6ae19"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Pour on to the rectangle rhubarb, sugar and cinnamon. leave one edge ca 2 cm empty. Roll and cut in to the equal slices. You should get ca 6-7 rolls. Empty edge turn under the roll as bottom.",
      "ingredients_used": [
        "db114cba-4ccc-573c-b59c-55c883d8081b",
        "f6ed48ea-1fdf-5198-8e4e-b6b6cbf92750",
        "d051e6cd-0a9e-5fb2-8346-ef17f81c72bb",
        "cf0cde91-1c0f-5d9b-8165-3747c09ae282"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Put roll in to the butter-spreaded springform pan, as flower. one roll in to the center and others around. Let enough space to rise.",
      "ingredients_used": [
        "0e450fcf-ca22-5de3-8c50-e29fefdb71ce"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Coat buns with beaten egg before putting into the oven. Bate at 180C 20-30 minutes .",
      "timer_seconds": 1800,
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
      "ingredients_used": [
        "71e5f0ae-f66f-5d2b-9616-1456991bd499"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Decorate with icing sugar.",
      "ingredients_used": [
        "db114cba-4ccc-573c-b59c-55c883d8081b",
        "d051e6cd-0a9e-5fb2-8346-ef17f81c72bb"
      ]
    }
  ],
