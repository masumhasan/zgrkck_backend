  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Soak: Soak corn and beans overnight in water.",
      "ingredients_used": [
        "5bae50b0-f810-5bc8-a505-ab9f5feeb543",
        "aa2bc72b-be2c-563b-bfe4-16af1f5d03c6"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cook Meats: In a large pot, brown the beef and pork. Add onions and spices, cooking until translucent.",
      "ingredients_used": [
        "9cab1838-4255-5709-948f-acc6d762abbe",
        "3ca4c5e8-8328-53ca-8adc-17eb11813f7d",
        "8262690a-fef3-555c-9df5-a46898413a02"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Simmer the Stew: Add soaked corn and beans, pumpkin, potato, and enough water to cover. Simmer for 2-3 hours, until thick.",
      "timer_seconds": 10800,
      "ingredients_used": [
        "5bae50b0-f810-5bc8-a505-ab9f5feeb543",
        "aa2bc72b-be2c-563b-bfe4-16af1f5d03c6",
        "0601e7c5-7512-597c-b09b-2a524cfeaee6"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Serve: Enjoy hot, with bread on the side."
    },
    {
      "step_number": 5,
      "instruction": "Pro Tips:"
    },
    {
      "step_number": 6,
      "instruction": "Toasting the corn slightly before adding it to the stew enhances its flavor.",
      "ingredients_used": [
        "5bae50b0-f810-5bc8-a505-ab9f5feeb543"
      ]
    },
    {
