  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the uncooked chicken breasts in the crock pot. Pour the full bottle of salad dressing over the chicken. Sprinkle the rest of the ingredients over the top and mix them in a bit with a spoon.",
      "ingredients_used": [
        "e58a0a21-16f2-5f48-a61a-c1cccfbe8706",
        "a036ee4f-20cc-5093-b53c-61600c6ea87c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cover your crock pot with the lid and cook on high for 4 hours.",
      "timer_seconds": 14400
    },
    {
      "step_number": 3,
      "instruction": "Remove all the chicken breasts from the crock pot and let cool.",
      "ingredients_used": [
        "e58a0a21-16f2-5f48-a61a-c1cccfbe8706"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Shred the chicken breasts and move to a glass bowl.",
      "ingredients_used": [
        "e58a0a21-16f2-5f48-a61a-c1cccfbe8706"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour most of the liquid over the shredded chicken."
    },
    {
      "step_number": 6,
      "instruction": "FOR THE TACOS:"
    },
    {
      "step_number": 7,
      "instruction": "Make the guacamole sauce by mixing the avocado and green salsa together. Pour the guacamole mixture through a strainer until smooth and transfer to a squeeze bottle. Cut the tip off the lid of the squeeze bottle to make the opening more wide if needed.",
      "ingredients_used": [
        "c574e853-da23-5fb6-9c07-1c3b39fc11f4",
        "c8b7f3cc-7367-576e-92ac-db0df4650fbd"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Make the sour cream sauce by mixing the sour cream and milk together until you get a more liquid sour cream sauce. Transfer to a squeeze bottle.",
      "ingredients_used": [
        "0180f3f9-9a3d-5aca-918b-2b3c35791ea8",
        "62b3449a-3494-570a-9300-2eaaa7b82b68"
      ]
    },
    {
      "step_number": 9,
      "instruction": "In a 9x 13 glass baking dish, fill all 12+ tacos with a layer of refried beans, cooked chicken and shredded cheese.",
      "ingredients_used": [
        "8488f0dc-2f37-5bf8-b5b6-74430c044a94"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Bake at 450 for 10-15 minutes just until the cheese is melted and bubbling.",
      "timer_seconds": 900
    },
    {
      "step_number": 11,
      "instruction": "Out of the oven top all the tacos with the sliced grape tomaotes, jalapeno and cilantro.",
      "ingredients_used": [
        "26b2ad0c-7d19-540c-8689-ccf4cc7951c6"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Finish with a drizzle of guacamole and sour cream.",
      "ingredients_used": [
        "0180f3f9-9a3d-5aca-918b-2b3c35791ea8"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Enjoy!"
    }
  ],
