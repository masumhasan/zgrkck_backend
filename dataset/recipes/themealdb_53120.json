  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Whisk the flour, salt, sugar, baking soda, and cardamom together in a large bowl.",
      "ingredients_used": [
        "7b626bcb-21ed-5f8a-8c49-c93fc48175de",
        "ffe72c23-45f6-5f82-b8e2-6efeaf9154ba",
        "fb239925-afbf-5ad1-a1fb-4ece077de6cf"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Separate the eggs and add the egg yolks to the flour mixture. Pour in the buttermilk (or cultured milk) and whisk the batter together until smooth. Cover and refrigerate for about 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "7b626bcb-21ed-5f8a-8c49-c93fc48175de",
        "ad195188-721b-5851-82a7-3b5bc9217459",
        "f3e83b2b-1b76-5dfb-9bbe-0da77337be15",
        "a2a669ce-5810-5626-958c-f0089575ebcf"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Use a hand (or stand) mixer to beat the egg whites until stiff. Carefully fold into the æbleskiver batter.",
      "ingredients_used": [
        "ad195188-721b-5851-82a7-3b5bc9217459"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Heat the pan on medium heat. Once hot, brush the pan with butter and fill each æbleskive hole almost full with the batter.",
      "ingredients_used": [
        "a2a669ce-5810-5626-958c-f0089575ebcf"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Once the edges become firm use a knitting needle or wooden skewer to turn the æbleskiver about 1/4. Continue turning until you get round pancake spheres. They should be golden brown."
    },
    {
      "step_number": 6,
      "instruction": "Remove the æbleskiver from the pan and serve with powdered sugar and jam.",
      "ingredients_used": [
        "c4e9c020-0076-5602-a4b8-9af935632e85"
      ]
    }
  ],
