  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 220C/425F/Gas 7",
      "temperature": {
        "value": 220,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Heat the vegetable oil in a large frying pan, and brown the beef all over. (You may need to do this in batches.) Set aside, then brown the kidneys on both sides in the same pan. Add the onions and cook for 3-4 minutes.",
      "timer_seconds": 240,
      "ingredients_used": [
        "a61f9c57-1017-5650-8df4-5c4524c1ec97",
        "487594d9-335d-5041-810b-a7e363495885",
        "2a72f915-74bc-5b0b-9aa3-e3d3cd227ef0",
        "3f113d5b-0f25-5167-bca1-ae474002874d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Return the beef to the pan, sprinkle flour over and coat the meat and onions",
      "ingredients_used": [
        "487594d9-335d-5041-810b-a7e363495885",
        "3f113d5b-0f25-5167-bca1-ae474002874d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the stock to the pan, stir well and bring to the boil."
    },
    {
      "step_number": 5,
      "instruction": "Turn the heat down and simmer for 1½ hours without a lid. If the liquid evaporates too much, add more stock."
    },
    {
      "step_number": 6,
      "instruction": "Remove from the heat. Add salt, pepper and Worcestershire sauce and allow to cool completely. Place the cooked meat mixture into a pie dish.",
      "ingredients_used": [
        "14c201b9-7c53-5210-a283-72ab6c484190",
        "dae75b18-107c-53c1-b9bb-da1a57070de1",
        "1ecf92db-a669-5749-b5cc-c9a9931cfee3"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Roll out the pastry to 5mm/¼in thick and 5cm/2in larger than the dish you are using.",
      "ingredients_used": [
        "4575cd5c-a8c1-532e-8ed7-61d312bf0fe9"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Using a rolling pin, lift the pastry and place it over the top of the pie dish. Trim and crimp the edges with your fingers and thumb.",
      "ingredients_used": [
        "4575cd5c-a8c1-532e-8ed7-61d312bf0fe9"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Brush the surface with the beaten egg mixture and bake for 30-40 minutes until golden-brown and puffed.",
      "timer_seconds": 2400
    },
    {
      "step_number": 10,
      "instruction": "Serve with creamy mash and steamed vegetables to soak up the gravy."
    }
  ],
