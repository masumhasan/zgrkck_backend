  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat milk in a saucepan until warm to the touch (25°C / 77℉). Transfer milk to a mixing bowl and dissolve the yeast in the milk.",
      "ingredients_used": [
        "132e664a-acfa-5ff9-a2cf-ba933c1d5bbf",
        "03a7aa00-79fb-5448-a3ac-b3b44ba1f808"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the remaining ingredients except for the butter and knead thoroughly. Use a kitchen mixer to knead the dough if you have one.",
      "ingredients_used": [
        "893ae1b6-3ac8-514f-bc65-325fedb67f29"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cut the butter into cubes and add to the dough. Knead for 5 to 10 minutes until the dough is elastic and smooth.",
      "timer_seconds": 600,
      "ingredients_used": [
        "893ae1b6-3ac8-514f-bc65-325fedb67f29"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cover the dough and let rise in a warm place for 45 minutes.",
      "timer_seconds": 2700
    },
    {
      "step_number": 5,
      "instruction": "Transfer the dough to a counter sprinkled with flour and divide into 10-12 pieces of equal size. Roll each piece into a round bun and arrange the buns close to each other on a lined roasting pan or oven-proof dish (approximately 20 x 30 cm). Cover the buns and let rise for approximately 1 hour until they double in size.",
      "timer_seconds": 3600
    },
    {
      "step_number": 6,
      "instruction": "Heat the oven to 180°C / 356℉ on fan setting.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 7,
      "instruction": "Beat the egg in a small bowl and brush the tops of the buns with egg. Bake on the middle oven rack for 14 to 16 minutes until the buns develop a nice golden surface. Serve warm or toasted with butter.",
      "timer_seconds": 960,
      "ingredients_used": [
        "893ae1b6-3ac8-514f-bc65-325fedb67f29",
        "ec348f9c-379f-5f22-bde2-b9b6f8345697"
      ]
    }
  ],
