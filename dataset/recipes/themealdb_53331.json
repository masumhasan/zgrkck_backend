  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place all the ingredients in the glass and beat."
    },
    {
      "step_number": 2,
      "instruction": "Let the mixture stand for 10 minutes.",
      "timer_seconds": 600
    },
    {
      "step_number": 3,
      "instruction": "Grease a hot frying pan with a little butter and pour a little of the mixture.",
      "ingredients_used": [
        "c3cb0c1e-234d-5292-9a06-b29546f33a03"
      ]
    },
    {
      "step_number": 4,
      "instruction": "When it starts to bubble on the surface, turn over with a spatula. Cook over medium-low heat so that they do not burn."
