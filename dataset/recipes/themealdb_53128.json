  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Vanilla custard"
    },
    {
      "step_number": 2,
      "instruction": "Separate the egg yolks and set aside the whites to use in the meringue.",
      "ingredients_used": [
        "2b519a65-5fcd-5d75-b7e8-579ac64fa569",
        "884d6d8d-4c38-5b10-b8b7-59d454440d85",
        "3a9fef6c-6efa-5e66-9730-211c1cdd011e"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Whisk together the egg yolks, cornstarch and sugar in a bowl.",
      "ingredients_used": [
        "2b519a65-5fcd-5d75-b7e8-579ac64fa569",
        "50661413-c2cb-51fa-bd8e-9322b24b824c",
        "884d6d8d-4c38-5b10-b8b7-59d454440d85"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Heat the cream and milk in a saucepan. Split open the vanilla pod and add the beans to the saucepan. Once the milk begins to bubble pour about half of it into the bowl with the egg mixture, whisking constantly. Then return the saucepan to the heat and pour the egg mixture back into the saucepan with remaining milk, whisking constantly. Once the mixture thickens lower the heat and continue whisking for about 30 seconds.",
      "timer_seconds": 30,
      "ingredients_used": [
        "da1464f3-63d3-5eda-9134-59a35f84b34e",
        "8d50c1aa-57f1-5bd8-8933-dae5967a1ffe",
        "74ab4679-feca-5234-8fe7-aa5459722a0a"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour the custard into a clean bowl and cover with plastic wrap, placing the plastic directly on the top layer of the custard. Chill in the fridge."
    },
    {
      "step_number": 6,
      "instruction": "Cake"
    },
    {
      "step_number": 7,
      "instruction": "Mix together butter and sugar until light and fluffy. Add egg yolks one at a time, setting aside the egg whites for the meringue. Add the flour mixed with baking powder. Stir in the milk, beating until smooth (you can use an electric mixer if you prefer).",
      "ingredients_used": [
        "2b519a65-5fcd-5d75-b7e8-579ac64fa569",
        "da1464f3-63d3-5eda-9134-59a35f84b34e",
        "bf5b60bf-2769-5541-9478-a2dbf0924ba4",
        "884d6d8d-4c38-5b10-b8b7-59d454440d85",
        "d45f0948-8e06-5d1a-a8d1-a76f2b9785b2",
        "d0b5989f-502d-5cdc-bc8c-f5288cf4f66a",
        "74ab4679-feca-5234-8fe7-aa5459722a0a",
        "3a9fef6c-6efa-5e66-9730-211c1cdd011e"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Preheat oven to 320°F (160°C). Cover a baking sheet with baking paper and spread out the batter into a large, even rectangle.",
      "temperature": {
        "value": 320,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 9,
      "instruction": "Meringue topping"
    },
    {
      "step_number": 10,
      "instruction": "Whisk together the egg whites and sugar until you get glossy, stiff peaks. The meringue should hold its form – if it still melts continue whisking.",
      "ingredients_used": [
        "3a9fef6c-6efa-5e66-9730-211c1cdd011e"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Spread out the meringue on top of the cake batter. Use a spatula to form light waves with the meringue. Sprinkle almonds on top of the meringue. Bake for about 30 minutes, until the meringue and almonds are golden.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "cab778b1-b996-59a4-a203-835abfb3f95b"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Cream filling"
    },
    {
      "step_number": 13,
      "instruction": "Whisk the cream into stiff peaks. Carefully fold in the vanilla custard."
    },
    {
      "step_number": 14,
      "instruction": "Assembly"
    },
    {
      "step_number": 15,
      "instruction": "Once the cake has cooled, cut it in half. You can use scissors for this, or a knife on a cutting board, slicing through the baking paper as well."
    },
    {
      "step_number": 16,
      "instruction": "Place half of the cake on a serving platter with the meringue side down and peel off the baking paper."
    },
    {
      "step_number": 17,
      "instruction": "Spread the cream filling across the cake. Then carefully remove the other half of the cake from the baking paper and place it over the cream filling, meringue side up."
    },
    {
      "step_number": 18,
      "instruction": "Serve with fresh berries."
    }
  ],
