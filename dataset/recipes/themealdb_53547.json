  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place pork chops in a 3-qt. glass baking dish. Using a fork, poke holes into pork all over; season all over with 1 tsp. salt. Drizzle with oil and toss to coat.",
      "ingredients_used": [
        "940627f1-ca7a-5eb7-82b7-b4a7fdb41cc8",
        "2f1470c4-e236-5b84-82f5-917dbe2aa938"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a small bowl, combine orange zest and juice, lime zest and juice, oregano, pepper, garlic powder, cumin, and onion powder. Add half of marinade to pork and let rest 10 to 15 minutes.",
      "timer_seconds": 900,
      "ingredients_used": [
        "3244aea4-3bc2-59ec-8ec3-e0ca4779970f",
        "2dc0e74b-ed18-5a18-9204-de263c323d80",
        "7487e4eb-174f-5a15-912a-fafc144ca2d5",
        "f12f2697-0fc7-566b-a167-dff21c3972b6"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Meanwhile, arrange a rack in center of oven; preheat to 425°. Add mustard and mayonnaise to remaining marinade and stir until smooth.",
      "ingredients_used": [
        "00435304-8dd9-5d29-a902-512f1be0bc7b",
        "5681f668-49ba-561b-8118-d51ffafa5771"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Transfer pork to oven and roast until an instant-read thermometer inserted into thickest part registers 140°, 15 to 20 minutes.",
      "timer_seconds": 1200
    },
    {
      "step_number": 5,
      "instruction": "To build sandwiches, cut loaf in half crosswise, then cut each piece in half lengthwise for 4 pieces total. Spread butter on outside of bread on the top and bottom. Spread mustard mixture on cut sides of bread. On 2 bread pieces, layer each with 2 oz. cheese, 4 oz. ham, half of roast pork, 4 pickle slices, and remaining 2 oz. cheese. Close with remaining bread pieces and wrap each sandwich in foil.",
      "ingredients_used": [
        "00435304-8dd9-5d29-a902-512f1be0bc7b",
        "047c74e3-516f-57fc-9afd-7790806eb605",
        "53eac336-1716-53c7-88c8-2a26c606aa48"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Heat a large cast-iron skillet over medium heat. Place foil-wrapped sandwiches in skillet, then place another heavy skillet on top to create a homemade sandwich press. If you don’t have another heavy skillet, weigh the pan down with another lighter skillet or baking sheet, then top with couple of canned goods."
    },
    {
      "step_number": 7,
      "instruction": "Grill sandwiches, turning halfway through, until toasted and cheese is melted, 3 to 4 minutes per side. Cut each sandwich in half and serve.",
      "timer_seconds": 240
    }
  ],
