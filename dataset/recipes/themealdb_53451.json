  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "If you are using rohu fish it will usually be frozen. Soak it in cold water for 30-45 minutes to defrost and while still a little firm, descale and cut each steak into quarters and wash in cold saltwater a few times. Drain and set aside. If using an alternative such as cod, cut into 2 ½ inch chunks then rinse, drain and set aside",
      "timer_seconds": 2700,
      "ingredients_used": [
        "283b7bee-b0da-594f-bfc2-915dae241b3a",
        "00c8e89f-8672-50f9-9737-8d0ae743d02a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Top and tail the daikon and peel using a potato peeler. Cut in half widthways then cut each half down the middle, lengthways. Now slice into 2cm-thick half-moon pieces. Rinse and set aside"
    },
    {
      "step_number": 3,
      "instruction": "Place a large, shallow saucepan over a medium heat and add the oil. When the oil is hot add the crushed garlic and stir for a minute until pale golden",
      "ingredients_used": [
        "19b956a1-bc5a-5ce1-bd7d-8a24cdbb556f"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the onion paste and salt and cook for 3-5 minutes, until the onion softens and becomes translucent, stirring occasionally",
      "timer_seconds": 300,
      "ingredients_used": [
        "f1356a43-9529-5d4f-8341-80a217513473",
        "00c8e89f-8672-50f9-9737-8d0ae743d02a"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour in 200ml of water then cover and cook for 10 minutes, stirring once or twice",
      "timer_seconds": 600
    },
    {
      "step_number": 6,
      "instruction": "After 10 minutes add the ground spices and stir for a couple of minutes so that the spices cook through. Cover and cook for 5 minutes over a low heat then stir in the daikon. After a minute or so add 200ml of water. Cover and cook for 10 minutes on a medium heat"
    },
    {
      "step_number": 7,
      "instruction": "Add the fish pieces to the pan and mix thoroughly so that the fish is coated in the spices. Gently shake the pan and cover and cook for 5 minutes on medium heat. It is very important not to stir the pot after this stage",
      "timer_seconds": 300,
      "ingredients_used": [
        "283b7bee-b0da-594f-bfc2-915dae241b3a"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Meanwhile, boil some water. After the 5 minutes are over carefully pour 500ml hot water into the pan. When doing this pour into the sides of the pan so that you don’t pour boiling water directly onto the fish",
      "timer_seconds": 300,
      "ingredients_used": [
        "283b7bee-b0da-594f-bfc2-915dae241b3a"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Give the pan a gentle shake then cover and simmer over high heat for 15 minutes. Add the chopped coriander and chillies and continue cooking for another 5 minutes then turn off the heat. Serve immediately with rice and the lime wedges",
      "ingredients_used": [
        "28ddc48f-0aca-5c32-8d10-755aad848239",
        "38d61cfd-9def-566f-917d-fc4f0e1121e2",
        "08828549-5a20-5a05-985c-ac6715ca349c"
      ]
    }
  ],
