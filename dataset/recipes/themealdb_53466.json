  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the chicken, water and one garlic clove in a large saucepan. Place it over medium-high heat until boiling. Then turn the heat low, cover the pan and simmer the chicken for 10 minutes. Remove the chicken leg and breast. Keep the fresh chicken stock for later.",
      "timer_seconds": 600,
      "ingredients_used": [
        "323e84ee-c977-58c8-9566-acb07f58bb3f",
        "65dc1129-c64d-5385-b9fa-d584f1457b6f",
        "d0b9f4c7-3bff-560e-bb0a-41139f7496f1"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Let the chicken cool. Then dice the chicken breast up. Pick the meat off the leg. Discard any bones and skin. Slice the leek, celery and carrot finely (julienne). Add the butter, rosemary and bay leaves to a large pan and place it over medium heat until melted.",
      "ingredients_used": [
        "323e84ee-c977-58c8-9566-acb07f58bb3f",
        "70582b05-db03-57ca-b3b7-7cd453c18d61",
        "97bd1c22-2d45-54c6-b702-0345be34d06a",
        "562f4244-e7db-5537-bc2a-f63b5d38a349",
        "6614a249-c660-56fc-92a0-8d7db9abdf41"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Then add the sliced vegetables. Season with pepper and salt.",
      "ingredients_used": [
        "912b1c61-267f-58b3-b1f3-376d991db322",
        "557163bd-d6fc-56c1-a206-4480779fa4f0"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Stir and cook the vegetables for 3 minutes. Then add the shredded and diced chicken.",
      "timer_seconds": 180
    },
    {
      "step_number": 5,
      "instruction": "Cover the pan and cook the chicken and vegetables for 5 minutes. Then add the cream and ½ cup (120 ml) of the fresh chicken stock.",
      "timer_seconds": 300,
      "ingredients_used": [
        "aab2767e-8a92-5cb9-9488-47d02657ca39"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Look at this delicious waterzooi recipe! Do try out my chunky chicken stew with fresh leeks, celery, carrots and lots of cream... This is Belgian comfort food!",
      "ingredients_used": [
        "93956c8f-e9a2-592b-be29-dc0128681125",
        "70582b05-db03-57ca-b3b7-7cd453c18d61",
        "97bd1c22-2d45-54c6-b702-0345be34d06a",
        "aab2767e-8a92-5cb9-9488-47d02657ca39"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Cover the pan and cook the stew for 20 minutes until the potatoes are tender. Add the egg yolk and 2 tablespoons of the warm cream from the pan to a cup. Whisk and add it back to the pan to thicken the sauce.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "12e9476b-f27b-58c6-9081-6f3b894e2583",
        "aab2767e-8a92-5cb9-9488-47d02657ca39"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Stir all the ingredients and then turn the heat very low. Check the seasoning and add extra pepper or salt to taste. Remove the rosemary and bay leaves. Divide the stew over deep plates and drizzle with the remaining cream sauce. Serve hot.",
      "ingredients_used": [
        "562f4244-e7db-5537-bc2a-f63b5d38a349",
        "aab2767e-8a92-5cb9-9488-47d02657ca39",
        "912b1c61-267f-58b3-b1f3-376d991db322",
        "557163bd-d6fc-56c1-a206-4480779fa4f0"
      ]
    }
  ],
