  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix all the ingredients for the dipping sauce along with 50ml water in a bowl and set aside to allow the sugar to dissolve and flavor to infuse."
    },
    {
      "step_number": 2,
      "instruction": "To assemble the rolls, fill a wide bowl with warm water and grab a clean damp tea towel to work on. Dip a rice paper wrapper into the water for a few seconds until it softens then carefully place onto the tea towel."
    },
    {
      "step_number": 3,
      "instruction": "Put a few mint and coriander leaves in the center of the wrapper then top with two prawns and a small handful of the spiralized veg, which may need to be cut up if the spirals are too long.",
      "ingredients_used": [
        "692dc940-7ce1-5d7b-9d67-6cdb43470f83",
        "89ec3f15-7c59-5c8f-a288-dc11b470131c",
        "ec34722a-7f4b-5deb-9131-1d0b9c66b782"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Fold the sides of the wrapper into the center, over the filling, then fold in the edges, so that the filling is completely encased, then tightly roll. Repeat until all of the wrappers and filling have been used. To serve, slice on a diagonal and eat with the dipping sauce."
    }
  ],
