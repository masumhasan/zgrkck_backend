  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Wash the stewing steak and place it in the mixing bowl with the lemon or lime juice.",
      "ingredients_used": [
        "a824f489-4d4d-5393-b015-b746b0ca042c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Set that to one side; while you slice the garlic into tiny slices, slice the onion. Chop the basil and thyme.",
      "ingredients_used": [
        "3680ecff-7d00-56fa-b7c7-7186bd90f555",
        "cbc0cbd6-d0e4-5a68-b217-b96b52f823b3",
        "4dd5faf6-0bc8-59b2-9da2-f49326b4c815",
        "191e23a2-d15c-5cb6-8863-d15d7065f3c5"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Now you need to be very careful when you slice the scotch bonnet peppers; you want these in fine pieces, which you can either do with a long knife trying not to touch the pepper, or you can wear rubber gloves to cut it up. Wash your hands straight afterward and do not touch your eyes; these peppers really burn your hands and eyes if they make contact with the skin!",
      "ingredients_used": [
        "0dd48659-1278-5938-b99f-9a965ee80cdd"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Now rinse the lime or lemon juice off the stewing steak. And cut the meat into cubes."
    },
    {
      "step_number": 5,
      "instruction": "Also, chop the pig’s trotters and the oxtail into cubes.",
      "ingredients_used": [
        "f3e228ce-e222-5ee6-97bf-cb373eff0e67",
        "c14e0f39-e422-5a47-8aba-a6b5b62bd043"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Fill the large saucepan with water and bring to a boil."
    },
    {
      "step_number": 7,
      "instruction": "Add the pig’s trotters.",
      "ingredients_used": [
        "f3e228ce-e222-5ee6-97bf-cb373eff0e67"
      ]
    },
    {
      "step_number": 8,
      "instruction": "When the pig’s trotters have boiled, drain the excess water, and now add the stewing steak and cover with fresh hot water.",
      "ingredients_used": [
        "f3e228ce-e222-5ee6-97bf-cb373eff0e67"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Now add your chopped garlic, onion, and peppers.",
      "ingredients_used": [
        "3680ecff-7d00-56fa-b7c7-7186bd90f555",
        "cbc0cbd6-d0e4-5a68-b217-b96b52f823b3"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Now add the cinnamon stick, cloves, basil, and thyme and a pinch of salt and sugar to taste.",
      "ingredients_used": [
        "0b072bbb-7854-5d71-b14e-099f9790b60a",
        "31e3bbff-b7bd-541c-aeea-e4da6326b5c5",
        "befa6d33-cb1a-50bf-aa47-1bac0135e3dd",
        "16c5e86a-039f-5974-978a-d8f722885bfc",
        "4dd5faf6-0bc8-59b2-9da2-f49326b4c815",
        "191e23a2-d15c-5cb6-8863-d15d7065f3c5"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Now simmer until the meat is tender. The flavor of this dish comes out over a few days and therefore gets tastier each time you reheat it; make sure you always reheat the entire pot to boiling point."
    }
  ],
