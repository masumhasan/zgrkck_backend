  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Boil the potatoes. Peel the potatoes while still warm and run them through a potato ricer twice.",
      "ingredients_used": [
        "1d51bedf-c436-599f-a5cc-2c7aff20faa8"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Let the potatoes cool in an uncovered bowl in the fridge.",
      "ingredients_used": [
        "1d51bedf-c436-599f-a5cc-2c7aff20faa8"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Stir the salt, sugar, melted butter, and cream into the riced potatoes.",
      "ingredients_used": [
        "1d51bedf-c436-599f-a5cc-2c7aff20faa8",
        "5c7aaf13-ea87-5ff3-9377-de3d45564bab",
        "50388a75-1ff0-595a-8477-4b04d3f47609",
        "54da10cd-16f2-574b-b3ad-c8d015cad125",
        "ed1983f4-1c6a-5625-8cb9-89263553c37a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Slowly add the flour and knead by hand until you get a good consistency. Don't add more flour than necessary! Roll the dough into a long sausage and divide into about 7 or 8 pieces if using an 18 inch griddle. If using a smaller griddle or frying pan, divide the dough into 10 – 12 pieces.",
      "ingredients_used": [
        "744795a7-9395-5e31-a7e0-3b3fc05ff136"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Roll each piece into a ball and then press into a flat circle, using the edges of your hands to form the dough into a nice circle shape without any cracks. This is important, otherwise you won't get round lefser."
    },
    {
      "step_number": 6,
      "instruction": "Heat up your griddle on medium/high heat."
    },
    {
      "step_number": 7,
      "instruction": "Flour your rolling surface and roll the lefse dough into a large circle slightly smaller than your griddle or frying pan. Begin rolling with a smooth rolling pin, then switch to a corrugated rolling pin as the lefse gets thinner. Don't use too much flour, as then the edges can become hard.",
      "ingredients_used": [
        "744795a7-9395-5e31-a7e0-3b3fc05ff136"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Roll the lefse onto your lefse stick and then gently unroll it onto your griddle. After a minute or two check the underside of the lefse for brown spots and then use the lefse stick to flip the lefse and cook on the other side."
    },
    {
      "step_number": 9,
      "instruction": "Use the lefse stick to remove the lefse from the griddle and place it in a folded damp sheet or tablecloth."
    }
  ],
