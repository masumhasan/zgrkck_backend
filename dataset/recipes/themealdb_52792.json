  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Grease a 1 liter/2 pint pie dish with butter.",
      "ingredients_used": [
        "0bedf0bb-f31e-5e87-b226-1d27eb8ac2ef"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cut the crusts off the bread. Spread each slice with on one side with butter, then cut into triangles.",
      "ingredients_used": [
        "0bedf0bb-f31e-5e87-b226-1d27eb8ac2ef",
        "12e346a2-afea-599d-9f77-3cc055b68c72"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Arrange a layer of bread, buttered-side up, in the bottom of the dish, then add a layer of sultanas. Sprinkle with a little cinnamon, then repeat the layers of bread and sultanas, sprinkling with cinnamon, until you have used up all of the bread. Finish with a layer of bread, then set aside.",
      "ingredients_used": [
        "0bedf0bb-f31e-5e87-b226-1d27eb8ac2ef",
        "12e346a2-afea-599d-9f77-3cc055b68c72",
        "ee6edcb1-236c-5648-aae6-e7abbb1482c0",
        "42aeba7a-fd65-5739-8232-87136489a8d1"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Gently warm the milk and cream in a pan over a low heat to scalding point. Don't let it boil.",
      "ingredients_used": [
        "3ad7cf0f-1c35-504e-9ef9-858ae30cf71b"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Crack the eggs into a bowl, add three quarters of the sugar and lightly whisk until pale.",
      "ingredients_used": [
        "d029e657-96ab-55a6-ad98-b488dbe2a8ff",
        "00ab7e23-6152-5ed3-9b27-0f48c6ed0bb0"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add the warm milk and cream mixture and stir well, then strain the custard into a bowl.",
      "ingredients_used": [
        "3ad7cf0f-1c35-504e-9ef9-858ae30cf71b"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Pour the custard over the prepared bread layers and sprinkle with nutmeg and the remaining sugar and leave to stand for 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "12e346a2-afea-599d-9f77-3cc055b68c72",
        "00ab7e23-6152-5ed3-9b27-0f48c6ed0bb0",
        "9329b8af-56bb-5218-8efc-326da3304838"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Preheat the oven to 180C/355F/Gas 4.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 9,
      "instruction": "Place the dish into the oven and bake for 30-40 minutes, or until the custard has set and the top is golden-brown.",
      "timer_seconds": 2400
    }
  ],
