  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 120C/225F/gas mark 1.",
      "temperature": {
        "value": 120,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Take the meat out of the fridge to de-chill. Pulse the onions and garlic in a food processor until finely chopped. Heat 2 tbsp olive oil in a large casserole and sear the meat on all sides until golden.",
      "ingredients_used": [
        "15b4e690-1af6-5b39-91a4-21b7c1d2c0b9",
        "1ad56b0f-046c-5953-95a1-cbeb10691b6f",
        "698d0891-93eb-5d24-ba72-7f5c7d22ea27"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Set to one side and add another small slug of oil to brown the chorizo. Remove and add the onion and garlic, spices, herbs and chillies then cook until soft in the chorizo oil. Season with salt and pepper and add the vinegar, tomatoes, ketchup and sugar.",
      "ingredients_used": [
        "1ad56b0f-046c-5953-95a1-cbeb10691b6f",
        "209662fb-e6ed-55f9-9bf8-6840bd6dd3d5",
        "4b42b82f-e312-5c34-a225-1dc5c43237b1",
        "ab4e72e9-c955-5176-a65f-1f1665d457ce",
        "3ba8f04c-2a9c-5ae9-9b0d-61811529e76c"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Put all the meat back into the pot with 400ml water (or red wine if you prefer), bring up to a simmer and cook, covered, in the low oven."
    },
    {
      "step_number": 5,
      "instruction": "After 2 hours, check the meat and add the beans. Cook for a further hour and just before serving, pull the meat apart with a pair of forks.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "6a454c3e-6d02-5473-80da-6695a148755d"
      ]
    }
  ],
