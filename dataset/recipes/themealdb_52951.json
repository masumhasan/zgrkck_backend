  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "DIRECTIONS:"
    },
    {
      "step_number": 2,
      "instruction": "SAUCE"
    },
    {
      "step_number": 3,
      "instruction": "In a bowl, add 2 Cups of water, 2 Tablespoon soy sauce, 2 Tablespoon white vinegar, sherry cooking wine, 1/4 Teaspoon white pepper, minced ginger, minced garlic, hot pepper, ketchup, hoisin sauce, and sugar.",
      "ingredients_used": [
        "92d9110a-6117-51d3-8abd-65633a2048ff",
        "2afe74e5-998c-5c73-bea9-e2f8c4ee9e92",
        "189e123c-2c09-506e-9fcb-eb054d05e6c0",
        "7d06c70c-108d-5ae2-9518-3a8a8e80cca7"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Mix together well and set aside."
    },
    {
      "step_number": 5,
      "instruction": "MARINATING THE CHICKEN"
    },
    {
      "step_number": 6,
      "instruction": "In a bowl, add the chicken, 1 pinch of salt, 1 pinch of white pepper, 2 egg whites, and 3 Tablespoon of corn starch",
      "ingredients_used": [
        "124f1f47-5221-5cce-b5ca-a309b8633a7a",
        "f44989c3-30db-5dd3-a33e-6efe75cdf95a",
        "d992e5a0-13e4-55b5-ad9a-38fd8acaf4af",
        "f63cfda9-ad79-5c78-93ab-2f502b4af643",
        "2ed97adb-be46-59e4-9ffb-55a8127b96e3"
      ]
    },
    {
      "step_number": 7,
      "instruction": "DEEP FRY THE CHICKEN"
    },
    {
      "step_number": 8,
      "instruction": "Deep fry the chicken at 350 degrees for 3-4 minutes or until it is golden brown and loosen up the chicken so that they don't stick together.",
      "timer_seconds": 240
    },
    {
      "step_number": 9,
      "instruction": "Set the chicken aside."
    },
    {
      "step_number": 10,
      "instruction": "STIR FRY"
    },
    {
      "step_number": 11,
      "instruction": "Add the sauce to the wok and then the broccoli and wait until it is boiling."
    },
    {
      "step_number": 12,
      "instruction": "To thicken the sauce, whisk together 2 Tablespoon of cornstarch and 4 Tablespoon of water in a bowl and slowly add to your stir-fry until it's the right thickness.",
      "ingredients_used": [
        "92d9110a-6117-51d3-8abd-65633a2048ff"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Next add in the chicken and stir-fry for a minute and serve on a plate"
    }
  ],
