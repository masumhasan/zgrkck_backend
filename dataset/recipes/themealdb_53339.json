  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 350 °F (180 °C) and line a large baking sheet with parchment paper.",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "In a stand mixer with the paddle attachment, cream the butter, white sugar and egg until combined, then add the molasses and vanilla and mix until smooth.",
      "ingredients_used": [
        "9b556829-9f4d-5375-ab44-e50a5753de77",
        "0234221d-7642-5218-9ea6-33544adc94e6",
        "5c836ca0-8968-51cf-8cb3-9ea315dc1fe5",
        "ab3c0a5e-5e88-5139-9eb0-e90c6ad77908",
        "027ba3f4-172e-5928-b014-3320b9a8e783"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Once combined, add the baking soda water mixture and mix for another minute to combine.",
      "ingredients_used": [
        "3ab11918-02eb-56ef-bdad-7a108cb3408c"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Combine dry ingredients; mix baking powder, cinnamon, flour and salt in a separate bowl then add to the wet ingredients a little at a time, mixing on low until fully combined and scraping down the sides to ensure everything is incorporated. The dough should be easily shaped.",
      "ingredients_used": [
        "cdfa5a2b-a86e-5321-922f-bef93c255db3",
        "390e222f-75b7-5a01-92df-8e51df6ce80c",
        "88a0a273-ced0-5777-a10a-5ae08baefd08",
        "1cd12b91-0ed1-53be-902c-40d16e812724",
        "59d51e5f-e282-5478-bfdd-b8f9bd070d1f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Portion dough with a small spoon, roll them into balls and place them on the lined cookie sheet, press them into flat discs using a floured glass or your moistened palm."
    },
    {
      "step_number": 6,
      "instruction": "Place cookies on parchment-lined baking sheets and bake for 10-12 mins. Remove from the oven and let them cool for at least 10 minutes."
    },
    {
      "step_number": 7,
      "instruction": "Once cooled the cookie sandwiches by spreading at least two teaspoons of your favorite jam between the two cookies. Repeat and enjoy with a cup of tea.",
      "ingredients_used": [
        "ef15297c-922c-5a1f-992b-3ec71f158f31"
      ]
    }
  ],
