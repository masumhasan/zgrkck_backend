      ]
    },
    {
      "step_number": 2,
      "instruction": "Drizzle vegetable oil in a 30cm x 25cm x 6cm deep roasting tray and heat in the oven for 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "604c9479-f0a8-57e2-a384-c790a4464196"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Put the plain flour in a bowl, crack in the medium free-range eggs, then stir in the grated horseradish. Gradually beat in the semi-skimmed milk. Season.",
      "ingredients_used": [
        "210facad-ed8c-577d-979c-babd71c4e7bf",
        "af8d3214-51ac-5190-853c-475cc7898603",
