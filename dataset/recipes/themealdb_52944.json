  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Rinse fish; rub with lemon or lime, seasoned with salt and pepper or use your favorite seasoning. I used creole seasoning. Set aside or place in the oven to keep it warm until sauce is ready.",
      "ingredients_used": [
        "b8c64171-6b74-53c1-8db4-63ea75a5e2da",
        "d2daa7ef-524c-5322-9828-37c3458970cd"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In large skillet heat oil over medium heat, until hot, add the fish, cook each side- for about 5-7 minutes until cooked through and crispy on both sides. Remove fish and set aside. Drain oil and leave about 2-3 tablespoons of oil",
      "timer_seconds": 420
    },
    {
      "step_number": 3,
      "instruction": "Add, bay leave, garlic and ginger, stir-fry for about a minute making sure the garlic does not burn",
      "ingredients_used": [
        "38b3b91f-b4b3-592f-b812-6abf41c8b49a",
        "0e54fb05-1e7f-5bbf-9cea-125b3ddc7880"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Then add onion, bell peppers, thyme, scotch bonnet, sugar, all spice-continue stirring for about 2-3 minutes. Add vinegar, mix an adjust salt and pepper according to preference. Let it simmer for about 2 more minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "735312cb-1718-5e59-8350-b15a77d28630",
        "10983348-e445-5802-b597-161ad4cb4379",
        "9cc5a33f-74cd-5e75-abef-ef53520a8e9d",
        "9d005aba-6c16-554d-b114-6b03e6b7de8f",
        "d2daa7ef-524c-5322-9828-37c3458970cd"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Discard bay leave, thyme spring and serve over fish with a side of this bammy. You may make the sauce about 2 days in advance.",
      "ingredients_used": [
        "735312cb-1718-5e59-8350-b15a77d28630"
      ]
    }
  ],
