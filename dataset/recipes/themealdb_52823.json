  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Melt the butter in a thick-based pan and gently cook the onion without color until it is soft.",
      "ingredients_used": [
        "310f509f-313f-5be7-b15f-c0b833e88d12",
        "b64b2e03-72cd-55e8-be9a-5d6b499cfb04"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the rice and stir to coat all the grains in the butter",
      "ingredients_used": [
        "310f509f-313f-5be7-b15f-c0b833e88d12",
        "d292c9f5-31db-546b-bc9c-9a09a7c96534"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the wine and cook gently stirring until it is absorbed",
      "ingredients_used": [
        "8a295d2e-056b-5194-a07e-5390b63ad3c8"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Gradually add the hot stock, stirring until each addition is absorbed. Keep stirring until the rice is tender",
      "ingredients_used": [
        "d292c9f5-31db-546b-bc9c-9a09a7c96534"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Season with the lemon juice and zest, and pepper to taste. (there will probably be sufficient saltiness from the salmon to not need to add salt) Stir gently to heat through",
      "ingredients_used": [
        "e8dd9d9f-b0b8-5334-9b36-fff17a9ee137",
        "de087acb-3bc1-5703-9b13-8821c8e2dd74"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Serve scattered with the Parmesan and seasonal vegetables.",
      "ingredients_used": [
        "10f499b5-589d-50b6-9a25-87a4bd0c8801"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Grill the salmon and gently place onto the risotto with the prawns and asparagus",
      "ingredients_used": [
        "1baf28e5-9424-57b6-b6ae-69299c09f023",
        "de087acb-3bc1-5703-9b13-8821c8e2dd74",
        "b6453504-b122-5407-aa8b-f9ee4daac169"
      ]
    }
  ],
