  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix milk, oil and egg together. Sift flour, baking powder and salt into the mixture. Stir well until all ingredients are combined evenly.",
      "ingredients_used": [
        "39643747-e3ea-59bf-84c2-2cd15fc2894f",
        "f953feae-7130-5017-bfe5-f54ed6211ec5",
        "843057e2-7ed5-5fbb-b4c3-a324ebd7f020",
        "d8bf4f4f-ea27-55b0-aa12-75c93cb4be62",
        "43ed7ab0-d444-5999-93e8-2ec113534242"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Spread some batter onto the pan. Spread a thin layer of batter to the side of the pan. Cover the pan for 30-60 seconds until small air bubbles appear.",
      "timer_seconds": 60
    },
    {
      "step_number": 3,
      "instruction": "Add butter, cream corn, crushed peanuts and sugar onto the pancake. Fold the pancake into half once the bottom surface is browned.",
      "ingredients_used": [
        "dfe36221-fafd-5b30-926f-f468239e4094",
        "82d4c4a5-9acd-5326-8a64-d164735d4df6",
        "15fe3981-66a7-5d40-9de1-0ca9e958ecb0"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cut into wedges and best eaten when it is warm."
    }
  ],
