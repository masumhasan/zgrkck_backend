  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add all the flour, baking powder, and salt to a large mixing bowl.",
      "ingredients_used": [
        "7e01e152-a154-501b-80c0-8a71d67457b9",
        "1f8b5341-c767-5ba2-9ae4-5e314c3a0b11",
        "6a1c95ee-e3af-5416-b37f-b4eeec71b8af"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Melt the butter in a saucepan.",
      "ingredients_used": [
        "e7faf295-3224-5cda-bcec-9434b070aabe"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Mix the coconut and most of the sugar in another bowl – leave some back to cover the loaves later, raisins, egg, milk, almond essence, vanilla essence, and melted butter.",
      "ingredients_used": [
        "aa0fb351-97f7-55c0-8291-ee22bc645240",
        "e7faf295-3224-5cda-bcec-9434b070aabe",
        "be755230-64fb-5ed1-93df-7a08d9d60b1b",
        "8367bb33-f561-542f-b68a-ef25c3e96d06",
        "242ccf89-8525-5dc8-a306-6846872b62ca",
        "db6ec6bc-0bb6-5490-8d2e-a35965a2499e",
        "c0126c91-f957-5c18-960b-15df3031f4f7"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Mix well until you have a creamy paste."
    },
    {
      "step_number": 5,
      "instruction": "Add this to the bowl with the flour, baking powder, and salt. Mix until you form a stiff dough.",
      "ingredients_used": [
        "7e01e152-a154-501b-80c0-8a71d67457b9",
        "1f8b5341-c767-5ba2-9ae4-5e314c3a0b11",
        "6a1c95ee-e3af-5416-b37f-b4eeec71b8af"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Now divide the mixture between the baking tins."
    },
    {
      "step_number": 7,
      "instruction": "Now boil the water."
    },
    {
      "step_number": 8,
      "instruction": "Mix two tablespoons of sugar with some hot water and brush the top of each loaf.",
      "ingredients_used": [
        "be755230-64fb-5ed1-93df-7a08d9d60b1b"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Bake in the center of the oven for 1 hour.",
      "timer_seconds": 3600
    },
    {
      "step_number": 10,
      "instruction": "Leave to cool in tins before serving; slice and serve with a fresh pot of tea."
    }
  ],
