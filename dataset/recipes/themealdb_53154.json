  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Fry the chorizo in a large frying pan with a lid, over a medium heat until it is starting to crisp up and release its oil. Add the onion and cook for 5 mins until starting to soften. Then add the garlic and finely chopped parsley, and fry for 1 min more.",
      "ingredients_used": [
        "78917d39-4c4b-5b63-9aa1-eb1ebe809754",
        "4d5322dd-a932-5cef-a1f9-62a32504a052",
        "56a89cd5-1716-5093-a19a-da8b619c9a97"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Pour on the stock and tomatoes. Bring to the boil, reduce the heat, then add the beans and sherry vinegar. Simmer for 10 mins until the liquid is slightly reduced.",
      "timer_seconds": 600,
      "ingredients_used": [
        "f54f05b5-d87c-525d-a8ce-f608d04fa9f6",
        "326c2a10-b8e6-593d-b14c-ca494cb050cf"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Scatter over the clams, cover with the lid and steam for 2-4 mins, shaking the pan occasionally until the clams are open. Have a little taste before seasoning, as the clams can be quite salty. Then scatter over the chopped parsley. Eat with lots of crusty bread.",
      "timer_seconds": 240,
      "ingredients_used": [
        "56a89cd5-1716-5093-a19a-da8b619c9a97",
        "3134aaa6-a0e4-5969-9ef5-3cd706df3cb2",
        "d45c8036-85d5-598e-b96c-372568491fda"
      ]
    }
