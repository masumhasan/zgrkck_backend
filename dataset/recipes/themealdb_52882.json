  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 200C/400F/Gas 6 (180C fan).",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Put the potatoes into a saucepan of cold salted water. Bring up to the boil and simmer until completely tender. Drain well and then mash with the butter and milk. Add pepper and taste to check the seasoning. Add salt and more pepper if necessary.",
      "ingredients_used": [
        "0b1cea47-7e11-5612-966c-2e0b6af8ba5a",
        "aa2844a9-f4cd-5311-8963-cb337bd02dab",
        "faca26c2-a19b-564e-8580-1ad68a888f70",
        "1b5e5c86-269d-53e1-ad99-ced202b4b884",
        "35979693-f63d-51b8-ab33-30d91870ebba"
      ]
    },
    {
      "step_number": 3,
      "instruction": "For the fish filling, melt the butter in a saucepan, add the leeks and stir over the heat. Cover with a lid and simmer gently for 10 minutes, or until soft. Measure the flour into a small bowl. Add the wine and whisk together until smooth.",
      "timer_seconds": 600,
      "ingredients_used": [
        "aa2844a9-f4cd-5311-8963-cb337bd02dab",
        "1b5e5c86-269d-53e1-ad99-ced202b4b884",
        "a7380e26-571e-53c8-8c2a-c6ef782688b5",
        "0eee08af-588e-5bab-a111-987cc373a9bc"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the milk to the leeks, bring to the boil and then add the wine mixture. Stir briskly until thickened. Season and add the parsley and fish. Stir over the heat for two minutes, then spoon into an ovenproof casserole. Scatter over the eggs. Allow to cool until firm.",
      "ingredients_used": [
        "faca26c2-a19b-564e-8580-1ad68a888f70",
        "a7380e26-571e-53c8-8c2a-c6ef782688b5",
        "0eee08af-588e-5bab-a111-987cc373a9bc",
        "35979693-f63d-51b8-ab33-30d91870ebba",
        "2684cdfa-108e-59e2-b7ac-7a0a29ae45bd",
        "d7d0d792-4d2a-5604-a154-fd740ee9f888"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Spoon the mashed potatoes over the fish mixture and mark with a fork. Sprinkle with cheese.",
      "ingredients_used": [
        "0b1cea47-7e11-5612-966c-2e0b6af8ba5a"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Bake for 30-40 minutes, or until lightly golden-brown on top and bubbling around the edges.",
      "timer_seconds": 2400
    }
  ],
