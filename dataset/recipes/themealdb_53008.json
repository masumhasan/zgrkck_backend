  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 180C/160C fan/gas 4. Slice the tops off the tomatoes and reserve. Scoop out most of the pulp with a teaspoon, being careful not to break the skin. Finely chop the pulp, and keep any juices. Sprinkle the insides of the tomatoes with a little sugar to take away the acidity, then place them on a baking tray.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
      "ingredients_used": [
        "537aa0a7-dcb6-5391-885a-965034d92675",
        "0c28dd5e-d48c-51d6-b2b3-7053aeb6b0b5"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat 2 tbsp olive oil in a large frying pan, add the onion and garlic, then gently cook for about 10 mins until soft but not colored. Add the lamb, cinnamon and tomato purée, turn up the heat, then fry until the meat is browned. Add the tomato pulp and juice, the rice and the stock. Season generously. Bring to the boil, then simmer for 15 mins or until the rice is tender and the liquid has been absorbed. Set aside to cool a little, then stir in the herbs.",
      "ingredients_used": [
        "c92ce04d-a978-5f25-806b-a9f42d0c3c66",
        "01fe3ac8-67d4-5a97-bdea-21bc89fad433",
        "f96ab273-15f1-5544-8b56-f776ad4a5e8f",
        "09da9e59-9264-5008-a95e-e57ff5bde698",
        "a5105a45-9851-5781-bf47-11734f7026fa"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Stuff the tomatoes up to the brim, top tomatoes with their lids, drizzle with 2 tbsp more olive oil, sprinkle 3 tbsp water into the tray, then bake for 35 mins. Serve with salad and crusty bread, hot or cold.",
      "timer_seconds": 2100,
      "ingredients_used": [
        "537aa0a7-dcb6-5391-885a-965034d92675",
        "c92ce04d-a978-5f25-806b-a9f42d0c3c66"
      ]
    }
  ],
