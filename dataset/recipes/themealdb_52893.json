  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 190C/170C fan/gas 5. Tip the flour and sugar into a large bowl. Add the butter, then rub into the flour using your fingertips to make a light breadcrumb texture. Do not overwork it or the crumble will become heavy. Sprinkle the mixture evenly over a baking sheet and bake for 15 mins or until lightly colored.",
      "timer_seconds": 900,
      "temperature": {
        "value": 190,
        "unit": "celsius"
      },
      "ingredients_used": [
        "4a5b0e45-12f7-56ca-b14f-25691865dfe8",
        "680a4460-cb7d-5319-8bdc-bb0d49f88521"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Meanwhile, for the compote, peel, core and cut the apples into 2cm dice. Put the butter and sugar in a medium saucepan and melt together over a medium heat. Cook for 3 mins until the mixture turns to a light caramel. Stir in the apples and cook for 3 mins. Add the blackberries and cinnamon, and cook for 3 mins more. Cover, remove from the heat, then leave for 2-3 mins to continue cooking in the warmth of the pan.",
      "ingredients_used": [
        "4a5b0e45-12f7-56ca-b14f-25691865dfe8",
        "f834d525-abbe-5d0f-8a83-25291be2b1c1",
        "680a4460-cb7d-5319-8bdc-bb0d49f88521",
        "ca8c963d-7884-53b1-b912-a884f14d6b5f",
        "76839eb6-c8a1-54e9-b6ad-ff5955d64d1c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "To serve, spoon the warm fruit into an ovenproof gratin dish, top with the crumble mix, then reheat in the oven for 5-10 mins. Serve with vanilla ice cream.",
      "timer_seconds": 600,
      "ingredients_used": [
        "56bde445-0f66-5fcb-84bf-fa789e1e1349"
      ]
    }
  ],
