  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Allow butter to come to room temperature before beating in a bowl until creamed. Season with salt and a small, delicate pinch of nutmeg.",
      "ingredients_used": [
        "27df9384-75e2-5bb5-b486-1cdaa7b306f2",
        "610a54cc-2c96-57dd-8ebb-c3d9a24e9d3b",
        "8168bff0-9283-5c8d-87a7-83c6c443c7b1"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add in the egg, stirring vigorously. Sprinkle the semolina over this, and mix it in well until the surface is smooth. Cover with saran wrap and leave to rest for 15 – 20 minutes.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "47d80c0f-97d7-556e-934b-90bbcccaa351",
        "04d554b6-2efa-5fab-bbd8-1ddb0a4f3202"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Use two spoons, dipped regularly into hot water throughout, to press or shape dumplings from the paste. You can also place these on a lightly oiled board or plate and again leave them to stand for a short while (this allows the dumplings to rise even more)."
    },
    {
      "step_number": 4,
      "instruction": "Heat a generous quantity of salted water in a large pan. Place the dumplings into the water and bring them back to a boil before turning down the heat and leaving to simmer gently for 10 – 15 minutes (do not boil). Carefully turn the dumplings occasionally.",
      "timer_seconds": 900,
      "ingredients_used": [
        "610a54cc-2c96-57dd-8ebb-c3d9a24e9d3b"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Remove the semolina dumplings carefully and put them in the heated soup. Serve promptly, with a garnish of sprinkled parsley or chives.",
      "ingredients_used": [
        "47d80c0f-97d7-556e-934b-90bbcccaa351",
        "5d8ca8e7-cf5c-5e4e-a59a-a70f6d15ca6b"
      ]
    },
    {
      "step_number": 6,
      "instruction": "The semolina dumplings can also be cooked in the beef broth, but this causes the soup to take on a slightly dull appearance. The cooked dumplings should never be left standing in the soup for too long, as they will “soak up” the soup and become softened.",
      "ingredients_used": [
        "47d80c0f-97d7-556e-934b-90bbcccaa351"
      ]
    }
  ],
