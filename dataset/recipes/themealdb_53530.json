  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Pat the chicken dry and season the pieces with salt, pepper and paprika.",
      "ingredients_used": [
        "18ea93ba-67b0-5a75-9ed6-ea956e86a824",
        "99ca9d78-a48d-59bd-a867-e5ff887597ba"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat a saucepan over medium high heat and add the oil. Let the oil heat for a few seconds. Add the chicken and cook to sear all the sides turning the pieces a couple of times until they are golden browned about 10 minutes.",
      "timer_seconds": 600
    },
    {
      "step_number": 3,
      "instruction": "Transfer the browned chicken to a plate and set a side. Add the onions and garlic to the skillet and cook for about 2 minutes or until soft. Add the chicken broth, mustard, honey and cream. Season with salt and black pepper.",
      "timer_seconds": 120,
      "ingredients_used": [
        "99ca9d78-a48d-59bd-a867-e5ff887597ba",
        "afc17f1e-2a48-50f4-b719-1a38135196ee",
        "10274ff5-0398-51ef-aa66-d55935158412",
        "560684a0-1fa9-5d60-b2af-a56d3c71aee4",
        "f24719ef-b38b-563f-bd13-0cddb9bd34bf",
        "bed62096-ad51-5580-8956-94180ec4646a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Stir well and return the chicken pieces to the pan. Cover the pan and cook over medium low for about 45 minutes or until the chicken is cooked. The final temperature for chicken legs should be 170˚F.",
      "timer_seconds": 2700,
      "ingredients_used": [
        "c3458d64-7237-52dd-ac8f-a0441bd8a3fb"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Serve warm over white rice and garnish with chopped parsley.",
      "ingredients_used": [
        "f6451f4f-d69b-5bf2-963d-64274221ade5"
      ]
    }
  ],
