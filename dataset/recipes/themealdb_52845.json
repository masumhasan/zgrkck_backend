  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 180C/160C fan/gas 4. Heat the oil in a large frying pan and cook the onion for 8-10 mins until softened. Add the garlic, Worcestershire sauce and 2 tsp tomato purée, and stir until combined. Set aside to cool.",
      "timer_seconds": 600,
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
      "ingredients_used": [
        "38469145-150c-5748-a762-81606b534770",
        "5308ccb0-dbda-50fa-a33d-6e8f2ce43315",
        "85f53e02-a2a6-5627-8783-82c41a352e36"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Put the turkey mince, egg, breadcrumbs and cooled onion mix in a large bowl and season well. Mix everything to combine, then shape into a rectangular loaf and place in a large roasting tin. Spread 2 tbsp barbecue sauce over the meatloaf and bake for 30 mins.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "38469145-150c-5748-a762-81606b534770",
        "be8b3904-0138-5f8f-98be-b06f370f4687",
        "d89184aa-6e48-51bc-98d1-74ed87e7cb59"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Meanwhile, drain 1 can of beans only, then pour both cans into a large bowl. Add the remaining barbecue sauce and tomato purée. Season and set aside.",
      "ingredients_used": [
        "04d20e82-ca32-5f1c-b7bc-8e548212c99e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "When the meatloaf has had its initial cooking time, scatter the beans around the outside and bake for 15 mins more until the meatloaf is cooked through and the beans are piping hot. Scatter over the parsley and serve the meatloaf in slices.",
      "timer_seconds": 900,
      "ingredients_used": [
        "04d20e82-ca32-5f1c-b7bc-8e548212c99e",
        "e73f80fa-42f0-56c2-b798-a2ba70e52814"
      ]
    }
  ],
