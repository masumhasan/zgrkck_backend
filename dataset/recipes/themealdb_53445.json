  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix the cubed white bread with the milk, season with salt, and let the mixture rest for a while.",
      "ingredients_used": [
        "b1a589a8-5cbd-5679-96fc-112a3f6f175d",
        "f62ff4a5-e639-50eb-8677-e07c67dae617",
        "f4f6883e-d772-5677-bddc-220b275cdedc"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Now add the shredded potatoes, the grated cheese, eggs, and parsley.",
      "ingredients_used": [
        "bd33306e-089e-5533-9c74-84956c46729c",
        "9a144bdc-0fd3-5338-94fb-dc168f1338b3",
        "abdefc36-20ce-5652-aa35-df2a7c52d898",
        "16bbed5c-e552-519a-b03a-39c032eae722"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Melt the butter and fry the cubed onions until golden brown in color and put into the mixture.",
      "ingredients_used": [
        "f58fcec1-a761-5507-a48a-c5cc3da16a55",
        "3f0e1399-ef1f-52d1-b0bc-d99f09918372"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the flour and gently knead the dough. Shape it into round dumplings, gently press them flat and fry them on both sides in butter until golden brown.",
      "ingredients_used": [
        "a5809116-2679-511a-a61e-e2f24e6e7476",
        "3f0e1399-ef1f-52d1-b0bc-d99f09918372"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Serve in clear broth."
    }
  ],
