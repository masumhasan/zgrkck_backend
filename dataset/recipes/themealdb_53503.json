  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat 1 tbsp vegetable oil in a large pot over medium-high heat until it shimmers, about 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "b0d81aea-ad67-5ca0-94e3-b402d5b85c35"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add 1 lb boneless, skinless chicken thighs to the pot and cook until browned on all sides, approximately 5-7 minutes, stirring occasionally to prevent sticking.",
      "timer_seconds": 420,
      "ingredients_used": [
        "782bd1c5-b91c-5a3d-81af-53694713fb94"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Pour 4 cups water into the pot and bring to a boil, then reduce heat to a simmer.",
      "ingredients_used": [
        "baf68b45-0f36-5c79-80e6-9c3e99d31ce6"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Stir in 2 tbsp tamarind paste, 1 tbsp fish sauce, and 1 tsp sugar until fully dissolved, about 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "20ccc3f3-70d8-586b-ad6b-98afe28671ba",
        "00e109b2-1c0b-510d-8b1a-463ec4a32439",
        "d33c4391-599a-5bad-81f7-ac7cf25690db"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add 1 stalk lemongrass and 2 kaffir lime leaves to the pot, then cover and simmer for 10 minutes to infuse the broth with flavor.",
      "timer_seconds": 600,
      "ingredients_used": [
        "2d819ae6-095c-50c6-8de1-2efcf27036c0",
        "05be2882-1718-5edc-a02f-e134534cec2e"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Tip: Bruising the lemongrass before adding helps release its essential oils for a more aromatic stew.",
      "ingredients_used": [
        "2d819ae6-095c-50c6-8de1-2efcf27036c0"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add 1 cup pineapple chunks, 1 cup cherry tomatoes, and 1 cup green beans to the pot, stirring gently to combine.",
      "ingredients_used": [
        "9b2292ea-7783-58f7-a397-07c4ff3d6b96",
        "83bcd107-2760-5bf8-8535-1346e2856d0a",
        "93abc49a-f8ba-5194-8a8b-1812c675faa7"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Simmer uncovered for 10-12 minutes, or until the green beans are tender but still crisp and the tomatoes start to soften.",
      "timer_seconds": 720,
      "ingredients_used": [
        "83bcd107-2760-5bf8-8535-1346e2856d0a",
        "93abc49a-f8ba-5194-8a8b-1812c675faa7"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Tip: Avoid overcooking the vegetables to maintain their vibrant color and texture in the final dish."
    },
    {
      "step_number": 10,
      "instruction": "Stir in 1 Thai chili and simmer for an additional 2 minutes to incorporate the heat.",
      "timer_seconds": 120
    },
    {
      "step_number": 11,
      "instruction": "Tip: Taste the broth and adjust with extra tamarind paste or fish sauce if desired, but do so gradually to avoid overpowering the balance.",
      "ingredients_used": [
        "20ccc3f3-70d8-586b-ad6b-98afe28671ba",
        "00e109b2-1c0b-510d-8b1a-463ec4a32439"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Remove the pot from heat and discard the lemongrass and kaffir lime leaves before serving.",
      "ingredients_used": [
        "2d819ae6-095c-50c6-8de1-2efcf27036c0",
        "05be2882-1718-5edc-a02f-e134534cec2e"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Present the stew hot in bowls, optionally garnished with fresh herbs like cilantro."
    }
  ],
