  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel and chop eggplant and pumpkin into medium-sized pieces.",
      "ingredients_used": [
        "f5e6f1f9-a1d3-5820-8c59-d9953064c82e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat butter and add onions and garlic in a medium sized pot set to medium to high heat. Sauté for 2 minutes until softened but not browned.",
      "timer_seconds": 120,
      "ingredients_used": [
        "ca586762-afb5-54bb-be5c-b55dcb878256",
        "86d48f48-d716-51a8-9090-1b2b41da9aa6",
        "b583a6fb-1875-5070-b3b9-4e04053f7c44"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add pumpkin and eggplant. Sauté for an additional two to three minutes.",
      "ingredients_used": [
        "f5e6f1f9-a1d3-5820-8c59-d9953064c82e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add water just to cover the vegetables. Bring to a boil, reduce heat to a simmer and cook until the vegetables are soft."
    },
    {
      "step_number": 5,
      "instruction": "Add the chopped spinach, stir and cook for an additional 3 minutes.",
      "timer_seconds": 180
    },
    {
      "step_number": 6,
      "instruction": "Pour the vegetable mixture into a colander and let drain."
    },
    {
      "step_number": 7,
      "instruction": "After vegetable mixture has been drained return it to the pot and mash vigorously with a potato masher or a thick whisk."
    },
    {
      "step_number": 8,
      "instruction": "Add salt and pepper. Adjust seasoning to taste.",
      "ingredients_used": [
        "ea947c91-3cc8-50a0-8581-e88ce892fb08"
      ]
    }
  ],
