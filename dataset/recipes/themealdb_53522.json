  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a small pot, add water and cinnamon sticks, bring to a boil and cook for 10 minutes. Set aside and discard cinnamon sticks.",
      "timer_seconds": 600,
      "ingredients_used": [
        "f49b461a-f5f1-5a47-818c-ddfdbf5feb57",
        "bf642174-d0fe-525c-8e4c-cd501262c6a6"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Place the rice and the cinnamon water in a large saucepan, over medium heat and cook for 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "523eb9ad-cbf9-5f9f-af4a-caa62411b5e9",
        "bf642174-d0fe-525c-8e4c-cd501262c6a6"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add salt, butter, vanilla extract, 2 cups of milk, and sugar. Stir well to mix and cook uncovered for approximately 15 minutes.",
      "timer_seconds": 900,
      "ingredients_used": [
        "8c96fbeb-2476-51be-9a1f-118d500a48e3",
        "b7a36107-21cc-527c-bf21-37b7d90e42fe",
        "b4f4bcb4-7f82-54ce-9591-77bc3c47d965",
        "aa490e75-09ce-5785-9bfc-f3892fd8101e",
        "03cf4000-2905-584e-8a84-146415fc33d6",
        "4ffb75d2-ea60-543e-8812-0990beef33ac"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Reduce heat to medium low. Add the remaining milk and condensed milk. Stir with a wooden spoon. Cook for 1 hour and 15 minutes, or until the rice pudding thickens to desire consistency.",
      "ingredients_used": [
        "523eb9ad-cbf9-5f9f-af4a-caa62411b5e9",
        "8c96fbeb-2476-51be-9a1f-118d500a48e3",
        "4ffb75d2-ea60-543e-8812-0990beef33ac"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Stir well and remove from heat, and let it cool at room temperature. The consistency should be very creamy. Refrigerate for a least 1 hour or overnight.",
      "timer_seconds": 3600
    }
  ],
