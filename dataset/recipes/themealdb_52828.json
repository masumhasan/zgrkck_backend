  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Slice the uncooked pork thinly, about ⅛\". It helps to slightly freeze it (optional).",
      "ingredients_used": [
        "4fa8e50e-f42d-596f-96b4-621954be77ba"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Mince garlic and shallots. Mix in a bowl with sugar, fish sauce, thick soy sauce, pepper, and oil until sugar dissolves.",
      "ingredients_used": [
        "deffb344-b6a4-5c8f-9c39-2ea99eb69446",
        "87f33d44-6906-5d84-9d7b-94f94ddac012",
        "328d5c3b-e3de-57e2-9192-741249ff347c",
        "3a3328db-2aaf-5288-bce0-75d90c63cef3",
        "a8e551a2-68f0-5a2e-b511-ce0602cad318"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Marinate the meat for 1 hour, or overnight for better results.",
      "timer_seconds": 3600
    },
    {
      "step_number": 4,
      "instruction": "Bake the pork at 375F for 10-15 minutes or until about 80% cooked. Finish cooking by broiling in the oven until a nice golden brown color develops, flipping the pieces midway.",
      "timer_seconds": 900,
      "temperature": {
        "value": 375,
        "unit": "fahrenheit"
      },
      "ingredients_used": [
        "4fa8e50e-f42d-596f-96b4-621954be77ba"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Assemble your bowl with veggies, noodles, and garnish. Many like to mix the whole bowl up and pour the fish sauce on top, but I like to make individual bites and sauce it slowly.",
      "ingredients_used": [
        "328d5c3b-e3de-57e2-9192-741249ff347c"
      ]
    }
  ],
