  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "For the pudding custard",
      "ingredients_used": [
        "cb46cc21-0262-57aa-9aad-067888544f52"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Combine water and gelatin in a bowl",
      "ingredients_used": [
        "bb42aaca-25e2-5f30-a3e2-a1dc5200452d",
        "7c957bc0-b2b9-5b28-8c19-1606c1bc0d6f"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Let it rest for about 7-10 minutes",
      "timer_seconds": 600
    },
    {
      "step_number": 4,
      "instruction": "Combine cream, milk and sugar and heat for a few minutes until all the sugar melts. Do not boil.",
      "ingredients_used": [
        "059c5972-db59-50d3-9c85-bb917149acc5",
        "1e2c1430-1829-57e1-a55c-fddbb87cf083",
        "bf813866-44e6-510e-adde-2a534f0ac840"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Take it off the stovetop and let it rest for about 5 minutes",
      "timer_seconds": 300
    },
    {
      "step_number": 6,
      "instruction": "Add gelatin mixture and stir. Add vanilla essence."
    },
    {
      "step_number": 7,
      "instruction": "Pour mixture into small glasses at an angle. It's really rich so the smaller glasses will help reduce the serving."
    },
    {
      "step_number": 8,
      "instruction": "Transfer to refrigerator to chill for a minimum of 4 hours. ( I kept mine in the refrigerator overnight) Please don't put it in the freezer.",
      "timer_seconds": 14400
    },
    {
      "step_number": 9,
      "instruction": "For the mango puree",
      "ingredients_used": [
        "72fd3f33-769e-5975-81f7-9db2023c0e04",
        "089c1947-7086-5dc2-9ec2-6762456c71ce"
      ]
    },
    {
      "step_number": 10,
      "instruction": "When you're ready to add the mango purée to the top of the pudding, you can then start the process of preparing the puree",
      "ingredients_used": [
        "72fd3f33-769e-5975-81f7-9db2023c0e04",
        "089c1947-7086-5dc2-9ec2-6762456c71ce"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Using a blender or hand help mixer, purée mango chunks/slices",
      "ingredients_used": [
        "72fd3f33-769e-5975-81f7-9db2023c0e04",
        "089c1947-7086-5dc2-9ec2-6762456c71ce"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Strain purée for a finer consistency"
    },
    {
      "step_number": 13,
      "instruction": "You can use puree as is or you can add some sugar for a little more sweetness",
      "ingredients_used": [
        "1e2c1430-1829-57e1-a55c-fddbb87cf083",
        "bf813866-44e6-510e-adde-2a534f0ac840"
      ]
    },
    {
      "step_number": 14,
      "instruction": "To make the puree like pudding"
    },
    {
      "step_number": 15,
      "instruction": "Add sugar to puree",
      "ingredients_used": [
        "1e2c1430-1829-57e1-a55c-fddbb87cf083",
        "bf813866-44e6-510e-adde-2a534f0ac840"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Transfer to a stove top and stir until sugar is dissolved. Remove from stovetop",
      "ingredients_used": [
        "1e2c1430-1829-57e1-a55c-fddbb87cf083",
        "bf813866-44e6-510e-adde-2a534f0ac840"
      ]
    },
    {
      "step_number": 17,
      "instruction": "Add gelatin mixture and stir consistently"
    },
    {
      "step_number": 18,
      "instruction": "Remove chilled creamy custard from refrigerator and add mango puree mixture to the top of it",
      "ingredients_used": [
        "cb46cc21-0262-57aa-9aad-067888544f52",
        "72fd3f33-769e-5975-81f7-9db2023c0e04",
        "089c1947-7086-5dc2-9ec2-6762456c71ce"
      ]
    },
    {
      "step_number": 19,
      "instruction": "Chill for a minimum of 2 hours (longer is better)",
      "timer_seconds": 7200
    },
    {
      "step_number": 20,
      "instruction": "Garnish with mint and small mango pieces and serve",
      "ingredients_used": [
        "9590615a-d95a-5253-a286-574f9a0bf33b",
        "72fd3f33-769e-5975-81f7-9db2023c0e04",
        "089c1947-7086-5dc2-9ec2-6762456c71ce"
      ]
    }
  ],
