  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Toast the bread slices -- either in a toaster, or by baking them in the oven at 400°F -- until crispy and golden.  (Toasting/baking time will totally depend on the type and thickness of your bread.)",
      "temperature": {
        "value": 400,
        "unit": "fahrenheit"
      },
