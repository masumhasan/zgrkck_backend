        "97c92845-7af4-5723-842d-73636060bcb8"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Take a clove of garlic and rub it cut-side-down all over the top of a slice of bread.",
      "ingredients_used": [
        "97c92845-7af4-5723-842d-73636060bcb8",
        "a977aa76-0548-572c-ba40-7716560aab04"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Take a tomato half and rub it cut-side-down all over the top of the bread.",
      "ingredients_used": [
        "97c92845-7af4-5723-842d-73636060bcb8",
        "486cdf39-b078-569c-a397-84fa389c5164"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Drizzle the bread evenly with a hint of olive oil.  Sprinkle with a pinch of salt.",
      "ingredients_used": [
        "97c92845-7af4-5723-842d-73636060bcb8",
        "f41a7511-73fc-5dcf-83a1-2a1eb6e2c195"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Repeat with the remaining slices of bread.  Then serve immediately while they're nice and warm!",
