  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 350 degrees F (175 degrees C).",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "Heat a large pot over medium heat. Add the bacon and kielbasa; cook and stir until the bacon has rendered its fat and sausage is lightly browned. Use a slotted spoon to remove the meat and transfer to a large casserole or Dutch oven.",
      "ingredients_used": [
        "774ee145-b75c-5599-88bb-b8dc0f37e921",
        "c0d93994-31dc-555e-9d89-ad7286cb6f74"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Coat the cubes of pork lightly with flour and fry them in the bacon drippings over medium-high heat until golden brown. Use a slotted spoon to transfer the pork to the casserole. Add the garlic, onion, carrots, fresh mushrooms, cabbage and sauerkraut. Reduce heat to medium; cook and stir until the carrots are soft, about 10 minutes. Do not let the vegetables brown.",
      "timer_seconds": 600,
      "ingredients_used": [
        "774ee145-b75c-5599-88bb-b8dc0f37e921",
        "5449cdc8-78fd-5836-826e-9208891af00e",
        "d606dd60-be8b-5892-a9b0-3cfde30e1a34",
        "c0b9f701-538d-5cd4-8efb-1d529bfb0b92",
        "5debb152-437e-595d-bec0-ba1fa66f0b63",
        "773f5821-2854-57e8-8099-27b688ef1107",
        "78d5c1ae-92c6-5252-a09a-1e7787ccf5f0",
        "9789241f-ebf0-511a-848f-b8279569b779"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Deglaze the pan by pouring in the red wine and stirring to loosen all of the bits of food and flour that are stuck to the bottom. Season with the bay leaf, basil, marjoram, paprika, salt, pepper, caraway seeds and cayenne pepper; cook for 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "d606dd60-be8b-5892-a9b0-3cfde30e1a34",
        "c8271d84-afed-527a-af5e-f9a6171c1887",
        "28b46a39-2fd9-5666-a7e1-9d866325b533",
        "3cf1c313-c317-5083-b71d-94bd7224ace0",
        "83e3e264-821c-5a9c-9556-19613166871e",
        "958b6ac9-636e-5c52-b997-47ea5e549941",
        "0492a3b1-646c-5aed-aee2-d9289e093785"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Mix in the dried mushrooms, hot pepper sauce, Worcestershire sauce, beef stock, tomato paste and tomatoes. Heat through just until boiling. Pour the vegetables and all of the liquid into the casserole dish with the meat. Cover with a lid.",
      "ingredients_used": [
        "773f5821-2854-57e8-8099-27b688ef1107",
        "4b77f1e9-b806-56c1-a17c-670135cf1bc4",
        "ba339def-f1bc-56d6-88f6-2db0f47395f9",
        "523898b8-ae8a-5951-9d90-22347f8f2522"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Bake in the preheated oven for 2 1/2 to 3 hours, until meat is very tender.",
      "timer_seconds": 10800
    }
  ],
