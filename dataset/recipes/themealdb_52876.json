  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 200C/400F/Gas 6.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Heat the oil in a deep frying pan and fry the beef mince for 4-5 minutes, breaking it up with a wooden spoon as it browns.",
      "timer_seconds": 300,
      "ingredients_used": [
        "ae220dd9-56bd-5b60-980c-5710e6b99136"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the onion and cook for 2-3 minutes, then stir in the tomato purée and cook for 2-3 more minutes. Stir in the flour and cook for a further minute, then add the chopped mushrooms, the stout or beef stock and a couple of dashes of Worcestershire sauce. Bring to the boil, then reduce the heat, cover the pan with a lid and leave to simmer for 20 minutes. Set aside and leave to cool, then turn the meat mixture into a one liter pie dish.",
      "ingredients_used": [
        "ae220dd9-56bd-5b60-980c-5710e6b99136",
        "9ae42131-c136-5fab-bba6-347031f0163e",
        "d39217d5-260e-503f-950a-351174565584",
        "87628406-4916-50f0-993e-2a2b85ada05c",
        "f44fb293-51d2-5b4e-9071-0cce2cf8975a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Roll out the pastry on a floured work surface until it is slightly larger than the pie dish. Gently drape the pastry over the dish, pressing firmly onto the edges. Trim, then shape the edges into a fluted shape.",
      "ingredients_used": [
        "bd048560-0083-5026-82a1-0b30f214c242"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Cut some leaf shapes out of the pastry trimmings and decorate the top of the pie, sticking them to the pastry with the beaten egg yolk.",
      "ingredients_used": [
        "bd048560-0083-5026-82a1-0b30f214c242"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Make three or four slits in the pastry to allow the steam to escape, then brush the pie with the rest of the beaten egg yolk and bake in the oven for 20-25 minutes, or until golden-brown.",
      "timer_seconds": 1500,
      "ingredients_used": [
        "bd048560-0083-5026-82a1-0b30f214c242"
      ]
    },
    {
      "step_number": 7,
      "instruction": "To serve, slice into wedges."
    }
  ],
