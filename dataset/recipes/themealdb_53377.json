  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Dried shrimp gives this Chinese dish a punch of salty umami flavor. You can find it at an Asian grocery store in the frozen or refrigerated section. Look for small-sized dried shrimp, about a 1/4-inch in size. If you use medium or large dried shrimp, hydrate the shrimp with more water (1 cup for medium-sized shrimp, 1 1/4 cup for large) and for longer time (45 to 60 minutes), then chop it up into smaller 1/4-inch chunks. To make this recipe vegetarian, omit the dried shrimp and use four or five dried shiitake mushrooms, rehydrated, and sliced thin.",
      "timer_seconds": 3600,
      "ingredients_used": [
        "90659044-e728-5893-a44f-64405aade71f",
        "b0b72912-113a-556b-9670-3449a85af3ca",
        "df16118b-2024-5825-930d-06d006e08ed5"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Rehydrate the dried shrimp:",
      "ingredients_used": [
        "90659044-e728-5893-a44f-64405aade71f"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Place the dried shrimp in a small bowl and pour the boiling water over it. Cover with a small plate and let sit for 30 minutes so the shrimp can rehydrate. The shrimp will be lighter in color and plump up slightly.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "90659044-e728-5893-a44f-64405aade71f",
        "630f64a3-b4ea-5b11-ace2-5484df9f143f",
        "b0b72912-113a-556b-9670-3449a85af3ca"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Prep the cabbage:",
      "ingredients_used": [
        "a13a11ac-c08c-5887-b070-6422d87fbcba"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Meanwhile, split the napa cabbage in half lengthwise. Rinse the cabbage and shake it dry. Cut out the core of the cabbage and discard.",
      "ingredients_used": [
        "a13a11ac-c08c-5887-b070-6422d87fbcba"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Set out two large bowls. Cut the remaining cabbage into 1-inch pieces, putting the thicker white pieces at the bottom of the cabbage into one bowl and the top thinner leafy green pieces into the other bowl.",
      "ingredients_used": [
        "a13a11ac-c08c-5887-b070-6422d87fbcba"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Drain the shrimp:",
      "ingredients_used": [
        "90659044-e728-5893-a44f-64405aade71f"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Once the shrimp has rehydrated, drain it and discard the liquid.",
      "ingredients_used": [
        "90659044-e728-5893-a44f-64405aade71f"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Cook the shrimp and cabbage:",
      "ingredients_used": [
        "90659044-e728-5893-a44f-64405aade71f",
        "a13a11ac-c08c-5887-b070-6422d87fbcba"
      ]
    },
    {
      "step_number": 10,
      "instruction": "In a large wok or skillet over high heat add the peanut oil, swirling it around to coat the pan.",
      "ingredients_used": [
        "7092197e-442a-533a-9465-6e05c347f5f3"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Heat until the oil looks shimmering hot, then carefully add the scallions, ginger, and rehydrated shrimp, paying specially attention as the wet ingredients may cause the hot oil to splatter. Toss with a spatula until the scallions are bright green and the entire mixture is fragrant, about 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "90659044-e728-5893-a44f-64405aade71f",
        "354d8c23-57f3-576e-b171-c6f1caffe06b",
        "f0043480-e416-5192-b14e-f54e5208969f"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Add the thicker white part of the napa cabbage to the pan and lower the heat to medium high. Continue to cook and stir for 3 to 4 minutes, or until the edges of the cabbage pieces start to look slightly translucent but the center of the cabbage pieces are still opaque white.",
      "timer_seconds": 240,
      "ingredients_used": [
        "a13a11ac-c08c-5887-b070-6422d87fbcba"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Reduce the heat to medium low and add the leafy green pieces of cabbage into the pan. Cook until the leaves are wilted, about 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "a13a11ac-c08c-5887-b070-6422d87fbcba"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Make a cornstarch slurry:",
      "ingredients_used": [
        "321aa979-6471-50bf-aad7-e710182d45d1"
      ]
    },
    {
      "step_number": 15,
      "instruction": "In a small bowl, combine the soy sauce, cold water, and cornstarch, stirring to make a slurry. Then pour over the cabbage and continue to cook and stir until a sauce has thickened slightly to the consistency of whole milk.",
      "ingredients_used": [
        "a13a11ac-c08c-5887-b070-6422d87fbcba",
        "c6ac36a1-64f1-5a47-8de4-8611cc7973f0",
        "b0b72912-113a-556b-9670-3449a85af3ca",
        "321aa979-6471-50bf-aad7-e710182d45d1"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Season the stir fry:"
    },
    {
      "step_number": 17,
      "instruction": "Season the stir fry with salt and pepper, then taste and add more salt and pepper if you wish. The cabbage will be translucent and silky looking, with specks of dried shrimp all over.",
      "ingredients_used": [
        "90659044-e728-5893-a44f-64405aade71f",
        "a13a11ac-c08c-5887-b070-6422d87fbcba",
        "df16118b-2024-5825-930d-06d006e08ed5",
        "5a690e72-0a4c-59fc-8e04-83ea763e8ba0"
      ]
    }
  ],
