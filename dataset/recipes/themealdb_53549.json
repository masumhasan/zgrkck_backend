  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place chicken breast in a saucepan and cover with water. Bring to a boil, add 1 tsp salt and simmer for approximately 15 minutes. Allow chicken to cool and then shred meat with two forks.",
      "timer_seconds": 900,
      "ingredients_used": [
        "3e40b87f-b81d-5d22-b09c-22440a69ef44",
        "a0dfed51-ad0a-5adb-a421-03ca64ebb200"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Finely chop shallot/red onion."
    },
    {
      "step_number": 3,
      "instruction": "Stir mayonnaise, crème fraîche, Dijon mustard and apple cider vinegar to combine. Season with salt, pepper and extra Dijon mustard to taste. Combine with onion and chicken.",
      "ingredients_used": [
        "1bb0c8c0-34fc-5923-bff8-49a063a93537",
        "65f4183a-004a-5b3c-b5ad-53b5da60e223",
        "ad232984-9c28-5962-a3cc-7786634fd299",
        "a0dfed51-ad0a-5adb-a421-03ca64ebb200",
        "433c7912-8e5a-5bcf-8678-5f95f43e5409"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Fry bacon until crisp and transfer to plate lined with paper towels.",
      "ingredients_used": [
        "046cf73e-c5da-5c97-9e02-f16a8fe222b7"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Rinse mushrooms, slice and fry in the same pan as bacon until golden (approximately 5 minutes). Season with a bit of salt and pepper.",
      "timer_seconds": 300,
      "ingredients_used": [
        "046cf73e-c5da-5c97-9e02-f16a8fe222b7",
        "148ae86b-7a2a-50be-9225-dc914631f9ea",
        "a0dfed51-ad0a-5adb-a421-03ca64ebb200",
        "433c7912-8e5a-5bcf-8678-5f95f43e5409"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Arrange your chicken salad in a serving dish, topped with crisp bacon, mushrooms and chopped parsley. Serve on a slice of light or dark bread.",
      "ingredients_used": [
        "046cf73e-c5da-5c97-9e02-f16a8fe222b7",
        "148ae86b-7a2a-50be-9225-dc914631f9ea",
        "e1741247-23ce-5804-b5e5-06f5f67ec79a"
      ]
    }
  ],
