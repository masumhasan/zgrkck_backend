  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Tart shell"
    },
    {
      "step_number": 2,
      "instruction": "Heat oven to 175°C / 347 °F",
      "temperature": {
        "value": 175,
        "unit": "celsius"
      }
    },
    {
      "step_number": 3,
      "instruction": "Grate the marzipan and mix thoroughly with the sugar. Whip the mixture with butter until fluffy.",
      "ingredients_used": [
        "c0139ed9-3ae6-5a01-b66f-a92a08ded6f4",
        "c6b84b57-37f6-571d-9502-6acb66a442e6",
        "4875bf76-ec4e-5d0d-9a44-cf2ef4909a56",
        "2c2749c4-d948-59ad-b690-f2a6e44ae2fb"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Whip the eggs into the mixture and then folk the flour into the dough. Line an approximately 24 cm springform pan with baking paper and grease with butter. Then roll out the dough and transfer to the pan. Bake in the middle of the oven for approximately 25 minutes. Prepare the vanilla custard while the dough bakes.",
      "timer_seconds": 1500,
      "ingredients_used": [
        "4875bf76-ec4e-5d0d-9a44-cf2ef4909a56",
        "24167be9-865d-542d-bd03-305f218b8ff3"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Finely chop the chocolate and sprinkle over the shell after baking. Spread out the chocolate with a spatula as it melts. Allow the shell to cool to room temperature.",
      "ingredients_used": [
        "bc5fdf04-667c-5e42-a5f3-b7a44c348c0c"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Vanilla custard"
    },
    {
      "step_number": 7,
      "instruction": "Mix vanilla sugar, egg yolks, sugar and corn starch in a saucepan. Turn the heat to medium and whisk in the milk. Heat the mixture while stirring until it thickens. Transfer the custard to a container and cool completely.",
      "ingredients_used": [
        "c6b84b57-37f6-571d-9502-6acb66a442e6",
        "86de12d3-d812-550d-9b4c-80abbc609b1f",
        "ac74dc2a-f5bd-5c67-b4ae-eaa42fadcec3",
        "2c2749c4-d948-59ad-b690-f2a6e44ae2fb",
        "245d9b85-3b2b-57fe-92a2-e6e20cb6844b"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Whip the double cream to a light foam and folk into the cooled vanilla custard.",
      "ingredients_used": [
        "f5d383b0-3a75-5094-9bac-0939aba389ae"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Tart assembly"
    },
    {
      "step_number": 10,
      "instruction": "Rinse the strawberries, remove the stems and quarter from top to bottom",
      "ingredients_used": [
        "d339edfd-fc45-5838-b07f-324841448fed"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Spread the vanilla custard in a thick layer on top of the tart shell. Top with the fresh strawberries and fresh mint (optional). Bon appétit!",
      "ingredients_used": [
        "d339edfd-fc45-5838-b07f-324841448fed",
        "110b6a4b-0c9b-5f3d-a002-c0c3a315e3d9"
      ]
    }
  ],
