  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a wide, shallow bowl, beat the eggs with the cream, milk, golden caster sugar and sherry. Cut each slice of bread in two and dip them into the egg mix, turning to make sure they get a good coating on either side. Soak bread in egg mixture for 10 mins to absorb the liquid (carefully turn them over from time to time and make sure they don’t get too soggy).",
      "timer_seconds": 600,
      "ingredients_used": [
        "93d8a51b-88d8-5d67-9690-4bf094f51384",
        "5ee3af48-3c09-53f2-a345-5c3afb09d0e2",
        "46a8dee8-3d20-5d94-bb21-bbb1624d60bb",
        "91bff19c-9624-5924-93e3-1a16418aa1c0",
        "d07233e1-241a-51c0-8550-fc5a5ec42b8b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat 1½ tbsp olive oil in a large frying pan and cook the bread for about 3 mins on each side until dark golden and crisp on the edge. Keep the slices warm in a low oven as you cook the rest.",
      "timer_seconds": 180,
      "ingredients_used": [
        "d07233e1-241a-51c0-8550-fc5a5ec42b8b",
        "919d5b34-5232-5599-801c-25c63b9cf743"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Divide the torrijas between plates and dust with the icing sugar. Serve with crème fraîche or Greek yogurt on the side.",
      "ingredients_used": [
        "a8b0e632-be88-5129-80a4-29c0daec3811"
      ]
    }
  ],
