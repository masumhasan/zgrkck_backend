  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Sorrel jam instructions",
      "ingredients_used": [
        "751e463d-f4dd-550d-97a5-fe98e3fc39af",
        "3c037774-f983-5763-9571-ad949bb8a1ea"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Combine sugar, sorrel, lemon zest, water in a medium sized pot.",
      "ingredients_used": [
        "751e463d-f4dd-550d-97a5-fe98e3fc39af",
        "a0ebaca2-b270-538d-b3ef-d1896b1ed093",
        "b97d5932-6d06-576a-8000-03d60a1f05ad"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Bring to a boil as petal becomes soft"
    },
    {
      "step_number": 4,
      "instruction": "Reduce heat, and cook until thickened."
    },
    {
      "step_number": 5,
      "instruction": "Let it rest before using on brie",
      "ingredients_used": [
        "c6247c11-0559-585a-93e8-6a8129ec4afe"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Baked brie instructions",
      "ingredients_used": [
        "c6247c11-0559-585a-93e8-6a8129ec4afe"
      ]
    },
    {
      "step_number": 7,
      "instruction": "You can slice the brie in half to create a sandwich-like effect. Or you can leave the brie wheel intact and just trim the top rind of the wheel.",
      "ingredients_used": [
        "c6247c11-0559-585a-93e8-6a8129ec4afe"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add a generous portion of jam to the top of the wheel, or one side of the sandwich"
    },
    {
      "step_number": 9,
      "instruction": "Roll dough out with a rolling pin on a floured surface"
    },
    {
      "step_number": 10,
      "instruction": "Trim excess dough. You can also use it to decorate ."
    },
    {
      "step_number": 11,
      "instruction": "Wrap the pastry up around the sides and over the top of cheese wheel, wrapping completely and pressing the edges of dough together to form a tightly sealed package.",
      "ingredients_used": [
        "7b69ecf2-2c9a-5856-9824-a815ba2d38f6"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Carefully flip the dough-wrapped cheese over, so that the gathered dough is on the bottom.Place the package, seam side down, on a baking sheet sprayed with non-stick cooking spray."
    },
    {
      "step_number": 13,
      "instruction": "The brie can be prepared up to this point and refrigerated for 2 days before baking.",
      "ingredients_used": [
        "c6247c11-0559-585a-93e8-6a8129ec4afe"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Be sure to bring the brie to room temperature before baking.",
      "ingredients_used": [
        "c6247c11-0559-585a-93e8-6a8129ec4afe"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Preheat the oven to 400° F.",
      "temperature": {
        "value": 400,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 16,
      "instruction": "Combine the egg and water and brush the mixture over the top and sides of the pastry.",
      "ingredients_used": [
        "a0ebaca2-b270-538d-b3ef-d1896b1ed093",
        "4905017b-4878-5077-8cd9-75e7bf301a8c",
        "7b69ecf2-2c9a-5856-9824-a815ba2d38f6",
        "b97d5932-6d06-576a-8000-03d60a1f05ad"
      ]
    },
    {
      "step_number": 17,
      "instruction": "Add design from leftover dough if you'd like, and brush with egg mixture",
      "ingredients_used": [
        "4905017b-4878-5077-8cd9-75e7bf301a8c"
      ]
    },
    {
      "step_number": 18,
      "instruction": "You can use leftover sorrel pulp from your juice to make the jam. It will be  a little less acidic and the color will be a brighter red instead of darker red.",
      "ingredients_used": [
        "751e463d-f4dd-550d-97a5-fe98e3fc39af"
      ]
    },
    {
      "step_number": 19,
      "instruction": "Make my jam a day ahead, so I don’t feel rushed and the jam will have time to settle."
    },
    {
      "step_number": 20,
      "instruction": "Add the jam to the center of the brie by slicing the brie in half and having the jam as a filler.",
      "ingredients_used": [
        "c6247c11-0559-585a-93e8-6a8129ec4afe"
      ]
    },
    {
      "step_number": 21,
      "instruction": "Next time, I’ll use a larger pot, so that I don’t need to add water frequently to tenderize the sorrel.",
      "ingredients_used": [
        "751e463d-f4dd-550d-97a5-fe98e3fc39af",
        "a0ebaca2-b270-538d-b3ef-d1896b1ed093",
        "b97d5932-6d06-576a-8000-03d60a1f05ad"
      ]
    }
  ],
