  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix the dry yeast with some of the luke warm milk en stir until dissolved.",
      "ingredients_used": [
        "fd19c3bb-f15c-5017-a112-0ce5c1be0b9e",
        "0eaeb192-ea0e-596b-b556-4e65babd4f4e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Place buckwheat and the flour together in a bowl and make a small circle in the middle. Add the yeast mixture into it. Add the milk and stir until you have a smooth batter.",
      "ingredients_used": [
        "510e6008-9dcd-5854-9617-0938ddf09ff0",
        "fd19c3bb-f15c-5017-a112-0ce5c1be0b9e",
        "0eaeb192-ea0e-596b-b556-4e65babd4f4e"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the eggs, salt and vanille sugar and stir through. Leave to stand and rise for about 45 minutes.",
      "timer_seconds": 2700,
      "ingredients_used": [
        "24016e3b-d0e9-532b-9666-f3bcfa075117"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Heat the poffertjespan and add a bit of butter into each hole. Fill halfway with batter and first bake one side until you can see the top dry out a little. Turn the poffertjes around with a small fork and bake the other side until cooked and golden brown.",
      "ingredients_used": [
        "c93a83f8-740e-5993-8fab-89d3ec1f871f",
        "13b219eb-26f1-5f98-b766-82ea0a38049f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Serve the poffertjes with butter and icing sugar",
      "ingredients_used": [
        "c93a83f8-740e-5993-8fab-89d3ec1f871f",
        "13b219eb-26f1-5f98-b766-82ea0a38049f",
        "bb5a3f75-c997-516b-8598-1e180a9e1e06"
      ]
    }
