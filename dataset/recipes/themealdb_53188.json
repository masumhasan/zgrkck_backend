  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare the Bread Mixture",
      "ingredients_used": [
        "3f24be97-ca2f-5e8f-9c78-825a29930256"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Soak the bread slices in milk or water until soft.",
      "ingredients_used": [
        "3f24be97-ca2f-5e8f-9c78-825a29930256",
        "487787d1-c3aa-5b51-ad24-9f20b33137e2"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Squeeze out excess liquid and mash into small crumbs."
    },
    {
      "step_number": 4,
      "instruction": "Mix the Ingredients"
    },
    {
      "step_number": 5,
      "instruction": "In a large bowl, combine ground meat, chopped onions, garlic, soaked bread, egg, and seasonings.",
      "ingredients_used": [
        "0570bf3e-19c1-5520-94fa-a8fc6b95f9e1",
        "63e09f81-ce4e-5b28-87d0-c9328eed8d5e",
        "3f24be97-ca2f-5e8f-9c78-825a29930256",
        "f389caed-9dbf-5576-9642-b0273c5ee794",
        "3d8da212-eeb2-5d55-aa0e-803eb655fba0"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Mix well until evenly combined."
    },
    {
      "step_number": 7,
      "instruction": "Shape the Meat Patties"
    },
    {
      "step_number": 8,
      "instruction": "Take portions of the mixture and shape them into palm-sized patties."
    },
    {
      "step_number": 9,
      "instruction": "Flatten slightly to help with even cooking."
    },
    {
      "step_number": 10,
      "instruction": "Coat the Patties"
    },
    {
      "step_number": 11,
      "instruction": "Lightly dust each patty with flour.",
      "ingredients_used": [
        "2dbfc0cc-e68f-58e8-b771-219bfba6af56"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Dip into beaten egg, then coat with breadcrumbs for a crispy finish.",
      "ingredients_used": [
        "3f24be97-ca2f-5e8f-9c78-825a29930256",
        "f389caed-9dbf-5576-9642-b0273c5ee794",
        "3d8da212-eeb2-5d55-aa0e-803eb655fba0",
        "03177068-0223-5c2e-8d48-1538f28aea06"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Fry the Fašírky"
    },
    {
      "step_number": 14,
      "instruction": "Heat vegetable oil in a pan over medium heat.",
      "ingredients_used": [
        "243018a9-113d-5082-95b2-f99c94119eee"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Fry the patties for 4-5 minutes per side until golden brown and fully cooked.",
      "timer_seconds": 300
    },
    {
      "step_number": 16,
      "instruction": "Transfer to a paper towel-lined plate to drain excess oil."
    },
    {
      "step_number": 17,
      "instruction": "Serve and Enjoy"
    },
    {
      "step_number": 18,
      "instruction": "Serve Fašírky hot with mashed potatoes, cabbage salad, or fresh bread.",
      "ingredients_used": [
        "3f24be97-ca2f-5e8f-9c78-825a29930256"
      ]
    },
    {
      "step_number": 19,
      "instruction": "Enjoy with mustard, pickles, or garlic sauce for extra flavor.",
      "ingredients_used": [
        "63e09f81-ce4e-5b28-87d0-c9328eed8d5e",
        "9ad791fe-6009-500b-94cb-451074eb1cc3"
      ]
    }
  ],
