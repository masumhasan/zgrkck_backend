  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the gelatine leaves in a bowl, cover with warm water and leave to soak for 5 mins. Drain and squeeze out any excess water.",
      "timer_seconds": 300
    },
    {
      "step_number": 2,
      "instruction": "Tip the raspberries into a pan over a medium-low heat along with the sugar and lemon juice. Cook for 5-6 mins until the berries have completely broken down. Push the mixture through a sieve set over a bowl, discarding the seeds. Stir in the gelatine leaves until dissolved (if they don’t dissolve, pour the mixture into a clean saucepan and heat gently until dissolved). Set aside to cool for 15 mins.",
      "ingredients_used": [
        "11a1ba08-9c63-588e-9a16-683eed5b4c96",
        "101e306f-acb4-5faa-a9af-781f9935c5b1"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Whip the cream to soft peaks using an electric whisk, then gently fold this into the raspberry mixture. Spoon into the ramekins or molds and chill overnight, or for at least 6 hrs. Serve with raspberries scattered over the top.",
      "timer_seconds": 21600,
      "ingredients_used": [
        "11a1ba08-9c63-588e-9a16-683eed5b4c96"
      ]
    }
  ],
