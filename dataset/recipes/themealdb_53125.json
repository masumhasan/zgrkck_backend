  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Grate half an onion and set aside. Slice the rest of the onions and fry in butter on low/medium heat until caramelized.",
      "ingredients_used": [
        "18842ca6-a4d0-5726-9bad-2cd463a87dbd",
        "7a2af3e3-ce4f-506d-b830-beeb2a7f0d2a",
        "7a65971f-089e-5e98-bd5a-606c39b6abc7"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a bowl, mix together ground beef, grated onion, salt, pepper, nutmeg, potato/corn starch, and water.",
      "ingredients_used": [
        "18842ca6-a4d0-5726-9bad-2cd463a87dbd",
        "879fd213-ecdb-523a-b2af-ca470a125854",
        "2eaec389-96b9-5989-b1a0-13b79a8ba511",
        "52d6d95f-2881-569d-972c-97a59fd66435",
        "46d4aeba-8576-5cc3-96f8-e689a27b0368",
        "f95fba47-f8d7-50ab-9c5b-0ee36a737efa"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Form into a sausage and cut 6 patties. Using a knife make a light grid pattern in each patty."
    },
    {
      "step_number": 4,
      "instruction": "Brown both sides of the karbonader in butter on high heat, then turn down to low heat and fry for another 2 – 3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "7a2af3e3-ce4f-506d-b830-beeb2a7f0d2a",
        "7a65971f-089e-5e98-bd5a-606c39b6abc7"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Serve the karbonader and onions with potatoes, stewed peas, and brown sauce for dinner, or on a slice of bread for lunch or a snack.",
      "ingredients_used": [
        "18842ca6-a4d0-5726-9bad-2cd463a87dbd"
      ]
    }
  ],
