  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "1 Preheat the oven to 230°C.",
      "temperature": {
        "value": 230,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "2 Add the sugar and crumble the fresh yeast into warm water.",
      "ingredients_used": [
        "6802eee6-2ef2-54ef-b43e-1be79ccfa267",
        "d45f29af-9db7-5d2b-803c-0d3100ef2d47",
        "09bb28b0-eea0-5ef5-a25a-d83a7476af51"
      ]
    },
    {
      "step_number": 3,
      "instruction": "3 Allow the mixture to stand for 10 – 15 minutes in a warm place (we find a windowsill on a sunny day works best) until froth develops on the surface.",
      "timer_seconds": 900
    },
    {
      "step_number": 4,
      "instruction": "4 Sift the flour and salt into a large mixing bowl, make a well in the middle and pour in the yeast mixture and olive oil.",
      "ingredients_used": [
        "09bb28b0-eea0-5ef5-a25a-d83a7476af51",
        "3ee34500-c689-5de6-bfe7-0f3a698cbd68",
        "8d6bcf0a-a874-5a49-9618-70288877caf2"
      ]
    },
    {
      "step_number": 5,
      "instruction": "5 Lightly flour your hands, and slowly mix the ingredients together until they bind."
    },
    {
      "step_number": 6,
      "instruction": "6 Generously dust your surface with flour."
    },
    {
      "step_number": 7,
      "instruction": "7 Throw down the dough and begin kneading for 10 minutes until smooth, silky and soft.",
      "timer_seconds": 600
    },
    {
      "step_number": 8,
      "instruction": "8 Place in a lightly oiled, non-stick baking tray (we use a round one, but any shape will do!)"
    },
    {
      "step_number": 9,
      "instruction": "9 Spread the passata on top making sure you go to the edge.",
      "ingredients_used": [
        "05e77833-e816-5771-8b0a-4266a4ce73b8"
      ]
    },
    {
      "step_number": 10,
      "instruction": "10 Evenly place the mozzarella (or other cheese) on top, season with the oregano and black pepper, then drizzle with a little olive oil.",
      "ingredients_used": [
        "8d6bcf0a-a874-5a49-9618-70288877caf2",
        "8f9431a1-2421-5c03-ae8f-8cd235e66ee7",
        "bbe30f3b-bfbe-574c-9389-b745a4b888df",
        "f69dca0c-ee44-52b3-9b6f-737d9ada7780"
      ]
    },
    {
      "step_number": 11,
      "instruction": "11 Cook in the oven for 10 – 12 minutes until the cheese slightly colors.",
      "timer_seconds": 720
    },
    {
      "step_number": 12,
      "instruction": "12 When ready, place the basil leaf on top and tuck in!",
      "ingredients_used": [
        "766bfb4b-cbe5-50e9-b3bf-a27bf4e69b74"
      ]
    }
  ],
