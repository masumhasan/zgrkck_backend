  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cut the chicken up into bite size pieces. Peel and cut the onions, mince the garlic.",
      "ingredients_used": [
        "bdc24e15-f0a5-5cd9-a0b5-83ac5184f705",
        "7390a246-f67c-5cef-b8b6-c76392e48c4b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Assemble the rest of the ingredients and you are ready to start cooking."
    },
    {
      "step_number": 3,
      "instruction": "Make the Dish"
    },
    {
      "step_number": 4,
      "instruction": "Heat up a fry pan over medium heat. Add the oil and when hot, sauté the onion until translucent. Remove from pan and transfer to a blender or food processor.",
      "ingredients_used": [
        "bdc24e15-f0a5-5cd9-a0b5-83ac5184f705"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add tomatoes, garlic, turmeric, cumin, sugar, ginger paste, coconut milk, water and blend smooth.",
      "ingredients_used": [
        "7390a246-f67c-5cef-b8b6-c76392e48c4b",
        "bbe17929-6386-51f1-be1e-1dd2a7096905",
        "78ca446d-2470-5fc7-b8c3-b33ff8c185d0",
        "b1f3655b-f574-521c-a0b8-33ee10a1fc6f",
        "257650a4-2507-5c1a-b32a-e5a64d878e9e",
        "88ec2f0c-2c4a-5b30-86e3-da0beca33282",
        "e152afe8-b0e0-58bf-90fa-9839c8db45f2",
        "d71db344-f070-5109-90e6-1b123f349366"
      ]
    },
    {
      "step_number": 6,
      "instruction": "In the same pan you cooked the onion, add the chicken and brown all sides. This should take about 3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "bdc24e15-f0a5-5cd9-a0b5-83ac5184f705"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add the blender ingredients and bay leaves to the pan, bring to a simmer and cook until the chicken is white inside and the liquid is creamy. (15 to 20 minutes)",
      "timer_seconds": 1200,
      "ingredients_used": [
        "ab65d9e0-4f51-5580-a892-2e3dce6da227"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Remove the bay leaves and serve with white rice.",
      "ingredients_used": [
        "ab65d9e0-4f51-5580-a892-2e3dce6da227"
      ]
    }
  ],
