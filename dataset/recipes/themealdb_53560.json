  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Combine the flour, the sugar, yeast, and salt in a mixing bowl or large bowl",
      "ingredients_used": [
        "da14613c-d17b-55c0-8909-3f679cd9197f",
        "8854c487-01e9-5dea-b073-890d851f509e",
        "9e27ab8f-181c-598b-8c68-7bb6cff7507b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add warm milk and start kneading dough",
      "ingredients_used": [
        "09b43ea1-9a90-57fa-9fd5-0c5387f28472"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Once the dough is smooth and elastic, add the butter and continue kneading",
      "ingredients_used": [
        "920ce9bc-c658-5174-82be-051943bbc4d2"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Allow the dough to rise in a covered bowl until it’s doubled in bulk, about 90 minutes.",
      "timer_seconds": 5400
    },
    {
      "step_number": 5,
      "instruction": "Turn the dough out onto a lightly floured surface, divide dough and round all of the pieces into smooth balls."
    },
    {
      "step_number": 6,
      "instruction": "Lightly grease pans"
    },
    {
      "step_number": 7,
      "instruction": "Place dough on pan"
    },
    {
      "step_number": 8,
      "instruction": "Cover the pans, and let the loaves rise until they're puffy and soft"
    },
    {
      "step_number": 9,
      "instruction": "Using a brush, add egg whites to loaves",
      "ingredients_used": [
        "058aff69-b238-504c-b3b2-c695ba03431d"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Towards the end of the rising time, preheat the oven to 375°F",
      "temperature": {
        "value": 375,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 11,
      "instruction": "Uncover the loaves, and bake them for 28 to 32 minutes, until their crust is golden brown",
      "timer_seconds": 1920
    },
    {
      "step_number": 12,
      "instruction": "Remove from oven and enjoy"
    }
  ],
