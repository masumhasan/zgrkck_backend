  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix 1/2 cup plus 2 tablespoons semolina, 2 tablespoons sesame seeds, sugar, yeast, and salt together in a large bowl. Whisk in oil, egg, and egg white. Stir in warm milk slowly until a liquid dough forms.",
      "ingredients_used": [
        "278cd2cb-b7d2-5008-9643-b2e032ebf2e7",
        "ca9d6a45-eff4-57e2-a96d-b8232015a78a",
        "46defe08-90dd-55a8-90e7-23383f3696f3",
        "f8fe4ccc-b4b4-5092-b82d-9e9fca747865",
        "6c316d46-53bd-5e67-b048-d9ba0e9d8166",
        "2380afd7-d810-5fb4-a5d9-5d3da688e9ed",
        "80fa2ddb-8ccb-5a43-8304-d3cd3f363d89"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cover the bowl with a plate or plastic wrap; let stand at room temperature until frothy, about 1 hour.",
      "timer_seconds": 3600
    },
    {
      "step_number": 3,
      "instruction": "Stir in 2 3/4 cups flour with a wooden spoon until a sticky dough forms. Cover again and allow to rest for 30 minutes.",
      "timer_seconds": 1800
    },
    {
      "step_number": 4,
      "instruction": "Line a baking sheet with parchment paper or a baking mat."
    },
    {
      "step_number": 5,
      "instruction": "Sprinkle 1 tablespoon flour over the dough and your hands. Mix dough, adding flour as needed, 1 tablespoon at a time, until it pulls away from the sides of the bowl. Shape into a round loaf and place on the prepared baking sheet. Cover loosely with a towel and let rise for 1 hour in a warm place until loaf doubles in volume.",
      "timer_seconds": 3600
    },
    {
      "step_number": 6,
      "instruction": "Preheat oven to 400 degrees F (200 degrees C).",
      "temperature": {
        "value": 400,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 7,
      "instruction": "Beat egg yolk and water in a bowl with a fork; brush over the entire surface of the loaf. Sprinkle 1 tablespoon sesame seeds on top.",
      "ingredients_used": [
        "278cd2cb-b7d2-5008-9643-b2e032ebf2e7",
        "6c316d46-53bd-5e67-b048-d9ba0e9d8166",
        "2380afd7-d810-5fb4-a5d9-5d3da688e9ed",
        "3274dde0-1d36-503d-8a49-c58d8c5a6870"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Bake in the preheated oven until loaf is golden brown, about 20 to 25 minutes.",
      "timer_seconds": 1500
    }
  ],
