  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Fried rice is best made with leftover rice that's at least a day old. Otherwise it becomes gummy in the skillet.",
      "ingredients_used": [
        "2e278dc2-8ee6-5b8c-9850-0127659b153f"
      ]
    },
    {
      "step_number": 2,
      "instruction": "If you don’t have any leftover rice from the night before, cook a batch of rice and spread it on a large baking sheet or several large plates. Let the rice dry out for about 1 to 2 hours before using it for fried rice.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "2e278dc2-8ee6-5b8c-9850-0127659b153f"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Rice sticks to the pan very easily, so make sure to use a wok or pan that doesn’t have a sticky surface. I usually cook stir-fries in my seasoned carbon steel wok, but cast iron or nonstick pans work well, too. You might need to add a little more oil if things aren’t releasing easily.",
      "ingredients_used": [
        "2e278dc2-8ee6-5b8c-9850-0127659b153f"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Prepare the chicken:"
    },
    {
      "step_number": 5,
      "instruction": "Chop the chicken into small 1/4-inch to 1/2-inch cubes. Sprinkle 1/2 teaspoon of salt over the chicken and mix to combine. Set the chicken aside for about 10 minutes (I usually use this time to chop all the vegetables).",
      "timer_seconds": 600,
      "ingredients_used": [
        "6c20c718-e33f-5321-82a5-c7d6923d69c1"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Scramble the egg:",
      "ingredients_used": [
        "1c87ad1c-9c60-5c5b-86f7-4285b0b9aa44"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Heat a wok or large sauté pan over medium-high heat. Swirl in a tablespoon of oil and add the whisked eggs. Use a spatula to quickly scramble the eggs, breaking the curds into smaller pieces as they come together. Transfer the eggs to a plate."
    },
    {
      "step_number": 8,
      "instruction": "Cook the chicken:"
    },
    {
      "step_number": 9,
      "instruction": "Add another tablespoon of oil in the wok or pan. Add the chicken and cook for 4 to 5 minutes, stirring occasionally. Turn off the heat and transfer the cooked chicken to a plate.",
      "timer_seconds": 300
    },
    {
      "step_number": 10,
      "instruction": "Using your spatula, scrape off any chicken bits that are still stuck to the wok so they don't burn during the next step. You can also use paper towels to wipe down your wok or pan."
    },
    {
      "step_number": 11,
      "instruction": "Cook the vegetables:"
    },
    {
      "step_number": 12,
      "instruction": "Swirl 1 tablespoon of oil into the wok over medium-high heat. Add the diced onions and cook them for 1 minute, until they start to soften. Mix in the minced garlic and ginger and cook until fragrant, about 30 seconds. Add the diced carrots and cook for 2 minutes, stirring frequently. Add 1/2 teaspoon salt and the peas, and stir to incorporate.",
      "ingredients_used": [
        "6c20c718-e33f-5321-82a5-c7d6923d69c1",
        "52f6f4fe-3b5d-5f40-81d1-fe3cfa13b179",
        "5ba66619-95bb-5956-9b9e-cc6e5a99f57f",
        "23df52d2-02eb-52a6-8d82-2f352cc608e5",
        "67ed5925-67dd-5c8b-af48-e65ef81c0e44",
        "b3fc77cd-9c41-5e22-8ee3-095ab05ad566"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Cook the rice:",
      "ingredients_used": [
        "2e278dc2-8ee6-5b8c-9850-0127659b153f"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Add the rice to the wok or pan on top of the vegetables and stir to combine. Using the back of your spatula, smash any large chunks of rice to break them apart. Add the white and green parts of the sliced scallions (save the dark green parts) and five-spice powder. Stir to incorporate. If the rice starts to stick to the pan, stir in a little more oil.",
      "ingredients_used": [
        "2e278dc2-8ee6-5b8c-9850-0127659b153f",
        "faf90bd6-9db6-556b-b5ef-62832d63095c"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Drizzle the soy sauce and sesame oil over the rice and stir to incorporate. Stir in the cooked chicken, scrambled eggs, and the dark parts of the scallions. Stir briefly to bring it together, and cook for another 1 to 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "2e278dc2-8ee6-5b8c-9850-0127659b153f",
        "faf90bd6-9db6-556b-b5ef-62832d63095c",
        "cd151b99-b822-55e1-b748-b49343948b73"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Serve:"
    },
    {
      "step_number": 17,
      "instruction": "Taste, and add more soy sauce if necessary. Serve immediately.",
      "ingredients_used": [
        "cd151b99-b822-55e1-b748-b49343948b73"
      ]
    }
  ],
