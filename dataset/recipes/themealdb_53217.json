  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a dutch oven or slow cooker, add all the spices, beef broth and lemon juice. Stir to combine..",
      "ingredients_used": [
        "b149733a-fd63-56d5-83dd-d7b5194c2e68"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the beef and turn to coat, spoon some sauce over the top."
    },
    {
      "step_number": 3,
      "instruction": "Cover and cook on low for 8-10 hours.",
      "timer_seconds": 36000
    },
    {
      "step_number": 4,
      "instruction": "After cooking, remove beef and use two forks to shred. Discard any excess fat."
    },
    {
      "step_number": 5,
      "instruction": "Skim fat off of the top of the liquid remaining."
    },
    {
      "step_number": 6,
      "instruction": "Mix shredded beef into sauce. Keep warm until you are ready to serve."
    },
    {
      "step_number": 7,
      "instruction": "Build wrap by spreading garlic sauce on the pita. Top with beef and add garnishes to your liking."
    },
    {
      "step_number": 8,
      "instruction": "Fold it burrito style."
    },
    {
      "step_number": 9,
      "instruction": "Heat a grill pan and grill the wrap."
    }
  ],
