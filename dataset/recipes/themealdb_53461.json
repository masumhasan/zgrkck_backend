  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Bring water to a boil and add the broken-up macaroni, elbows, and salt. Cook uncovered until tender but not overcooked (about 8 minutes).",
      "timer_seconds": 480,
      "ingredients_used": [
        "292aebc8-86bf-5106-9593-bece63057db1",
        "de9c395d-fa27-53a5-b78a-60579df67f84"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Preheat a moderately hot oven to 350F, 180C, or Gas Mark 4.",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 3,
      "instruction": "Drain the macaroni thoroughly, put it back into the same hot saucepan cooked in, and mix in the butter.",
      "ingredients_used": [
        "292aebc8-86bf-5106-9593-bece63057db1",
        "07cace5a-4c7e-5341-9779-3ce6cec5b7d0",
        "9a135685-a1c9-50c4-b824-f94bba667a47"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Grate the cheese and mix it with the macaroni while it is still warm.",
      "ingredients_used": [
        "292aebc8-86bf-5106-9593-bece63057db1"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Whisk the egg until fluffy, and add the milk, onion powder, white pepper, salt, pepper sauce, and mustard. Pour in with the macaroni and mix.",
      "ingredients_used": [
        "292aebc8-86bf-5106-9593-bece63057db1",
        "7ad66d2f-6798-539e-a800-b56fea6270e9",
        "b801341c-320d-5418-96b7-fb8cfd6845e6",
        "d3b33c49-9a51-5669-b6e8-e64fc0bde30b",
        "41e4e58d-126a-5076-9456-8d449be08935",
        "eb6c7e59-9c44-5f1f-8138-1d8f91dc9d76",
        "de9c395d-fa27-53a5-b78a-60579df67f84"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Place in a greased ovenproof casserole dish. Top with butter, some grated cheese, and fine breadcrumbs. Bake in the center of the oven for about 30-45 minutes, depending on the dish’s depth.",
      "timer_seconds": 2700,
      "ingredients_used": [
        "07cace5a-4c7e-5341-9779-3ce6cec5b7d0",
        "e2f8ccd7-28ae-5782-b2b4-a0b534ba3823",
        "9a135685-a1c9-50c4-b824-f94bba667a47"
      ]
    }
