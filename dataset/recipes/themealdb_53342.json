  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a medium bowl, whisk together flour, brown sugar, baking powder, and spices.",
      "ingredients_used": [
        "37b13640-f99b-586a-b1c0-7bf237ab1e60",
        "ab1f7e0e-3beb-594f-aa70-dd646434266e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add raisins and stir well, making sure to coat the raisins in the flour mixture.",
      "ingredients_used": [
        "53057a08-bd91-5d5e-8d15-9f695654ff47"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add melted butter, molasses and water and mix with a wooden spoon. Form a ball with the spoon or your hands and put the dough ball in a cotton pudding bag. Tie the bag, leaving at least 1 inch of room to allow the pudding to expand while cooking.",
      "ingredients_used": [
        "6a73d9a0-0749-59e1-9f49-cab0111bb855",
        "05c84aa3-2f6a-59d7-b8c4-7e32ddcd6b58",
        "8ec6e823-416f-564d-b419-15a5c2b65012"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Boil pudding for 1.5 hours. (In NL, this is typically done in the pot along with Jiggs Dinner, but it can be done independently.)",
      "timer_seconds": 5400
    },
    {
      "step_number": 5,
      "instruction": "When the duff is firm, remove it from the boiling water and let it cool slightly before removing it from the pudding bag.",
      "ingredients_used": [
        "8ec6e823-416f-564d-b419-15a5c2b65012"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Slice pudding like a cake and serve with the warm sauce of your choice: rum butter sauce, warmed molasses or Molasses Coady sauce (1 cup (250 mL) molasses, 1/4 cup (60 mL) butter, 1/4 cup (60 mL) water) is common in Newfoundland.",
      "ingredients_used": [
        "6a73d9a0-0749-59e1-9f49-cab0111bb855",
        "05c84aa3-2f6a-59d7-b8c4-7e32ddcd6b58",
        "8ec6e823-416f-564d-b419-15a5c2b65012"
      ]
    }
  ],
