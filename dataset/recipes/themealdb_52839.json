  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix the dressing ingredients in a small bowl and season with salt and pepper. Set aside."
    },
    {
      "step_number": 2,
      "instruction": "Cook the pasta according to the packet instructions. Add the sugar snap peas for the last minute or so of cooking time.",
      "ingredients_used": [
        "caa243d2-b402-56ee-aeb7-baecd2891fed",
        "381e30fe-bed1-5a88-98a3-3c071756f3ae"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Meanwhile, heat the oil in a wok or large frying pan, toss in the garlic and chilli and cook over a fairly gentle heat for about 30 seconds without letting the garlic brown. Tip in the prawns and cook over a high heat, stirring frequently, for about 3 minutes until they turn pink.",
      "ingredients_used": [
        "ceeac5c8-2c32-5b39-ba65-5e30b13e23e9",
        "4c2c108e-9214-5457-94cd-36b52e56bd30"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the tomatoes and cook, stirring occasionally, for 3 minutes until they just start to soften. Drain the pasta and sugar snaps well, then toss into the prawn mixture. Tear in the basil leaves, stir, and season with salt and pepper.",
      "timer_seconds": 180,
      "ingredients_used": [
        "caa243d2-b402-56ee-aeb7-baecd2891fed",
        "13090f03-77d2-582a-9374-6860bf6b4dc9",
        "f370f7c2-90bf-52fd-846c-29f1bf8d7527"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Serve with salad leaves drizzled with the lime dressing, and warm crusty bread.",
      "ingredients_used": [
        "e8a802ba-fbf6-5b03-b790-af88a319f92a",
        "f89abd75-422f-5672-a9da-b38d9ba8a775"
      ]
    }
  ],
