  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Line an 8-inch-square baking pan with wax paper or foil, and coat with non-stick spray."
    },
    {
      "step_number": 2,
      "instruction": "Pour ½ cup of the miniature marshmallows into the bottom of the lined baking dish.",
      "ingredients_used": [
        "af836564-c138-52a7-ae50-1dec084cff19"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In a microwave-safe bowl, combine the chocolate chips and peanut butter. Microwave the chocolate mixture in 20-second intervals, stirring in between each interval, until the chocolate is melted.",
      "ingredients_used": [
        "fc19dc01-91d7-532c-b22a-6719fbc1f602",
        "36dfe93c-ac95-5df2-85f9-2afb40821d2b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the vanilla extract and stir well, until smooth.",
      "ingredients_used": [
        "c32289f7-26f5-5857-a882-6b8ee10da60a"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Reserve 2 tablespoons of the chopped almonds or peanuts, and set aside.",
      "ingredients_used": [
        "7cf9a054-8040-5ce3-a7c5-fe89ffc4bc1b"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Fold 1 ½ cups of the miniature marshmallows and the remaining chopped nuts into the chocolate mixture.",
      "ingredients_used": [
        "af836564-c138-52a7-ae50-1dec084cff19"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Transfer the chocolate mixture into the prepared pan and spread into an even layer. Immediately top with the reserved chopped nuts and the mallow bits or additional miniature marshmallows, if using.",
      "ingredients_used": [
        "af836564-c138-52a7-ae50-1dec084cff19"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Refrigerate for 4 hours, or until set.",
      "timer_seconds": 14400
    },
    {
      "step_number": 9,
      "instruction": "Remove the fudge and wax paper from the pan. Carefully peel all of wax paper from the fudge."
    },
    {
      "step_number": 10,
      "instruction": "Cut the fudge into bite-sized pieces and serve."
    }
  ],
