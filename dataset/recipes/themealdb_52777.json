  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Bring a large saucepan of salted water to the boil",
      "ingredients_used": [
        "48c7ab16-5ee7-567f-a7a0-72ee5fb340bb"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the pasta, stir once and cook for about 10 minutes or as directed on the packet.",
      "timer_seconds": 600
    },
    {
      "step_number": 3,
      "instruction": "Meanwhile, wash the tomatoes and cut into quarters. Slice the olives. Wash the basil.",
      "ingredients_used": [
        "a343d23d-6a50-5b0a-94ef-3cbfbe0ffef1",
        "6e4d5896-bc07-5500-a955-1f57b2ebf32e",
        "6fde6e11-df45-5418-98bb-8a1bc8172c09"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Put the tomatoes into a salad bowl and tear the basil leaves over them. Add a tablespoon of olive oil and mix.",
      "ingredients_used": [
        "a343d23d-6a50-5b0a-94ef-3cbfbe0ffef1",
        "6e4d5896-bc07-5500-a955-1f57b2ebf32e"
      ]
    },
    {
      "step_number": 5,
      "instruction": "When the pasta is ready, drain into a colander and run cold water over it to cool it quickly."
    },
    {
      "step_number": 6,
      "instruction": "Toss the pasta into the salad bowl with the tomatoes and basil.",
      "ingredients_used": [
        "a343d23d-6a50-5b0a-94ef-3cbfbe0ffef1",
        "6e4d5896-bc07-5500-a955-1f57b2ebf32e"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add the sliced olives, drained mozzarella balls, and chunks of tuna. Mix well and let the salad rest for at least half an hour to allow the flavors to mingle.",
      "ingredients_used": [
        "b8d0b35a-9afc-5377-9151-2fa6a488da02",
        "6fde6e11-df45-5418-98bb-8a1bc8172c09",
        "55ecad1b-f76d-5bd3-b043-7298738258c9"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Sprinkle the pasta with a generous grind of black pepper and drizzle with the remaining olive oil just before serving.",
      "ingredients_used": [
        "035e5ef2-d805-5db6-9fc6-e06d56e0e800"
      ]
    }
  ],
