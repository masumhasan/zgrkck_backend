  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 200°C fan / 220°C / 425°F / Gas mark 7",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "If you have not bought diced lamb, cut your lamb shoulder or leg into large chunks and place to one side.",
      "ingredients_used": [
        "774d34ea-f87f-5e5e-875c-96162a57d380"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Chunks of chopped lamb of a red chopping board"
    },
    {
      "step_number": 4,
      "instruction": "Make oil marinade -"
    },
    {
      "step_number": 5,
      "instruction": "Mix 80ml of olive oil in a bowl with garlic puree, sundried tomato puree ,black pepper and salt.",
      "ingredients_used": [
        "7c4988e5-9ebc-51a0-a009-06a23faacafb",
        "5b10d9c3-225f-5385-9e19-19e5e1036f58",
        "ed0d5ae0-9740-5aa6-a01d-23a48ef49675"
      ]
    },
    {
      "step_number": 6,
      "instruction": "olive oil, gia sundried tomato puree and gia garlic puree and black pepper mixed together in a silver bowl to make Croatian peka",
      "ingredients_used": [
        "7c4988e5-9ebc-51a0-a009-06a23faacafb",
        "5b10d9c3-225f-5385-9e19-19e5e1036f58",
        "ed0d5ae0-9740-5aa6-a01d-23a48ef49675"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add potatoes and vegetables into a large lidded casserole dish.",
      "ingredients_used": [
        "2a5adc3e-a7b9-5c57-89ab-32b9277de01f"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Chopped up vegetables which consist of chopped up red onion, courgette, potatoes red peppers in a cast iron pan",
      "ingredients_used": [
        "2a5adc3e-a7b9-5c57-89ab-32b9277de01f",
        "9802a80d-fec9-5665-a13d-42dd2d1dca7d"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Place diced lamb on top of the vegetables, pour the marinade and wine over the top.",
      "ingredients_used": [
        "087b2373-0ab0-55b9-a0d0-cb990a1f6ca3"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Chunks of lamb covered in in a sundried tomato oil sauce which is on top of chopped red onion, aubergine, courgette and potatoes in a cast iron pan",
      "ingredients_used": [
        "2a5adc3e-a7b9-5c57-89ab-32b9277de01f",
        "21989bcc-4f0e-5c9d-a691-1d77cef7738d",
        "9802a80d-fec9-5665-a13d-42dd2d1dca7d"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Add the rosemary, thyme and sage, trying to keep the herbs on top.",
      "ingredients_used": [
        "e17b8c8a-17ce-5674-896f-f3529c586c30"
      ]
    },
    {
      "step_number": 12,
      "instruction": "So you can easily remove the herb stalks once cooked."
    },
    {
      "step_number": 13,
      "instruction": "Chunks of lamb coated in a sundried tomato oil sauce and covered with thyme, rosemary and sage which is on top of chopped red onion, aubergine, courgette and potatoes in a cast iron pan",
      "ingredients_used": [
        "2a5adc3e-a7b9-5c57-89ab-32b9277de01f",
        "21989bcc-4f0e-5c9d-a691-1d77cef7738d",
        "9802a80d-fec9-5665-a13d-42dd2d1dca7d",
        "e17b8c8a-17ce-5674-896f-f3529c586c30"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Place lid on the casserole dish and cook for 1hr 30 minute"
    },
    {
      "step_number": 15,
      "instruction": "If you do not have a lid cover very well with kitchen foil"
    },
    {
      "step_number": 16,
      "instruction": "Cast iron dish with lid on in the oven"
    },
    {
      "step_number": 17,
      "instruction": "Take the lid off, remove any thick herb stems. Stir in 2 tbsp of olive oil.",
      "ingredients_used": [
        "5b10d9c3-225f-5385-9e19-19e5e1036f58"
      ]
    },
    {
      "step_number": 18,
      "instruction": "Cook for a further 20-30 mins.",
      "timer_seconds": 1800
    },
    {
      "step_number": 19,
      "instruction": "Cooked Croatian Lamb Peka in a cast iron pan in the oven"
    },
    {
      "step_number": 20,
      "instruction": "Serve with fresh homemade bread to dip into the juices."
    }
