      ]
    },
    {
      "step_number": 3,
      "instruction": "Take lumps of the cashew paste and shape into small balls. Roll the balls in icing sugar and transfer to the baking tray. Push an almond in the center of each ghribia.",
      "ingredients_used": [
        "cd8c9335-bae8-59a6-84ff-f9bf28959b83",
        "eb53195b-b10c-5b16-9dbf-318e7df51e74"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Bake until the biscuits are lightly golden, about 20 minutes. Keep an eye on them, they burn quickly.",
