  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Boil the potatoes for 15 mins or until tender. Drain, then mash.",
      "timer_seconds": 900,
      "ingredients_used": [
        "712a9d48-128d-56e8-bef2-bdd1e497ce4e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat the milk and half the butter in the corner of the pan, then beat into the mash, along with the wholegrain mustard.",
      "ingredients_used": [
        "2ca3a92f-6eeb-5226-bd50-28e3c243257e",
        "f548732c-0347-57f3-a7ef-f3f08ed6c770",
        "29436716-53a6-5383-a866-e31ab2f3302e"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Gently fry the spring onions in the remaining butter for 2 mins until just soft but still a perky green. Fold into the mash and serve. Great with gammon or to top a fish pie.",
      "timer_seconds": 120,
