  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Dry-fry the pine nuts or almonds in a large pan until lightly toasted, then tip onto a plate. Add the oil to the pan, then fry the onion and cinnamon together until starting to turn golden. Turn up the heat, stir in the lamb, fry until the meat changes color, then tip in the rice and cook for 1 min, stirring all the time.",
      "timer_seconds": 60,
      "ingredients_used": [
        "65fb2420-b525-5955-bd13-04745f614229",
        "aeb26e00-72a0-5621-8481-ef9906a34516",
        "aaabcc7d-f6d3-5449-99e9-08d0ff8db8ab",
        "ac20fd8f-5a2d-5819-830e-51e01f73ee40",
        "7861877b-5f1b-522a-86f7-8a80cf777a89"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Pour in 500ml boiling water, crumble in the stock cube, add the apricots, then season to taste. Turn the heat down, cover and simmer for 12 mins until the rice is tender and the stock has been absorbed. Toss in the pine nuts and mint and serve.",
      "timer_seconds": 720,
      "ingredients_used": [
        "65fb2420-b525-5955-bd13-04745f614229",
