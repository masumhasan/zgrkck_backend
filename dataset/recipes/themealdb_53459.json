  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add a pint of chicken stock to the simmer and put three tablespoons of sugar into a large saucepan on high; cook until the sugar caramelizes, then add the cubed chicken breasts and stir until the chicken browns.",
      "ingredients_used": [
        "79b8e19c-2819-55c5-8fa4-7f7403f3d59b",
        "fd533c93-081a-52e3-af6b-d7e876d00780"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add chopped onions, garlic, parsley, thyme, jerk seasoning, salt, and the whole scotch bonnet pepper – do not cut up the pepper! Reduce the heat to low and let this simmer for 25 minutes.",
      "timer_seconds": 1500,
      "ingredients_used": [
        "68e9531d-70c8-5d4a-8a51-17f3a19edd06",
        "8d1aef7e-e716-570f-8554-441e2e7f887a",
        "fa996ea2-b4cb-534e-afaa-932b54a9e165",
        "1d80da5e-967e-5fa5-bf86-9356640e6eea",
        "4a8eb43f-6513-5030-bd9f-3ad23f5e6d2b",
        "53756e92-e642-59e3-ac8f-0f51c92cde48",
        "844f99ac-75c0-53eb-a638-43c71d116609",
        "0c4411bc-6369-5495-96c3-9181d2dcf06a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In a large mixing bowl, sift the flour, and add a pinch of salt to taste.",
      "ingredients_used": [
        "9872075e-32d0-520e-a48a-cca5be802ba7",
        "68e9531d-70c8-5d4a-8a51-17f3a19edd06",
        "4a8eb43f-6513-5030-bd9f-3ad23f5e6d2b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Now add the first tablespoon of shortening, and with your fingers, rub the flour into the shortening until it forms a breadcrumb-like consistency.",
      "ingredients_used": [
        "9872075e-32d0-520e-a48a-cca5be802ba7",
        "fa7f4f6a-2aff-5809-ae77-641729e4bf33"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Then add the second tablespoon of shortening and rub against the flour until it looks like breadcrumbs.",
      "ingredients_used": [
        "9872075e-32d0-520e-a48a-cca5be802ba7",
        "fa7f4f6a-2aff-5809-ae77-641729e4bf33"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Now add the third tablespoon of shortening and repeat the process.",
      "ingredients_used": [
        "fa7f4f6a-2aff-5809-ae77-641729e4bf33"
      ]
    },
    {
      "step_number": 7,
      "instruction": "You should by now have used all the flour. Your bowl should be all breadcrumb-like; if you still have fresh flour, use another tablespoon of shortening until your fresh flour is all used up.",
      "ingredients_used": [
        "9872075e-32d0-520e-a48a-cca5be802ba7",
        "fa7f4f6a-2aff-5809-ae77-641729e4bf33"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add a small amount of water and mix with a butter knife; keep adding small amounts until your mixture forms a soft dough.",
      "ingredients_used": [
        "cd7fd805-cb1e-5ec1-be9a-b25a41487685"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Now dust your surface with flour and roll out your pastry; you want to roll wafer-thin rounds – this mixture should make at least 12 roti skins.",
      "ingredients_used": [
        "9872075e-32d0-520e-a48a-cca5be802ba7"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Cover with a tea towel while returning to the pot."
    },
    {
      "step_number": 11,
      "instruction": "Now peel the potatoes and cube them into small bite-size pieces.",
      "ingredients_used": [
        "89987de7-8fdd-53d8-b300-c87cfb174e7a"
      ]
    },
    {
      "step_number": 12,
      "instruction": "After 25 minutes of simmering, add 1/2 pint of water and the potatoes to the pool.",
      "timer_seconds": 1500,
      "ingredients_used": [
        "cd7fd805-cb1e-5ec1-be9a-b25a41487685",
        "89987de7-8fdd-53d8-b300-c87cfb174e7a"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Now cover and cook for 30 minutes on low heat.",
      "timer_seconds": 1800
    },
    {
      "step_number": 14,
      "instruction": "Turn a flat baking tray upside down, lightly cover with foil, and place on the stovetop on high; cook each roti skin for 1 minute on each side until brown but not crisp.",
      "timer_seconds": 60
    },
    {
      "step_number": 15,
      "instruction": "Now pile up your cooked roti skins, remove the pot after 30 minutes, and remove the whole scotch bonnet.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "0c4411bc-6369-5495-96c3-9181d2dcf06a"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Take the entire pot to the table with a pile of plates; each person assumes the roti skin, lays it flat on the scale, spoons some filling into the middle of the roti skin, and folds around the filling eats enjoy."
    }
  ],
