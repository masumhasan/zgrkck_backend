  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Soak the bread roll in the milk so it softens completely. Meanwhile, fry the onion in the oil for around 8 mins or until soft and golden. Add the fried onion to the beef mince along with the egg, garlic, marjoram and some seasoning. Squeeze the excess milk from the bread roll and add it to the mince mixture. Mix everything together and season well.",
      "timer_seconds": 480,
      "ingredients_used": [
        "ef50cc6d-e424-5d87-90f8-b6cd4d86a6de",
        "4346799c-2a54-5aa4-984a-521b812591a6",
        "0488877c-1c62-50c0-81ec-4a878973a6a0",
        "1ab24364-2e85-5efa-9dc9-2cfd946aed9f",
        "d2442df9-bc47-55b7-96fb-eb48dfeb7a54"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Divide the meat into 8 patties. Tip the dried breadcrumbs into a shallow bowl and coat the patties in it, all over. Heat some oil in a deep frying pan and fry the patties in batches on both sides until browned and cooked through, about 6-7 mins on each side.",
      "timer_seconds": 420,
      "ingredients_used": [
        "550222a1-b9fe-5827-b52a-1b74e9a82fcf"
      ]
    }
