  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix the flour and salt then pour one cup of water and start kneading.",
      "ingredients_used": [
        "56249ab9-3ad7-5a2b-825f-5cd872c7aa9b",
        "66b6af04-7968-5e91-be87-55133ae98f8c",
        "c08f3e72-c44a-5381-8bd0-4735f9fd9f50"
      ]
    },
    {
      "step_number": 2,
      "instruction": "If you feel the dough is still not coming together or too dry, gradually add the remaining water until you get a dough that is very elastic so that when you pull it and it won’t be torn.",
      "ingredients_used": [
        "66b6af04-7968-5e91-be87-55133ae98f8c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Let the dough rest for just 10 minutes then divide the dough into 6-8 balls depending on the size you want for your feteer.",
      "timer_seconds": 600
    },
    {
      "step_number": 4,
      "instruction": "Warm up the butter/ghee or oil you are using and pour into a deep bowl.",
      "ingredients_used": [
        "a611c4b1-623c-5616-ac84-e22095bb4ed2"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Immerse the dough balls into the warm butter. Let it rest for 15 to 20 minutes.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "a611c4b1-623c-5616-ac84-e22095bb4ed2"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Preheat oven to 550F.",
      "temperature": {
        "value": 550,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 7,
      "instruction": "Stretch the first ball with your hands on a clean countertop. Stretch it as thin as you can, the goal here is to see your countertop through the dough."
    },
    {
      "step_number": 8,
      "instruction": "Fold the dough over itself to form a square brushing in between folds with the butter mixture.",
      "ingredients_used": [
        "a611c4b1-623c-5616-ac84-e22095bb4ed2"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Set aside and start making the next ball."
    },
    {
      "step_number": 10,
      "instruction": "Stretch the second one thin as we have done for the first ball."
    },
    {
      "step_number": 11,
      "instruction": "Place the previous one on the middle seam side down. Fold the outer one over brushing with more butter mixture as you fold. Set aside.",
      "ingredients_used": [
        "a611c4b1-623c-5616-ac84-e22095bb4ed2"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Keep doing this for the third and fourth balls. Now we have one ready, place on a 10 inch baking/pie dish seam side down and brush the top with more butter.",
      "ingredients_used": [
        "a611c4b1-623c-5616-ac84-e22095bb4ed2"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Repeat for the remaining 4 balls to make a second one. With your hands lightly press the folded feteer to spread it on the baking dish."
    },
    {
      "step_number": 14,
      "instruction": "Place in preheated oven for 10 minutes when the feteer starts puffing turn on the broiler to brown the top.",
      "timer_seconds": 600
    },
    {
      "step_number": 15,
      "instruction": "When it is done add little butter on top and cover so it won’t get dry.",
      "ingredients_used": [
        "a611c4b1-623c-5616-ac84-e22095bb4ed2"
      ]
    }
  ],
