  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Soak salted fish in water overnight. Next, heat salted fish in water on stove until water boils. You should see a foam on top. Remove from heat and drain. Set aside and shred salted fish once it cools."
    },
    {
      "step_number": 2,
      "instruction": "Cook bacon in skillet over medium heat until crispy. Remove bacon from heat and drain the majority of the bacon grease, leaving about 1 tablespoon in the skillet.",
      "ingredients_used": [
        "bf9b2338-638b-5ec4-8da9-a0f54ad28ef0"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add yellow onion, green onion, scotch bonnet pepper, and garlic to the skillet and stir. Cook for about 2 minutes or until onions soften. Add salted fish to skillet and stir. Cook for about a minute.",
      "timer_seconds": 120,
      "ingredients_used": [
        "2a6de8ab-07a6-5b63-931c-ca910b6683b9",
        "a83ef025-eea1-52ef-aeed-11ee90e4ea36",
        "76d5984e-3a21-5347-8a18-5888bf520abe",
        "11633248-04b3-5b5a-bacc-925b5c8aa8d5"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Next, add callaloo, roma tomatoes, thyme, and black pepper. Stir to combine and cook until heated through, about 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "1e8bb1f4-9c18-5bb7-b5c5-2bc8c8be25d2",
        "cadc58de-73cb-5525-8f7d-051d4e5a0ec1",
        "401af12f-22dd-522a-9653-41a4b2f644bf",
        "9cd5725d-77ba-58fb-aeaa-c402a53f053e"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Enjoy"
    }
  ],
