  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Combine dry ingredients and mix (flour, salt, and baking powder)",
      "ingredients_used": [
        "08cccf20-d010-5c66-90af-bd16dc8c63cc",
        "98224041-22c2-5347-a009-5a890a136602"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add lightly melted butter mix.",
      "ingredients_used": [
        "b2f8f9b8-89bc-5db8-bd5e-faf86b5e7133"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Gradually add lukewarm milk.",
      "ingredients_used": [
        "307ea92f-12bd-5562-941a-4be8d52445b5"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Gently knead the dough with hands."
    },
    {
      "step_number": 5,
      "instruction": "The dough should not be firm but with a sticky consistency."
    },
    {
      "step_number": 6,
      "instruction": "Separate into small portions in the shapes of balls based on the desired size."
    },
    {
      "step_number": 7,
      "instruction": "Let the balls rest for 15 – 20 minutes covered with a towel or saran wrap.",
      "timer_seconds": 1200
    },
    {
      "step_number": 8,
      "instruction": "Flatten dough using hands, using your thumb to press dough in"
    },
    {
      "step_number": 9,
      "instruction": "Deep fry in a saucepan (I use a saucepan because the frying pan is too wide, and I'll need to use too much oil to deep fry). Use medium heat."
    },
    {
      "step_number": 10,
      "instruction": "Turn over on the other side when dough strarts getting brown, then turn over to brown the other side"
    },
    {
      "step_number": 11,
      "instruction": "Enjoy with your favorite side"
    }
  ],
