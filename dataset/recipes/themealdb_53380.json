  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 180°C. (350˚F) Grease a cake pan and line it with baking paper.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "In a large bowl, break the four eggs with the sugar and beat until they have tripled in volume and become fluffy.",
      "ingredients_used": [
        "75ff36fd-c6c7-5cf2-8621-99dbeeb8f8e1",
        "8c12d180-37c5-5246-b869-9fe8ccddd8af"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Sift the self-rising baking flour and add it to your egg mixture. Fold this over, preserving as much air as possible. Add the melted (and slightly cooled) butter and mix until combined.",
      "ingredients_used": [
        "a9b18123-aa98-513b-b7f3-6555ba0a939b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add cinnamon, pinch of salt and vanilla extract.",
      "ingredients_used": [
        "79c8b45b-da31-51ca-83c0-a19fcc9b47f6",
        "eb90914a-0211-5b56-8b39-7b3e34502505",
        "d6b23d93-f29a-5f9a-a426-7e2a05d5c1df"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the diced apple to the batter and gently fold them into the batter so that the apple pieces are evenly distributed. You can roll the apple pieces through some more cinnamon.",
      "ingredients_used": [
        "eb90914a-0211-5b56-8b39-7b3e34502505"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Pour the batter into the prepared cake pan and smooth the top with a spatula."
    },
    {
      "step_number": 7,
      "instruction": "Place the apple slices on top of the batter and press lightly. Sprinkle optionally with some almond shavings."
    },
    {
      "step_number": 8,
      "instruction": "Bake the apple cake in the preheated oven for about 45-50 minutes, or until a wooden skewer comes out clean when inserted into the center of the cake.",
      "timer_seconds": 3000
    },
    {
      "step_number": 9,
      "instruction": "Remove the cake from the oven and let it cool in the mold for a few minutes. Then carefully remove the cake from the mold and let cool completely on a wire rack."
    },
    {
      "step_number": 10,
      "instruction": "Sprinkle the cooled apple cake with powdered sugar",
      "ingredients_used": [
        "8c12d180-37c5-5246-b869-9fe8ccddd8af"
      ]
    }
  ],
