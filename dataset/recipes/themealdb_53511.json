  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cover the diced salt beef with water and bring to a boil. Repeat as necessary, draining and replacing water to eliminate some of the brine.",
      "ingredients_used": [
        "6bc14320-799c-5aae-a97c-1c1f6f5c418d",
        "21604d71-c15b-5b36-b874-f5ac495ddaf0"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a separate pan, place beans in water, add coconut milk, bay leaves, pimento seeds, whole garlic, whole scotch bonnet pepper and scallions. Slowly bring to a boil and simmer for about 2 hours, or until beans are tender.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "628b510e-9e55-5d8e-b4c8-679c466e6466",
        "f40b40bd-4c7e-5e5f-a6d5-0f1d6410a16e",
        "ac2ee34d-d471-50d8-bb4e-da650e19fcbd",
        "4e641141-4725-51c9-991b-e7b1ce9fa3eb",
        "21604d71-c15b-5b36-b874-f5ac495ddaf0",
        "43ac0bce-acba-5fbd-80a0-c1b1ff4e0179",
        "ca50aacf-26e8-501e-ace6-c0b6e802640d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add salt beef, onions, thyme and crushed garlic and simmer for another 20 minutes. Adjust seasonings if necessary.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "6bc14320-799c-5aae-a97c-1c1f6f5c418d",
        "91edff20-160a-5fc4-ba29-424ffb717a44",
        "4e641141-4725-51c9-991b-e7b1ce9fa3eb",
        "ca50aacf-26e8-501e-ace6-c0b6e802640d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Remove the bay leaves and scotch bonnet pepper, being careful not to burst the pepper. Serve with white rice and your choice of salad or vegetables.",
      "ingredients_used": [
        "f40b40bd-4c7e-5e5f-a6d5-0f1d6410a16e"
      ]
    }
  ],
