  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 180°C/fan 160°C/gas mark 4 and grease and line a 25cm x 20cm tin. Melt the butter, sugar, syrup and orange zest in a large saucepan over a medium heat. The aim is to dissolve all the ingredients so that they are smooth, but to not lose any volume through boiling so be careful not to overheat.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
      "ingredients_used": [
        "eda1b9c1-d8f2-5966-b1c7-4bc0bdc0f18b",
        "24d68417-3b4f-5a50-b580-11d608ceb677",
        "2c9fc5e2-f4d9-5f89-865c-50cb9a9aa686"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the oats and stir well until evenly coated. Stir through the leftover Christmas pudding and tip into the prepared tin. Use a spoon to flatten the top and bake for 40 minutes until the edges start to brown. Whilst still warm in the tin, score into 12 squares. Allow to cool completely before cutting along the scores.",
      "timer_seconds": 2400,
      "ingredients_used": [
        "909d1ecb-d88f-555b-8764-8eda285e4a6e",
        "baa21d3e-4567-53ee-b7b0-749a5aff2a5d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Keeps for 5 days in an air tight tin or freeze for up to 1 month."
    }
