  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in a medium saucepan and add the chilli. Cook for 1 min, then add the curry paste, stir and cook for 1 min more. Dissolve the stock cube in a large jug in 700ml boiling water, then pour into the pan and stir to combine. Tip in the coconut milk and bring to the boil.",
      "ingredients_used": [
        "17e1bbe6-3c21-5ffb-b218-ee10a5e00899",
        "a480203a-f96f-5136-b3f2-671f8adbc674",
        "97aba81c-be6f-56b8-a750-0c1da2a83533"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the fish sauce and a little seasoning. Toss in the noodles and cook for a further 3-4 mins until softening. Squeeze in the lime juice, add the prawns and cook through until warm, about 2-3 mins. Scatter over some of the coriander.",
      "ingredients_used": [
        "4df33644-075c-520f-86b7-0809a235c00a",
        "0363cb13-5b96-5c9e-95db-ec33a70677c6",
        "778a55f7-e649-5adb-bab0-4038a34ff0d9",
        "3847f2ba-ebd5-5f05-b5b7-18490909c6e7",
        "6b1622dd-aab5-5277-98a6-6e7afbf29924"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Serve in bowls with the remaining coriander and lime wedges on top for squeezing over.",
      "ingredients_used": [
        "778a55f7-e649-5adb-bab0-4038a34ff0d9",
        "6b1622dd-aab5-5277-98a6-6e7afbf29924"
      ]
    }
  ],
