  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Make the gravy:"
    },
    {
      "step_number": 2,
      "instruction": "In a small saucepan, add the beef stock, soy sauce, Shaoxing wine, oyster sauce, and white pepper powder over medium heat. Whisk together and bring to a simmer.",
      "ingredients_used": [
        "47f356b5-5bd3-5096-a426-a668daf7736e",
        "52519d81-bf53-5030-8c66-f260f0f70849",
        "c8804032-d813-5ace-ab78-535714107dc2",
        "3a16d331-ff7e-5073-97da-0ff97d9974fa"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Combine the cornstarch and water in a small bowl and whisk to dissolve. Add to the saucepan and whisk until the gravy thickens and coats the back of the spoon, 2 to 3 minutes. Cover the saucepan with a lid and keep it warm on the lowest possible heat.",
      "timer_seconds": 180,
      "ingredients_used": [
        "c27d0187-26cc-53b3-aadd-fb0f448c4874",
        "187a6f24-fed1-597a-bdcb-4212513c899d",
        "fec5387d-3839-52ae-ac88-9840831ff52c",
        "f83d01d4-3dce-5a7b-b205-17c1e3024c7c"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Make the egg foo young batter:",
      "ingredients_used": [
        "fbe806fd-5555-5e6f-ad34-3754a1d224df"
      ]
    },
    {
      "step_number": 5,
      "instruction": "In a medium bowl, whisk together the cornstarch and water until dissolved. Add the eggs, salt, and sugar. Whisk until well combined and there are no more egg white clumps.",
      "ingredients_used": [
        "c27d0187-26cc-53b3-aadd-fb0f448c4874",
        "187a6f24-fed1-597a-bdcb-4212513c899d",
        "fec5387d-3839-52ae-ac88-9840831ff52c",
        "f83d01d4-3dce-5a7b-b205-17c1e3024c7c",
        "fbe806fd-5555-5e6f-ad34-3754a1d224df",
        "39ac7477-b48e-5efb-81aa-35abfa2a6f54",
        "70582ec9-4085-566e-8230-08f6c8e58d27"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add the green onion, bean sprouts, and shrimp. Stir until everything is evenly coated.",
      "ingredients_used": [
        "02457ece-0358-5878-a2e0-b895f996b559",
        "519334f6-14d1-571a-b071-0882e5e414ba"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Fry the egg foo young:",
      "ingredients_used": [
        "fbe806fd-5555-5e6f-ad34-3754a1d224df"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add the vegetable oil to a large wok; it should reach about 2 inches up the sides. Heat the oil over medium-high heat to 350°F, or until vigorous bubbles form around an inserted wooden chopstick.",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      },
      "ingredients_used": [
        "a3293af5-578a-5afb-96d7-291877949fab"
      ]
    },
    {
      "step_number": 9,
      "instruction": "With a ladle, gently and slowly add 1/4 of the omelet batter. Egg foo young should immediately bubble and puff up like magic. Fry until golden brown and crispy on each side, about 2 minutes per side. If there are any light spots, use a ladle to gently baste it with hot oil.",
      "timer_seconds": 120,
      "ingredients_used": [
        "fbe806fd-5555-5e6f-ad34-3754a1d224df"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Tip"
    },
    {
      "step_number": 11,
      "instruction": "Egg foo young can be a bit tricky to flip. The easiest method is to put a tool in each hand (a spider, slotted spoon, tongs, and large chopsticks are all good candidates) and gently coax the omelet over, pulling up on one side and pushing down and around on the other.",
      "ingredients_used": [
        "fbe806fd-5555-5e6f-ad34-3754a1d224df"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Remove the omelet and place it on a paper towel-lined baking sheet. Let it cool for 5 minutes. Meanwhile, repeat with the remaining batter to make 4 omelets. If needed, add more oil to the pan between batches.",
      "timer_seconds": 300
    },
    {
      "step_number": 13,
      "instruction": "Serve and enjoy:"
    },
    {
      "step_number": 14,
      "instruction": "Plate each egg foo young over a bed of rice. Spoon the warm gravy over the top and serve immediately.",
      "ingredients_used": [
        "fbe806fd-5555-5e6f-ad34-3754a1d224df",
        "b8eb79f1-402a-5d44-bdba-b8d731291ba2"
      ]
    }
  ],
