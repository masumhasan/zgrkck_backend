  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 230C/fan 210C/gas 8.",
      "temperature": {
        "value": 230,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Drizzle a little sunflower oil evenly into two 4-hole Yorkshire pudding tins or two 12-hole non-stick muffin tins and place in the oven to heat through.",
      "ingredients_used": [
        "95f82e1e-7d7a-5a02-8871-4aded1243f70"
      ]
    },
    {
      "step_number": 3,
      "instruction": "To make the batter, tip 140g plain flour into a bowl and beat in 4 eggs until smooth.",
      "ingredients_used": [
        "57c94384-71b4-5371-8fbb-fd0ee82c7bda"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Gradually add 200ml milk and carry on beating until the mix is completely lump-free. Season with salt and pepper.",
      "ingredients_used": [
        "223e25da-efd6-52da-8d24-ab80a86a3099"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour the batter into a jug, then remove the hot tins from the oven. Carefully and evenly pour the batter into the holes."
    },
    {
      "step_number": 6,
      "instruction": "Place the tins back in the oven and leave undisturbed for 20-25 mins until the puddings have puffed up and browned.",
      "timer_seconds": 1500
    },
    {
      "step_number": 7,
      "instruction": "Serve immediately. You can now cool them and freeze for up to 1 month."
    }
  ],
