  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Boil the corn cobs for 5 mins. Leave in the water until you’re ready to grill them. Mix the garlic and mayonnaise in a small bowl. Just before barbecuing, remove the cobs from the pan, pat dry and rub the mayonnaise into each one.",
      "timer_seconds": 300,
      "ingredients_used": [
        "3e3c3a4a-93d4-53c5-a88c-9c75fdb53f7e",
        "55289635-ebd5-5922-8c94-711c2abd383a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Season the cobs and grill them until marks appear, about 5 mins. Remove and scatter over the Parmesan and coriander. Squeeze lime over to serve.",
