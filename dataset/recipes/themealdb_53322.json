  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "For the caramel place 100 grams of sugar in a frying pan without any fat and melt on medium heat. Try not to stir with a spoon, but swirl the pan itself. Let melt until you have an amber color and sugar is fully melted. Fill the bottom of four flan containers with it. Caramel will harden immediately, so you need to be fast. My containers yield about 120 milliliters each.",
      "ingredients_used": [
        "48cddccf-bbe3-510a-89ad-63e5bc90b5c5",
        "28341042-97a1-5f30-b669-e387ac75233a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Preheat oven to 150 degrees Celsius and look for a casserole or container all your four flan containers fit into.",
      "temperature": {
        "value": 150,
        "unit": "celsius"
      }
    },
    {
      "step_number": 3,
      "instruction": "Heat milk with 45 grams of sugar and the cut and scraped out vanilla pod. The milk does not need to boil, just needs to be heated. Take out vanilla pod after a few minutes. Meanwhile stir the egg yolks and eggs gently, try not to incorporate any air in it. Them pour milk-mix into egg-mix and again only stir very gently. Pour into prepared flan containers and place these into your casserole or container. Boil water and pour the water into the large casserole. Be sure not to touch the flan mixture. Place on middle rack in the oven and let bake for about 35-40 minutes. An inserted toothpick should come out clean.",
      "timer_seconds": 2400,
      "ingredients_used": [
        "48cddccf-bbe3-510a-89ad-63e5bc90b5c5",
        "02b22588-1ddb-52e6-b2a4-acebc0071b5d",
        "28341042-97a1-5f30-b669-e387ac75233a",
        "b64c827e-8a41-573d-96d5-3771f75b47b3",
        "2f3fbfb5-5370-5089-8da0-d60a55d94769",
        "3f8863d4-d4a7-5ab7-9309-cae15bdaf873"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Let cool inside the container for an hour before transferring to the fridge. Chill overnight. The next day gently release the rim and then turn upside down on a plate. Serve with some dulce de leche on the side.",
      "ingredients_used": [
        "219899a8-ef87-5040-941c-019b46bb1d62"
      ]
    }
  ],
