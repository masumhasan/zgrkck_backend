  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat an outdoor grill for medium-high heat and lightly oil the grate. Prick the surface of the skin of eggplants several times with the tip of a knife."
    },
    {
      "step_number": 2,
      "instruction": "Place eggplants directly on grill. Turn frequently with tongs while skin chars. Cook until eggplants have collapsed and are very soft, 25 to 30 minutes. Transfer to a bowl and cover tightly with aluminum foil and allow to cool, about 15 minutes."
    },
    {
      "step_number": 3,
      "instruction": "When eggplants are cool enough to handle, split them in half and scrape flesh into a colander placed over a bowl. Drain 5 or 10 minutes.",
      "timer_seconds": 600
    },
    {
      "step_number": 4,
      "instruction": "Transfer eggplant to mixing bowl. Add crushed garlic and salt; mash until creamy but with a little texture, about 5 minutes. Whisk in lemon juice, tahini, olive oil, and cayenne pepper. Stir in yogurt.",
      "timer_seconds": 300,
      "ingredients_used": [
        "222a948c-96c7-5da5-85f4-dcdf8ea2c121",
        "51f4db22-bac7-5d0f-b074-f88618932b73",
        "c3683f67-9fbe-59b4-9f0e-a306e09881fa",
        "1cc77904-4c0c-5955-a542-557117e86ad7",
        "72e6a5a0-d456-5962-86e7-d547f9379767",
        "0b087e3d-b027-5348-8b33-84b3096c18c8"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Cover bowl with plastic wrap and refrigerate until completely chilled. Stir in mint and parsley, and taste to adjust seasonings before serving.",
      "ingredients_used": [
        "c3658d38-b836-5776-87bf-6102d802f1dd",
        "321992f8-0b48-5965-a2de-34ec181eacf6"
      ]
    }
  ],
