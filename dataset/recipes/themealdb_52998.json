  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place corned beef in large pot or Dutch oven and cover with water. Add the spice packet that came with the corned beef. Cover pot and bring to a boil, then reduce to a simmer. Simmer approximately 50 minutes per pound or until tender.",
      "timer_seconds": 3000
    },
    {
      "step_number": 2,
      "instruction": "Add whole potatoes and peeled and cut carrots, and cook until the vegetables are almost tender. Add cabbage and cook for 15 more minutes. Remove meat and let rest 15 minutes.",
      "timer_seconds": 900,
