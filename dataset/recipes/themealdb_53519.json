  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 350 degrees F (175 degrees C).",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "Pour the milk into a saucepan along with the lemon zest and cinnamon sticks. Bring to a simmer over medium-high heat, then reduce heat to low, and cook for 5 minutes. Turn heat off, and allow to steep for 15 minutes.",
      "ingredients_used": [
        "51794fa4-bc0c-51af-813e-b07440645e6f",
        "a5d4b924-392f-50d3-845e-a045465c35a0",
        "a160a0b6-1b68-5069-9daf-9352433f94e5"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Gently beat the eggs and sugar together until the sugar has dissolved. Slowly beat in 1 cup of the hot milk, a little at a time, until it has been incorporated. Stir the egg mixture back into the hot milk, pour in the pisco, and mix until well combined.",
      "ingredients_used": [
        "51794fa4-bc0c-51af-813e-b07440645e6f",
        "384ca702-b681-5988-b3e4-39193f244a0d",
        "9353b851-6f24-5739-8450-53f0b6e2b382"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Pour the custard through a fine mesh sieve into a 2-quart ceramic casserole dish to remove the lemon zest and cinnamon. Bake in preheated oven until set, and browned on top, about 30 minutes. Chill before serving.",
      "timer_seconds": 1800,
      "ingredients_used": [
