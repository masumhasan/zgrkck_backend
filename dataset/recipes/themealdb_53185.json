  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the tomatoes in a bowl with the onion and thyme. Season, then drizzle with the vinegar and oil. Let the flavors mingle while you cook the chorizo.",
      "ingredients_used": [
        "e62ac5d0-75e2-557e-a944-a567fa41410b",
        "c79385f1-c72e-5c9a-9057-be0c6e7aa5d9",
        "7583de89-0c8b-5703-b3bb-4adf90cd8b28"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a hot, dry pan, fry the chorizo slices until browned on both sides. Serve the tomatoes with the fried chorizo, drizzled with a little oil from the pan.",
