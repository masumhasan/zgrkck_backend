  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel the squash and cut it into pieces 1cm wide. Deep fry it in oil until golden and set aside.",
      "ingredients_used": [
        "72eebe7c-e943-5b63-9f9a-db3fb108ec92",
        "d087b86e-9d60-5073-994f-c2e41355b818"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Using the same pan and oil, deep fry the onions until golden. Remove the onions and grind with the garlic (if using garlic paste, mix it into the onions once ground).",
      "ingredients_used": [
        "a0ba18db-32e4-54da-8053-a5d601ae03b7",
        "d087b86e-9d60-5073-994f-c2e41355b818",
        "43b1744f-fc8f-5a33-9182-03635de1baf3"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add a small amount of oil to a pan on medium heat. Once hot, add the turmeric. Mix the salt into one cup of water and add it to the turmeric. Add a layer of squash, then a layer of onion and garlic. Repeat this step until the squash, onion and garlic have been used up.",
      "ingredients_used": [
        "72eebe7c-e943-5b63-9f9a-db3fb108ec92",
        "a0ba18db-32e4-54da-8053-a5d601ae03b7",
        "d087b86e-9d60-5073-994f-c2e41355b818",
        "f7596b62-bfc4-5b6f-8295-b493421bb72c",
        "43b1744f-fc8f-5a33-9182-03635de1baf3",
        "f0f02213-834b-5327-bfaf-eeb2f4f0d71a",
        "2f5a49c5-7067-5d6a-a5b7-01ece34cca74"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the sugar and one cup of water. Turn the heat down and cook until the water has reduced.",
      "ingredients_used": [
        "8a899dcd-397f-5d03-89f8-6a5e74cf854f",
        "2f5a49c5-7067-5d6a-a5b7-01ece34cca74"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add 1-2 tablespoons of melted curd to a plate, add the squash on top with another layer of melted curd. At last, add some green chilli and serve!",
      "ingredients_used": [
        "72eebe7c-e943-5b63-9f9a-db3fb108ec92",
        "986a3843-52cf-52a9-b1de-4d4d7a9dee8b"
      ]
    }
  ],
