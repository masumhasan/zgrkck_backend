  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oven to 200C/180C fan/gas 6. Heat the olive oil in a large ovenproof frying pan over a medium heat and fry the onion, chorizo and peppers along with a pinch of salt and pepper for 15 mins until the veg has softened and the chorizo has released its oils. Add the paprika and garlic, and cook for another few minutes until fragrant.",
      "timer_seconds": 900,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "7391d4c7-618a-5032-97ce-bcb099bde231",
        "44aa984b-c97a-552a-b920-2b007708faee",
        "1c9b7451-97c7-5149-bc00-290d1aa0cd04",
        "43ad7bfc-c8f9-574b-ab76-ab28c8b67b19"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Tip in the chopped tomatoes, olives and butter beans, stir to combine and season. Nestle in the chicken thighs and season well. Transfer to the oven and bake for 40 mins until the chicken skin is crisp and the meat cooked through and tender. Scatter with the parsley and serve.",
