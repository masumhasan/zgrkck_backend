  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Soak the beans for at least 4 hrs or overnight in a large bowl with plenty of water to cover. Next day, rinse and drain, then put in a large heavy based pan with the onion, paprika, herb bundle and chicken. Pour over enough water or stock to cover, bring to the boil, then reduce the heat, cover and simmer for 45 mins.",
      "ingredients_used": [
        "9c6cb1bd-c1ba-5aa7-ba02-7e1264353de8",
        "bd1ea5c6-27b1-54f3-8004-1f652a31cb09",
        "2ed16e07-5334-515f-9946-69ebd285ef97"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Remove the chicken to a plate, then add the potatoes and chorizo to the pan. Continue cooking for 30 mins until the beans and potatoes are tender.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "9c6cb1bd-c1ba-5aa7-ba02-7e1264353de8",
        "ac10ccf2-a105-5d7a-8d1c-ed0db9e56448",
        "b5bcf52b-d7a6-5bff-abba-8d36f3384b73"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Discard the skin and bones from the chicken and tear into large chunks. Return the chicken to the pan with the spinach and simmer for 5 mins.",
      "timer_seconds": 300,
      "ingredients_used": [
        "2ed1a69c-f6ed-53d5-93d9-90b313f1cbfc"
      ]
    }
  ],
