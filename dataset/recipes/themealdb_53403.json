  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Remove the skin of the pumpkin. Also remove the inner seeds.",
      "ingredients_used": [
        "36ae15f0-0b1a-5c74-a4af-83d33ee7f181"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cut the flesh into 2cm cubes."
    },
    {
      "step_number": 3,
      "instruction": "Take the zest off the oranges, with as little pith as possible, and cut into matchstick-sized strips.",
      "ingredients_used": [
        "045611ae-a61f-5609-9843-4c1a1ad0e27e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Extract the juice from the oranges. Remove the seeds from the cardamom pods and reserve.",
      "ingredients_used": [
        "045611ae-a61f-5609-9843-4c1a1ad0e27e",
        "98711b5f-a42a-5cb5-a1d5-1cd3736ca682"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Place the pumpkin, orange juice, orange strips, sugar and whole cardamom pod seeds in a large pan, mix well and leave to marinate for about 10 hours or overnight. Stir occasionally.",
      "timer_seconds": 36000,
      "ingredients_used": [
        "36ae15f0-0b1a-5c74-a4af-83d33ee7f181",
        "045611ae-a61f-5609-9843-4c1a1ad0e27e",
        "6296706e-cf0c-5e5b-b762-e1b08f1da4f0",
        "98711b5f-a42a-5cb5-a1d5-1cd3736ca682"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Bring the mixture to the boil, then reduce the heat and simmer until the liquid has thickened and become syrupy. This can take about an hour or a little bit longer."
    },
    {
      "step_number": 7,
      "instruction": "Leave to cool then place in clean, dry jars. Enjoy!"
    }
  ],
