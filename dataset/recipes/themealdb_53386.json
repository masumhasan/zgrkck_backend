  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add the flour, 150 gr of the sugar, pinch of salt and 1 egg yolk in the bowl of a food processor. Cut the butter into small cubes and add to the bowl. Turn this into a firm dough. Don't over process, you do not want the dough to turn warm. Check if it sticks by pinching it between your fingers.",
      "ingredients_used": [
        "1786a9fe-979d-522e-8b64-cde47061ebb2",
        "fbb767d2-ea50-54c8-9068-c38ced073a45",
        "ca6ea591-80bd-542f-ab83-e14cff80fc80",
        "c8d370d7-d4d0-568e-82a6-8c49cc895da3"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Turn out onto a piece of plastic wrap. Make a round ball of it by using your hands and roll it into the plastic. Place into the fridge for half an hour to cool."
    },
    {
      "step_number": 3,
      "instruction": "Take a round baking tin of 22 cm diameter and cover this with baking paper. Brush the sides with butter.",
      "ingredients_used": [
        "1786a9fe-979d-522e-8b64-cde47061ebb2"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Preheat the oven to 170˚C (340˚F)"
    },
    {
      "step_number": 5,
      "instruction": "Cut the apple into cubes and mix this with the raisins, the left over sugar and the cinnamon.",
      "ingredients_used": [
        "ca6ea591-80bd-542f-ab83-e14cff80fc80",
        "dc3df9a0-ca8c-554e-910f-7712d9dfa9fb",
        "886a64d9-54fe-58b3-8432-6698389f6d80"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Place the cooled dough on a flat surface sprinkled with flour and roll out into a thin sheet. Place this into the baking tin and cover the bottom and the sides well. I usually just press it into the tin without rolling it out. I find that the easiest way but it is less smooth. Just do whatever works for you.",
      "ingredients_used": [
        "fbb767d2-ea50-54c8-9068-c38ced073a45"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Make sure you keep 1/4 of the dough separate to form the strips on the top."
    },
    {
      "step_number": 8,
      "instruction": "Once the bottom and sides are covered with the dough, take the rusks and crumble them over the bottom. You can use breadcrumbs for this as well. Shake it a bit so it is divided equally across the bottom."
    },
    {
      "step_number": 9,
      "instruction": "Add the apple mixture and divide well over the tin. Rol out the rest of the dough and cut into strips. Place that over the top of the pie in a diamond shaped pattern. Brush the strokes and sides with the other egg yolk and place in the preaheated oven."
    },
    {
      "step_number": 10,
      "instruction": "Bake the apple pie for about 1 hour or until golden and cooked through. Leave to cool in the tin and make sure the sides are loose before opening the tin.",
      "timer_seconds": 3600
    }
  ],
