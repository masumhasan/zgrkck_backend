  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 200C/fan 180C/gas 6. Boil the potatoes for 15-20 mins until tender. Drain, return to the pan, then mash with some seasoning and 2 tsp of the paprika.",
      "timer_seconds": 1200,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "2f99e5d1-033f-5562-a6a4-cbdc2cffc372",
        "1ac223a0-a4e4-5a2d-8d09-89d35eae82e0"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Meanwhile, heat the oil in a large pan, then fry the onions and garlic for a few mins until softened. Stir in the remaining paprika for 1 min, add the tomatoes , then, bring to a simmer. Tip into a large ovenproof dish, then stir in the chicken, peppers, olives and some seasoning.",
      "timer_seconds": 60,
      "ingredients_used": [
        "1ac223a0-a4e4-5a2d-8d09-89d35eae82e0",
        "5e6ba9d2-6a44-5779-89de-bd27ddc04f73",
        "45e07526-e1e8-59a9-9b73-bc26d24ddeba",
        "70d6d995-b565-592a-a63f-f6e21c1f6ef2",
        "8c927a44-8e00-5b67-8da1-ad1c63c68630"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Spoon over the mash, then bake for 15 mins until the mash is golden on top and the sauce is bubbling.",
      "timer_seconds": 900
    }
  ],
