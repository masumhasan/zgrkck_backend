  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oven to 200C/180C fan/gas 6. Bake the baguettes on a baking tray for 8-10 mins, then leave to cool.",
      "timer_seconds": 600,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "558c5b66-4fb2-5eca-9685-d512877f1cfb"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat 2 tsp of the butter and 1 tsp of the oil in a pan over a low heat and cook the chopped onion for 5 mins until soft. Stir in the mushrooms, turn the heat to medium and cook for 5-10 mins more until the veg is soft and the mushroom liquid has evaporated. Stir in the garlic and cook for 1-2 mins until soft. Season, then stir in the mayonnaise and remove from the heat.",
      "ingredients_used": [
        "82f530a1-01b9-5c31-bc60-c2447b16a163",
        "e99b3c79-b14e-5eb1-8b82-41266d5bd7ab",
        "0b14c199-7f1b-5424-9139-5a416377f1b8",
        "dcf2cfa5-e36d-5480-8390-942fa647d438",
        "4a89ce81-3a57-523a-9e58-0709c9218900"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Halve the baguettes lengthways, then return to the baking tray, cut-side up and spread over the mushroom mixture, then sprinkle over the cheddar, ham, kabanos and mozzarella. Bake for 8-10 mins, or until the cheese has melted and turned golden.",
      "timer_seconds": 600,
      "ingredients_used": [
        "558c5b66-4fb2-5eca-9685-d512877f1cfb",
        "5ef62514-48b7-5d88-960e-0a047d9c50bc",
        "54799fca-924a-5ac2-b505-dd47478d7fd4",
        "236c817c-0f2f-5665-8466-cdb2ff1e81fe"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Meanwhile, heat the remaining butter and oil in a pan over a medium heat and fry the sliced onions for 5 mins until golden and soft. Remove from the heat and set aside. Once the pizzas are cooked, top with the caramelized onions, dill pickles (if using), the chives and a zig-zag drizzle of ketchup.",
      "timer_seconds": 300,
      "ingredients_used": [
        "82f530a1-01b9-5c31-bc60-c2447b16a163",
        "e99b3c79-b14e-5eb1-8b82-41266d5bd7ab",
        "9c7e608f-0f7e-5334-a47a-3b01249fdc49",
        "3fd35933-10d0-5dbd-98fa-d80a57262723",
        "13bda226-c90b-54f8-a6e8-47c5d5329a8f"
      ]
    }
