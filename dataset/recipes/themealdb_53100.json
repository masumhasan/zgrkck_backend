  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to fan 180C/conventional 200C/gas 6. Generously butter six non-stick friand or muffin tins. Melt the butter and set aside to cool.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
      "ingredients_used": [
        "dbd53d08-f57b-59de-be06-38236bff0d08"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Sift the icing sugar and flour into a bowl. Add the almonds and mix everything between your fingers.",
      "ingredients_used": [
        "f90ad4f7-06db-52cb-9ad8-ca842a4460be",
        "cde3242a-a184-5aef-9964-235e7368e377",
        "22646ccf-6383-54ce-bbf4-1b31606e2484"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Whisk the egg whites in another bowl until they form a light, floppy foam. Make a well in the center of the dry ingredients, tip in the egg whites and lemon rind, then lightly stir in the butter to form a soft batter.",
      "ingredients_used": [
        "dbd53d08-f57b-59de-be06-38236bff0d08",
        "4b3c2f28-4bd6-51b1-8c33-7aeafe17c38f",
        "96ca7305-eddb-58d3-b47f-848efa916246"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Divide the batter among the tins, a large serving spoon is perfect for this job. Sprinkle a handful of blueberries over each cake and bake for 15-20 minutes until just firm to the touch and golden brown.",
      "timer_seconds": 1200
    },
    {
      "step_number": 5,
      "instruction": "Cool in the tins for 5 minutes, then turn out and cool on a wire rack. To serve, dust lightly with icing sugar.",
      "timer_seconds": 300,
      "ingredients_used": [
        "f90ad4f7-06db-52cb-9ad8-ca842a4460be"
      ]
    }
  ],
