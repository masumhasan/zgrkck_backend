  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "To make the pastry, measure the flour into a bowl and rub in the butter with your fingertips until the mixture resembles fine breadcrumbs. Add the water, mixing to form a soft dough.",
      "ingredients_used": [
        "d008797c-755c-533c-beb6-675c5557dd0d",
        "63f3f0f4-318d-50c0-b896-e0fe9eab3cb9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Roll out the dough on a lightly floured work surface and use to line a 20cm/8in flan tin. Leave in the fridge to chill for 30 minutes.",
      "timer_seconds": 1800
    },
    {
      "step_number": 3,
      "instruction": "Preheat the oven to 200C/400F/Gas 6 (180C fan).",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 4,
      "instruction": "Line the pastry case with foil and fill with baking beans. Bake blind for about 15 minutes, then remove the beans and foil and cook for a further five minutes to dry out the base.",
      "timer_seconds": 900
    },
    {
      "step_number": 5,
      "instruction": "For the filing, spread the base of the flan generously with raspberry jam.",
      "ingredients_used": [
        "b6e6c4d5-2908-5e87-a8bd-4da26ecfb45b"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Melt the butter in a pan, take off the heat and then stir in the sugar. Add ground almonds, egg and almond extract. Pour into the flan tin and sprinkle over the flaked almonds.",
      "ingredients_used": [
        "d008797c-755c-533c-beb6-675c5557dd0d",
        "63f3f0f4-318d-50c0-b896-e0fe9eab3cb9",
        "877a7247-bb78-5645-a54a-4a53c2a9623d",
        "ff44a4f7-c367-5285-8a6f-464dd4307030",
        "18e5a576-0fb2-5892-8da3-899b38832b3c"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Bake for about 35 minutes. If the almonds seem to be browning too quickly, cover the tart loosely with foil to prevent them burning.",
      "timer_seconds": 2100,
      "ingredients_used": [
        "877a7247-bb78-5645-a54a-4a53c2a9623d",
        "18e5a576-0fb2-5892-8da3-899b38832b3c"
      ]
    }
  ],
