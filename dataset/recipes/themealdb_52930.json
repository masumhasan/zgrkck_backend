  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a large pot of salted water, cook the potatoes until they are very tender. Drain.",
      "ingredients_used": [
        "c51bf1b9-64ca-546e-a30f-1f1d90736f29",
        "eb80a77c-789c-5589-9244-e6c42aca2598"
      ]
    },
    {
      "step_number": 2,
      "instruction": "With a masher, coarsely crush the potatoes with at least 30 ml (2 tablespoons) of butter. With an electric mixer, purée with the milk. Season with salt and pepper. Set aside.",
      "ingredients_used": [
        "c51bf1b9-64ca-546e-a30f-1f1d90736f29",
        "3931c8ef-5d5f-5624-85fb-a8cf4ad75408",
        "f8619a8e-6d24-5723-b7ec-ece361ad0729",
        "eb80a77c-789c-5589-9244-e6c42aca2598",
        "6e0e4f16-3c9f-5c93-9b72-fce22bda7e45"
      ]
    },
    {
      "step_number": 3,
      "instruction": "With the rack in the middle position, preheat the oven to 190 °C (375 °F).",
      "temperature": {
        "value": 190,
        "unit": "celsius"
      }
    },
    {
      "step_number": 4,
      "instruction": "In a large skillet, brown the onion in the remaining butter. Add the meat and cook until golden brown. Season with salt and pepper. Remove from the heat.",
      "ingredients_used": [
        "3931c8ef-5d5f-5624-85fb-a8cf4ad75408",
        "39365949-ba7d-5d3d-95c4-d0e1b23402d5",
        "eb80a77c-789c-5589-9244-e6c42aca2598",
        "6e0e4f16-3c9f-5c93-9b72-fce22bda7e45"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Lightly press the meat at the bottom of a 20-cm (8-inch) square baking dish. Cover with the corn and the mashed potatoes. Sprinkle with paprika and parsley.",
      "ingredients_used": [
        "c51bf1b9-64ca-546e-a30f-1f1d90736f29",
        "f1edb928-d5c4-58cd-84b7-eb3c826761af",
        "88984898-272a-519f-ab7d-54342c29f03a",
        "9eea213f-ff13-5bec-b5bc-b29fb368d4c0"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Bake for about 30 minutes. Finish cooking under the broiler. Let cool for 10 minutes."
    }
  ],
