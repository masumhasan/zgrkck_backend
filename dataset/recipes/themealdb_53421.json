  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Fry the eggs sunny-side up and set aside. Finely chop the garlic. Wash the lettuce leaves and drain well. Thinly slice the onion and tomatoes.",
      "ingredients_used": [
        "60ab7477-61b2-533b-b1bb-33a9861b3f68",
        "184b0dc2-7d40-5686-bb11-cd95e13cc8f6",
        "84480f69-5cbc-5fa6-bd48-bd669361db93",
        "f7b1b773-b08e-5b2b-9a09-c00c8b62836f",
        "14440a7b-635e-5d47-bf79-ced41a537560"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cut the beef tenderloin into 2–3 cm cubes. Marinate with sea salt, palm sugar, Chinese cooking wine, oyster sauce, soy sauce, and sesame oil. Mix well.",
      "ingredients_used": [
        "55b30728-197f-597f-976d-292c85dc4265",
        "321938c4-238f-5ff6-9a3f-9bd99d72db7b",
        "a28e8702-2e3d-5f5b-a6a5-3fa28ed752cc",
        "c5dd75d3-61ae-57aa-85ac-aa426a216fb2",
        "e59a24f4-3afc-5103-a731-41aaa1718217",
        "0f793399-6f27-58b2-9a13-0662312e5182",
        "09378168-02cc-5006-8879-553c775250c8",
        "207ba397-7208-5054-9618-da0345a9e6d7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat a frying pan on high heat with cooking oil. Add chopped garlic and stir until the garlic browns lightly. Add the marinated beef (with all the marinade) and cook for 5–7 minutes, depending on how rare you want the beef.",
      "timer_seconds": 420,
      "ingredients_used": [
        "60ab7477-61b2-533b-b1bb-33a9861b3f68",
        "321938c4-238f-5ff6-9a3f-9bd99d72db7b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Dry roast the black Kampot peppercorns in a frying pan over medium-low heat for 2–3 minutes until fragrant. Grind the roasted pepper, place it in a bowl, then add sea salt and lime juice. Mix well.",
      "timer_seconds": 180,
      "ingredients_used": [
        "c5dd75d3-61ae-57aa-85ac-aa426a216fb2",
        "207ba397-7208-5054-9618-da0345a9e6d7",
        "546bc166-716f-526d-a1df-75bf5261f610"
      ]
    },
    {
      "step_number": 5,
      "instruction": "On a serving plate, arrange a bed of lettuce, then layer tomatoes, then onions. Spoon the cooked beef over the vegetables and place fried eggs on top. Serve with the Kampot pepper sauce and fragrant steamed rice.",
      "ingredients_used": [
        "184b0dc2-7d40-5686-bb11-cd95e13cc8f6",
        "84480f69-5cbc-5fa6-bd48-bd669361db93",
        "f7b1b773-b08e-5b2b-9a09-c00c8b62836f",
        "14440a7b-635e-5d47-bf79-ced41a537560",
        "f9915154-5e1c-57da-95c4-805ad1076e07"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Sear hot and fast, Lok Lak is at its best when the beef stays tender and juicy, with a bold, bright dipping sauce to cut through the richness."
    }
  ],
