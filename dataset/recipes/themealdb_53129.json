  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Whisk the egg and sugar until the mixture thickens.",
      "ingredients_used": [
        "92fa8ea5-0ce0-5a64-8022-71c28207d7c1",
        "85c13705-265f-5e01-9b98-0b6a4cc3b749"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Melt the butter and let it cool slightly, then add the butter to the egg mixture.",
      "ingredients_used": [
        "92fa8ea5-0ce0-5a64-8022-71c28207d7c1",
        "b3b0a2af-fe17-55af-9727-533dbf5ddae2"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Mix in spices and then slowly add the flour while stirring to avoid lumps.",
      "ingredients_used": [
        "5aa23428-2016-5351-ba0a-0964b44318ce"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Let the batter rest for at least 30 minutes. This improves the texture of the krumkaker.",
      "timer_seconds": 1800
    },
    {
      "step_number": 5,
      "instruction": "Spoon about one heaping tablespoon of batter onto iron and bake. If the batter is too thick, add some water to it.",
      "ingredients_used": [
        "daad90e8-9f0a-57d7-b9dd-5f91bccf5564"
      ]
    },
    {
      "step_number": 6,
      "instruction": "While still hot, shape the krumkake with a wooden krumkake roller or over a cup (if using a cup, make them a bit thicker). The krumkaker harden quickly, so you can just let them sit on the roller/cup until the next krumkake is ready to be shaped."
    },
    {
      "step_number": 7,
      "instruction": "After completely cooled, store the krumkaker in a metal or glass tin lined with paper towels at the bottom. You can also freeze them!"
    }
  ],
