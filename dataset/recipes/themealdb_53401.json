  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the flour and teaspoon of salt in a mixing bowl. Slowly adding as much water as is required. Mix to form a stiff dough.",
      "ingredients_used": [
        "e650478b-7b22-5cc0-89d3-a8480461d652",
        "f36d6422-4de7-575d-a1ff-a083da5b7204"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Place the dough on a clean work surface and knead for about 5-10 minutes until the dough is elastic, smooth and shiny. Form the dough into a ball, cover with a damp cloth and set aside for at least half an hour.",
      "timer_seconds": 600
    },
    {
      "step_number": 3,
      "instruction": "Peel and wash the potatoes and boil them in salted water until soft. Drain off the water and mash thoroughly. Add the spring onions, salt and black pepper.",
      "ingredients_used": [
        "e650478b-7b22-5cc0-89d3-a8480461d652",
        "f36d6422-4de7-575d-a1ff-a083da5b7204",
        "05c7c530-0fb8-5177-a707-ab547cab1e50",
        "5ff4d421-c4a5-5864-8e51-54a4bb6fb741",
        "9d2bf402-94e2-58b0-8edc-c200db03cc8b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Divide the dough into 3 or 4 balls. Roll out each ball as thinly as possible on a lightly floured surface (the thickness should be no more than 1.5mm - if the dough is too thick the Bolani will be tough)"
    },
    {
      "step_number": 5,
      "instruction": "Take a round cutter of 13-15cm (I often use a pan lid or tid lid), and cut as many rounds as possible. On each round spread 1-2 tablespoons of the mashed potato. Moisten the edges of the dough, fold over and seal shut."
    },
    {
      "step_number": 6,
      "instruction": "The Bolani should be spread out on a lightly floured surface until ready to fry. Heat enough vegetable oil in a frying-pan and shallow fry one or two Bolani at a time, browning on both sides.",
      "ingredients_used": [
        "da40d60d-e500-5932-835d-386c67db2965"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Make sure to keep the fried Bolani warm until all are finished, and serve straight away."
    }
  ],
