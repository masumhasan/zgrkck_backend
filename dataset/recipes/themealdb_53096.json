  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Sauté the onions:",
      "ingredients_used": [
        "61e086a3-e2ad-59be-8ef8-134c95b2a5aa"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat butter in a large skillet (preferably cast iron) on medium heat. Add the onion and cook a few minutes, until translucent.",
      "ingredients_used": [
        "62457d44-13bc-5104-ae55-637fd392d635",
        "61e086a3-e2ad-59be-8ef8-134c95b2a5aa"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the potatoes and corned beef:",
      "ingredients_used": [
        "da857186-2ae3-5f7a-b9d8-b5928ac7a9e0",
        "288577ae-e508-5341-bd61-5b2597366e83"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Mix in the chopped corned beef and potatoes. Spread out evenly over the pan. Increase the heat to high or medium high and press down on the mixture with a metal spatula.",
      "ingredients_used": [
        "da857186-2ae3-5f7a-b9d8-b5928ac7a9e0",
        "288577ae-e508-5341-bd61-5b2597366e83"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Cook until browned and then flip:"
    },
    {
      "step_number": 6,
      "instruction": "Do not stir the potatoes and corned beef, but let them brown. If you hear them sizzling, this is good.",
      "ingredients_used": [
        "da857186-2ae3-5f7a-b9d8-b5928ac7a9e0",
        "288577ae-e508-5341-bd61-5b2597366e83"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Use a metal spatula to peek underneath and see if they are browning. If nicely browned, use the spatula to flip sections over in the pan so that they brown on the other side. Press down again with the spatula."
    },
    {
      "step_number": 8,
      "instruction": "If there is too much sticking, you can add a little more butter to the pan. Continue to cook in this manner until the potatoes and the corned beef are nicely browned.",
      "ingredients_used": [
        "62457d44-13bc-5104-ae55-637fd392d635",
        "da857186-2ae3-5f7a-b9d8-b5928ac7a9e0",
        "288577ae-e508-5341-bd61-5b2597366e83"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Stir in the parsley and season:",
      "ingredients_used": [
        "c3649491-6132-5815-b26b-7bd4b90377ff"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Remove from heat, stir in chopped parsley. Add plenty of freshly ground black pepper, and add salt to taste.",
      "ingredients_used": [
        "317f39e0-0442-5f6d-bd1a-47c9936468c8",
        "2ab7a1e0-6011-5ae0-b444-0df265d27f8d",
        "c3649491-6132-5815-b26b-7bd4b90377ff"
      ]
    }
  ],
