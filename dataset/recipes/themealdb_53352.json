  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Instructions"
    },
    {
      "step_number": 2,
      "instruction": "Set Instant Pot to \"Sauté.\" Once Hot, add olive oil. Then add yellow onion and stir until softened, about 3 minutes. Add garlic and green onions and stir for about 30 more seconds.",
      "timer_seconds": 180,
      "ingredients_used": [
        "63bd29d7-5d72-5ccc-955e-15a9e824e804",
        "217c5707-4890-5bad-8eb3-3690db81253f",
        "e7b412cd-4069-5e5f-878e-f624e893a4c3",
        "0913111b-7385-54d5-9531-80eea3d5ca3c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Press “Cancel” on the Instant Pot. Add rice, coconut milk, water, salt, allspice, and black pepper and stir.",
      "ingredients_used": [
        "d157be5a-2526-56c4-a6dd-9310079120e5",
        "fef00e72-c533-5c53-9e72-447f1a68e51a",
        "fcbb5f25-c253-5874-80e6-aa8729bc83c3",
        "cc2059c7-6bfd-5e02-80a7-5ec867696a01",
        "0112b36c-269a-5bb5-944d-38090239f2d6",
        "46b07827-c692-50a9-8536-cfdcee02ad63"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Pour undrained kidney beans on top of the rice mixture. Do not stir. Lay sprigs of thyme on top. Cover the Instant Pot, ensuring the valve is set to “Sealing.”",
      "ingredients_used": [
        "d157be5a-2526-56c4-a6dd-9310079120e5",
        "ad57fb8d-70ad-57c9-bd73-6ff16507de05",
        "3f46eca1-c071-53fe-9019-4def4423f0fb"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Press “Manual” or “Pressure Cook” on the Instant Pot and set for High pressure for 6 minutes.",
      "timer_seconds": 360
    },
    {
      "step_number": 6,
      "instruction": "Once the pressure cooking time is done, allow it to natural release for 10 minutes, then quick release any remaining pressure by moving valve to \"Venting\"",
      "timer_seconds": 600
    },
    {
      "step_number": 7,
      "instruction": "Open lid and remove thyme sprigs. Fluff rice with fork and Enjoy!",
      "ingredients_used": [
        "d157be5a-2526-56c4-a6dd-9310079120e5",
        "3f46eca1-c071-53fe-9019-4def4423f0fb"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Stove Top Instructions"
    },
    {
      "step_number": 9,
      "instruction": "Heat olive oil in a large pot over medium heat. Add yellow onion and stir until softened, about 3 minutes. Add garlic and green onions and stir for about 30 more seconds.",
      "timer_seconds": 180,
      "ingredients_used": [
        "63bd29d7-5d72-5ccc-955e-15a9e824e804",
        "217c5707-4890-5bad-8eb3-3690db81253f",
        "e7b412cd-4069-5e5f-878e-f624e893a4c3",
        "0913111b-7385-54d5-9531-80eea3d5ca3c"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Add rice, undrained kidney beans, coconut milk, water, salt, allspice, and black pepper and stir until combined. Lay thyme on top. Bring mixture to a simmer.",
      "ingredients_used": [
        "d157be5a-2526-56c4-a6dd-9310079120e5",
        "fef00e72-c533-5c53-9e72-447f1a68e51a",
        "fcbb5f25-c253-5874-80e6-aa8729bc83c3",
        "cc2059c7-6bfd-5e02-80a7-5ec867696a01",
        "0112b36c-269a-5bb5-944d-38090239f2d6",
        "46b07827-c692-50a9-8536-cfdcee02ad63",
        "ad57fb8d-70ad-57c9-bd73-6ff16507de05",
        "3f46eca1-c071-53fe-9019-4def4423f0fb"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Cover with a lid and reduce heat to low. Allow to cook for 18 minutes over low heat, then remove from heat. Leave the lid on for an additional 5 minutes."
    },
    {
      "step_number": 12,
      "instruction": "Open the lid and remove the thyme. Fluff rice with fork. Enjoy.",
      "ingredients_used": [
        "d157be5a-2526-56c4-a6dd-9310079120e5",
        "3f46eca1-c071-53fe-9019-4def4423f0fb"
      ]
    }
  ],
