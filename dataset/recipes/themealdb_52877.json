  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Dust the meat with flour to lightly coat.",
      "ingredients_used": [
        "52bfc3fc-4195-5e02-a773-e109ba6200dc"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat enough vegetable oil in a large saucepan to fill the base, and fry the onion and meat until lightly browned. Season with salt and pepper.",
      "ingredients_used": [
        "1caef155-6c07-5907-afe1-43423cb86c09",
        "6d27d572-a199-5bcc-a075-49642eff7650"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the carrots, stock and more seasoning to taste.",
      "ingredients_used": [
        "7b8089eb-0004-5a56-ad39-78201eea6a64"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Bring to the boil, cover and reduce the heat to a simmer. Simmer for at least an hour or until the meat is tender. Take your time cooking the meat, the longer you leave it to cook, the better the flavor will be."
    },
    {
      "step_number": 5,
      "instruction": "Preheat the oven to 180C/350F/Gas 4.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 6,
      "instruction": "Add the drained potato cubes to the lamb."
    },
    {
      "step_number": 7,
      "instruction": "Turn the mixture into a pie dish or casserole and cover with the shortcrust pastry. Make three slits in the top of the pastry to release any steam while cooking.",
      "ingredients_used": [
        "18f7a69f-4adf-531d-a5c9-e991cbf94b38"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Brush with beaten egg and bake for about 40 minutes, until the pastry is golden brown.",
      "timer_seconds": 2400,
      "ingredients_used": [
        "18f7a69f-4adf-531d-a5c9-e991cbf94b38"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Serve."
    }
  ],
