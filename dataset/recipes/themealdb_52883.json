  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 180C/160C Fan/Gas 4. Butter a wide shallow 1.7-liter/3-pint ovenproof dish.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
      "ingredients_used": [
        "f82a2f13-9ff3-5163-ae07-9c6b34c613d2",
        "cfaad2e5-d7e3-57a7-80d8-2dbd7235be90"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Put the butter, sugar, eggs, flour, baking powder, bicarbonate of soda and treacle into a mixing bowl. Beat using an electric handheld whisk for about 30 seconds or until combined. Pour in the milk gradually and whisk again until smooth. Pour into the prepared dish. Bake for 35–40 minutes or until well risen and springy in the center.",
      "ingredients_used": [
        "f82a2f13-9ff3-5163-ae07-9c6b34c613d2",
        "f0c66e09-ab2a-501d-a000-ac5ddcd48764",
        "30e32a45-a546-5d5c-9d06-f4ca9e1f8b7d",
        "1d3e1dc5-8127-53f3-828c-57c20f6bcb6a",
        "a5640cb2-ad8a-5ddb-b527-28aeef5323d9",
        "8d79afc5-6a5d-5e11-8f42-672cecc39a2e",
        "cfaad2e5-d7e3-57a7-80d8-2dbd7235be90",
        "61c21077-a349-571a-95a6-3482b97de948"
      ]
    },
    {
      "step_number": 3,
      "instruction": "To make the sauce, put all the ingredients into a saucepan and stir over a low heat until the sugar has dissolved and the butter has melted. Bring to the boil, stirring for a minute.",
      "ingredients_used": [
        "f82a2f13-9ff3-5163-ae07-9c6b34c613d2",
        "cfaad2e5-d7e3-57a7-80d8-2dbd7235be90"
      ]
    },
    {
      "step_number": 4,
      "instruction": "To serve, pour half the sauce over the pudding in the baking dish. Serve with the cream or ice cream."
    }
  ],
