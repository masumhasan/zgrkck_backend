  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 150C/300F/Gas 2.",
      "temperature": {
        "value": 150,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Toss the beef and flour together in a bowl with some salt and black pepper.",
      "ingredients_used": [
        "8d771af3-a09f-5884-8cce-1dbfbeaa99eb",
        "eb6c6b59-2bfd-5065-805b-e675370255fb",
        "3d41aef4-245c-5dfa-ae03-09f1035aa9ca"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat a large casserole until hot, add half of the rapeseed oil and enough of the beef to just cover the bottom of the casserole.",
      "ingredients_used": [
        "8d771af3-a09f-5884-8cce-1dbfbeaa99eb",
        "b0596c7a-c21a-5627-b8ee-46dcd6576a35"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Fry until browned on each side, then remove and set aside. Repeat with the remaining oil and beef.",
      "ingredients_used": [
        "8d771af3-a09f-5884-8cce-1dbfbeaa99eb"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Return the beef to the pan, add the wine and cook until the volume of liquid has reduced by half, then add the stock, onion, carrots, thyme and mustard, and season well with salt and pepper.",
      "ingredients_used": [
        "8d771af3-a09f-5884-8cce-1dbfbeaa99eb",
        "b7b5c3d7-d358-5cb0-918d-47d33406f1a8",
        "25b69a5f-d98e-5e0e-a185-4fa535776d24",
        "adb68ec0-2736-529a-8d4f-76daab6663d0",
        "48a9c1f2-c5d7-50e8-ad00-9ddd9f1d6145",
        "36c33f9d-7e6b-5c2d-9a55-209e2253e9c3",
        "eb6c6b59-2bfd-5065-805b-e675370255fb",
        "3d41aef4-245c-5dfa-ae03-09f1035aa9ca"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Cover with a lid and place in the oven for two hours."
    },
    {
      "step_number": 7,
      "instruction": "Remove from the oven, check the seasoning and set aside to cool. Remove the thyme.",
      "ingredients_used": [
        "48a9c1f2-c5d7-50e8-ad00-9ddd9f1d6145"
      ]
    },
    {
      "step_number": 8,
      "instruction": "When the beef is cool and you're ready to assemble the pie, preheat the oven to 200C/400F/Gas 6.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "8d771af3-a09f-5884-8cce-1dbfbeaa99eb"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Transfer the beef to a pie dish, brush the rim with the beaten egg yolks and lay the pastry over the top. Brush the top of the pastry with more beaten egg.",
      "ingredients_used": [
        "8d771af3-a09f-5884-8cce-1dbfbeaa99eb",
        "a55ae870-b283-5083-accd-d61e4415d4bc",
        "df1efbcd-185d-5605-9f24-e6460d86fa70"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Trim the pastry so there is just enough excess to crimp the edges, then place in the oven and bake for 30 minutes, or until the pastry is golden-brown and cooked through.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "df1efbcd-185d-5605-9f24-e6460d86fa70"
      ]
    },
    {
      "step_number": 11,
      "instruction": "For the green beans, bring a saucepan of salted water to the boil, add the beans and cook for 4-5 minutes, or until just tender.",
      "timer_seconds": 300,
      "ingredients_used": [
        "10637df9-920d-58ea-9bf2-ba975fa4cfd3",
        "eb6c6b59-2bfd-5065-805b-e675370255fb"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Drain and toss with the butter, then season with black pepper.",
      "ingredients_used": [
        "eeace0cb-07a6-51cb-9a0d-1a72a576aa18",
        "3d41aef4-245c-5dfa-ae03-09f1035aa9ca"
      ]
    },
    {
      "step_number": 13,
      "instruction": "To serve, place a large spoonful of pie onto each plate with some green beans alongside.",
      "ingredients_used": [
        "10637df9-920d-58ea-9bf2-ba975fa4cfd3"
      ]
    }
  ],
