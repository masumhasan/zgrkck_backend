  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Rinse lobster under cold running water. Bring water and salt to boil in a 12 quart pot. Quickly plunge lobsters, headfirst, into boiling water. Cover and boil for 20 minutes or until lobsters turn red.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "82654387-ff48-55bd-b2f5-4dc7e4f380b7",
        "b6ae9d27-e585-5e57-892c-d2acc806bf2c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Remove lobster and allow it to cool. Remove lobster tails and cut shell down to middle to remove the meat. Cut the tail meat down the middle to remove the vein inside. Remove large claws and smaller legs by twisting them away from the body. A nut cracker can be used to crush the claw and legs to remove the meat inside.",
      "ingredients_used": [
        "82654387-ff48-55bd-b2f5-4dc7e4f380b7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Chop lobster meat. Heat butter or olive oil in large pan over low heat. Sauté red, green and scotch bonnet peppers, thyme and garlic. Add salt and chicken stock to pan. Then, add lobster meat and sauté for 10 to 15 minutes. Thicken sauce with the corn starch and water mixture.",
      "timer_seconds": 900,
      "ingredients_used": [
        "82654387-ff48-55bd-b2f5-4dc7e4f380b7",
        "a4a9e17b-a3fd-50ab-a057-e37599315b20",
        "825e13f4-caf5-5c36-8eb7-30dcb05c0680",
        "ad47d790-8e75-56b9-a60f-3977056f15b2",
        "b6ae9d27-e585-5e57-892c-d2acc806bf2c",
        "c452bd8b-6004-5dff-8b52-26a587ca56da",
        "e40a20b6-63f0-541a-b845-a59a689bbc88"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Serve with your choice of vegetables, salad and/or rice."
    }
  ],
