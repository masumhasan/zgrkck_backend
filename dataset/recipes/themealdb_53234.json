  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Pour the stock into a large pan, bring to the boil, then stir in the curry paste. Add the noodles and cook for 8 mins. Tip in the mushrooms and corn and cook for 2 mins more.",
      "ingredients_used": [
        "c0ccf2c3-f0ff-5061-aa97-805c0b53a71b",
        "32d76e64-5dcc-5e48-822e-65fd985e6de2"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the salmon to the pan and cook for 3 mins or until cooked through. Remove from the heat and stir in the lime juice, soy sauce and a pinch of sugar. Ladle into 4 bowls and sprinkle over the coriander just before you serve.",
      "timer_seconds": 180,
