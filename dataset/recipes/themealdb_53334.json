  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare the meat in a skillet and add salt and pepper to taste, heat the beans over medium heat in a pan, fry or grill the ripe plantains as indicated on its package and cut the tomato into small cubes. Reserve these ingredients until filling.",
      "ingredients_used": [
        "4429ea7b-383a-5166-a5c2-9e6ca1ac39ca",
        "a4e2a614-2d12-5256-b8b5-047d2de12e2d",
        "0ecbe843-1ae7-5ef6-91a8-aefb41a123af",
        "2fe63842-dcf4-53af-8f0b-9bec3dd61719",
        "71a18e9d-93f4-51eb-862c-3375a2956063"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Preheat the grill or pan and grill the arepa, putting it once on each side until they are golden brown."
    },
    {
      "step_number": 3,
      "instruction": "With the help of a knife, open it by the edge through the middle, creating a space to fill it with the ripe plantain, the beans, meat and chopped tomato.",
      "ingredients_used": [
        "4429ea7b-383a-5166-a5c2-9e6ca1ac39ca",
        "a4e2a614-2d12-5256-b8b5-047d2de12e2d",
        "0ecbe843-1ae7-5ef6-91a8-aefb41a123af"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Serve with a little pico de gallo or guacamole dip sauce."
    }
  ],
