  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Whizz the almonds in a food processor until most are finely chopped, then tip into a large bowl. Roughly chop the figs, then whizz to a smooth sticky paste. Scrape onto the almonds then, using your hands, mix together well with the dried fruit, brandy, honey and cloves.",
      "ingredients_used": [
        "36071de7-9e1b-5332-b28b-1b127e858bab",
        "312b7236-2b15-57bf-aec6-56e53471ae03",
        "bf5b75b7-c766-5486-b16a-54801186e8cd",
        "c8573bbe-d452-5ebc-b640-206059adf378",
        "97dd2707-0289-53b6-ad11-b690b9e99a26"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Divide the mixture into 6 and roll into balls. Tip the sesame seeds onto a tray, then roll the balls in them until covered. Cover the tray loosely with a clean tea towel, then leave the fig balls to dry for a week before packaging. Will keep in a cool place for 2 months.",
      "ingredients_used": [
        "1ee5875e-edd8-5767-94ca-ebf7b1b5edb1"
      ]
    }
  ],
