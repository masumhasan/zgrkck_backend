        "37fbe0d6-4c12-5d66-a6fe-c09fccee7ffb",
        "f8c33f20-1e94-5047-92ef-fd58cf26d81d",
        "d145f966-96ac-5b83-96c0-dc7759f7f91a"
      ]
    },
    {
      "step_number": 7,
      "instruction": "A braiser with cooked ground beef, carrots, onions, peppers, garlic and seasoning.",
      "ingredients_used": [
        "18874e06-dc76-57a3-bfc7-f44d50e4d85b",
        "532d1ba0-81d4-5b73-8e2d-1aa1028d8f23",
        "186de1f0-bb90-5571-996d-2ff27dc7fb6b",
        "99a6cbf5-e475-5e49-85f3-7e526acd6fd4"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add Cabbage and Liquid:",
      "ingredients_used": [
        "19030988-d25d-5c50-bb41-6d001da293e8"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Add the chopped cabbage, apple cider vinegar or lemon juice (if using), and water. Stir well to combine. Reduce the heat to medium-low, cover, and cook for 30 minutes. Stir occasionally to prevent the cabbage from sticking to the bottom of the pan.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "19030988-d25d-5c50-bb41-6d001da293e8",
        "44d58d74-4992-56d7-8a68-1abb599bd648",
        "6c39162f-cb21-535a-90db-9bb88bf6785c"
      ]
    },
    {
      "step_number": 10,
      "instruction": "A pot with cooked ground beef, vegetables and cabbage on a stove top",
      "ingredients_used": [
        "18874e06-dc76-57a3-bfc7-f44d50e4d85b",
        "19030988-d25d-5c50-bb41-6d001da293e8"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Check for Doneness:"
    },
    {
      "step_number": 12,
      "instruction": "Uncover and check the texture of the cabbage. If necessary, increase the heat to medium-high and cook for an additional 5–7 minutes to evaporate excess liquid and finish cooking.",
