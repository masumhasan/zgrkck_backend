  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat a large skillet or braiser over medium heat on the stovetop. Add the olive oil.",
      "ingredients_used": [
        "ef2d1364-7ca8-5873-a726-51c9c4990c34"
      ]
    },
    {
      "step_number": 2,
      "instruction": "A braiser with cooked ground beef",
      "ingredients_used": [
        "18874e06-dc76-57a3-bfc7-f44d50e4d85b"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cook the Meat:"
    },
    {
      "step_number": 4,
      "instruction": "Add the ground meat to the pan. Use a potato masher or wooden spoon to break it into small pieces. Cook for 3–4 minutes until browned.",
      "timer_seconds": 240
    },
    {
      "step_number": 5,
      "instruction": "Add Vegetables and Seasoning:"
    },
    {
      "step_number": 6,
      "instruction": "Stir in the onion, carrots, red pepper, garlic, and tomato paste. Season with salt, black pepper, smoked paprika, ground cumin, and Italian seasoning (if using). Cook for 2–3 minutes, stirring frequently.",
      "timer_seconds": 180,
      "ingredients_used": [
        "532d1ba0-81d4-5b73-8e2d-1aa1028d8f23",
        "186de1f0-bb90-5571-996d-2ff27dc7fb6b",
