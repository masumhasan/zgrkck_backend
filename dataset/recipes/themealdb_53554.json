  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Scrub the potatoes clean and place in a small saucepan with water and 1 tablespoon of salt. Bring to a boil and simmer the potatoes for about 10 minutes. Turn off the heat and let the potatoes stand in the water for 5 minutes. Drain the potatoes and allow to cool slightly. Remember that potatoes come in various sizes, so the cooking time may vary – if they do not easily glide off of a fork when speared and lifted out of the water, they are not done yet.",
      "ingredients_used": [
        "5a0721b0-93d7-5b72-b9fb-ed2f37e776d3",
        "52b55855-35be-577b-af17-36eda4c098a2"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Fry bacon slices and transfer to a dish lined with paper towels.",
      "ingredients_used": [
        "7252d5b6-cab8-5f32-90ed-9ee3b111e63b"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Peel the red onion and slice in thin rings."
    },
    {
      "step_number": 4,
      "instruction": "Transfer the flour to a bowl and toss the onions in the flour. Remove onions and shake off excess flour.",
      "ingredients_used": [
        "f73b0e83-a78d-5c22-a748-50fe75304b2e"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Heat the oil in a saucepan over medium heat. You can test whether the oil is hot enough by adding a small piece of onion to the saucepan. If the oil bubbles around the onion, the oil is ready."
    },
    {
      "step_number": 6,
      "instruction": "Transfer as many onion rings to the saucepan as can fit in one layer. Do not add too many onion rings at once."
    },
    {
      "step_number": 7,
      "instruction": "Fry the onions for a couple of minutes until they are golden brown. Transfer onions to a dish lined with paper towels and sprinkle with salt. Repeat the process until all onions are fried.",
      "ingredients_used": [
        "f73b0e83-a78d-5c22-a748-50fe75304b2e",
        "52b55855-35be-577b-af17-36eda4c098a2"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Butter a slice of dark rye bread and arrange round potato slices (or, if the potatoes are very small, halved potatoes) on top. Top your open potato sandwich with a good mayonnaise, crispy fried onions, fried bacon and sliced chives.",
      "ingredients_used": [
        "5a0721b0-93d7-5b72-b9fb-ed2f37e776d3",
        "7252d5b6-cab8-5f32-90ed-9ee3b111e63b",
        "1b3e1547-71fe-52bf-851c-4fd3f630f045",
        "5b87cf00-9118-54b4-8f32-238fa3587323",
        "d6b89a81-0d03-5d13-972f-c776e0bfe15b",
        "f73b0e83-a78d-5c22-a748-50fe75304b2e"
      ]
    }
  ],
