  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a medium bowl, whisk together the soy sauce and honey to create a marinade.",
      "ingredients_used": [
        "3f10b037-2ee5-551c-b987-80078892f2da",
        "765a4115-8980-5563-abbb-bac01de63151"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the chicken thigh strips to the marinade, ensuring each piece is fully coated, and let it sit for 20 minutes at room temperature.",
      "timer_seconds": 1200
    },
    {
      "step_number": 3,
      "instruction": "While the chicken marinates, combine the julienned carrots, daikon radish, rice vinegar, and granulated sugar in a separate bowl, stirring until the sugar dissolves to pickle the vegetables.",
      "ingredients_used": [
        "4122ce29-0054-548b-9ed7-173e353952ee",
        "5c2dc3e2-c7e6-5eed-9f12-25a1c20e17e9",
        "6a661819-90c1-5b04-a1bc-f497ab60c90c",
        "f5217c7c-e8d6-503d-b8d1-7772fa6900e6"
      ]
    },
    {
      "step_number": 4,
      "instruction": "In a small bowl, mix the mayonnaise and sriracha sauce thoroughly to make a spicy aioli.",
      "ingredients_used": [
        "589353e9-a585-532d-b022-8fcee4ef5f34",
        "58359fde-e54b-5f2c-8986-3130b26b1b3a"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Heat the vegetable oil in a large skillet or wok over medium-high heat until it shimmers, about 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "08d23830-d2bb-57f0-a543-cccd5ee32db0"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add the marinated chicken strips to the hot skillet in a single layer, cooking for 4-5 minutes per side until they reach an internal temperature of 165°F and develop a golden-brown crust.",
      "timer_seconds": 300,
      "temperature": {
        "value": 165,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 7,
      "instruction": "While the chicken cooks, lightly toast the split baguettes in a toaster oven or under a broiler for 2-3 minutes until just crisp on the edges.",
      "timer_seconds": 180,
      "ingredients_used": [
        "355cdb7c-fca8-5875-a379-b0638bcd996e"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Spread a generous layer of the spicy aioli on the inside of each toasted baguette.",
      "ingredients_used": [
        "355cdb7c-fca8-5875-a379-b0638bcd996e"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Drain the pickled carrots and daikon radish from their liquid, then layer them onto the bottom half of each baguette.",
      "ingredients_used": [
        "355cdb7c-fca8-5875-a379-b0638bcd996e",
        "4122ce29-0054-548b-9ed7-173e353952ee",
        "5c2dc3e2-c7e6-5eed-9f12-25a1c20e17e9"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Place the cooked chicken strips evenly over the pickled vegetables in each sandwich."
    },
    {
      "step_number": 11,
      "instruction": "Top the chicken with fresh cilantro leaves and thinly sliced cucumber.",
      "ingredients_used": [
        "82cfd00e-0aad-5517-932d-080fed7aba0b",
        "2a207880-f184-5786-a57d-ef5f06050124"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Close the sandwiches by pressing the top half of each baguette down gently.",
      "ingredients_used": [
        "355cdb7c-fca8-5875-a379-b0638bcd996e"
      ]
    }
  ],
