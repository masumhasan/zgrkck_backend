  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Combine the sake or rice wine, soy sauce, sesame oil and cornflour dissolved in water. Divide mixture in half.",
      "ingredients_used": [
        "0f9503e0-5965-5d69-a827-5a6940194380",
        "e4ae18b4-7700-5a83-bb66-062ba63a1a79",
        "320e6a52-84da-5a07-885e-c2fad2af0daf"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a glass dish or bowl, combine half of the sake mixture with the chicken pieces and toss to coat. Cover dish and place in refrigerator for about 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "0f9503e0-5965-5d69-a827-5a6940194380",
        "9372aa55-83f4-5fb3-b7e3-d84ef65802a9"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In a medium frying pan, combine remaining sake mixture, chillies, vinegar and sugar. Mix together and add spring onion, garlic, water chestnuts and peanuts. Heat sauce slowly over medium heat until aromatic.",
      "ingredients_used": [
        "0f9503e0-5965-5d69-a827-5a6940194380",
        "320e6a52-84da-5a07-885e-c2fad2af0daf",
        "02af8b6d-205c-58f7-87c5-ba2fd8e485b7",
        "8347696b-2247-5235-87bb-dbd08c9a160a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Meanwhile, remove chicken from marinade and sauté in a large frying pan until juices run clear. When sauce is aromatic, add sautéed chicken and let simmer together until sauce thickens.",
      "ingredients_used": [
        "9372aa55-83f4-5fb3-b7e3-d84ef65802a9"
      ]
    }
  ],
