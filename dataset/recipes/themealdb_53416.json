  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Bring salted water to boil in a large pot.",
      "ingredients_used": [
        "acb0a9fa-adcc-5394-a45c-331a28db85c7"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add in the cabbage and potatoes, cook until tender about 30-40 minutes",
      "timer_seconds": 2400,
      "ingredients_used": [
        "2e0f62c4-9bc8-545a-adf6-98bf77b0492c",
        "31518a9e-ea97-5c89-a1b4-4e6845c3569c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "When tender, drain, very well."
    },
    {
      "step_number": 4,
      "instruction": "Return the vegetables to the pot and turn on the burner to low. Let steam"
    },
    {
      "step_number": 5,
      "instruction": "Meanwhile cook up the bacon, reserving the fat for frying the hash.",
      "ingredients_used": [
        "48965a69-6dcd-5d93-b433-fe0889cf2960"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Chop up the bacon, into small pieces.",
      "ingredients_used": [
        "48965a69-6dcd-5d93-b433-fe0889cf2960"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Mash the potatoes and cabbage with a potato masher and add in the minced garlic.",
      "ingredients_used": [
        "2e0f62c4-9bc8-545a-adf6-98bf77b0492c",
        "31518a9e-ea97-5c89-a1b4-4e6845c3569c",
        "056d5534-df12-554a-b8b1-351a2d603f34"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add in salt and pepper to taste.",
      "ingredients_used": [
        "acb0a9fa-adcc-5394-a45c-331a28db85c7",
        "dba41d9c-0891-534b-8b03-8328afa9ce31"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Using a form for individual servings, press the hash mixture into the form with bacon on top, fry in the reserved bacon fat until golden brown, flip over and repeat on the other side.",
      "ingredients_used": [
        "48965a69-6dcd-5d93-b433-fe0889cf2960"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Remove form and garnish with chopped parsley.",
      "ingredients_used": [
        "aeb152db-c146-580b-879a-9e2fc3fd62ba"
      ]
    },
    {
      "step_number": 11,
      "instruction": "If you want to make one big hash, just use a skillet, pressing the hash into the skillet with the bacon pieces and reserved fat, then flip over once golden brown. Cut into servings.",
      "ingredients_used": [
        "48965a69-6dcd-5d93-b433-fe0889cf2960"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Garnish with chopped parsley.",
      "ingredients_used": [
        "aeb152db-c146-580b-879a-9e2fc3fd62ba"
      ]
    }
  ],
