  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "First make the tomato sauce. Heat the oil in a large pan and fry the garlic for 1 min. Add the sugar, vinegar, tomatoes and some seasoning and simmer for 20 mins, stirring occasionally, until thick. Add the basil and divide the sauce between 2 or more shallow ovenproof dishes (see Tips for freezing, below). Set aside. Make a sauce by beating the mascarpone with the milk until smooth, season, then set aside.",
      "ingredients_used": [
        "094ee04d-978d-580d-95ea-1dbf590e2102",
        "15b05045-9d9c-5b91-819e-12e05d199ae8",
        "6a25ca5f-84a4-5941-a916-613c3fddda4e",
        "db27680a-235b-5cf4-942a-39e4c19dfb5a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Put the spinach in a large colander and pour over a kettle of boiling water to wilt it (you may need to do this in batches). When cool enough to handle squeeze out the excess water. Roughly chop the spinach and mix in a large bowl with 100g Parmesan and ricotta. Season well with salt, pepper and the nutmeg.",
      "ingredients_used": [
        "e7013427-f707-5e43-ac41-0abc8b1b6f0f",
        "77d253aa-3900-5cea-be3e-ee3a54a7edde",
        "3f93c4d9-8090-59fc-8d9f-4bbc62937a4c",
        "4493aaf0-7348-520d-ac93-f3933880ae88",
        "d12d08f9-3e22-57b0-b18d-dc8852644017"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat oven to 200C/180C fan/gas 6. Using a piping bag or plastic food bag with the corner snipped off, squeeze the filling into the cannelloni tubes. Lay the tubes, side by side, on top of the tomato sauce and spoon over the mascarpone sauce. Top with Parmesan and mozzarella. You can now freeze the cannelloni, uncooked, or you can cook it first and then freeze. Bake for 30-35 mins until golden and bubbling. Remove from oven and let stand for 5 mins before serving.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "6a25ca5f-84a4-5941-a916-613c3fddda4e",
