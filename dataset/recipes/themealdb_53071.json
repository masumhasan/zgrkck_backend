  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Combine beef, crushed peppercorn, soy sauce, vinegar, dried bay leaves, lemon, and tomato sauce. Mix well. Marinate beef for at least 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "bb22f7c2-8b53-503b-862b-2ec9f384c498",
        "bb5639d6-16d3-5409-9ce4-e293ed46db1f",
        "868287b1-a048-5022-a871-61f1bfd63a19",
        "9ccfda9e-0186-5764-8b78-03f5629a68e2"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Put the marinated beef in a cooking pot along with remaining marinade. Add water. Let boil.",
      "ingredients_used": [
        "bb22f7c2-8b53-503b-862b-2ec9f384c498",
        "f74939f7-f5fd-5721-a8a4-189602f92a95"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add Knorr Beef Cube. Stir. Cover the pot and cook for 40 minutes in low heat.",
      "timer_seconds": 2400,
      "ingredients_used": [
        "bb22f7c2-8b53-503b-862b-2ec9f384c498"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Turn the beef over. Add tomato paste. Continue cooking until beef tenderizes. Set aside.",
      "ingredients_used": [
        "bb22f7c2-8b53-503b-862b-2ec9f384c498"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Heat oil in a pan. Fry the potato until it browns. Turn over and continue frying the opposite side. Remove from the pan and place on a clean plate. Do the same with the carrots."
    },
    {
      "step_number": 6,
      "instruction": "Save 3 tablespoons of cooking oil from the pan where the potato was fried. Saute onion and garlic until onion softens.",
      "ingredients_used": [
        "af9a573c-aefa-5ef9-883c-938d22fd2369",
        "e681bdac-054e-54d5-9772-3cfb20e864cf"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Pour-in the sauce from the beef stew. Let boil. Add the beef. Cook for 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "bb22f7c2-8b53-503b-862b-2ec9f384c498"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add butter and let it melt. Continue cooking until the sauce reduces to half.",
      "ingredients_used": [
        "ac777b9f-f1b1-5eaa-a4b4-0c7ea75b29d3"
      ]
    }
  ],
