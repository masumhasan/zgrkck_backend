  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Bring milk, sugar, and vanilla extract to a boil in a saucepan over high heat. Reduce heat to medium-low, continue cooking, and continuously stirring until milk has thickened and turned a caramel color, about 1 hour or more.",
