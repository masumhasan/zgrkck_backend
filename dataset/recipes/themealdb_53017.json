  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Sift flour and salt into a large mixing bowl.",
      "ingredients_used": [
        "b60d2b16-b532-5992-9bfe-2d291c5ad20d",
        "560081bd-acca-559f-8d3e-523c3edd5583",
        "32e74d64-f92b-5e26-aec9-fa13864be226"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Use a spoon to push the egg yolk through a fine sieve into the flour.",
      "ingredients_used": [
        "b60d2b16-b532-5992-9bfe-2d291c5ad20d",
        "5e2302fa-8ba5-5c9c-b0d8-d98806108ce8",
        "860181ea-f1e1-55f5-9800-314ae7ea1c44"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the raw egg and mix well.",
      "ingredients_used": [
        "5e2302fa-8ba5-5c9c-b0d8-d98806108ce8",
        "860181ea-f1e1-55f5-9800-314ae7ea1c44"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Beat in butter 1 tablespoon at a time.",
      "ingredients_used": [
        "f6b37254-7f2f-5cde-86d4-1760fa4c7ec5",
        "5334f8ca-cc1b-580e-b50d-28b7111f24ff"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Place dough on a floured surface and knead until smooth and elastic, then wrap in waxed paper and refrigerate until firm (at least 30 minutes).",
      "timer_seconds": 1800
    },
    {
      "step_number": 6,
      "instruction": "In a heavy skillet, melt 2 tablespoons butter over medium heat; saute the onion and rutabaga until the onion is soft and transparent (5 minutes).",
      "timer_seconds": 300,
      "ingredients_used": [
        "f6b37254-7f2f-5cde-86d4-1760fa4c7ec5",
        "5334f8ca-cc1b-580e-b50d-28b7111f24ff",
        "34f685c4-5b20-594f-b031-d56a1ac7fd61"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Put the onions, rutabaga, and beef through a meat grinder twice if you have one, if not just chop them up as fine as possible.",
      "ingredients_used": [
        "34f685c4-5b20-594f-b031-d56a1ac7fd61"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Melt the remaining 4 tablespoons butter over medium heat, and add the meat mixture.",
      "ingredients_used": [
        "f6b37254-7f2f-5cde-86d4-1760fa4c7ec5",
        "5334f8ca-cc1b-580e-b50d-28b7111f24ff"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Cook over low heat, stirring occasionally, until all of the liquid has evaporated and the mixture is thick enough to hold its shape."
    },
    {
      "step_number": 10,
      "instruction": "Remove from heat and let cool, then stir in 1 egg, and season with salt and pepper.",
      "ingredients_used": [
        "560081bd-acca-559f-8d3e-523c3edd5583",
        "5e2302fa-8ba5-5c9c-b0d8-d98806108ce8",
        "860181ea-f1e1-55f5-9800-314ae7ea1c44",
        "32e74d64-f92b-5e26-aec9-fa13864be226",
        "05b730f1-8406-551b-acbf-9dee11d0739e"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Preheat oven to 350°F.",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 12,
      "instruction": "On a lightly floured surface, roll the dough out into a 13x8\" rectangle (1/8\" thick)."
    },
    {
      "step_number": 13,
      "instruction": "Spoon the filling down the center of the rectangle lengthwise, leaving about an inch of space on each end."
    },
    {
      "step_number": 14,
      "instruction": "Lightly brush the long sides with cold water, then fold one of the long sides over the filling and the other side over the top of that."
    },
    {
      "step_number": 15,
      "instruction": "Brush the short ends with cold water and fold them over the top, enclosing the filling."
    },
    {
      "step_number": 16,
      "instruction": "Place pastry seam side down on a baking sheet and brush the top evenly with the remaining scrambled egg.",
      "ingredients_used": [
        "5e2302fa-8ba5-5c9c-b0d8-d98806108ce8",
        "860181ea-f1e1-55f5-9800-314ae7ea1c44"
      ]
    },
    {
      "step_number": 17,
      "instruction": "Bake in preheated oven until rich golden brown (30 minutes).",
      "timer_seconds": 1800
    },
    {
      "step_number": 18,
      "instruction": "Slice pastry diagonally into 1.5\" long pieces and serve as an appetizer or with soup."
    }
  ],
