  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the prawns in a bowl. Put the chilli, garlic, coriander stalks (snip these up using scissors first) and caster sugar in a spice grinder or small food processor and whizz together. Add half of the lime juice and the fish sauce, then pour this over the prawns.",
      "ingredients_used": [
        "6c071b79-bf0b-5438-ab07-ec70955c315c",
        "15b9d21e-07b4-566d-85e4-c98a3e54ec7a",
        "b386a093-a24d-50c2-89cc-ccc9925b98d6",
        "c171e77a-1f4d-574e-93d3-e70a2d3d9315",
        "2876fe86-f121-5e15-ac1a-57ecd82ecaf8",
        "b189e884-c8ab-5d75-8afc-161b659b9adf",
        "d3f45849-a157-55a6-9d2b-61137ace35c5",
        "475904bf-d71b-5415-88d7-d22f534d9277"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat 1 tbsp oil in a wok, add the ginger and spring onions and fry for 1 min. Add the red pepper and fry for 1 min, until the pepper starts to soften. Add the water chestnuts and bean sprouts, and toss together until the bean sprouts start to wilt. Add the soy sauce and a really good grind of black pepper, then tip the lot into a serving dish.",
      "ingredients_used": [
        "572662c4-9bd0-5038-bea6-62130c2346a8",
        "f8f17e87-807a-5fef-9e81-15972682d9ba",
        "bb368518-a839-5032-b1d0-69064c4869d6",
        "39262acb-fcd0-55de-8b1c-68bd951e0bb9",
        "8f8156cf-1165-5856-976a-2b95d34aa8ba",
        "c6cbc32c-c93f-5580-ba7c-7bcf536f176d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat the remaining oil in the wok and add the prawns, lifting them out of their juices. Toss for 1-2 mins until they turn pink, add the marinade and swirl the wok quickly, then tip the lot onto the veg. Snip over the coriander leaves and sprinkle on the remaining lime. Serves over noodles with extra lime for squeezing over.",
      "timer_seconds": 120,
      "ingredients_used": [
        "6c071b79-bf0b-5438-ab07-ec70955c315c",
        "c171e77a-1f4d-574e-93d3-e70a2d3d9315",
        "b189e884-c8ab-5d75-8afc-161b659b9adf",
