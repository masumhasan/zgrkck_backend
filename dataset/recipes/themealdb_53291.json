  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 300 degrees F (150 degrees C). Line a baking sheet with parchment paper. Spread almonds over the baking sheet.",
      "temperature": {
        "value": 300,
        "unit": "fahrenheit"
      },
      "ingredients_used": [
        "c27be3de-11f6-5f92-882e-3c9466316d5b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Bake in the preheated oven until almonds are fragrant and roasted, 20 to 25 minutes.",
      "timer_seconds": 1500,
      "ingredients_used": [
        "c27be3de-11f6-5f92-882e-3c9466316d5b"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Prepare pastry dough while almonds are roasting. Combine flour, 1/2 cup plus 1 tablespoon butter, and salt in a bowl and rub together until the mixture resembles breadcrumbs. Add egg, oil, and 1 1/2 tablespoons orange blossom water; knead everything into a smooth pastry dough. Add a little water, 1 teaspoon at a time, if dough is too dry. Shape pastry dough into a ball, wrap in plastic wrap, and set aside for 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "c27be3de-11f6-5f92-882e-3c9466316d5b",
        "0afb9dcb-4df5-5472-bfbd-ecda5f9a25a9",
        "358ca998-783b-517a-9a1f-633a84445958",
        "f489a09c-42fc-59d5-9a5b-8b115d072086",
        "20c097ca-cb5c-5bff-8bc3-2b3d3751b83f",
        "39859c2e-86ab-51bb-8258-00f9918a8127",
        "a0a514d8-934b-5b57-b4cb-8fc62d954760"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Remove almonds from oven and cool slightly, about 5 minutes. Place almonds in the bowl of a food processor; process until finely and evenly ground. Add 3/4 cup plus 1 tablespoon sugar, cinnamon, egg, and 1 tablespoon orange blossom water in that order to the food processor, pulsing after each addition until mixture is evenly combined and resembles a paste.",
      "timer_seconds": 300,
      "ingredients_used": [
        "c27be3de-11f6-5f92-882e-3c9466316d5b",
        "e1885a95-6955-59a4-bef5-9bbe52a8f734",
        "9e43befc-cb43-5d89-8339-da81e0d0d636",
        "9f668b07-58ab-5bcf-800c-ac581e348243",
        "0afb9dcb-4df5-5472-bfbd-ecda5f9a25a9",
        "358ca998-783b-517a-9a1f-633a84445958",
        "39859c2e-86ab-51bb-8258-00f9918a8127",
        "a0a514d8-934b-5b57-b4cb-8fc62d954760"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Remove small walnut-sized portions of filling with greased hands. Roll them into small logs with thin ends. Set aside."
    },
    {
      "step_number": 6,
      "instruction": "Preheat oven to 325 degrees F (165 degrees C). Line a baking sheet with parchment paper.",
      "temperature": {
        "value": 325,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 7,
      "instruction": "Roll out half of the pastry dough on a lightly floured surface until very thin. Place one of the almond paste logs on the edge of the pastry, fold pastry over the filling, covering it completely, and seal the edges. Mold with your fingers into a crescent shape. Using a pastry cutter, cut around the crescent, and transfer to the prepared baking sheet. Repeat with remaining dough and filling."
    },
    {
      "step_number": 8,
      "instruction": "Bake in the preheated oven until gazelle horns are lightly golden and baked through, about 20 minutes. They should not get too dark. Let cool slightly, about 3 minutes."
    },
    {
      "step_number": 9,
      "instruction": "Heat honey in a small saucepan over low-medium heat. Remove from heat and stir in 1 tablespoon orange blossom water. Dip gazelle horns into the honey and place on a serving plate. Sprinkle with crushed pistachios.",
      "ingredients_used": [
        "358ca998-783b-517a-9a1f-633a84445958",
        "a0a514d8-934b-5b57-b4cb-8fc62d954760",
        "7c3118f5-8f02-585c-91eb-5b6cf338d0a4"
      ]
    }
  ],
