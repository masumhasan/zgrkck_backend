  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "For the sandwich cookie cream the soft butter for about a minute, then add the sugar and cream for another two minutes. Incorporate the egg fully before mixing in the egg yolk. Once everything is nicely combined, add all remaining ingredients and mix one more time. Form dough into a ball and wrap in plastic wrap. Chill for at least half an hour or overnight.",
      "ingredients_used": [
        "e860f4a0-b446-5be6-9c7f-aa3270b76f96",
        "f1002000-5228-5fda-87bb-e92c03a95563",
        "d317aa18-08c3-533a-9951-3792cf086406"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Preheat oven to 180 degrees Celsius and line two baking sheets with parchment paper.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 3,
      "instruction": "Divide dough in half, put one back in the fridge and roll out the other thickly on a lightly floured surface. Cut out cookies with either the bottom of a glass or a cookie cutter around 6cm in diameter. Repeat with all the dough."
    },
    {
      "step_number": 4,
      "instruction": "Bake for about 8-10min, the cookies will look very pale. Let cool off before filling half with each a teaspoon of dulce de leche. Place other half of cookies on top and roll the sides of each cookie in the coconut flakes (it helps if the dulce de leche was pressed down to the sides of the cookie). Enjoy.",
      "timer_seconds": 600,
      "ingredients_used": [
        "1fa6e99b-2752-504b-b6ce-611a607e1424",
        "378cd0e9-cc2b-598d-92cc-6bd4d06502f5",
        "b97ecea3-5e73-5c0f-844c-64057749d45c",
        "fd1e0636-67c9-5cd7-b7f6-b5e780a37e81"
      ]
    }
