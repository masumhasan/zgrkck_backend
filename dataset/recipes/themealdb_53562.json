  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place a large pot of water to boil, add breadfruit, and let it cook for around 30 minutes",
      "timer_seconds": 1800,
      "ingredients_used": [
        "9e712712-6ae5-51d0-abbb-ab72a61df528",
        "fe5bc521-fd73-57a5-9b23-02b23182d6ce"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Remove breadfruit from pot and let it cool for a few minutes",
      "ingredients_used": [
        "9e712712-6ae5-51d0-abbb-ab72a61df528"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Hold the breadfruit firmly and using a large sharp knife slice into thin rounds",
      "ingredients_used": [
        "9e712712-6ae5-51d0-abbb-ab72a61df528"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Slice as many as you need"
    },
    {
      "step_number": 5,
      "instruction": "Then cut off skin and core (You may leave the core on if you like)"
    },
    {
      "step_number": 6,
      "instruction": "Gently fold to shape like a taco shell, use two toothpicks to hold it in place."
    },
    {
      "step_number": 7,
      "instruction": "Place on a large plate or tray and repeat this process for all breadfruit slices",
      "ingredients_used": [
        "9e712712-6ae5-51d0-abbb-ab72a61df528"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Heat oil for deep frying, using a pair of tongs submerge breadfruit slices in pan,",
      "ingredients_used": [
        "9e712712-6ae5-51d0-abbb-ab72a61df528",
        "08ee56d4-02de-556e-977c-9bab986288cd"
      ]
    },
    {
      "step_number": 9,
      "instruction": "You can guide slices with tongs if you need to"
    },
    {
      "step_number": 10,
      "instruction": "You can leave the small toothpicks in the taco shells and remove them after they're cooked. Or, you can do like I did. If your'e using larger toothpicks, you may need to remove them safely. Be very careful as you need to adjust it in the hot oil.",
      "ingredients_used": [
        "08ee56d4-02de-556e-977c-9bab986288cd"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Remove when golden brown"
    },
    {
      "step_number": 12,
      "instruction": "Set over tissue paper"
    },
    {
      "step_number": 13,
      "instruction": "Repeat this for the rest of the shells"
    },
    {
      "step_number": 14,
      "instruction": "Stuff the shell with your favorite filling. I chose codfish/ salt fish"
    }
  ],
