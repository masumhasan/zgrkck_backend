  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Marinate the beef:"
    },
    {
      "step_number": 2,
      "instruction": "Stir together the beef marinade ingredients (1 teaspoon soy sauce, 1 teaspoon Chinese rice wine, 1/2 teaspoon cornstarch, 1/8 teaspoon black pepper) in a medium bowl.",
      "ingredients_used": [
        "3d574a74-f261-54b5-b4a3-c3ecc38815b2",
        "dc98d6a4-73ed-5caa-a885-a550f70fbb17",
        "ce99fd0f-d0a8-57e8-851d-13bb7160f89e",
        "7e11fa94-f8af-55e0-9249-d01f5468f2ff",
        "3c93591d-240f-5304-a37c-231a1322985e"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the beef slices and stir until coated. Let stand for 10 minutes.",
      "timer_seconds": 600
    },
    {
      "step_number": 4,
      "instruction": "Prepare the sauce:"
    },
    {
      "step_number": 5,
      "instruction": "Stir together the sauce ingredients (2 tablespoons oyster sauce, 1 teaspoon Chinese rice wine, 1 teaspoon soy sauce, 1/4 cup chicken broth) in a small bowl. Set aside.",
      "ingredients_used": [
        "3d574a74-f261-54b5-b4a3-c3ecc38815b2",
        "d977e19b-110b-5e23-b35c-b485d6577d29",
        "7e11fa94-f8af-55e0-9249-d01f5468f2ff"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Blanch or steam the broccoli:",
      "ingredients_used": [
        "6497624d-0a77-5f1d-a73a-82884a1d949d"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Bring a pot of water to a boil. Add the broccoli and cook until crisp-tender, about 2 minutes. Drain thoroughly.",
      "timer_seconds": 120,
      "ingredients_used": [
        "6497624d-0a77-5f1d-a73a-82884a1d949d",
        "65382374-8d93-5c5a-a971-f85015e4ea43"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Stir-fry the beef:"
    },
    {
      "step_number": 9,
      "instruction": "Heat a large frying pan or wok over high heat until a bead of water sizzles and instantly evaporates upon contact. Add the cooking oil and swirl to coat.",
      "ingredients_used": [
        "65382374-8d93-5c5a-a971-f85015e4ea43"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Add the beef and immediately spread it out all over the surface of the wok or pan in a single layer (preferably not touching)."
    },
    {
      "step_number": 11,
      "instruction": "Let the beef fry undisturbed for 1 minute. Flip the beef slices over, add the garlic to the pan, and fry for an additional 30 seconds to 1 minute until no longer pink.",
      "ingredients_used": [
        "6b1f1990-135a-51f6-8a77-f32e09f7fbea"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Add the sauce, cornstarch, and broccoli:",
      "ingredients_used": [
        "dc98d6a4-73ed-5caa-a885-a550f70fbb17",
        "6497624d-0a77-5f1d-a73a-82884a1d949d",
        "3c93591d-240f-5304-a37c-231a1322985e"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Pour in the sauce and the cornstarch slurry (1 teaspoon cornstarch dissolved in 1 tablespoon of water). Stir until the sauce boils and thickens, about 30 seconds. Stir in the broccoli.",
      "timer_seconds": 30,
      "ingredients_used": [
        "dc98d6a4-73ed-5caa-a885-a550f70fbb17",
        "6497624d-0a77-5f1d-a73a-82884a1d949d",
        "3c93591d-240f-5304-a37c-231a1322985e",
        "65382374-8d93-5c5a-a971-f85015e4ea43"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Serve immediately, with steamed rice or on its own."
    }
  ],
