  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Wash crabs and boil in large pot of water for 15 minutes, remove from boiling water and cool. Crack legs and open backs to remove all meat, set aside.",
      "timer_seconds": 900
    },
    {
      "step_number": 2,
      "instruction": "Remove seeds from scotch bonnet pepper and dice pepper and onions. Sauté onions and scotch bonnet peppers in oil over medium heat until onions begin to get transparent. Add crab meat, black pepper and salt, stirring occasionally. Cook over medium heat for an additional 5 to 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "691df83b-ef25-5695-a894-1fbb5464fdd8",
        "701bbd0c-4d11-5419-9f60-63d8bab404ca",
        "bc63e817-d3a9-5df8-a8ba-e496b3c4bc11",
        "ec2d3b02-4362-5d28-aa78-a70bd07f6baa",
        "2a7d0801-fb10-574a-82e5-8ba535aa9565"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Serve with “bread kind”, a local dish that consists of a variety of starchy vegetables including pumpkin, squash, plantain, potato, cassava and breadfruit."
    },
    {
      "step_number": 4,
      "instruction": "Optional: Seasoned crab meat may also be stuffed in cleaned crab backs and baked. Cover stuffed backs with foil paper and bake at 350 degrees for 30 minutes.",
      "timer_seconds": 1800
    }
  ],
