  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Drain the chickpeas into a sieve set over a bowl or jug to catch the liquid. Tip the chickpeas, tahini, garlic and yogurt into a food processor or blender and whizz to smooth.",
      "ingredients_used": [
        "3f32c27e-2e41-59ca-a6b4-fa5e7cb390fb",
        "745d77b6-65a6-570e-85e3-dbccbc3b9c5c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Whizz in a tbsp of the chickpea liquid at a time until you have a nice consistency, then scrape into a bowl."
    },
    {
      "step_number": 3,
      "instruction": "Stir in a squeeze of lemon juice and season to taste.",
