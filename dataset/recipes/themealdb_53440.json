  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "These delectable fish balls can also be made with salmon or fish fillets. Substitute one large can of salmon or one pound of any white fish for the cod."
    },
    {
      "step_number": 2,
      "instruction": "Soak for twenty-four hours:"
    },
    {
      "step_number": 3,
      "instruction": "1 salted cod, or bakijow Discard the water.",
      "ingredients_used": [
        "e075fa8d-170a-57e9-9dd9-8c94d94eea15"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Place cod in saucepan with fresh water to cover. Simmer gently until the fish flakes easily when tested with the tines of a fork. Strain, reserving a bit of the broth. De bone the cod and set it aside for later use. In a saucepan, bring to boil in water to cover: 3 medium potatoes, peeled and diced When the potatoes are tender, drain them well. Add the cod and mash the two ingredients thoroughly together.",
      "ingredients_used": [
        "95f5a639-895a-57d9-b495-7ddd9d6cec25"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Place in the container of an electric blender:"
    },
    {
      "step_number": 6,
      "instruction": "1 tomato, peeled and chopped",
      "ingredients_used": [
        "bd686bd7-30de-5485-9127-f4e67f547b4f"
      ]
    },
    {
      "step_number": 7,
      "instruction": "1/2 green pepper, chopped",
      "ingredients_used": [
        "7d66b734-6454-5b61-8e3d-7c5855973b37",
        "f2afb0b2-2032-51cd-9330-925f1058d3f9"
      ]
    },
    {
      "step_number": 8,
      "instruction": "1 medium onion, peeled and chopped",
      "ingredients_used": [
        "aa22cbda-7434-5df7-9b55-43c122020b0b"
      ]
    },
    {
      "step_number": 9,
      "instruction": "1 clove garlic, slivered",
      "ingredients_used": [
        "dc9e77c4-93c8-5da2-a20e-c07ab760b448"
      ]
    },
    {
      "step_number": 10,
      "instruction": "1/2 tsp. Tabasco sauce, or minced hot pepper",
      "ingredients_used": [
        "f2afb0b2-2032-51cd-9330-925f1058d3f9"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Dash of nutmeg",
      "ingredients_used": [
        "e7464a73-60e7-5035-bd93-7cb3262442ff"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Salt and pepper to taste",
      "ingredients_used": [
        "e075fa8d-170a-57e9-9dd9-8c94d94eea15",
        "f2afb0b2-2032-51cd-9330-925f1058d3f9"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Blend for a few seconds and pour the sauce over the mashed fish mixture. Combine these ingredients well and add 1 egg, beaten Mixture should be stiff enough to mold into balls about one and a half inches in diameter, If it's too dry, add the fish stock a tablespoon at a time. Fry the balls in hot, deep fat until golden brown.",
      "ingredients_used": [
        "631eaa7b-d544-5b71-8969-cfeb909ea368"
      ]
    }
  ],
