  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 160C/fan 140C/gas 3. Line the base and sides of a 20 cm round, 7.5 cm deep cake tin. Beat the butter and sugar with an electric hand mixer for 1-2 mins until very creamy and pale in color, scraping down the sides of the bowl half way through. Stir in a spoonful of the flour, then stir in the beaten egg and the rest of the flour alternately, a quarter at a time, beating well each time with a wooden spoon. Stir in the almonds.",
      "timer_seconds": 120,
      "temperature": {
        "value": 160,
        "unit": "celsius"
      },
      "ingredients_used": [
        "efcd0c90-5efb-5775-826b-f5706f0c4566",
        "8f38bab8-fc45-5f2f-b84b-2e438feae712"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Mix in the sherry (the mix will look curdled), then add the peel, cherries, raisins, cherries, nuts, lemon zest, spice, rosewater and vanilla. Beat together to mix, then stir in the baking powder.",
      "ingredients_used": [
        "5df87691-ad62-5c46-a40b-7038e2017c4c",
        "328d2420-114e-55f4-a830-7e09435e678a",
        "d95d5719-318b-5225-8ad6-644f883d0a8a",
        "7106c666-7fe2-5006-9139-84b040013fa3",
        "e3448a90-4e59-573c-a901-e9e21643b5f8",
        "f413f65e-24d3-55cd-9c3e-a420e17e3448",
        "73d2e0c5-c736-5a8b-8e24-4c3e47993763"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Spoon mixture into the tin and smooth the top, making a slight dip in the center. Bake for 30 mins, then lower temperature to 150C/fan 130C/gas 2 and bake a further 2-2¼ hrs, until a skewer insterted in the middle comes out clean. Leave to cool in the tin, then take out of the tin and peel off the lining paper. When completely cold, wrap well in cling film and foil to store until ready to decorate. The cake will keep for several months.",
      "timer_seconds": 1800,
      "temperature": {
        "value": 150,
        "unit": "celsius"
      },
      "ingredients_used": [
        "328d2420-114e-55f4-a830-7e09435e678a"
      ]
    }
