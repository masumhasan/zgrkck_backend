  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Baking the Lamb",
      "ingredients_used": [
        "17eca8f7-7153-570f-96bc-bdc8186c7188"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a large pan (with a lid) melt the butter and olive oil together then add the diced lamb. Brown the lamb on a medium heat, this will take around 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "17eca8f7-7153-570f-96bc-bdc8186c7188",
        "c2fd01dd-4d48-5392-9ffe-25be68bc30e7",
        "118538b6-cf4b-54aa-95e4-09af6c926f34",
        "0fe12ff2-e634-5f27-9add-9a49c18ed47d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the garlic, oregano, 300ml of water and season with salt and pepper. Mix well before covering with the lid. Leave to simmer for 50 minutes mixing a couple of times ensuring the lamb doesn’t start to burn.",
      "timer_seconds": 3000,
      "ingredients_used": [
        "17eca8f7-7153-570f-96bc-bdc8186c7188",
        "96fef2a4-4987-5492-b5d1-da1cad010534",
        "76ca8206-ff91-5362-867c-712d617600bc",
        "a196e7b5-3850-5ebc-a38e-8bdae3694d20",
        "f4b03a43-0cfb-5be5-a16d-3b7445833965",
        "87c6fd6d-2bff-52c0-ab5a-4741caf8466d",
        "b2f9b44c-1933-52b6-8222-37f926b67fd9"
      ]
    },
    {
      "step_number": 4,
      "instruction": "The juices should have nearly all boiled away so another 150ml of water should be added along with the rice. Mix altogether, bring to the boil, place the lid on and leave for just 10 minutes. It’s advised to check at around 8 minutes – you want the liquid to be evaporated with just moist coating of oily water left over the lamb and rice.",
      "ingredients_used": [
        "17eca8f7-7153-570f-96bc-bdc8186c7188",
        "df98fddf-6b0a-51fe-810a-507cd58f7221"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Place the lamb and rice into a casserole dish, the mixture should fully cover the base and have at least 2 inches spare for the yogurt. Alternatively you can split into four ceramic bowls.",
      "ingredients_used": [
        "17eca8f7-7153-570f-96bc-bdc8186c7188",
        "df98fddf-6b0a-51fe-810a-507cd58f7221",
        "09f645dd-44ea-51b3-b888-acba6ac985ea"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Making a Roux"
    },
    {
      "step_number": 7,
      "instruction": "In a small saucepan melt the butter over a medium heat and then add two tablespoons of flour while continuously stirring for two minutes (add a little extra flour if needed). The roux should not be thick but not too runny, the color will darken slightly. Pour the roux into a bowl and keep to one side.",
      "ingredients_used": [
        "c2fd01dd-4d48-5392-9ffe-25be68bc30e7",
        "0fe12ff2-e634-5f27-9add-9a49c18ed47d",
        "b3f0bf6a-5587-5e5f-a1b0-079658767171"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Making the Yogurt Mixture",
      "ingredients_used": [
        "09f645dd-44ea-51b3-b888-acba6ac985ea"
      ]
    },
    {
      "step_number": 9,
      "instruction": "In a mixing bowl add the yogurt, eggs and season with salt and pepper. Mix together then add the roux continuing to mix fast for a minute to ensure the roux and yogurt are thoroughly combined.",
      "ingredients_used": [
        "a196e7b5-3850-5ebc-a38e-8bdae3694d20",
        "f4b03a43-0cfb-5be5-a16d-3b7445833965",
        "09f645dd-44ea-51b3-b888-acba6ac985ea",
        "411370c6-5eb8-5ab6-b263-1001e9b2db7d",
        "87c6fd6d-2bff-52c0-ab5a-4741caf8466d",
        "b2f9b44c-1933-52b6-8222-37f926b67fd9"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Pour the yogurt mixture over the baked lamb and rice and sprinkle on a little oregano.",
      "ingredients_used": [
        "17eca8f7-7153-570f-96bc-bdc8186c7188",
        "df98fddf-6b0a-51fe-810a-507cd58f7221",
        "96fef2a4-4987-5492-b5d1-da1cad010534",
        "09f645dd-44ea-51b3-b888-acba6ac985ea"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Cooking"
    },
    {
      "step_number": 12,
      "instruction": "Place on the bottom shelf of the oven on 180 degrees for 35 minutes then move it up to the middle for a further 10 minutes. The Tavë kosi is ready when the yogurt has risen up high and a golden crust formed.",
      "ingredients_used": [
        "09f645dd-44ea-51b3-b888-acba6ac985ea"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Leave to cool for 5 – 10 minutes before serving.",
      "timer_seconds": 600
    }
  ],
