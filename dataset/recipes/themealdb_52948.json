  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Combine pork, garlic, ginger, soy sauce, sesame oil, and vegetables in a bowl.",
      "ingredients_used": [
        "ae3dee6d-8576-5d40-9735-5d67537a7c40",
        "3059d466-b18f-5df0-8c9d-a870e2e355c7",
        "8398f9ae-80c0-5b98-8022-816078e01d5a",
        "9299d7c6-2a2e-5e3e-8c07-af2766a8337c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Separate wonton skins.",
      "ingredients_used": [
        "c19294d3-1091-530e-ab2f-15ff9b308814"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Place a heaping teaspoon of filling in the center of the wonton."
    },
    {
      "step_number": 4,
      "instruction": "Brush water on 2 borders of the skin, covering 1/4 inch from the edge.",
      "ingredients_used": [
        "c19294d3-1091-530e-ab2f-15ff9b308814",
        "c8277f17-5160-5c69-ad94-d265de0643ca"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Fold skin over to form a triangle, sealing edges.",
      "ingredients_used": [
        "c19294d3-1091-530e-ab2f-15ff9b308814"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Pinch the two long outside points together."
    },
    {
      "step_number": 7,
      "instruction": "Heat oil to 450 degrees and fry 4 to 5 at a time until golden.",
      "ingredients_used": [
        "9299d7c6-2a2e-5e3e-8c07-af2766a8337c"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Drain and serve with sauce."
    }
  ],
