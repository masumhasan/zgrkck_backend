  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In the bowl of a stand mixer, add warm water, a big pinch of sugar and yeast. Allow to sit until frothy.",
      "ingredients_used": [
        "8b082f5e-aa2b-5348-9b02-6c6f0dba7a9a",
        "1fec9a66-ba2c-595c-9c22-3745bb393da3",
        "d9c1a13b-4bd2-5c5e-89e8-098b0762d46c",
        "80153958-914b-5f9d-ae4f-ef9d6446012e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Into the same bowl, add 1/2 cup sugar, warm milk, melted butter, eggs and salt, and whisk until combined.",
      "ingredients_used": [
        "d9c1a13b-4bd2-5c5e-89e8-098b0762d46c",
        "1cc99bbf-e373-586d-bfd7-7ee9f6fd7a44",
        "517770fc-e487-5d1f-91c9-b52559019b7c",
        "8f7072c6-86a9-52d9-bad5-f83f441be279",
        "569e7be9-bb8b-5ae2-aa23-e4bd531167cb",
        "80153958-914b-5f9d-ae4f-ef9d6446012e"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Place a dough hook on the mixer, add the flour with the machine on, until a smooth but slightly sticky dough forms.",
      "ingredients_used": [
        "e95455e2-9b24-5df6-83f8-c6bb07df42cf"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Place dough in a bowl, cover with plastic wrap, and allow to proof for 1 1/2 hours.",
      "timer_seconds": 7200
    },
    {
      "step_number": 5,
      "instruction": "Cut dough into 12 pieces, and roll out into long oval-like shapes about 1/4 inch thick that resemble a beaver’s tail."
    },
    {
      "step_number": 6,
      "instruction": "In a large, deep pot, heat oil to 350 degrees. Gently place beavertail dough into hot oil and cook for 30 to 45 seconds on each side until golden brown.",
      "timer_seconds": 45,
      "ingredients_used": [
        "cd6193e3-73b2-50f7-a9e4-f90a3edc6e0d"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Drain on paper towels, and garnish as desired. Toss in cinnamon sugar, in white sugar with a squeeze of lemon, or with a generous slathering of Nutella and a handful of toasted almonds. Enjoy!",
      "ingredients_used": [
        "d9c1a13b-4bd2-5c5e-89e8-098b0762d46c",
        "c529478a-058e-57c2-b600-961f693d0e16",
        "80153958-914b-5f9d-ae4f-ef9d6446012e",
        "a2e690fb-d5e1-5174-a208-52385d36fb8f"
      ]
    }
  ],
