  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a medium bowl, combine shrimp with minced Scotch Bonnet peppers, all-purpose seasoning, ground annatto, and grounf allspice. Toss well to coat evenly and let marinate for 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "3be58c3a-8632-516d-882e-e32153722d31",
        "8efe444e-3d8c-5bae-9bf2-7701dc71348e",
        "c8e13b48-c3f3-55c8-9742-4b3e9015b467",
        "fa7b1a78-a985-5dde-b5af-ea045062f47d",
        "22e866d3-8a99-5e59-a374-11ea162b62ab"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat a large pan over medium heat. Add the shrimp stock and bring to a gentle simmer. Stir in the diced onion and garlic, cooking until softened and fragrant, about 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "3be58c3a-8632-516d-882e-e32153722d31",
        "d69fd373-29c6-5c6f-a993-3a8471760c2b",
        "c156a710-1836-54dc-9402-1d8d22179208",
        "1e1bd261-e681-56a1-9a2e-f7eb1af9758a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the seasoned shrimp and thyme sprigs, spreading the shrimp in the pan. Cover and cook for about 5–7 minutes, stirring occasionally, until the shrimp turn bright orange and are cooked through.",
      "timer_seconds": 420,
      "ingredients_used": [
        "3be58c3a-8632-516d-882e-e32153722d31",
        "e0c402b1-e125-500c-990a-606ac5ccfe80"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the white vinegar, stir, and cook for another minute. Taste; add salt to taste. Using a slotted spoon, transfer the shrimp to a plate. Serve hot with some cooking liquid drizzled on top.",
      "ingredients_used": [
        "3be58c3a-8632-516d-882e-e32153722d31",
        "3d977c18-276c-59f8-8651-896a1fe9ae39",
        "623f82ad-8832-5380-86b7-025557b8dfa3"
      ]
    }
  ],
