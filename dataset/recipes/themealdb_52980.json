  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Wash and peel the potatoes and cut into similarly sized pieces for even cooking.",
      "ingredients_used": [
        "46409d8a-6580-555b-b628-e9e808f2d02f"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a large soup pot, boil the potatoes and the bay leaves in salted water for 20 minutes. Discard the bay leaves.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "46409d8a-6580-555b-b628-e9e808f2d02f",
        "d93b5bb1-f2db-59a1-85ba-9ea831545144"
      ]
    },
    {
      "step_number": 3,
      "instruction": "If you're not using a bag of ready-cut curly kale, wash the bunches thoroughly under cool running water to get rid of all soil—you wouldn't want that gritty texture in your finished dish. Trim any coarse stems and discard any brown leaves. With a sharp knife, cut the curly kale into thin strips.",
      "ingredients_used": [
        "7f7e7c48-3baf-589b-8c8d-42a157a6bc6d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Peel and chop the shallots.",
      "ingredients_used": [
        "014e5541-5ac7-535c-acf0-4af5adb711bd"
      ]
    },
    {
      "step_number": 5,
      "instruction": "In a frying pan or skillet, melt 1 tbsp. of butter and saute the shallots for a few minutes before adding the curly kale and 2 tbsp. of water. Season and cook for about 10 minutes, or until tender.",
      "timer_seconds": 600,
      "ingredients_used": [
        "014e5541-5ac7-535c-acf0-4af5adb711bd",
        "cde64cca-a45f-547b-a20d-d4c3f0382f2a",
        "7f7e7c48-3baf-589b-8c8d-42a157a6bc6d"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Warm the milk on the stove or in the microwave.",
      "ingredients_used": [
        "16703624-a334-5a57-b787-6442fe473d89"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Drain, shake and dry the potatoes with kitchen towels before mashing with a potato masher or ricer. Working quickly, add the warm milk and the remaining butter. Season to taste with nutmeg, salt, and pepper.",
      "ingredients_used": [
        "46409d8a-6580-555b-b628-e9e808f2d02f",
        "cde64cca-a45f-547b-a20d-d4c3f0382f2a",
        "16703624-a334-5a57-b787-6442fe473d89",
        "9cc6afaa-572a-5e61-9972-5df43a0e863f",
        "d93b5bb1-f2db-59a1-85ba-9ea831545144",
        "d271b2fc-a53c-5e16-a69d-5b8ada580b33"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Mix the cooked curly kale through the cooked mashed potato mixture.",
      "ingredients_used": [
        "7f7e7c48-3baf-589b-8c8d-42a157a6bc6d"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Top with slices of the smoked sausage and serve hot with your favorite mustard or gravy."
    },
    {
      "step_number": 10,
      "instruction": "Serve and enjoy!"
    }
  ],
