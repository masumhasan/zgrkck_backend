  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Take your puff pastry from the freezer and defrost.",
      "ingredients_used": [
        "12b58148-5321-53f2-ae3a-4d1d0c26dac0"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Sprinkle some flour on the kitchen counter. Stack the sheets of puff pastry on top of each other and roll them out with a rolling pin. You want those five sheets to end up being as thin as one sheet.",
      "ingredients_used": [
        "12b58148-5321-53f2-ae3a-4d1d0c26dac0"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Using a round or oval form press into the puff pastry and try to be as economical doing that as possible. You want to have as many cookies as you can.",
      "ingredients_used": [
        "12b58148-5321-53f2-ae3a-4d1d0c26dac0"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Mix the vanilla sugar with the cinnamon, cardemom and limezest in a little bowl",
      "ingredients_used": [
        "463df961-20a2-57e8-a68e-bb089248105a",
        "ee83904a-1888-5270-821a-a99fa544cc6b",
        "6bea630d-c07e-51e7-9cba-21b90f37f9ba"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Remove the flour from the counter and sprinkle with a bit of the sugar mix."
    },
    {
      "step_number": 6,
      "instruction": "Brush your puff pastry with a little bit of eggwash and than dip into the sugar mix and roll them softly to press the sugar in.",
      "ingredients_used": [
        "12b58148-5321-53f2-ae3a-4d1d0c26dac0"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Put your sugary puff pastry on a baking sheet (greased or with baking paper) and leave the dough to rest for about 20 to 25 minutes. this will make the cookies even crisper.",
      "timer_seconds": 1500,
      "ingredients_used": [
        "12b58148-5321-53f2-ae3a-4d1d0c26dac0"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Preheat the oven in the meantime to 180 C and put the baking tray in the oven.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 9,
      "instruction": "bake the cookies golden brown in about 25 minutes and make sure the sugar is caramelized nicely",
      "timer_seconds": 1500
    },
    {
      "step_number": 10,
      "instruction": "And voila, Girls from Arnhem with an Almeerse twist"
    },
    {
      "step_number": 11,
      "instruction": "Voila, Arnhemse Meisjes met een Almeerse twist."
    }
  ],
