  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare the Figs",
      "ingredients_used": [
        "f81b1065-b047-55ee-ba05-41f8a8d040ee"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cut off the hard bits of stalk and then cut the figs in half length ways.",
      "ingredients_used": [
        "f81b1065-b047-55ee-ba05-41f8a8d040ee"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Place the figs in a small frying pan / saute pan with the cut side face up and add the water around them.",
      "ingredients_used": [
        "f81b1065-b047-55ee-ba05-41f8a8d040ee",
        "0f9617c4-f135-5aa4-aab6-490bb59d49fd"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cooking"
    },
    {
      "step_number": 5,
      "instruction": "Leave the figs on a medium heat to cook through, once they become soft remove them from the pan and place onto a serving dish. This will take around 10 - 15 minutes.",
      "timer_seconds": 900,
      "ingredients_used": [
        "f81b1065-b047-55ee-ba05-41f8a8d040ee"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Prepare the Syrup"
    },
    {
      "step_number": 7,
      "instruction": "In the pan there will be a red water juice left from the figs. Add the sugar while remaining on a medium heat. Stir continuously for a couple of minutes until the juice has turned to a thick syrup. Remove from the heat.",
      "ingredients_used": [
        "f81b1065-b047-55ee-ba05-41f8a8d040ee",
        "0f9617c4-f135-5aa4-aab6-490bb59d49fd",
        "132f4f32-cf90-5c83-a8d8-4a89cf9c0b14"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Serving"
    },
    {
      "step_number": 9,
      "instruction": "Push one half of walnut into every fig and then drizzle the syrup over the top."
    },
    {
      "step_number": 10,
      "instruction": "Serve warm or cooled."
    }
  ],
