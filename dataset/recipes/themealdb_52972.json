        "c81ef867-8e97-5c53-b2ed-316bf2a63cd9",
        "b0870b66-5824-5851-a1d5-42c731810b3a",
        "d8e4793e-ea0f-5686-ad67-3d4b21784f7e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the pasta and cook for 15 minutes or until pasta is cooked.",
      "timer_seconds": 900
    }
