  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "For the sweet onion, look for Vidalia, OSO Sweet, or Walla Walla. The super-sweet varieties are more suited to this stir-fry because at the end of cooking, the onion still has a slight crunch.",
      "ingredients_used": [
        "9a31ab05-17fb-51fb-a85b-4589eb632d0e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Make the sauce:"
    },
    {
      "step_number": 3,
      "instruction": "In a bowl, combine the sesame oil, soy sauce, and rice vinegar.",
      "ingredients_used": [
        "64d3281c-faa0-555b-82bb-7c7b06bdaa8a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cook the rice noodles:",
      "ingredients_used": [
        "5e102dc2-6567-561a-96cb-d24b467b6d82"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Bring a large saucepan of water to a boil, add the noodles, and use tongs to turn them so they are submerged. Cook for 2 minutes, or until they are tender but still have some bite (they will cook a little more once you add them to the skillet).",
      "timer_seconds": 120,
      "ingredients_used": [
        "5e102dc2-6567-561a-96cb-d24b467b6d82"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Drain, rinse with cold water, and use scissors to snip the noodles several times to break them up into shorter lengths.",
      "ingredients_used": [
        "5e102dc2-6567-561a-96cb-d24b467b6d82"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Scramble the eggs:"
    },
    {
      "step_number": 8,
      "instruction": "In a small bowl whisk together the eggs. Heat the skillet or Dutch oven over medium heat. Add 1 tablespoon of the peanut or canola oil. Add the eggs and scramble them for 2 minutes, or until they form large, soft curds. Transfer them from the pan to a plate or bowl.",
      "timer_seconds": 120
    },
    {
      "step_number": 9,
      "instruction": "Cook the vegetables:"
    },
    {
      "step_number": 10,
      "instruction": "Add 1 tablespoon of the remaining oil to the pan. When it is hot, add the ginger, garlic, carrots, jalapeño, onion, and salt. Cook, stirring constantly, for 2 minutes or until the vegetables start to soften.",
      "timer_seconds": 120,
      "ingredients_used": [
        "b9aaac29-0525-529f-b624-3366a613952b",
        "c9e224af-5022-54e9-a841-a0c6c9214f61",
        "34585a4a-831c-5672-9e5f-2e885094b4a0",
        "9a31ab05-17fb-51fb-a85b-4589eb632d0e",
        "8ee7dbd8-6f24-5143-a49e-7c7bfed98a7f"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Add the remaining ingredients:"
    },
    {
      "step_number": 12,
      "instruction": "Sprinkle the vegetable mixture with the remaining 1 tablespoon peanut or canola oil. When the oil is hot, add the ham, cabbage, scallions, red pepper, and curry powder to the pan. Cook, stirring constantly, for 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "ee107431-03e1-5902-a1b2-f31c2988f7bb",
        "a91e3a4d-3f65-53d1-b58c-e12b8aa03035",
        "79272206-931d-53a4-ae5f-81b6b5a0c679",
        "0dcf3f65-de6c-5e08-89c6-0480d9cdbc73",
        "126056aa-a12c-5829-9881-fe02243a33dd"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Add the shrimp and cook, stirring, for 3 more minutes or until the shrimp are bright pink and cooked through.",
      "ingredients_used": [
        "863ae01a-2e3b-5bde-ae78-a8c55aa1e770"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Add the noodles in batches:",
      "ingredients_used": [
        "5e102dc2-6567-561a-96cb-d24b467b6d82"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Add the eggs, the sauce mixture, and half the noodles to the pan. Toss for 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "5e102dc2-6567-561a-96cb-d24b467b6d82"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Add the remaining noodles and continue tossing for 1 minute more until they are thoroughly combined and the mixture is heated through.",
      "timer_seconds": 60,
      "ingredients_used": [
        "5e102dc2-6567-561a-96cb-d24b467b6d82"
      ]
    },
    {
      "step_number": 17,
      "instruction": "Serve:"
    },
    {
      "step_number": 18,
      "instruction": "Taste for seasoning and add more salt or soy sauce, if you like. Sprinkle with cilantro leaves and serve.",
      "ingredients_used": [
        "64d3281c-faa0-555b-82bb-7c7b06bdaa8a",
        "8ee7dbd8-6f24-5143-a49e-7c7bfed98a7f",
        "edb5f341-5ecb-58cf-a805-7a1a8204f803"
      ]
    }
  ],
