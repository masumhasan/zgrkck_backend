  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Chop the onion and garlic, slice the mushrooms and wash the buckwheat. Heat the oil and lightly sauté the onion.",
      "ingredients_used": [
        "437e8290-4cea-5b26-86c3-c1ffd4c5409d",
        "935b68ee-a155-5454-870d-7d2a644d6e2b",
        "a1e91b40-421a-54f4-a77b-248bfeb6031e",
        "49fe4aee-ed6a-576e-934a-dac47894b36c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the mushrooms and the garlic and continue to sauté. Add the salt, vegetable seasoning, buckwheat and the bay leaf and cover with water.",
      "ingredients_used": [
        "437e8290-4cea-5b26-86c3-c1ffd4c5409d",
        "935b68ee-a155-5454-870d-7d2a644d6e2b",
        "49fe4aee-ed6a-576e-934a-dac47894b36c",
        "b1e22a04-ce9a-5fc9-9397-cec3c76d60b7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Simmer gently and just before it is completely cooked, add pepper, sour cream mixed with flour, the chopped parsley and vinegar to taste.",
      "ingredients_used": [
        "5ada411d-61c0-5417-9ad5-2222c81cf1f8",
        "d8dd0d02-b786-52e9-b28c-ca371637f3e6"
      ]
    }
  ],
