  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "oak the beans in water to cover overnight.Drain. If skinless beans are unavailable, rub to loosen the skins, then discard the skins. Pat the beans dry with a towel.",
      "ingredients_used": [
        "94c585cd-2622-5a6c-b44b-eef841c6585b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Grind the beans in a food mill or meat grinder.If neither appliance is available, process them in a food processor but only until the beans form a paste. (If blended too smoothly, the batter tends to fall apart during cooking.) Add the scallions, garlic, cilantro, cumin, baking powder, cayenne, salt, pepper, and coriander, if using.  Refrigerate for at least 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "94c585cd-2622-5a6c-b44b-eef841c6585b",
        "a8ae9ddc-f47f-524f-9a53-452d50b973fd",
        "a36b0e4a-bed2-55dd-914d-ad640bffcdab"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Shape the bean mixture into 1-inch balls.Flatten slightly and coat with flour.",
      "ingredients_used": [
        "622c35a1-5321-5e62-9bdc-c05438904c86"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Heat at least 1½-inches of oil over medium heat to 365 degrees."
    },
    {
      "step_number": 5,
      "instruction": "Fry the patties in batches, turning once, until golden brown on all sides, about 5 minutes.Remove with a wire mesh skimmer or slotted spoon. Serve as part of a meze or in pita bread with tomato-cucumber salad and tahina sauce.",
      "timer_seconds": 300
    }
  ],
