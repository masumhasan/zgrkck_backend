  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 180° C.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Combine carrots, onion, garlic, cumin seeds, coriander seeds, salt and olive oil in a bowl and mix well. Transfer on a baking tray.",
      "ingredients_used": [
        "2e15ed43-6d14-5c9b-91c3-283973b7a79d",
        "53e1687f-6bf4-550a-9b42-a85b40933d3a",
        "527e7fed-e32d-5385-bbd4-249d30016f9e",
        "42b3fe60-1721-5755-8369-45d4e1b57b5d",
        "fe34061f-c5ef-50f8-b31d-5628bd2a1108"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Put the baking tray in preheated oven and roast for 10-12 minutes or till carrots soften. Remove from heat and cool.",
      "timer_seconds": 720,
      "ingredients_used": [
        "2e15ed43-6d14-5c9b-91c3-283973b7a79d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Grind the baked carrot mixture along with some water to make a smooth paste and strain in a bowl."
    },
    {
      "step_number": 5,
      "instruction": "Heat the carrot mixture in a non-stick pan. Add two cups of water and bring to a boil. Add garam masala powder and mix. Add salt and mix well.",
      "ingredients_used": [
        "5d80a9ce-a7e0-5296-ac66-694086f98f4e"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Remove from heat, add lemon juice and mix well.",
      "ingredients_used": [
        "1e86b337-cc8c-5ea1-98e0-fe3712423468"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Serve hot."
    }
  ],
