  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "First, pan fry the black pepper and garlic over a dry medium heat until fragrant.",
      "ingredients_used": [
        "fadb1f78-991e-5e2a-9fce-4abd1219e004"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add a good amount of extra virgin olive oil and infuse for a minute.",
      "ingredients_used": [
        "f9192705-9dc4-5975-8515-5009a4c62d8f"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Once the oil heats up, add the tomatoes and salt, and cover with a lid. Simmer for 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "ea221b67-7764-56ff-9149-3a2ddd706d90",
        "57f8a5d4-b242-5c11-abbc-d42bf7214ec1"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Remove the lid and mash the tomatoes. Reduce until you reach the desired consistency of choice.",
      "ingredients_used": [
        "ea221b67-7764-56ff-9149-3a2ddd706d90"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Make craters for the eggs and lower the heat. Carefully crack the eggs into the craters, making sure it touches the pan and not the tomato sauce.",
      "ingredients_used": [
        "ea221b67-7764-56ff-9149-3a2ddd706d90"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Cover the eggs and leave it for 5 minutes without lifting the lid.",
      "timer_seconds": 300
    },
    {
      "step_number": 7,
      "instruction": "Remove from the heat and let the residual heat steam the eggs for 1-2 minutes.",
      "timer_seconds": 120
    },
    {
      "step_number": 8,
      "instruction": "Serve with flatbread. Enjoy!"
    }
  ],
