  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare"
    },
    {
      "step_number": 2,
      "instruction": "In a mixing bowl cream together the eggs, sugar and cooled melted butter then add the honey and soda.",
      "ingredients_used": [
        "e20a3403-1306-5131-a513-863060fc0168",
        "f017c3b3-8864-5190-84d2-381eb58ba982",
        "e62e6fe0-bdff-56d6-a161-a9254cf02bc4",
        "f6806c48-81a8-5dd3-9b76-a114dd43c453",
        "ca191c60-2821-506a-90dc-21d2ba0c2624"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add half the flour and the walnuts (you can add the walnuts whole or ground them) and mix well.",
      "ingredients_used": [
        "de49c132-d84d-5c43-8bea-d3db4f63ea32",
        "a6be4f78-cb83-564b-8942-a6c3ba1b1a96"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the rest of the flour and using your hands kneed the mixture together until a firm dough is formed.",
      "ingredients_used": [
        "de49c132-d84d-5c43-8bea-d3db4f63ea32"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Coat a large baking tray (traditionally a circle tray is used about 30cm is best with a 2 - 3 inch height) with olive oil. Add the dough and press it down so that it fits the whole tray. Try and get the dough flat and equal in height all over."
    },
    {
      "step_number": 6,
      "instruction": "Baking"
    },
    {
      "step_number": 7,
      "instruction": "Place on the bottom shelf of a cold oven and turn the temperture up to 180 degrees. Bake for 35 minutes and the dough has turned dark brown and is firm to touch.",
      "timer_seconds": 2100
    },
    {
      "step_number": 8,
      "instruction": "Remove from the oven and leave to cool while making the syrup."
    },
    {
      "step_number": 9,
      "instruction": "Adding the Syrup"
    },
    {
      "step_number": 10,
      "instruction": "Add the sugar and water to a saucepan and bring to the boil. Leave boiling for 10 minutes, mixing occasionally. Remove from the heat.",
      "timer_seconds": 600,
      "ingredients_used": [
        "e20a3403-1306-5131-a513-863060fc0168",
        "ca191c60-2821-506a-90dc-21d2ba0c2624",
        "ca9aabf6-9a26-5aeb-bbd5-253f3f951e33"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Cut the Shendetlie into squares of diamond shapes and pour over the hot syrup. Use enough of the syrup to cover the cake plus 1 cm overflowing, sitting on top. This will soak into the cake while you leave it to cool for at least 1 hour before serving.",
      "timer_seconds": 3600
    }
  ],
