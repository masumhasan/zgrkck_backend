  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place coconut cream in a small pot over low heat. Cut 3 pandan leaves into large strips and add to the pot with brown sugar, salt, and ginger. Bring to a boil, then cook 2 more minutes. Turn off the heat, remove the pandan leaves, and let cool.",
      "ingredients_used": [
        "64637adf-03e5-503c-a0e3-6ee7cb404b92",
        "993cb323-2bd6-558e-bd26-a692c9537045",
        "d713f032-4f97-5738-9ccb-52a31fd7ee43",
        "0a3eea72-26cb-517a-8a49-5ef49bf5e4a2",
        "8cb5c41a-6bbf-58b1-a769-b60e7c7a13ef"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Chop the remaining 4 pandan leaves, blend with ¼ cup water until very green, then strain well. In a bowl, place 200 g sticky rice flour, add a little pandan liquid, and knead until smooth.",
      "ingredients_used": [
        "ef02665c-b1b8-530c-9a6d-a0e8a6cf3011",
        "64637adf-03e5-503c-a0e3-6ee7cb404b92",
        "7c93515f-67c8-5710-a221-bcea26898a85",
        "24d8af74-e908-52a1-b3da-1cd3f855383f"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Peel and chop beetroot, blend with ¼ cup water until red, then strain well. In a bowl, place 200 g sticky rice flour, add a little beetroot liquid, and knead until smooth.",
      "ingredients_used": [
        "ef02665c-b1b8-530c-9a6d-a0e8a6cf3011",
        "17ca2a68-ba11-50a4-88f9-9e263ff19436",
        "7c93515f-67c8-5710-a221-bcea26898a85",
        "24d8af74-e908-52a1-b3da-1cd3f855383f"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Bring 3 liters of water to a boil in a medium–large pot. Divide each dough into small pieces, roll into balls about ⅓ the size of a ping pong ball, then drop into boiling water. When they float, remove and place them into fresh, icy water to keep them separate.",
      "ingredients_used": [
        "7c93515f-67c8-5710-a221-bcea26898a85",
        "24d8af74-e908-52a1-b3da-1cd3f855383f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Drain well, then place the mixed colored balls into the cooled coconut sugar syrup and stir. Serve in small bowls (add longan and shredded coconut as desired).",
      "ingredients_used": [
        "880f143e-c6a3-5171-867a-fbd518209dbb",
        "993cb323-2bd6-558e-bd26-a692c9537045"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add the coloring liquids gradually—each flour absorbs differently. You want a dough that’s smooth and pliable, not sticky."
    }
  ],
