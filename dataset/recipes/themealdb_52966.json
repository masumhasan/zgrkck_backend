  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Grease and line a 20 x 20cm/8\" x 8\" baking tin with parchment paper."
    },
    {
      "step_number": 2,
      "instruction": "Put the mars bars and butter in a heat proof bowl and place over a pan of barely simmering water. Mixing with a whisk, melt until the mixture is smooth.",
      "ingredients_used": [
        "4b453d17-7793-54b6-8b4c-baac24443f6c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Pour over the rice krispies in a mixing bowl and mix until all the ingredients are evenly combined. Press evenly into the prepare baking tin and set aside.",
      "ingredients_used": [
        "6eca7ffa-4729-56fa-b09f-3a863f6d5784"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Melt the milk chocolate in the microwave or over a pan of barely simmering water.",
      "ingredients_used": [
        "bf5a7dd0-0302-596b-be03-94644e144770"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Spread the melted chocolate over the rice krispie mixture and leave to set in a cool place. Once set slice into squares and serve!",
      "ingredients_used": [
        "bf5a7dd0-0302-596b-be03-94644e144770"
      ]
    }
  ],
