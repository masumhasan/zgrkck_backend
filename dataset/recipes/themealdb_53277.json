  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat 2 tsp oil in a pan and soften the onions for 5 mins. Add the garlic and spices and cook for a few mins more. Spoon half the onion mixture into a bowl and set aside to cool. Add the tomatoes, sugar and seasoning to the remaining onions in the pan and simmer for about 10 mins until reduced.",
      "ingredients_used": [
        "7a1e4768-6859-53ed-b2ea-6f33fb8e4dd6",
        "1b88b0ab-5a93-54e9-b625-b0f18dfdb7d5",
        "4d571b89-5496-5d1d-9659-2afb6ee04d79"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Meanwhile, add the mint, lamb, apricots and breadcrumbs to the cooled onions, season and mix well with your hands. Shape into little meatballs.",
      "ingredients_used": [
        "7a1e4768-6859-53ed-b2ea-6f33fb8e4dd6",
        "3d95d700-968e-570d-a7bf-28b57fdd40de",
        "ca7ffd1f-de85-533f-86cc-bf8a115090c0",
        "d765701b-e0ac-5d19-bb54-3c5c4a326971",
        "cdfbf86d-7678-5d04-99aa-c2a56feabd56"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat the rest of the oil in a non-stick pan and fry the meatballs until golden (in batches if you need to). Stir in the sauce with a splash of water and gently cook everything for a few mins until the meatballs are cooked through. Serve with pitta bread and salad.",
      "ingredients_used": [
        "cdfbf86d-7678-5d04-99aa-c2a56feabd56"
      ]
    }
  ],
