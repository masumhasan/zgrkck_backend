  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Combine the marinade ingredients in a large ziplock bag (or bowl)."
    },
    {
      "step_number": 2,
      "instruction": "Add the chicken and use your hands to make sure each piece is coated. If using a ziplock bag, I find it convenient to close the bag then massage the bag to disperse the rub all over each chicken piece."
    },
    {
      "step_number": 3,
      "instruction": "Marinate overnight or up to 24 hours.",
      "timer_seconds": 86400
    },
    {
      "step_number": 4,
      "instruction": "Combine the Yogurt Sauce ingredients in a bowl and mix. Cover and put in the fridge until required (it will last for 3 days in the fridge)."
    },
    {
      "step_number": 5,
      "instruction": "Heat grill/BBQ (or large heavy based pan on stove) on medium high. You should not need to oil it because the marinade has oil in it and also thigh fillets have fat. But if you are worried then oil your hotplate/grill. (See notes for baking)"
    },
    {
      "step_number": 6,
      "instruction": "Place chicken on the grill and cook the first side for 4 to 5 minutes until nicely charred, then turn and cook the other side for 3 to 4 minutes (the 2nd side takes less time)."
    },
    {
      "step_number": 7,
      "instruction": "Remove chicken from the grill and cover loosely with foil. Set aside to rest for 5 minutes.",
      "timer_seconds": 300
    },
    {
      "step_number": 8,
      "instruction": "TO SERVE"
    },
    {
      "step_number": 9,
      "instruction": "Slice chicken and pile onto platter alongside flatbreads, Salad and the Yogurt Sauce."
    },
    {
      "step_number": 10,
      "instruction": "To make a wrap, get a piece of flatbread and smear with Yogurt Sauce. Top with a bit of lettuce and tomato and Chicken Shawarma. Roll up and enjoy!",
      "ingredients_used": [
        "50b233d7-a665-5f45-8295-cd46c1f02987",
        "b086eceb-9cae-5951-84c3-a381f50af8af"
      ]
    }
  ],
