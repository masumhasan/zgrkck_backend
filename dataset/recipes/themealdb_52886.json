  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the flour and salt in a bowl. Add the suet, currants, sugar, lemon and orange zest.",
      "ingredients_used": [
        "f20ebad1-1800-5555-9816-be072caeaf01",
        "5d314017-695d-5665-9442-7a21dd7fcb46",
        "e5fdf35e-bdcc-5908-bb75-21e336ae2c02",
        "53f7a23d-5e97-5026-bdb2-1a117f10f1eb",
        "48aea9e3-3888-5965-b5cb-c9781149fc08"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Pour in 150ml milk and mix to a firm but moist dough, adding the extra milk if necessary.",
      "ingredients_used": [
        "ed7d45d7-a6cc-5e01-8e19-38f3715a5110"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Shape into a fat roll about 20cm long. Place on a large rectangle of baking parchment. Wrap loosely to allow for the pudding to rise and tie the ends with string like a Christmas cracker."
    },
    {
      "step_number": 4,
      "instruction": "Place a steamer over a large pan of boiling water, add the pudding to the steamer, cover and steam for 1 1/2 hours. Top up the pan with water from time to time.",
      "timer_seconds": 7200
    },
    {
      "step_number": 5,
      "instruction": "Remove from the steamer and allow to cool slightly before unwrapping. Serve sliced with custard.",
      "ingredients_used": [
        "3348f894-7231-504f-be42-5d813d2dfcb2"
      ]
    }
  ],
