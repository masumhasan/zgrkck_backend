  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Rub the garlic over the steaks then put in a sandwich bag and tip in the olive oil, sherry vinegar and parsley stalks. Smoosh everything together, then use a rolling pin to bash the steaks a few times. Leave for 1-2 hours.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "2c66a6bf-9a7d-5eaf-9ee6-0604f2312584",
        "d686bb50-8fb3-52d6-96ba-f6a052d9d3b8",
        "43998294-bf49-5985-8492-63ae303f9e6f",
        "4f59b912-1383-54ee-8985-c05bf908bcd9",
        "65cd3314-8d87-53d7-b022-e8b612ed560c",
        "619de42f-7d08-5e52-b8af-db34d8d1f52a",
        "d765e86d-bf70-599c-8c33-a3b9f91df337"
      ]
    },
    {
      "step_number": 2,
      "instruction": "To make the sauce, put all the ingredients into a blender with 1 tbsp water and whizz until as smooth as possible. This will make more than you’ll need for the recipe but will keep for a week in an airtight jar."
    },
    {
      "step_number": 3,
      "instruction": "Heat a griddle or frying pan to high. Brush away the garlic and parsley stalks from the steaks and season well. Sear the steaks for 2 minutes on each side then rest on a plate. Put the ciabatta halves onto the plate, toasted-side down, to soak up any juices.",
      "timer_seconds": 120,
      "ingredients_used": [
        "2c66a6bf-9a7d-5eaf-9ee6-0604f2312584",
        "4f59b912-1383-54ee-8985-c05bf908bcd9",
        "abbf0859-b4aa-5cf5-9ad2-ba2e5f154b02",
        "65cd3314-8d87-53d7-b022-e8b612ed560c",
        "d765e86d-bf70-599c-8c33-a3b9f91df337"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Slice the steaks then stuff into the rolls with the green sauce and rocket.",
      "ingredients_used": [
        "71e599d0-1336-5151-bbf9-555b27ddc6c3"
      ]
    }
