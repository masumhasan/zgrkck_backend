  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Marinate beef in soy sauce, lemon (or calamansi), and ground black pepper for at least 1 hour. Note: marinate overnight for best result",
      "timer_seconds": 3600,
      "ingredients_used": [
        "78da8de4-c16d-5748-a544-b7ad58bf3350",
        "49ef22a7-074b-526a-a618-14aa03ea4053",
        "72ec5a81-171e-5411-8d57-e28c7688df6e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat the cooking oil in a pan then pan-fry half of the onions until the texture becomes soft. Set aside",
      "ingredients_used": [
        "4ffaced8-20e0-5fe4-8330-59213210254e"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Drain the marinade from the beef. Set it aside. Pan-fry the beef on the same pan where the onions were fried for 1 minute per side. Remove from the pan. Set aside",
      "timer_seconds": 60,
      "ingredients_used": [
        "78da8de4-c16d-5748-a544-b7ad58bf3350",
        "4ffaced8-20e0-5fe4-8330-59213210254e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add more oil if needed. Saute garlic and remaining raw onions until onion softens.",
      "ingredients_used": [
        "29bc22d5-fdf4-51f5-a691-4d3414bb2c2d",
        "4ffaced8-20e0-5fe4-8330-59213210254e"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour the remaining marinade and water. Bring to a boil.",
      "ingredients_used": [
        "40759b04-ab1b-5223-9a33-e543de4dee53"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add beef. Cover the pan and simmer until the meat is tender. Note: Add water as needed.",
      "ingredients_used": [
        "78da8de4-c16d-5748-a544-b7ad58bf3350",
        "40759b04-ab1b-5223-9a33-e543de4dee53"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Season with ground black pepper and salt as needed. Top with pan-fried onions.",
      "ingredients_used": [
        "4ffaced8-20e0-5fe4-8330-59213210254e",
        "433673e0-6a44-5754-a8c8-bf0a610e3c65"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Transfer to a serving plate. Serve hot. Share and Enjoy!"
    }
  ],
