  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place all the ingredients, except the oil in a medium bowl and mix well using your hands until soft and smooth dough is obtained."
    },
    {
      "step_number": 2,
      "instruction": "Form small balls using your hands."
    },
    {
      "step_number": 3,
      "instruction": "In a deep pot, heat the vegetable oil to 300°F (Warm, not very hot). Carefully drop the balls in the warm oil and fry for about 3 to 4 minutes or until gilden brown.",
      "timer_seconds": 240,
      "temperature": {
        "value": 300,
        "unit": "fahrenheit"
      },
      "ingredients_used": [
        "cf9f0c04-1739-5940-99a9-ef8dc7696918"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Remove from the oil and drain on a plate lined with paper towels. Serve."
    },
    {
      "step_number": 5,
      "instruction": "Frying Colombian buñuelos using the right temperature is very important. The oil can't be very hot or very cold. Be sure the oil is heated to 300 to 320 grades F."
    }
  ],
