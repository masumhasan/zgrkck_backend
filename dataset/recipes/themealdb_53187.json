  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare the Potatoes",
      "ingredients_used": [
        "c0baac1d-7e6c-5e75-a2ed-5a6ac5bfe97c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Boil the potatoes with their skins on until tender.",
      "ingredients_used": [
        "c0baac1d-7e6c-5e75-a2ed-5a6ac5bfe97c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Let them cool completely (preferably overnight), then peel and mash them finely."
    },
    {
      "step_number": 4,
      "instruction": "Make the Dough"
    },
    {
      "step_number": 5,
      "instruction": "In a bowl, combine mashed potatoes, flour, semolina, and salt.",
      "ingredients_used": [
        "c0baac1d-7e6c-5e75-a2ed-5a6ac5bfe97c",
        "04a3234b-5a1e-566d-b5ff-635bd64c8533",
        "9e2afc98-edfb-5a62-8b1d-9dcdd5f51aab"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Knead the mixture until you get a smooth, non-sticky dough."
    },
    {
      "step_number": 7,
      "instruction": "Shape the Šúĺlance"
    },
    {
      "step_number": 8,
      "instruction": "Divide the dough into portions and roll each into a thin rope (about 1.5 cm in diameter)."
    },
    {
      "step_number": 9,
      "instruction": "Cut into 3 cm-long pieces and roll between your palms to shape small dumplings."
    },
    {
      "step_number": 10,
      "instruction": "Cook the Dumplings"
    },
    {
      "step_number": 11,
      "instruction": "Bring a pot of salted water to a boil.",
      "ingredients_used": [
        "9e2afc98-edfb-5a62-8b1d-9dcdd5f51aab"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Drop in the dumplings in batches and cook until they float to the surface (about 2-3 minutes).",
      "timer_seconds": 180
    },
    {
      "step_number": 13,
      "instruction": "Drain and transfer to a bowl."
    },
    {
      "step_number": 14,
      "instruction": "Prepare the Topping"
    },
    {
      "step_number": 15,
      "instruction": "In a separate bowl, mix ground poppy seeds and powdered sugar.",
      "ingredients_used": [
        "da2239f9-dbbe-588e-aeaf-f73d2835d1c6",
        "cce9abc6-6aea-5895-b186-f38f58752d78"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Melt the butter and keep it ready.",
      "ingredients_used": [
        "a6be5499-98bb-569e-ab95-dd0ada488563"
      ]
    },
    {
      "step_number": 17,
      "instruction": "Assemble the Dish"
    },
    {
      "step_number": 18,
      "instruction": "Drizzle the cooked dumplings with melted butter.",
      "ingredients_used": [
        "a6be5499-98bb-569e-ab95-dd0ada488563"
      ]
    },
    {
      "step_number": 19,
      "instruction": "Toss them in the poppy seed-sugar mixture until evenly coated."
    },
    {
      "step_number": 20,
      "instruction": "Serve and Enjoy"
    },
    {
      "step_number": 21,
      "instruction": "Serve warm, optionally with a dusting of extra powdered sugar or a drizzle of honey.",
      "ingredients_used": [
        "cce9abc6-6aea-5895-b186-f38f58752d78"
      ]
    }
  ],
