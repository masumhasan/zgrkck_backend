        "fe14fb7f-0dad-502f-9424-0834003ab660"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add garlic and stir for about 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "0e896a00-c4b9-5a11-a84e-b092d91afb59"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add shredded cabbage and stir. Cook for about about 3-5 minutes, stirring often until softened.",
      "timer_seconds": 300,
      "ingredients_used": [
        "af3bdf59-1075-50ab-83f9-f4fa1978b808"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add corned beef, Roma tomatoes, and thyme and stir. Add ketchup and scotch bonnet pepper sauce and stir. Reduce heat and cook on medium for about 3-5 minutes, until the corned beef is heated through. Remove from heat.",
