  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat olive oil in a skillet or Dutch pot over medium-high heat. Add onion and green pepper and sauté for about 3-5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "19b15982-d9f8-5372-915c-b6d68b3d7237",
        "500628c7-2350-5adc-ba00-568a7a95ec89",
