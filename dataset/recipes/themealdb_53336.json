  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place the dried beans into a Dutch oven with 6 cups (1.5 L) of water. Soak overnight.",
      "ingredients_used": [
        "348fbb92-eacd-59f3-904b-fa46d35a29a7"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Drain and pour beans back into the pot with enough water to cover the beans by a couple of inches, cook for 30 minutes until they are tender but still firm. Drain beans, making sure to reserve cooking liquid, set aside.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "348fbb92-eacd-59f3-904b-fa46d35a29a7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Preheat the oven to 325 °F (160 °C). While the oven is preheating, cook pork over medium-high heat in the Dutch Oven until fat is rendered and pork is beginning to brown, then add the onion cooking until tender.",
      "temperature": {
        "value": 325,
        "unit": "fahrenheit"
      },
      "ingredients_used": [
        "322b5415-c374-5e64-a8bf-3b7113507617"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the beans back to the pot, along with molasses, brown sugar, apple cider vinegar, ground mustard, salt and pepper and 3 cups (750 mL) of reserved bean water.",
      "ingredients_used": [
        "348fbb92-eacd-59f3-904b-fa46d35a29a7",
        "ba34faa3-a722-528d-bec2-739eb33984b5",
        "8efd70d3-4089-5e3a-8216-3be2ecf70a61",
        "5f9e3a6d-3793-55b1-ae79-8e8c3b34e837",
        "6c23e7c6-e791-5945-9ccd-142bcac59ee4",
        "dcc4378e-65b9-5e29-9e54-99dcc3910779",
        "a5fd128d-f135-55f2-8867-ab63ab6e30f6"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Bake uncovered for 3 to 5 hours until the beans are tender, and the sauce has thickened, and the edges of the pot get sticky.",
      "timer_seconds": 18000,
      "ingredients_used": [
        "348fbb92-eacd-59f3-904b-fa46d35a29a7"
      ]
    },
    {
      "step_number": 6,
      "instruction": "(Note: if beans get dry, add another cup of water.)",
      "ingredients_used": [
        "348fbb92-eacd-59f3-904b-fa46d35a29a7"
      ]
    }
  ],
