  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cook the pasta following pack instructions. Heat the oil in a non-stick frying pan and cook the onion, garlic and chilli for 3-4 mins to soften. Stir in the tomato purée and cook for 1 min, then add the pilchards with their sauce. Cook, breaking up the fish with a wooden spoon, then add the olives and continue to cook for a few more mins.",
      "ingredients_used": [
        "979d42e6-8cc7-5384-a2c8-7a241856d5a4",
        "126aac34-d73d-5164-9778-5ec36ddf157a",
        "9abd90f1-95e4-5013-baea-14cd9de10d18",
        "8c836e1b-97ba-58ad-9fc1-476c613dbd12",
        "a20fdbbb-0a0d-59d6-b4de-6ba1603ebb1b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Drain the pasta and add to the pan with 2-3 tbsp of the cooking water. Toss everything together well, then divide between plates and serve, scattered with Parmesan.",
      "ingredients_used": [
        "65b2e534-217c-5ef3-80d0-b230c5543bf8"
      ]
    }
