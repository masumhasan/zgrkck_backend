        "78ac1484-155b-58df-b68a-7244e4420429",
        "d2dfcc42-3fed-5750-9ff6-8450816e96f2"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Drain and rinse the black-eyed peas. Pour into a food processor with the garlic and chili. Purée until smooth. Scrape into a bowl and add the onion, flour, salt, chilli powder and baking powder. Mix and roll into 16 balls.",
      "ingredients_used": [
        "0ef6d01d-412c-535a-be4b-5bd186e46d3a",
        "6dd6a028-86cb-581b-9bf0-611a0a54f674",
        "3b8fdaa3-7d57-5b87-bbc3-6cd547f21451",
        "2d80a48c-7092-5d07-aaba-a4074a51e353",
        "41187469-a39a-5376-88e0-8319898361c8",
        "af96c796-8903-52fe-8f7c-63b891964258",
        "b31e2c84-ee6f-54c5-8bb9-2c75b970d36b",
        "1910bb50-e2a6-5451-aae6-fd410c10cbba"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat the oven to 190C/170C fan/gas 5. Heat 8cm of the palm or vegetable oil in a wok or small heavy pan. When a small piece of bread sizzles, drop 4-5 balls into the oil. Fry until golden and crisp, about 4-5 mins. Drain on kitchen paper and repeat until they are all finished. You can keep them warm in the oven while you finish. Slice the fritters open down the center and spoon the prawn filling in. Serve with hot sauce.",
