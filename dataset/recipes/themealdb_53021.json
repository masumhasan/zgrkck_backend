  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Bring a large pot of lightly salted water to a boil. Place cabbage head into water, cover pot, and cook until cabbage leaves are slightly softened enough to remove from head, 3 minutes. Remove cabbage from pot and let cabbage sit until leaves are cool enough to handle, about 10 minutes.",
      "ingredients_used": [
        "23d201c6-ef40-5abd-8d31-ac995da16999",
        "a7c347ef-bd64-59bf-9f4d-36ae2984cd84"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Remove 18 whole leaves from the cabbage head, cutting out any thick tough center ribs. Set whole leaves aside. Chop the remainder of the cabbage head and spread it in the bottom of a casserole dish.",
      "ingredients_used": [
        "23d201c6-ef40-5abd-8d31-ac995da16999"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Melt butter in a large skillet over medium-high heat. Cook and stir onion in hot butter until tender, 5 to 10 minutes. Cool.",
      "timer_seconds": 600,
      "ingredients_used": [
        "2d83d4f0-2868-516b-b8c1-0cc92ef0d6a9",
        "da57b199-34e2-5f1d-be6b-873a3d82c270"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Stir onion, beef, pork, rice, garlic, 1 teaspoon salt, and 1/4 teaspoon pepper together in a large bowl.",
      "ingredients_used": [
        "da57b199-34e2-5f1d-be6b-873a3d82c270",
        "aeebb693-4299-543c-9760-d5f55a602778",
        "4a6e7d5a-b038-525c-b7c5-875d52860203",
        "5ae0e785-9663-5433-b8b4-5389437fd791",
        "5d80c7c4-d732-5f6d-8844-73108f9b7405",
        "a7c347ef-bd64-59bf-9f4d-36ae2984cd84"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Preheat oven to 350 degrees F (175 degrees C).",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 6,
      "instruction": "Place about 1/2 cup beef mixture on a cabbage leaf. Roll cabbage around beef mixture, tucking in sides to create an envelope around the meat. Repeat with remaining leaves and meat mixture. Place cabbage rolls in a layer atop the chopped cabbage in the casserole dish; season rolls with salt and black pepper.",
      "ingredients_used": [
        "23d201c6-ef40-5abd-8d31-ac995da16999",
        "aeebb693-4299-543c-9760-d5f55a602778",
        "a7c347ef-bd64-59bf-9f4d-36ae2984cd84",
        "77f3b9e6-78ee-5c0e-a685-d799d4bbba21"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Whisk tomato soup, tomato juice, and ketchup together in a bowl. Pour tomato soup mixture over cabbage rolls and cover dish wish aluminum foil.",
      "ingredients_used": [
        "23d201c6-ef40-5abd-8d31-ac995da16999"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Bake in the preheated oven until cabbage is tender and meat is cooked through, about 1 hour.",
      "timer_seconds": 3600,
      "ingredients_used": [
        "23d201c6-ef40-5abd-8d31-ac995da16999"
      ]
    }
  ],
