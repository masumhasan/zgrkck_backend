  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cook the potato in boiling water for 8-10 mins or until tender. Drain and allow to steam-dry.",
      "timer_seconds": 600
    },
    {
      "step_number": 2,
      "instruction": "Heat oil in an omelette pan, add chorizo and cook for 2 mins. Add the potato and cook for a further 5 mins until the potato starts to crisp.",
      "ingredients_used": [
        "56bda8f6-2944-517c-a5f0-59e2df2b5bc4"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Spoon pan contents out, wipe pan and cook a 2 or 3-egg omelette in the same pan. When almost cooked, scatter with the chorizo and potato, parsley and cheese.",
      "ingredients_used": [
        "56bda8f6-2944-517c-a5f0-59e2df2b5bc4",
