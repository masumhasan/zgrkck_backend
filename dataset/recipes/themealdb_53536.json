  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add all the ingredients in the Instant pot, Lock the lid on and set the Instant Pot to High Pressure for 35 minutes. Once the beans are done cooking, let the pressure release naturally for 20 minutes before releasing the remaining pressure. Open and serve!",
      "ingredients_used": [
        "c311530e-3bf8-5aeb-afb4-6095fb27a7b5"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Let the beans get cool completely before saving them in the fridge or freezer.",
