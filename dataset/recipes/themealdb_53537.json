  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 350 degrees F (175 degrees C).",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "​"
    },
    {
      "step_number": 3,
      "instruction": "Grease and flour a 12 x 8' pyrex (you can use a smaller pyrex if you prefer the bread to be thicker).",
      "ingredients_used": [
        "a0c37c6e-8098-5b3f-9e35-44b020415a9e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Peel and shred the yucca and set aside. In a medium bowl, combine flour, baking powder and salt and set aside.",
      "ingredients_used": [
        "4a451c59-cf97-55a1-8112-1f6a1517ee3f",
        "a0c37c6e-8098-5b3f-9e35-44b020415a9e",
        "76a4e3ca-624a-5cc4-9573-0115fd850ed6",
        "72a4c5ae-7208-58b0-abc2-87e77d8480cf"
      ]
    },
    {
      "step_number": 5,
      "instruction": "​"
    },
    {
      "step_number": 6,
      "instruction": "In a large bowl cream the butter with the sugar. Beat in the eggs, one at a time, then stir in the vanilla.",
      "ingredients_used": [
        "120f33ab-68c2-58c1-b248-6731a52ad374",
        "f913501a-5ae3-5541-853c-3f015e98c01b",
        "62f8166e-9244-5aaa-bf71-c2b432275b24",
        "fe9054b2-bd42-582f-801c-81e2307f407b"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add half of the dry ingredients and mix well, add cream cheese, mix well and, add the other half of the dry ingredients and mix well.",
      "ingredients_used": [
        "db7de89a-3e6e-578b-a38c-3d393a70ad5e"
      ]
    },
    {
      "step_number": 8,
      "instruction": "With a wooden spoon incorporate the shredded yucca, until well incorporated.",
      "ingredients_used": [
        "4a451c59-cf97-55a1-8112-1f6a1517ee3f"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Pour or spoon batter into the prepared pan and cook for 45 to 55 min.",
      "timer_seconds": 3300
    }
