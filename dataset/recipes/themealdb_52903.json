  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Melt the butter with the oil in a large heavy-based pan. Add the onions and fry with the lid on for 10 mins until soft. Sprinkle in the sugar and cook for 20 mins more, stirring frequently, until caramelized. The onions should be really golden, full of flavor and soft when pinched between your fingers. Take care towards the end to ensure that they don’t burn.",
      "ingredients_used": [
        "6d9fff7f-731a-5e57-a50d-58d4941d1fed",
        "9acbc833-4887-5cd8-98c5-a594c3beeddd",
        "28ff3f72-92ab-55d0-a59a-ccd61fce2b43"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the garlic for the final few mins of the onions’ cooking time, then sprinkle in the flour and stir well. Increase the heat and keep stirring as you gradually add the wine, followed by the hot stock. Cover and simmer for 15-20 mins.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "9acbc833-4887-5cd8-98c5-a594c3beeddd",
        "e8e1f028-02de-5b4c-bb8e-51ef40974d2d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "To serve, turn on the grill, and toast the bread. Ladle the soup into heatproof bowls. Put a slice or two of toast on top of the bowls of soup, and pile on the cheese. Grill until melted. Alternatively, you can complete the toasts under the grill, then serve them on top.",
      "ingredients_used": [
        "00203f55-36e6-59dc-9da2-8f4885d74d45"
      ]
    }
  ],
