  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Scrub the potatoes well but don't peel them. Cut them into bite-size pieces. Add them to a large pan water and a pinch of salt. Bring it to a good boil. Cook the potatoes until tender and then remove them using a slotted spoon. Keep the potatoes at room temperature.",
      "ingredients_used": [
        "74e5cc9a-a528-50de-af32-6a4249b19d83",
        "b13eef61-bc83-53cc-89fd-0fc6d5eaacae"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Trim and clean the green beans. Add them to the pan of hot water you boiled the potatoes in. Cook the green beans until nearly tender (keep them crunchy). Strain and refresh them immediately under cold running tap water to stop the cooking process.",
      "ingredients_used": [
        "74e5cc9a-a528-50de-af32-6a4249b19d83",
        "5e42e60d-df8a-53ec-9def-e3c0b5f82926"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the bacon to a large non-stick pan and place it over medium heat. Cook the bacon for a couple of minutes until cooked through. Then take the pan off the heat and let the bacon cool down a little.",
      "ingredients_used": [
        "3ba64168-58a0-57de-aebc-1cc7a889bf6b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Combine the olive oil, vinegar and mustard. Transfer the cooked potatoes, green beans, bacon, chopped onion, parsley and vinaigrette. Season with pepper and salt.",
      "ingredients_used": [
        "74e5cc9a-a528-50de-af32-6a4249b19d83",
        "5e42e60d-df8a-53ec-9def-e3c0b5f82926",
        "3ba64168-58a0-57de-aebc-1cc7a889bf6b",
        "ac9cee91-f159-5224-8baf-ad2e646a99ec",
        "5c481c3c-e9dc-53a4-a80a-b8fa618956bc",
        "67021b49-d2c7-50f2-ad65-677cc16236c4",
        "10e0b668-468f-5d89-95a9-0a9075331053",
        "93467acb-fdde-5bac-9637-deeabe0bd092",
        "b13eef61-bc83-53cc-89fd-0fc6d5eaacae"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Stir well. Check the seasoning and add extra vinegar, pepper or salt to taste. Transfer the salad to a large serving bowl or 2 deep plates and garnish with the boiled eggs. Serve lukewarm.",
      "ingredients_used": [
        "b5cbad9c-c3fc-5bef-b025-18594a2a4db7",
        "93467acb-fdde-5bac-9637-deeabe0bd092",
        "b13eef61-bc83-53cc-89fd-0fc6d5eaacae"
      ]
    }
  ],
