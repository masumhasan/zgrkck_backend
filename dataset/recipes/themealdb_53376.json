  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Coat the chicken with egg white:",
      "ingredients_used": [
        "6332e7f2-5c98-5fb5-b63b-f0c936a5eb2a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a bowl, combine the chicken with the egg white, 1/2 teaspoon kosher salt, and cornstarch. Stir to coat the chicken evenly. Let sit for 15 minutes at room temperature or up to overnight in the refrigerator.",
      "timer_seconds": 900,
      "ingredients_used": [
        "6332e7f2-5c98-5fb5-b63b-f0c936a5eb2a",
        "718cf065-4b5d-5339-a305-e8f85606e4d0",
        "fff8dfc0-5f8b-52fd-a722-06f0ebce53cb"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Make the sweet and sour sauce:"
    },
    {
      "step_number": 4,
      "instruction": "Whisk together the pineapple juice, vinegar, ketchup, 1/2 teaspoon kosher salt, and brown sugar.",
      "ingredients_used": [
        "718cf065-4b5d-5339-a305-e8f85606e4d0",
        "414e990c-aa56-57cd-aa0f-c67ad2bbb8ad",
        "aba333ba-f8b9-51f9-bb7c-b952538a7d3e",
        "b020201d-f75f-5405-b9a5-be825ea31e65"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Stir-fry the chicken over high heat:"
    },
    {
      "step_number": 6,
      "instruction": "Heat a large frying pan or wok over high heat until a bead of water instantly sizzles and evaporates. Pour in 1 tablespoon of cooking oil and swirl to coat. It's important that the pan is very hot.",
      "ingredients_used": [
        "1a15ce8c-5164-576e-beba-402343cd8b6f"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add the chicken and spread the pieces out in one layer. Let the chicken fry untouched for 1 minute, until the bottoms are browned.",
      "timer_seconds": 60
    },
    {
      "step_number": 8,
      "instruction": "Flip and fry the other side for 1 minute. The chicken should still be pinkish in the middle. Dish out the chicken onto a clean plate, leaving as much oil in the pan as possible.",
      "timer_seconds": 60,
      "ingredients_used": [
        "1a15ce8c-5164-576e-beba-402343cd8b6f"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Stir-fry the bell pepper and ginger:",
      "ingredients_used": [
        "2d29f92f-eef2-5926-a039-9330ea33abce"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Reduce the heat to medium and add the remaining 1 teaspoon of cooking oil. Let the oil heat up before adding the bell pepper chunks and ginger. Fry for 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "636ab935-6111-53e8-8fe4-38b5a9d5f9a0",
        "1a15ce8c-5164-576e-beba-402343cd8b6f",
        "2d29f92f-eef2-5926-a039-9330ea33abce"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Add the pineapple, sauce, and then, the chicken:"
    },
    {
      "step_number": 12,
      "instruction": "Add the pineapple chunks and the sweet and sour sauce. Turn up the heat to high. When the sauce is simmering, add the chicken pieces back in.",
      "ingredients_used": [
        "636ab935-6111-53e8-8fe4-38b5a9d5f9a0"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Let simmer for 1 to 2 minutes, until the chicken is cooked through. Timing depends on how thick you've cut your chicken. The best way to tell if the chicken is done is to take a piece out and cut into it. If it's pink, add another minute to the cooking.",
      "timer_seconds": 120
    },
    {
      "step_number": 14,
      "instruction": "Adjust the seasoning and serve:"
    },
    {
      "step_number": 15,
      "instruction": "Taste the sauce and add more brown sugar or vinegar to suit your tastes, if you’d like.",
      "ingredients_used": [
        "b020201d-f75f-5405-b9a5-be825ea31e65"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Serve hot with steamed white or brown rice.",
      "ingredients_used": [
        "6332e7f2-5c98-5fb5-b63b-f0c936a5eb2a"
      ]
    }
  ],
