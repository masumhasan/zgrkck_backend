  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Pour the chicken stock and coconut milk into a large saucepan set over a medium heat. Tip in the galangal, lemongrass and lime leaves, and bring to a gentle simmer, around 6-8 mins. Keeping at a gentle simmer, add the chicken. Cook for 8-10 mins until tender and cooked through.",
      "ingredients_used": [
        "27ddcb30-bafd-51ad-8270-7375c2f6a7a0",
        "7bc08f4f-d969-5fd8-8e05-3c14c2d49d7b",
        "3d3acb06-4dbe-5314-aeda-a90b32ad4be3",
        "d5dcf05e-dec7-5b0a-987c-9b5bc9d74784"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Stir in the mushrooms and chillies, and simmer for a further 3-5 mins until everything is cooked through. Sprinkle in the sugar and 3 tbsp each of the fish sauce and lime juice. Taste and add the remaining if required.",
      "timer_seconds": 300,
      "ingredients_used": [
        "43523449-34d3-5593-8a9e-8153df83adee",
        "904dde68-12df-5f0b-8bd2-345ae6bda3be",
        "44264fd1-ac20-5fa7-af05-9f21ac05a831",
        "d5dcf05e-dec7-5b0a-987c-9b5bc9d74784"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Remove the galangal, lemongrass and lime leaves before serving using a slotted spoon. Ladle into bowls and serve with coriander leaves sprinkled over and steamed rice on the side. Will keep chilled for up to three days. Leave to cool first.",
      "ingredients_used": [
        "3d3acb06-4dbe-5314-aeda-a90b32ad4be3",
        "d5dcf05e-dec7-5b0a-987c-9b5bc9d74784",
        "9c92e6b1-3085-5e48-8a42-78d4d09228df",
        "de29cefd-57a5-5f82-b063-ecf2a4ee05bd"
      ]
    }
  ],
