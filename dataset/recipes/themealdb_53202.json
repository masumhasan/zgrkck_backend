  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Nestle the fish fillets side by side on a large square of foil and scatter the ginger, garlic, chilli and lime zest over them. Drizzle the lime juice on top and then scatter the pieces of pak choi around and on top of the fish. Pour the soy sauce over the pak choi and loosely seal the foil to make a package, making sure you leave space at the top for the steam to circulate as the fish cooks.",
      "ingredients_used": [
        "19c2880c-c178-5ba7-b6f4-a2a9961ef061",
