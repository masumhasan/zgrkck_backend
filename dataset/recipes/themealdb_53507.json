  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel and cut potatoes in cubes, boil in salted water until tender. Chop peppers and onion and set aside.",
      "ingredients_used": [
        "64b41d82-7657-53b6-a52e-6dde9ed8fa71",
        "e9984d97-fe21-59a7-9d26-79450afd2ecc"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Mix together mayonnaise, mustard, sugar and black pepper and set aside. Drain potatoes once tender and place in large mixing bowl.",
      "ingredients_used": [
        "64b41d82-7657-53b6-a52e-6dde9ed8fa71",
        "d962b412-824f-5213-9b3b-c2f4913be29a",
