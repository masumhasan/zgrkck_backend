  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare the Steak: Season the steak with salt and pepper. Grill one side until half-cooked.",
      "ingredients_used": [
        "57d2e220-f804-5c92-a19d-9762285c2144",
        "db44f21a-18dd-5711-8a6f-7a7061b70f77",
        "58f8d364-ecde-5ba3-9a8d-dfb9af9f7742"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add Toppings: Spread tomato sauce over the cooked side, then add cheese, oregano, and olives.",
      "ingredients_used": [
        "28ce0b7c-212f-51dc-9e43-ebc78ad43c8e",
        "cd030bbb-105d-5a17-bd29-3cb696645dab",
        "03ea5b36-81f8-5652-9b47-084f705d96f4"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Finish Grilling: Grill until the cheese is melted and bubbly."
    },
    {
      "step_number": 4,
      "instruction": "Serve: Slice and serve hot."
    },
    {
      "step_number": 5,
      "instruction": "Pro Tips:"
    },
    {
      "step_number": 6,
      "instruction": "Tenderize the matambre by scoring it lightly on both sides. This helps it cook more evenly and absorb the flavors."
    },
    {
      "step_number": 7,
      "instruction": "Precook the matambre on the grill before adding the toppings to ensure it's fully cooked without burning the cheese."
    }
  ],
