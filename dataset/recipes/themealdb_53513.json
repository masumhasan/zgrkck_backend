  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel, seed, and cut zapallo into chunks. Place in a saucepan, cover with water, and bring to a boil over medium-high heat. Cook until zapallo is soft and easily pierced with a fork, 15 to 20 minutes. Drain and allow to cool slightly.",
      "timer_seconds": 1200
    },
    {
      "step_number": 2,
      "instruction": "Mix flour, baking soda, and salt together in a mixing bowl, and set aside. Stir together squash and melted butter. Stir the flour mixture into the butter mixture until blended. Turn the dough out onto a lightly floured surface and knead until soft and satiny, adding a little more flour if necessary. Cover dough with a towel and allow to rest 15 minutes.",
      "timer_seconds": 900,
      "ingredients_used": [
        "eac947af-2c1d-5ad0-9d45-84625dacfeb7",
        "bcf3e158-416f-56f4-ba64-5c71eca1fa70",
        "c1b3d11d-f562-5f2a-895a-904bd95ea7c7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Roll out the dough to 1/8-inch thick, and cut into 3-inch diameter circles. Poke each circle a few times with a fork to make holes and prevent rising."
    },
    {
      "step_number": 4,
      "instruction": "Pour oil into a large, deep skillet and heat over medium-high heat until hot, 385 degrees F (195 degrees C). Place several of the dough circles into hot oil; cook until lightly browned, 3 to 4 minutes. Drain on paper towels. Cook remainder of dough circles in batches.",
      "timer_seconds": 240,
      "temperature": {
        "value": 385,
        "unit": "fahrenheit"
      }
    }
  ],
