  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Season shrimp with 1 Tablespoon of curry powder and all-purpose seasoning and set aside for about 10 minutes while you prepare the other ingredients like chopping your onions, peppers, and garlic.",
      "timer_seconds": 600,
      "ingredients_used": [
        "4174e986-dfc2-52f1-bc97-59c8af7b7cb0",
        "9f31d0fd-72bd-566c-b9ee-25ec6cf58b57",
        "c4c407d9-fab0-5556-b003-fdabb7146aa1",
        "cbef6911-6b3f-5df7-b920-2623efd5c412"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat 2 Tablespoons of olive oil in a large skillet over medium heat. Add sliced yellow onion, red bell pepper, green bell pepper, scotch bonnet pepper, if using, and chopped garlic and stir for 5 minutes, until peppers are slightly softened.",
      "timer_seconds": 300,
      "ingredients_used": [
        "64345002-7740-50ab-b782-f36dca760137",
        "c4c407d9-fab0-5556-b003-fdabb7146aa1",
        "cc31e5b3-9ea8-582d-b897-59d3e131875a",
        "cbef6911-6b3f-5df7-b920-2623efd5c412",
        "89c93373-2145-592b-820d-f6a629900fb8"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add 1.5 Tablespoons of curry powder to the skillet and stir for an additional minute."
    },
    {
      "step_number": 4,
      "instruction": "Then add coconut milk, seasoned shrimp, ketchup, and thyme, making sure the shrimp is covered in the sauce.",
      "ingredients_used": [
        "4174e986-dfc2-52f1-bc97-59c8af7b7cb0",
        "d37762c8-cebc-591c-98ce-ed2a353da49a",
        "20d23805-312a-5561-93c6-ff6a2f696cb1",
        "7cae367a-cd46-5681-b571-9dc3800c211c"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Allow the sauce to come to a simmer and continue to cook over medium heat, stirring occasionally and flipping the shrimp halfway, until the shrimp is fully cooked on both sides. This should take about 5-6 minutes. Salt and pepper to taste.",
      "timer_seconds": 360,
      "ingredients_used": [
        "4174e986-dfc2-52f1-bc97-59c8af7b7cb0",
        "af273ab1-037a-5f49-a5cf-bd37bf77e195",
        "89c93373-2145-592b-820d-f6a629900fb8"
      ]
    }
  ],
