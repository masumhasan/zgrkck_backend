  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place the meat cut into pieces, in a large pan with the onions. Add the turmeric and enough water to cover. Bring to the boil then cook gently until the meat is very tender and can easily be removed from the bones.",
      "ingredients_used": [
        "4c265c12-5ebb-5a74-b49d-54bc864a30ed",
        "3cbb1d39-1913-52b4-8089-93d53f7b40e2"
      ]
    },
    {
      "step_number": 2,
      "instruction": "While the meat is cooking, cut the orange peel into thin match style pieces, removing as much pith as possible. Leave to soak in a bowl of water.",
      "ingredients_used": [
        "58f81565-e751-5f49-97e6-2974bf6e74fe"
      ]
    },
    {
      "step_number": 3,
      "instruction": "When the meat is tender, remove from the pan and when cool enough, remove the meat from the bones and shred the meat into strips with your hands. Return the meat to the pan."
    },
    {
      "step_number": 4,
      "instruction": "Wash the short grain rice and then add to the pan with salt according to taste. The juices should cover the rice by about 2cm, add more water if necessary. Bring back to the boil, then reduce the heat to medium and cook with the lid off, stirring from time to time until the rice is \"al dente\" and the liquid is absorbed.",
      "ingredients_used": [
        "f6832eba-8f2f-5316-9fbe-2bd53556c881",
        "3333a038-8c8f-5978-afc2-5ca1bc19b9ce"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the natural yogurt, and stir in well but carefully. Fry the crushed cloves of garlic in the oil and add to the dish along with the dill, black pepper, the chickpeas and extra salt to taste.",
      "ingredients_used": [
        "84fa76d8-6a8c-5c5e-9dad-105158f41738",
        "e9809cf6-6c39-515c-9e38-2e8d4f3ead68",
        "a0e4b1b5-85d3-5bf9-8a55-99b1b9b68a56",
        "388171c5-5e36-5a31-be7b-053f931bfead",
        "cda86302-97ab-52c5-9ab4-e2f050276713",
        "3333a038-8c8f-5978-afc2-5ca1bc19b9ce"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Mix in well, then cover the top of the pan with a clean thick cloth and the lid. Leave on a low heat for about half an hour to allow the flavors to absorb."
    },
    {
      "step_number": 7,
      "instruction": "Enjoy with some warm nan bread for extra comfort."
    }
  ],
