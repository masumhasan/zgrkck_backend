  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oven to 200C/fan 180C/gas. Mix the sugar into the bread mix in a large bowl, then add water as instructed on the pack. Bring the dough together with a wooden spoon, then knead on a lightly floured surface for 5 mins until smooth. Put into a large bowl, cover with oiled cling film then leave in a warm place until doubled in size.",
      "timer_seconds": 300,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "0a4b8356-5572-5034-ba3c-d9fb25b796fe"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Meanwhile, heat the oil in a pan, then fry the bacon until crisp, about 5 mins. Add the ginger and garlic and fry for 1 min until soft, then tip in the soy, honey and tomato purée and stir well. Can be made up to 3 days ahead.",
      "ingredients_used": [
        "671280d5-82d1-5b42-868f-bd6f6452982f",
        "7b7f7f8b-7b1d-5abc-a18f-886f89b9f973",
        "b9301fb0-dad7-5bf5-a377-ab4d27109a5e",
        "8f8fda8d-1163-58b8-820b-99a5681d7811"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Turn out the dough and knead briefly, then pull into 12 even-sized balls. Flatten with your hands, then put a teaspoon-size blob of the filling in the middle. Draw the dough up and pinch it closed like a purse, then turn the bun over and sit it on a large baking sheet. Cover with oiled cling film and leave to rise for about 30 mins until the dough feels pillowy. Brush with egg and bake for 20 mins until golden. Serve warm with dipping sauce. Can be frozen after second rise for up to 1 month or baked up to a day ahead and re-warmed.",
      "ingredients_used": [
        "55934e3d-9f2e-51a9-be00-980cdfe6378b"
      ]
    }
  ],
