  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place the potatoes and chicken bouillon in a medium saucepan. Cover with water and bring to a boil and cook about 30 minutes until tender. Drain and set a side.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "988c5c7c-356b-5227-a513-bade6f2bcd5d",
        "5d6bfbd4-a6ab-522a-b531-1dda873c4686"
      ]
    },
    {
      "step_number": 2,
      "instruction": "While the potatoes are cooking, heat the oil and butter in a frying pan over medium heat. Add onion and tomatoes, stir and cook about 7 minutes. Add garlic powder, cumin, salt and pepper. Stir and cook 2 minutes more.",
      "ingredients_used": [
        "988c5c7c-356b-5227-a513-bade6f2bcd5d",
        "b1203ddb-3936-5e40-806c-9df4250b34eb",
        "c5e106e8-6be7-5b92-91c7-da127de74709",
        "660ee8f5-be3c-56ed-aec0-b962456fc92b",
        "0315e993-7839-5669-8da9-fb201fd3ea44",
        "a8846482-62e1-5eec-a833-1b4a583fca4f",
        "21e41e71-2e91-5ba9-97a0-22f572773f09"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add cream, cilantro and cheese. Mix well and turn down the heat and cook for 3 minutes or until cheese has melted.",
      "timer_seconds": 180,
      "ingredients_used": [
        "d4bbd64e-d608-5611-a554-04584f83f0eb"
      ]
    },
    {
      "step_number": 4,
      "instruction": "In a serving dish place the potatoes and pour the sauce on top. Serve them hot.",
      "ingredients_used": [
        "988c5c7c-356b-5227-a513-bade6f2bcd5d"
      ]
    }
  ],
