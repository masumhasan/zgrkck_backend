  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix all the ingredients for the dressing together in a bowl with 1 tbsp water until the sugar has dissolved."
    },
    {
      "step_number": 2,
      "instruction": "Cook the noodles following pack instructions, then plunge into a bowl of cold water to cool completely. Drain the noodles, then add the carrot, cabbage, spring onion and dressing, and toss to combine.",
      "ingredients_used": [
        "bc217995-a5b3-5510-a72b-c566adac993c",
        "56cf8c42-7ff2-5fd2-b638-1168e0e4ad9b"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat the oil in a frying pan over a high heat. Season the steak, then cook to your liking; 2-3 mins on each side for medium rare. Leave to rest for 5 mins, then slice. Divide the salad and steak slices between bowls and scatter over some coriander to serve.",
      "ingredients_used": [
        "d86a8416-8118-5a62-a2c9-c5832e26945e",
        "47498730-d9dc-505b-be26-4de8d146351f"
      ]
    }
  ],
