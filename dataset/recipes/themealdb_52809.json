  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Soak all the spices, ginger, garlic, tamarind pulp and kashmiri chilies except oil in vinegar.",
      "ingredients_used": [
        "d6927003-aec7-5fe6-9a1c-e89167846ae1",
        "5cb6ba62-f501-5679-942c-da790d5923bc",
        "889f9e29-a3c1-5bb0-97c3-27dd7a0a8c6b",
        "eb3c3db6-dd46-57a4-821b-2323067bb266"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add sugar and salt.",
      "ingredients_used": [
        "5ae74f75-794a-56d7-b4a3-3a4fe50dd5ac"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Also add turmeric powder.",
      "ingredients_used": [
        "6270729d-e09a-5aab-95c5-4bc9d9d59cac"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Combine all nicely and marinate for 35-40 mins.",
      "timer_seconds": 2400
    },
    {
      "step_number": 5,
      "instruction": "Grind the mixture until soft and smooth. Add more vinegar if required but ensure the paste has to be thick so add vinegar accordingly. If the masala paste is thin then it would not stick to the fish.",
      "ingredients_used": [
        "6a3abd7f-b0e5-503c-8ffe-5ab364493ee1",
        "889f9e29-a3c1-5bb0-97c3-27dd7a0a8c6b"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Rinse the fish slit from the center and give some incision from the top. You could see the fish below for clarity."
    },
    {
      "step_number": 7,
      "instruction": "Now stuff the paste into the center and into the incision. Coat the entire fish with this paste. Marinate the fish for 30 mins.",
      "timer_seconds": 1800
    },
    {
      "step_number": 8,
      "instruction": "Place oil in a shallow pan, once oil is quite hot shallow fry the stuffed mackerels.",
      "ingredients_used": [
        "d7eceab0-8f1b-5a30-a2a3-5b413a539f04",
        "eb3c3db6-dd46-57a4-821b-2323067bb266"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Fry until golden brown from both sides"
    },
    {
      "step_number": 10,
      "instruction": "Serve the recheado mackerels hot with salad, lime wedges, rice and curry.",
      "ingredients_used": [
        "d7eceab0-8f1b-5a30-a2a3-5b413a539f04"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Notes"
    },
    {
      "step_number": 12,
      "instruction": "Ensure the masala paste is thick else the result won't be good."
    },
    {
      "step_number": 13,
      "instruction": "If you aren't able to find kashmiri chilies then use bedgi chilies or kashmiri red chili powder."
    },
    {
      "step_number": 14,
      "instruction": "You could use white vinegar or coconut vinegar.",
      "ingredients_used": [
        "889f9e29-a3c1-5bb0-97c3-27dd7a0a8c6b"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Any left over paste could be stored in the fridge for future use."
    },
    {
      "step_number": 16,
      "instruction": "Cinnamon could be avoided as it's a strong spice used generally for meat or chicken."
    }
  ],
