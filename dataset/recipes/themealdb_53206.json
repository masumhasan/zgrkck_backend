  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Toss the chicken, garlic, ginger, onion, coriander and chilli into a food processor and season well. Blitz until the chicken is finely ground and everything is well mixed. Use your hands to shape six small cakes.",
      "ingredients_used": [
        "214a6d2e-a328-5d88-95b9-b698f860717f",
        "0980d073-8a45-559f-be18-f9bb2f0d31d3",
