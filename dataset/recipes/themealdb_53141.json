  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Brown the Beef: In a large pot, brown the beef cubes. Remove and set aside.",
      "ingredients_used": [
        "be96151b-3770-5f97-aaf4-833c4c538855"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Sauté Vegetables: In the same pot, cook the onion until translucent. Add carrots, potatoes, and pumpkin, cooking for a few minutes.",
      "ingredients_used": [
        "483f7b5f-07b1-5601-92b5-b02a1962b587",
        "ba0b30f6-2145-5ced-9506-6952cb66991b",
        "cf8a86a6-4581-54ae-b7a5-1848b0ab3f36",
        "82ea0b4f-7ca1-567d-b293-ed5827234a28"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Simmer: Return the beef to the pot. Add broth and dried apricots. Season with salt and pepper. Simmer for 1-2 hours, until the beef is tender.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "be96151b-3770-5f97-aaf4-833c4c538855",
        "81a4136e-5e62-5550-adde-e7935463f983",
        "2e1a375b-94d9-582f-b14e-b5690aba50a9",
        "4d796a08-a0b7-5fff-bc12-6eb6c79b1936"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Serve: Enjoy hot, with a crusty piece of bread."
    },
    {
      "step_number": 5,
      "instruction": "Pro Tips:"
    },
    {
      "step_number": 6,
      "instruction": "Brown the beef in batches to ensure it gets a good sear, which adds depth to the stew's flavor.",
      "ingredients_used": [
        "be96151b-3770-5f97-aaf4-833c4c538855"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Adding the fruits towards the end of cooking preserves their texture and adds a subtle sweetness to the dish."
    }
