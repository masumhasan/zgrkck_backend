  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prep:15min  ›  Cook:30min  ›  Ready in:45min"
    },
    {
      "step_number": 2,
      "instruction": "For the curry sauce: Heat oil in medium non-stick saucepan, add onion and garlic and cook until softened. Stir in carrots and cook over low heat for 10 to 12 minutes.",
      "timer_seconds": 720,
      "ingredients_used": [
        "c16455bc-baa4-54f7-9872-2973e4b9b0f4",
        "f76c20d5-5bc0-58e1-adce-bee0ff6b3112"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add flour and curry powder; cook for 1 minute. Gradually stir in stock until combined; add honey, soy sauce and bay leaf. Slowly bring to the boil.",
      "timer_seconds": 60,
      "ingredients_used": [
        "85aeaed4-d80e-5b9c-9c39-d1ee341d8158",
        "39e1b6d9-878d-572f-90e3-d2383d1ed3d0",
        "2e12773a-ab8b-546f-9b66-15d1bf85ea23",
        "9bdf2e08-d778-52dc-9a8d-95f883e55e4e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Turn down heat and simmer for 20 minutes or until sauce thickens but is still of pouring consistency. Stir in garam masala. Pour the curry sauce through a sieve; return to saucepan and keep on low heat until ready to serve.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "1335d128-1ca6-5e39-ba00-e2f25da82d4f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "For the chicken: Season both sides of chicken breasts with salt and pepper. Place flour, egg and breadcrumbs in separate bowls and arrange in a row. Coat the chicken breasts in flour, then dip them into the egg, then coat in breadcrumbs, making sure you cover both sides.",
      "ingredients_used": [
        "7445c3cf-85ff-5aa9-8596-7d26dd8da4f4",
        "7f7d9ece-70a7-5b58-bc24-fa4b7e56e4d1",
        "e7663a56-4083-520d-b059-37dc3436813a"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Heat oil in large frying pan over medium-high heat. Place chicken into hot oil and cook until golden brown, about 3 or 4 minutes each side. Once cooked, place on kitchen paper to absorb excess oil.",
      "timer_seconds": 240
    },
    {
      "step_number": 7,
      "instruction": "Pour curry sauce over chicken, serve with white rice and enjoy!"
    }
  ],
