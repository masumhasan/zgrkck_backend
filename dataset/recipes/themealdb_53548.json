  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 450°. Bring a large pot of water to a boil. Trim ends of yuca and cut each one in half, widthwise. Stand them on their ends and use a sharp knife to cut the waxy peel off. Cut each piece in half lengthwise and then cut in half lengthwise one more time to create 16 pieces total. Trim the fibrous center out of each piece.",
      "ingredients_used": [
        "475e9108-1989-5dfa-9c52-92365bc015b9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Place cut yuca into boiling water and let boil until fork tender, 8 to 10 minutes. Using a slotted spoon, remove from pot and place on a paper towel lined cutting board. Pat dry with another paper towel.",
      "timer_seconds": 600,
      "ingredients_used": [
        "475e9108-1989-5dfa-9c52-92365bc015b9"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Place dried yuca into a large bowl and toss with oil. Season with chili powder, salt, and pepper and toss again to evenly coat. Place yuca on a large baking sheet in an even layer.",
      "ingredients_used": [
        "475e9108-1989-5dfa-9c52-92365bc015b9",
        "cbd68372-e68b-5538-bef4-ab7ab1145dd8"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Bake until golden and crispy, about 25 minutes, tossing halfway through.",
      "timer_seconds": 1500
    },
    {
      "step_number": 5,
      "instruction": "Meanwhile make dipping sauce: In a small food processor or blender, combine avocado, sour cream, lime juice, and cilantro and blend until smooth. Season with salt and pepper.",
      "ingredients_used": [
        "cbd68372-e68b-5538-bef4-ab7ab1145dd8",
        "f2665240-8c6e-5174-bf12-d2e7808e84d9",
        "e2aea675-1928-5bf8-b794-e4e9f174f754",
        "da8e6416-dfff-5fe2-99c9-741a685c3116",
        "1a9abfab-6356-58bb-8149-68f400dffc49"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Serve fries immediately with dipping sauce."
    }
  ],
