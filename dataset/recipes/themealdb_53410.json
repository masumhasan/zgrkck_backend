  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cooking"
    },
    {
      "step_number": 2,
      "instruction": "Fry the leeks in a small dash of olive oil for a few minutes until they start to brown.",
      "ingredients_used": [
        "852cd83d-c70a-5c56-a6cc-9c1433a12382",
        "c216d88c-2c2b-59f4-9a06-8f7f54878bfa"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the onions and mince and fry until everything is browned. Ensure you keep stirring to prevent the leeks catching and burning.",
      "ingredients_used": [
        "852cd83d-c70a-5c56-a6cc-9c1433a12382",
        "21484ff5-d988-5141-8321-588467298843",
        "3a9b57f4-8b91-588f-8d67-5fecb11f5e22"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the rice and stir together for a few minutes ensuring the rice is well blended and coated in any juices.",
      "ingredients_used": [
        "8b33dbc3-816e-5678-bcd5-c4e0fe11491f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the lamb stock, salt and pepper. Give it a good stir and leave it to come to the boil. Leave to boil for 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "27df05fc-1b48-52f6-84ea-82c93a8c1163",
        "ca3c3414-3341-58a6-b486-a1f35d973f79",
        "c8aeb5bf-e968-5593-8530-5b8a7eadd288"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Baking"
    },
    {
      "step_number": 7,
      "instruction": "Pour the mixture into a large baking tray, place on the bottom self of a preheated oven at 180 degrees. Leave to bake for up to 1 hour. The dish is ready when all the liquid is evaporated and the rice is soft.",
      "timer_seconds": 3600,
      "ingredients_used": [
        "8b33dbc3-816e-5678-bcd5-c4e0fe11491f"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Serving"
    },
    {
      "step_number": 9,
      "instruction": "Once cooked turn off the oven and keeping the door open leave the leek and rice bake to cool for 10 minutes before serving.",
      "timer_seconds": 600,
      "ingredients_used": [
        "852cd83d-c70a-5c56-a6cc-9c1433a12382",
        "8b33dbc3-816e-5678-bcd5-c4e0fe11491f"
      ]
    }
  ],
