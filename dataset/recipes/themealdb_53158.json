  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Soak the potatoes in just-boiled water for 30 mins, then drain and leave to air-dry for 5 mins. Heat the air fryer to 200C. Tip the potatoes into a bowl and drizzle over 1 tbsp of the oil and add 1/2 tsp each of salt and freshly ground black pepper. Mix to coat the potatoes all over, then tip into the air fryer basket and cook for 20-30 mins until crisp and golden.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "303c4fb7-5c00-50ec-9b42-6be2befab974"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Meanwhile, heat the remaining oil in a small pan over a medium-low heat and fry the onion for 8-10 mins until softened but not golden. Stir in the garlic and cook for a minute before adding the paprika and cooking for 30 seconds more. Stir in the tomato purée, cook for 1 min, then tip in the chopped tomatoes. Cook for 5-10 mins over a medium heat until thickened slightly.",
      "ingredients_used": [
        "cb0d1f8e-fcb7-5d60-839a-801ee61f100f",
        "b31c0af8-9f4c-5bb5-b0a7-52ed51632f50",
        "2db5eea5-893e-5cc7-8763-45452c769a78"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Once the potatoes are cooked, tip out onto a platter and pour over the tomato sauce. Sprinkle with the basil leaves, then serve.",
      "ingredients_used": [
        "303c4fb7-5c00-50ec-9b42-6be2befab974",
        "5636fd5d-f774-5f72-a9e8-03be15633454"
      ]
    }
  ],
