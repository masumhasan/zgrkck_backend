  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Before you do anything, freeze your bacon slices that way when you're ready to prep, it'll be so much easier to chop!",
      "ingredients_used": [
        "ab3e2ddd-5bd0-530f-b291-87aeab4d2785"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Wash the potatoes and cut medium dice into square pieces. To prevent any browning, place the already cut potatoes in a bowl filled with water.",
      "ingredients_used": [
        "458b0aae-f50b-5bb9-aa6e-bf359f453772"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In the meantime, heat 1-2 tablespoons of oil in a large skillet over medium-high heat. Tilt the skillet so the oil spreads evenly."
    },
    {
      "step_number": 4,
      "instruction": "Once the oil is hot, drain the potatoes and add to the skillet. Season with salt, pepper, and Old Bay as needed.",
      "ingredients_used": [
        "458b0aae-f50b-5bb9-aa6e-bf359f453772",
        "75a24df9-43a0-55cf-b6d7-ab89ca794b93",
        "2904212c-dc02-5d0d-94a3-d829afd36db6"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Cook for 10 minutes, stirring the potatoes often, until brown. If needed, add a tablespoon more of oil.",
      "timer_seconds": 600,
      "ingredients_used": [
        "458b0aae-f50b-5bb9-aa6e-bf359f453772"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Chop up the bacon and add to the potatoes. The bacon will start to render and the fat will begin to further cook the potatoes. Toss it up a bit! The bacon will take 5-6 minutes to crisp.",
      "timer_seconds": 360,
      "ingredients_used": [
        "458b0aae-f50b-5bb9-aa6e-bf359f453772",
        "ab3e2ddd-5bd0-530f-b291-87aeab4d2785"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Once the bacon is cooked, reduce the heat to medium-low, add the minced garlic and toss. Season once more. Add dried or fresh parsley. Control heat as needed.",
      "ingredients_used": [
        "ab3e2ddd-5bd0-530f-b291-87aeab4d2785",
        "ffcddec2-5a46-54c1-ae23-46348f2c176e"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Let the garlic cook until fragrant, about one minute."
    },
    {
      "step_number": 9,
      "instruction": "Just before serving, drizzle over the maple syrup and toss. Let that cook another minute, giving the potatoes a caramelized effect.",
      "ingredients_used": [
        "458b0aae-f50b-5bb9-aa6e-bf359f453772",
        "b07a6510-7210-5b97-b58d-dae826a8c810"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Serve in a warm bowl with a sunny side up egg!"
    }
  ],
