  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the olive oil in a large frying pan over a high heat, or if using an air-fryer, heat to 205C for 3 mins. Fry the peppers, stirring frequently, for 5 mins until blistered and wilted. The peppers should be soft and slightly charred.",
      "temperature": {
        "value": 205,
        "unit": "celsius"
