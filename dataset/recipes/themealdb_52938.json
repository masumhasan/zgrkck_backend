  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Make the Pastry Dough"
    },
    {
      "step_number": 2,
      "instruction": "To a large bowl, add flour, 1 teaspoon salt, and turmeric and mix thoroughly.",
      "ingredients_used": [
        "fa793c7c-e750-5d94-a787-7fee9317115e",
        "1dc7d6b7-74f3-572c-acd5-cb6aecac1ba8"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Rub shortening into flour until there are small pieces of shortening completely covered with flour."
    },
    {
      "step_number": 4,
      "instruction": "Pour in 1/2 cup of the ice water and mix with your hands to bring the dough together. Keep adding ice water 2 to 3 tablespoons at a time until the mixture forms a dough.",
      "ingredients_used": [
        "7fe9db3b-bfbd-593a-b212-a9ff527b68e3",
        "164c88a6-250e-5a14-86ce-8adcb065797a",
        "4d858a0d-bc93-5cc8-94e3-6cdc83b8c448",
        "7383336e-642c-5686-9c8a-e97d1e29b10c"
      ]
    },
    {
      "step_number": 5,
      "instruction": "At this stage, you can cut the dough into 2 large pieces, wrap in plastic and refrigerate for 30 minutes before using it.",
      "timer_seconds": 1800
    },
    {
      "step_number": 6,
      "instruction": "Alternatively, cut the dough into 10 to 12 equal pieces, place on a platter or baking sheet, cover securely with plastic wrap and let chill for 30 minutes while you make the filling.",
      "timer_seconds": 1800
    },
    {
      "step_number": 7,
      "instruction": "Make the Filling"
    },
    {
      "step_number": 8,
      "instruction": "Add ground beef to a large bowl. Sprinkle in allspice and black pepper. Mix together and set aside.",
      "ingredients_used": [
        "37969be1-2b6e-545e-88b7-96d951ce8d70",
        "cc7d2f78-7ab3-54e7-a110-0858d8127d8b",
        "1685e326-64ce-5b3a-ba02-0f6cc35f13e5"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Heat oil in a skillet until hot."
    },
    {
      "step_number": 10,
      "instruction": "Add onions and sauté until translucent. Add hot pepper, garlic and thyme and continue to sauté for another minute. Add 1/4 teaspoon salt.",
      "ingredients_used": [
        "fa793c7c-e750-5d94-a787-7fee9317115e",
        "37148a4d-6cf8-5ba4-97fa-fce2b38a472c",
        "410e6c9a-f6c8-5c14-8846-f97c33279d36",
        "ddeafb8c-2281-5ca1-89dc-ef2f8bd02c30",
        "1dc7d6b7-74f3-572c-acd5-cb6aecac1ba8",
        "724ed9d2-a15e-5944-b2fa-c79fffa54f73"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Add seasoned ground beef and toss to mix, breaking up any clumps, and let cook until the meat is no longer pink.",
      "ingredients_used": [
        "37969be1-2b6e-545e-88b7-96d951ce8d70"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Add ketchup and more salt to taste.",
      "ingredients_used": [
        "fa793c7c-e750-5d94-a787-7fee9317115e",
        "1dc7d6b7-74f3-572c-acd5-cb6aecac1ba8",
        "2e4656f6-1bdf-592e-af29-1552a8545006"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Pour in 2 cups of water and stir. Bring the mixture to a boil then reduce heat and let simmer until most of the liquid has evaporated and whatever is remaining has reduced to a thick sauce.",
      "ingredients_used": [
        "7fe9db3b-bfbd-593a-b212-a9ff527b68e3",
        "164c88a6-250e-5a14-86ce-8adcb065797a",
        "4d858a0d-bc93-5cc8-94e3-6cdc83b8c448",
        "7383336e-642c-5686-9c8a-e97d1e29b10c"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Fold in green onions. Remove from heat and let cool completely.",
      "ingredients_used": [
        "37148a4d-6cf8-5ba4-97fa-fce2b38a472c",
        "724ed9d2-a15e-5944-b2fa-c79fffa54f73"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Assemble the Patties"
    },
    {
      "step_number": 16,
      "instruction": "Beat the egg and water together to make an egg wash. Set aside.",
      "ingredients_used": [
        "7fe9db3b-bfbd-593a-b212-a9ff527b68e3",
        "164c88a6-250e-5a14-86ce-8adcb065797a",
        "8194b725-6f67-5585-96a0-37e15b176021",
        "4d858a0d-bc93-5cc8-94e3-6cdc83b8c448",
        "7383336e-642c-5686-9c8a-e97d1e29b10c"
      ]
    },
    {
      "step_number": 17,
      "instruction": "Now you can prepare the dough in two ways."
    },
    {
      "step_number": 18,
      "instruction": "First Method: Flour the work surface and rolling pin. If you had cut it into 2 large pieces, then take one of the large pieces and roll it out into a very large circle. Take a bowl with a wide rim (about 5 inches) and cut out three circles."
    },
    {
      "step_number": 19,
      "instruction": "Place about 3 heaping tablespoons of the filling onto 1/2 of each circle. Dip a finger into the water and moisten the edges of the pastry. Fold over the other half and press to seal.",
      "ingredients_used": [
        "7fe9db3b-bfbd-593a-b212-a9ff527b68e3",
        "164c88a6-250e-5a14-86ce-8adcb065797a",
        "4d858a0d-bc93-5cc8-94e3-6cdc83b8c448",
        "7383336e-642c-5686-9c8a-e97d1e29b10c"
      ]
    },
    {
      "step_number": 20,
      "instruction": "Take a fork and crimp the edges. Cut off any extra to make it look neat and uniform. Place on a parchment-lined baking sheet and continue to work until you have rolled all the dough and filled the patties."
    },
    {
      "step_number": 21,
      "instruction": "Second Method: If you had pre-cut the dough into individual pieces, work with one piece of dough at a time. Roll it out on a floured surface into a 5-inch circle or a little larger. Don’t worry if the edges are not perfect."
    },
    {
      "step_number": 22,
      "instruction": "Place 3 heaping tablespoons of the filling on one side of the circle. Dip a finger into the water and moisten the edges of the pastry. Fold over the other half and press to seal.",
      "ingredients_used": [
        "7fe9db3b-bfbd-593a-b212-a9ff527b68e3",
        "164c88a6-250e-5a14-86ce-8adcb065797a",
        "4d858a0d-bc93-5cc8-94e3-6cdc83b8c448",
        "7383336e-642c-5686-9c8a-e97d1e29b10c"
      ]
    },
    {
      "step_number": 23,
      "instruction": "Take a fork and crimp the edges. Cut off any extra to make it look neat and uniform. Place on a parchment-lined baking sheet and continue work until you have rolled all the dough and filled the patties."
    },
    {
      "step_number": 24,
      "instruction": "Frying and Serving the Patties"
    },
    {
      "step_number": 25,
      "instruction": "After forming the patties, place the pans in the refrigerator while you heat the oven to 350 F.",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 26,
      "instruction": "Just before adding the pans with the patties to the oven, brush the patties with egg wash.",
      "ingredients_used": [
        "8194b725-6f67-5585-96a0-37e15b176021"
      ]
    },
    {
      "step_number": 27,
      "instruction": "Bake patties for 30 minutes or until golden brown.",
      "timer_seconds": 1800
    },
    {
      "step_number": 28,
      "instruction": "Cool on wire racks."
    },
    {
      "step_number": 29,
      "instruction": "Serve warm."
    }
  ],
