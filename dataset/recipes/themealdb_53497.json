  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the vegetable oil in a large pot over medium heat until it shimmers, about 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "b7b52906-cfb9-55bf-8dfc-2e1a9cafb44c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the minced garlic and sauté until fragrant and lightly golden, about 1 minute, stirring constantly to prevent burning.",
      "timer_seconds": 60,
      "ingredients_used": [
        "6dc2dd07-6d46-5876-87e6-a8afa31492cb"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the chicken pieces and cook until they turn opaque on all sides, about 5 minutes, stirring occasionally.",
      "timer_seconds": 300
    },
    {
      "step_number": 4,
      "instruction": "Pour in the 8 cups of water and bring to a boil over high heat, which should take about 8 minutes.",
      "timer_seconds": 480,
      "ingredients_used": [
        "bdcc1b14-128d-5be7-905b-23a20dc03a20"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Reduce the heat to low, stir in the fish sauce, salt, and sugar, and simmer uncovered for 20 minutes to develop the flavors.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "fc176d85-af32-5e71-84dd-ebd769ff5870",
        "49282c0c-bec4-5430-b04f-e8b509828d4a",
        "376167a0-b6ea-5bf6-8425-9b6cd815ea2c"
      ]
    },
    {
      "step_number": 6,
      "instruction": "While the broth simmers, cook the rice noodles according to package instructions until al dente, then drain and rinse under cold water to stop the cooking.",
      "ingredients_used": [
        "bdcc1b14-128d-5be7-905b-23a20dc03a20",
        "fd6b97cb-7f08-566a-8eae-01275d07a082"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Divide the cooked noodles evenly among four bowls.",
      "ingredients_used": [
        "fd6b97cb-7f08-566a-8eae-01275d07a082"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Ladle the hot broth and chicken over the noodles in each bowl.",
      "ingredients_used": [
        "fd6b97cb-7f08-566a-8eae-01275d07a082"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Top each bowl with bean sprouts, chopped mint leaves, and optional red chili slices.",
      "ingredients_used": [
        "59b80111-5dd7-5ba6-81df-f79d6b0890fd",
        "35b8a3c6-d7ff-5a7c-af71-34dab5b9e9d5"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Serve immediately with lime wedges on the side for squeezing over the soup.",
      "ingredients_used": [
        "780de157-de15-521c-b39d-dfef61906010"
      ]
    }
  ],
