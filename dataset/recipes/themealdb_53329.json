  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cook the meat: Place the flank steak in a pot with broth or water and salt. Cook over low heat for about 2 hours, until tender and easy to shred.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "ba6ec04c-70e9-59c6-9186-2e6e2a8a7b13",
        "d05ba8cb-62aa-5ef3-9c97-ab0454b7ea82"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Shred the meat: Once cooked, drain and shred the meat using two forks."
    },
    {
      "step_number": 3,
      "instruction": "Prepare the vegetables: Sauté chopped onion, bell pepper, and garlic in a little oil. Add cumin, oregano, paprika, and salt. Stir in the meat and cook for a few minutes until the flavors are well combined.",
      "ingredients_used": [
        "8acd9643-05c1-5eba-8130-9aec32e92193",
        "b3c4b56a-cfab-59ae-8612-b5be8dd88ce9",
        "5bb5def5-f049-5be9-a3f0-3b76ad640ce7",
        "979ae828-2c98-5fbd-aa04-904b0932fa98",
        "85ae1c3b-bd2a-5a6e-92f5-aa3d41ede251",
        "d05ba8cb-62aa-5ef3-9c97-ab0454b7ea82"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Make the dough: In a bowl, mix the cornmeal with warm water and salt until a soft dough forms. Let it rest for 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "ba6ec04c-70e9-59c6-9186-2e6e2a8a7b13",
        "d05ba8cb-62aa-5ef3-9c97-ab0454b7ea82"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Form the arepas: Divide the dough into 6 portions, shape into balls, and flatten into thick discs."
    },
    {
      "step_number": 6,
      "instruction": "Cook: Cook the arepas on a griddle or skillet over medium heat for 2–3 minutes on each side until golden. You can then bake them for a few minutes if you prefer them crispier.",
      "timer_seconds": 180
    },
    {
      "step_number": 7,
      "instruction": "Fill: Slice the arepas open on one side, fill with the hot shredded beef, and top with grated cheese.",
      "ingredients_used": [
        "0e8eb6d5-ce6b-5c2c-941b-f1782fee681a",
        "b5232948-2ed7-5027-b973-971a9f3d7229"
      ]
    }
  ],
