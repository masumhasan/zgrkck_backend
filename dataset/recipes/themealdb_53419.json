  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Fry the ginger in plenty of oil until golden and slightly crispy. Set aside for later.",
      "ingredients_used": [
        "3d457b33-24c7-57e9-8a38-6cd7eb7b18d4",
        "e69f5922-95a0-5b83-a615-3da0eac782e9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cut the fish into strips. Dredge the fish in a very thin layer of tempura flour.",
      "ingredients_used": [
        "c9685a29-745b-599f-83cf-7ac3262dfa94"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Fry the fish in plenty of oil until golden brown and crispy. You can use the same oil as you were using to fry the ginger.",
      "ingredients_used": [
        "3d457b33-24c7-57e9-8a38-6cd7eb7b18d4",
        "e69f5922-95a0-5b83-a615-3da0eac782e9"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Crush the garlic and chop it into small pieces. Chop the spring onion.",
      "ingredients_used": [
        "12ea2ce1-4fdc-514b-86a0-ab1cefc5c1a1"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Drain the fermented soybeans using a colander. If you are using salted beans (soybeans in a very salty brine), you need to wash the beans in water before you add them to the dish.",
      "ingredients_used": [
        "2880cde8-c9b1-5946-a2c6-8233612cce1d",
        "99e7b093-814c-59cf-9574-399c94c3b34b"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add a tablespoon of oil to a deep pan or a large pot, and sauté the garlic until slightly golden.",
      "ingredients_used": [
        "e69f5922-95a0-5b83-a615-3da0eac782e9",
        "12ea2ce1-4fdc-514b-86a0-ab1cefc5c1a1"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add the soybeans and stir fry for a few minutes. If the soybeans are very salty, add ¼- ½ tablespoon sugar to balance the flavor.",
      "ingredients_used": [
        "85149fc4-b5aa-5d46-b442-f6d6be375d86"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add water and fry for a minute.",
      "ingredients_used": [
        "99e7b093-814c-59cf-9574-399c94c3b34b"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Just before serving, stir in the fried ginger, the spring onion, and the crispy fish. Serve with steamed rice.",
      "ingredients_used": [
        "3d457b33-24c7-57e9-8a38-6cd7eb7b18d4"
      ]
    }
  ],
