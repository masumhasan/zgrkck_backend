  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the cabbage in a heavy casserole dish, add the stock and cook over a low heat for about 50 mins, until tender.",
      "timer_seconds": 3000,
      "ingredients_used": [
        "ca376b21-7af2-5439-be84-ca673a9e5d9e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cut the soaked mushrooms into strips and save the soaking water. Heat the lard and fry the sausages and bacon, then scoop out, leaving the fat in the pan. Fry the onion in the same pan for 5-8 mins until lightly browned.",
      "timer_seconds": 480,
      "ingredients_used": [
        "6d7a6676-e314-56b0-b932-3129a71825dd",
        "32131e87-3aa6-5a39-8974-c741dea513d0",
        "2be9da83-3907-5dbb-bba7-5c4c1111d890",
        "2d0f7bf9-8565-5b52-afea-e7426c7ad822",
        "cd96d2f6-4db8-5458-9b68-2d6a8fa6c4b0"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the mushrooms and their liquid along with all the cooked meat, onions and prunes, then cover and cook for 20 mins. Add the spices, red wine and tomato purée and bring to a simmer, then cover and cook for 1 hr. Season well and leave to cool. Will keep covered and chilled for up to two days. Bigos improves in flavor over a couple of days. Leave to cool first. Reheat until piping hot before serving.",
      "ingredients_used": [
        "6d7a6676-e314-56b0-b932-3129a71825dd",
        "cd96d2f6-4db8-5458-9b68-2d6a8fa6c4b0",
        "c4aec96f-72f7-5fd0-bf68-660c1bdfcc23",
        "b33f55e3-5183-5d57-a989-7214f0432f6c"
      ]
    }
