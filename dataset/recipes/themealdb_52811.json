  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put 2 tablespoons of the oil in a large pot over medium heat. When it’s hot, add onion, carrot, celery and garlic; sprinkle with salt and pepper and cook, stirring occasionally, until vegetables are soft, 5 to 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "28daa5b5-2961-59d8-a951-b514547bf14a",
        "e717f9bc-29b6-5ffb-8809-3f9a95fa13bc",
        "a1e7d9b1-eaf3-56ce-bfaf-a3f19ebc4f18"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat the oven to 500 degrees. Drain the beans; if they’re canned, rinse them as well. Add them to the pot along with tomatoes and their juices and stock, rosemary and thyme. Bring to a boil, then reduce heat so the soup bubbles steadily; cover and cook, stirring once or twice to break up the tomatoes, until the flavors meld, 15 to 20 minutes.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "705b0e4f-19f6-5a70-a029-9c787a6d6640",
        "041c4e4e-964a-577b-8190-5440585f728d",
        "84c84fe7-efb6-5173-bc25-7dd11162e6f7",
        "dd6c447c-b692-5e70-9bb3-4cdc1c3eeecc"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Fish out and discard rosemary and thyme stems, if you like, and stir in kale. Taste and adjust seasoning. Lay bread slices on top of the stew so they cover the top and overlap as little as possible. Scatter red onion slices over the top, drizzle with the remaining 3 tablespoons oil and sprinkle with Parmesan.",
      "ingredients_used": [
        "28daa5b5-2961-59d8-a951-b514547bf14a",
        "84c84fe7-efb6-5173-bc25-7dd11162e6f7",
        "dd6c447c-b692-5e70-9bb3-4cdc1c3eeecc",
        "8a2b20ec-b84d-56af-a143-becda21aea88",
        "b394da3e-0084-535f-8c03-359b7e6be0c1",
        "756a34ed-a722-5d27-a77d-8fa0234922de"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Put the pot in the oven and bake until the bread, onions and cheese are browned and crisp, 10 to 15 minutes. (If your pot fits under the broiler, you can also brown the top there.) Divide the soup and bread among 4 bowls and serve.",
      "timer_seconds": 900,
      "ingredients_used": [
        "28daa5b5-2961-59d8-a951-b514547bf14a",
        "b394da3e-0084-535f-8c03-359b7e6be0c1",
        "b9de31ad-be22-5bf2-9a26-63cfa8a9d859"
      ]
    }
  ],
