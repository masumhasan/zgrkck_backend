  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cut the potatoes and carrots into small uniform cubes.",
      "ingredients_used": [
        "4c1dc99e-97a6-55a5-8ec6-badd999f770c",
        "86ad2a4d-4921-5405-978a-50f428cc3c43"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Place them in a large pot and fill with water."
    },
    {
      "step_number": 3,
      "instruction": "Add salt and vinegar. Bring it to a boil over medium high heat, and then reduce the heat to medium and continue to cook until the potatoes are cooked through, about 15 minutes. Drain the potatoes and let it cool to room temperature.",
      "timer_seconds": 900,
      "ingredients_used": [
        "4c1dc99e-97a6-55a5-8ec6-badd999f770c",
        "8e0eac8c-c24b-51d2-a48f-cf7cb759c40e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Meanwhile, cut the sausage and pickles into small cubes, and chop the green onions.",
      "ingredients_used": [
        "ec2c7158-1bc6-5270-8a72-46295200348f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Cut the hard-boiled eggs into small cubes as well.",
      "ingredients_used": [
        "5c2339d1-49f1-542c-beb0-795a906a458a"
      ]
    },
    {
      "step_number": 6,
      "instruction": "If using fresh dill, chop them as well.",
      "ingredients_used": [
        "5edb1919-8a25-5fc9-9278-15ae30b901a8"
      ]
    },
    {
      "step_number": 7,
      "instruction": "In a large bowl, combine potatoes, carrots, sausage, pickles, peas and green onions.",
      "ingredients_used": [
        "4c1dc99e-97a6-55a5-8ec6-badd999f770c",
        "86ad2a4d-4921-5405-978a-50f428cc3c43",
        "ecbf3f98-6880-5bff-8013-769f7c19ada6",
        "ec2c7158-1bc6-5270-8a72-46295200348f"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add mayo and dill and mix until well combined.",
      "ingredients_used": [
        "5edb1919-8a25-5fc9-9278-15ae30b901a8"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Salt and pepper to taste. Cover with a plastic wrap and refrigerate for at least 1 hour before serving.",
      "timer_seconds": 3600,
      "ingredients_used": [
        "8e0eac8c-c24b-51d2-a48f-cf7cb759c40e"
      ]
    }
  ],
