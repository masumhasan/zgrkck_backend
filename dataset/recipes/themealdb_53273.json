  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 200C/180C fan/gas 6. Brush the aubergine slices with 1 tbsp of the oil, then season. Arrange on a baking tray or sheet and roast for 20 mins until browned, popping the tomatoes on the tray for the final 5 mins. Tear the flatbread into pieces and place on a separate baking sheet. Brown in the oven for 8 mins, or until crisp, then remove.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "8ab7b609-5a99-53aa-8e12-69333a5760a6",
        "f858f2fd-6f79-52b6-9330-0ff035cd18d5"
      ]
    },
    {
      "step_number": 2,
      "instruction": "For the dressing, in a small bowl, mix the vinegar, mint, chopped shallots, chilli, remaining oil and some salt and pepper.",
      "ingredients_used": [
        "9941ccc9-ccf9-58e0-ab8b-4fef60f2c87c",
        "9d032c93-526d-5ee8-b54f-3bc9cbfffdfc",
        "b1bec796-5a5e-50c0-b0d4-f1bb951f1395",
        "64e915e7-4c0e-5b8c-9cf3-0f6bfaa858f7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Scatter the aubergine slices, tomatoes, sliced shallot and crisp flatbread into a serving bowl. Pour over the dressing, sprinkle with the goat’s cheese and scatter over a little rocket.",
      "ingredients_used": [
        "8ab7b609-5a99-53aa-8e12-69333a5760a6",
        "f858f2fd-6f79-52b6-9330-0ff035cd18d5",
        "c56cc748-aa1f-5615-b9c9-4c2d4fdea53c"
      ]
    }
