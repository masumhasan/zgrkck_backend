  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cook the sour cream in a covered saucepan on medium heat for about 5 minutes.",
      "timer_seconds": 300
    },
    {
      "step_number": 2,
      "instruction": "Turn down the heat and add half of the flour and stir well with a whisk. Once the flour is fully incorporated, let the mixture continue to cook, stirring occasionally, until fat starts to release. Use a spoon to gather as much of the fat as you can in a small bowl, saving for later. (Don't worry if you can't get any fat – in that case you can add butter later.)",
      "ingredients_used": [
        "48e48570-e0b0-556d-904a-d677f497810c",
        "b05c8f08-bcf2-5ccc-9455-b8990f486175"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Whisk in the rest of the flour and then slowly add the milk, whisking constantly to avoid lumps. Let the porridge continue to cook on low heat for 5 minutes and then add salt.",
      "timer_seconds": 300,
      "ingredients_used": [
        "48e48570-e0b0-556d-904a-d677f497810c",
        "ede2328e-f144-533c-953f-04589d68489f",
        "32355728-e8ad-5e9a-bbe2-9fdcfb0cfbe8"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Serve with sugar, cinnamon, and the fat from the porridge. If you're using lower fat sour cream you can top the rømmegrøt with some butter instead.",
      "ingredients_used": [
        "53dc1b20-31c6-551d-9dd0-44c25b68b171",
        "d52e3fe9-b71c-574b-8435-f81da75d12e2",
        "b05c8f08-bcf2-5ccc-9455-b8990f486175"
      ]
    }
  ],
