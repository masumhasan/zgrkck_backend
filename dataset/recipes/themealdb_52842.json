  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the rapeseed oil in a large saucepan and then add the onions. Cook on a medium heat until soft. Add a splash of water if the onions start to catch.",
      "ingredients_used": [
        "a4e897fa-7341-548e-ba38-3ffbc9f6c5a4",
        "d273ea01-1083-5625-b607-8bb4a699ef29"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the celery, leek, potato and a knob of butter. Stir until melted, then cover with a lid. Allow to sweat for 5 minutes. Remove the lid.",
      "timer_seconds": 300,
      "ingredients_used": [
        "4be26104-a522-5e34-a4fd-00544fc5061a",
        "bda1f1f1-a362-5f85-ad50-966c7ff2bf8f",
        "c9d5eb30-42db-5af8-b962-4aecc1f2a3d4"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Pour in the stock and add any chunky bits of broccoli stalk. Cook for 10 – 15 minutes until all the vegetables are soft.",
      "timer_seconds": 900,
      "ingredients_used": [
        "0e6f7ea7-db2b-5d99-9cb4-e68f150c98fb"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the rest of the broccoli and cook for a further 5 minutes. Carefully transfer to a blender and blitz until smooth. Stir in the stilton, allowing a few lumps to remain. Season with black pepper and serve.",
      "timer_seconds": 300,
      "ingredients_used": [
        "0e6f7ea7-db2b-5d99-9cb4-e68f150c98fb"
      ]
    }
  ],
