  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Take a large pot or wok, big enough to cook all the chicken, and heat the oil in it. Once the oil is hot, add sliced onion and fry them until deep golden brown. Then take them out on a plate and set aside.",
      "ingredients_used": [
        "a6885e1c-e9a7-55a0-8462-974b28e07675",
        "fde62220-2f5b-54c9-8a48-b76da25cd4fc"
      ]
    },
    {
      "step_number": 2,
      "instruction": "To the same pot, add the chopped garlic and sauté for a minute. Then add the chopped tomatoes and cook until tomatoes turn soft. This would take about 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "c39d3e80-0497-5097-a28e-cfea47e5762c",
        "08911c58-5032-5d9a-baca-5a3ab62c8087"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Then return the fried onion to the pot and stir. Add ginger paste and sauté well.",
      "ingredients_used": [
        "fde62220-2f5b-54c9-8a48-b76da25cd4fc",
        "48b2766a-7213-5956-a39d-26c0512b2b10"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Now add the cumin seeds, half of the coriander seeds and chopped green chillies. Give them a quick stir.",
      "ingredients_used": [
        "03be9a99-7513-5402-88ca-a2a934002110",
        "5ce1c128-75b3-5673-8953-3ee6d1b7cc38",
        "d83d5916-1280-5364-a8e1-121843643390"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Next goes in the spices – turmeric powder and red chilli powder. Sauté the spices well for couple of minutes.",
      "ingredients_used": [
        "05db8e22-2576-5c20-9307-8854b1748682",
        "09032958-58f5-5dad-ab05-d6b515d1f009",
        "d83d5916-1280-5364-a8e1-121843643390"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add the chicken pieces to the wok, season it with salt to taste and cook the chicken covered on medium-low heat until the chicken is almost cooked through. This would take about 15 minutes. Slowly sautéing the chicken will enhance the flavor, so do not expedite this step by putting it on high heat.",
      "timer_seconds": 900,
      "ingredients_used": [
        "a6885e1c-e9a7-55a0-8462-974b28e07675",
        "3e9c15e0-1eea-5426-b323-5805b515f57f"
      ]
    },
    {
      "step_number": 7,
      "instruction": "When the oil separates from the spices, add the beaten yogurt keeping the heat on lowest so that the yogurt doesn’t split. Sprinkle the remaining coriander seeds and add half of the dried fenugreek leaves. Mix well.",
      "ingredients_used": [
        "5ce1c128-75b3-5673-8953-3ee6d1b7cc38",
        "031dd3fa-09f0-593f-a528-db0c8bd64847",
        "147df405-63a2-54bc-a86a-fa5250ec4c8e"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Finally add the cream and give a final mix to combine everything well.",
      "ingredients_used": [
        "fa950d6c-8e98-5576-8c52-385f38f6d4b8"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Sprinkle the remaining kasuri methi and garam masala and serve the chicken handi hot with naan or rotis. Enjoy!",
      "ingredients_used": [
        "a6885e1c-e9a7-55a0-8462-974b28e07675",
        "9047bd9f-fddd-5e2b-af77-25bc2c20f284"
      ]
    }
  ],
