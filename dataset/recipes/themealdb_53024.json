  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a medium bowl mix egg yolks, philly cheese and baking powder using a hand held mixer. Carefully start adding the flour. When the mixture will not be mixing well, and will look like wood chips, put away the blending mixer and using your hands knead the dough.",
      "ingredients_used": [
        "ec75bb67-142c-5334-8c19-c8c6ed1715f0",
        "152a3dda-bec1-5dd1-a4f4-36b8e92133bc",
        "3b14722a-3e4b-5fa9-8e05-b2fe223e7c7c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Create a roll and cover in foil and freeze for 15 minutes. At this time preheat the oven to 375.",
      "timer_seconds": 900
    },
    {
      "step_number": 3,
      "instruction": "Take the dough out and separate into two. Roll and cut out 3 inch trangles."
    },
    {
      "step_number": 4,
      "instruction": "Make as many as you can and on center of each put a small spoon of jam. Roll them into a croissant shape.",
      "ingredients_used": [
        "de8ae423-45cf-545f-9cac-26e21eac9cc4"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Place the croissants onto a greased cookie sheet, and bake for 10-12 minutes or until golden.",
      "timer_seconds": 720
    },
    {
      "step_number": 6,
      "instruction": "Repeat with the rest of the dough."
    },
    {
      "step_number": 7,
      "instruction": "When you take them out, put aside and sprinkle with powdered sugar on top."
    },
    {
      "step_number": 8,
      "instruction": "This makes about 3 batches of 20 cookies each."
    },
    {
      "step_number": 9,
      "instruction": "Total count about 60 cookies."
    }
  ],
