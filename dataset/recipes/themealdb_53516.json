  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 450 degrees F (230 degrees C). Grease a baking sheet.",
      "temperature": {
        "value": 450,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "Whisk flour, 1 cup melted butter, milk, baking powder, and salt together in a bowl until begins to pull together. Turn dough out onto a lightly floured surface; knead until smooth and elastic.",
      "ingredients_used": [
        "1beda02e-9d21-54b6-b69f-8ffe1a082633",
        "ca68a713-6801-5011-bc95-de3abb460efc",
        "4c2c9142-bf23-5666-abc5-1f5846a79279",
        "1d8571f9-7643-5f4f-961e-2cf2a9c88b73",
        "230d5c49-8af2-58c2-8156-3f30ed9b418f"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Roll dough out to ⅛-inch thickness; cut into 8-inch circles. Brush circles with remaining 3 tablespoons melted butter. Fold each circle in half, then fold in half again to form triangles. Press firmly to seal the layers; place on the prepared baking sheet.",
      "ingredients_used": [
        "1beda02e-9d21-54b6-b69f-8ffe1a082633",
        "230d5c49-8af2-58c2-8156-3f30ed9b418f"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Bake in the preheated oven until golden brown, about 15 minutes. Serve warm",
      "timer_seconds": 900
    }
