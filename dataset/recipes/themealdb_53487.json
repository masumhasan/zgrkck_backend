  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Clean mushrooms – I usually wash them under cold water, dry them and remove the stems.",
      "ingredients_used": [
        "1e84d99e-8c63-52e5-93de-bc132839f697",
        "47c6d03f-8ad8-5bb0-b6a9-7379e739c9d9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cut mushrooms into thin strips.",
      "ingredients_used": [
        "1e84d99e-8c63-52e5-93de-bc132839f697"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Melt butter in a small pot. Add the mushrooms and cook for 10 minutes, until the mushrooms release liquid.",
      "timer_seconds": 600,
      "ingredients_used": [
        "1e84d99e-8c63-52e5-93de-bc132839f697",
        "78866ad7-94d7-5e71-9900-dc05c81bc40e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Combine the flour and water, whisk to remove any lumps and add to the pot. Add the salt and milk.",
      "ingredients_used": [
        "366c97e1-f0dd-5638-a462-e3f2736cb15d",
        "47c6d03f-8ad8-5bb0-b6a9-7379e739c9d9",
        "7495e1b8-93f6-557b-9d01-f7c89a939a33",
        "28d2f682-4637-5496-ad23-74913b0c60b8"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Cook for 10 more minutes."
    },
    {
      "step_number": 6,
      "instruction": "In a small bowl or jar combine the garlic and vinegar.",
      "ingredients_used": [
        "d221c8af-9f32-5879-a48c-9ad83a554aad"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Serve the soup with 1-2 tablespoons (or more) of the garlic and vinegar mixture and hot red pepper.",
      "ingredients_used": [
        "d221c8af-9f32-5879-a48c-9ad83a554aad"
      ]
    }
  ],
