  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Need Lollipop sticks"
    },
    {
      "step_number": 2,
      "instruction": "Instructions for crust"
    },
    {
      "step_number": 3,
      "instruction": "Combine the flour, sugar, and salt to a food processor bowl. Mix using the pulse setting.",
      "ingredients_used": [
        "65a65ae5-71a0-58cf-aa14-17e329c6c18b",
        "0fa7eb6c-c10c-5614-9188-e16247ebfb7a",
        "82532872-fa60-58f6-b7ef-a528c6546ff2",
        "15236341-fb69-5552-a7d0-01e007433893"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add butter and shortening and pulse about 10 -12 times until the texture is changed to small pebbles.",
      "ingredients_used": [
        "bcc651b4-ec8d-5fdc-841d-32aebd5e7d1b",
        "092f9ff3-8f77-5a0b-82fe-b261cac27f5e",
        "de365b19-a3a7-5703-b621-f712b0bb95b0"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add ¾ of the ice water and pulse a few more times until the dough takes the shape of a ball. Add more water as needed. Don't overmix. Don't worry if the dough isn't completely blended. You will use your rolling pin to finish creating the crust.",
      "ingredients_used": [
        "bd622bed-d514-5dd6-9545-f7864f750594"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Place dough ball onto the counter and flatten into a flat disc. Wrap it in plastic wrap and refrigerate for at least an hour or overnight."
    },
    {
      "step_number": 7,
      "instruction": "Instructions for pie filling"
    },
    {
      "step_number": 8,
      "instruction": "Heat butter over medium heat, until just golden brown",
      "ingredients_used": [
        "bcc651b4-ec8d-5fdc-841d-32aebd5e7d1b",
        "de365b19-a3a7-5703-b621-f712b0bb95b0"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Add brown sugar, spices, salt and lemon juice. Stir to combine ingredients",
      "ingredients_used": [
        "65a65ae5-71a0-58cf-aa14-17e329c6c18b",
        "0fa7eb6c-c10c-5614-9188-e16247ebfb7a",
        "6e790509-aa92-56a9-9917-e3950cf19941",
        "82532872-fa60-58f6-b7ef-a528c6546ff2",
        "fa873538-3d8e-5185-97c3-f9ca8a2a67f6",
        "15236341-fb69-5552-a7d0-01e007433893"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Add diced apples and stir.",
      "ingredients_used": [
        "b43a14ab-2479-5d4a-9918-a8143b5e0499"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Allow apples to cook for about 5-7 minutes, over medium heat",
      "timer_seconds": 420,
      "ingredients_used": [
        "b43a14ab-2479-5d4a-9918-a8143b5e0499"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Remove from heat and let the apple mixture cool. You can place apples in the refrigerator to speed up the process.",
      "ingredients_used": [
        "b43a14ab-2479-5d4a-9918-a8143b5e0499"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Mix egg and water for an egg wash.",
      "ingredients_used": [
        "892425ab-7138-5840-88cb-bfc52d5a4b68",
        "bd622bed-d514-5dd6-9545-f7864f750594"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Roll out pie dough to 1/8 inch thickness."
    },
    {
      "step_number": 15,
      "instruction": "Cut out rounds of 2 ½ to 3 inches and place them on parchment paper. You will need to roll out the extra dough left over scraps from cutting."
    },
    {
      "step_number": 16,
      "instruction": "In half of the rounds, cut out shapes or holes for ventilation purposes"
    },
    {
      "step_number": 17,
      "instruction": "On the other half of the rounds, gently press one lollipop stick about halfway up each round."
    },
    {
      "step_number": 18,
      "instruction": "Place one tablespoon of apple mixture in the center of each round."
    },
    {
      "step_number": 19,
      "instruction": "Place each round on top of apples seal the edges.",
      "ingredients_used": [
        "b43a14ab-2479-5d4a-9918-a8143b5e0499"
      ]
    },
    {
      "step_number": 20,
      "instruction": "Brush each pie pop with egg wash and sprinkle sugar on top.",
      "ingredients_used": [
        "65a65ae5-71a0-58cf-aa14-17e329c6c18b",
        "15236341-fb69-5552-a7d0-01e007433893",
        "892425ab-7138-5840-88cb-bfc52d5a4b68"
      ]
    },
    {
      "step_number": 21,
      "instruction": "Bake 15-20 minutes or until golden brown.",
      "timer_seconds": 1200
    },
    {
      "step_number": 22,
      "instruction": "Enjoy!"
    }
  ],
