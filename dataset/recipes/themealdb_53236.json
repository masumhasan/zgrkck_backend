  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in a medium-size, lidded saucepan. Add the ginger and garlic, then stir-fry for about 5 mins.",
      "timer_seconds": 300,
      "ingredients_used": [
        "ba7ddc3b-3777-5dc6-975a-3ad986d300a5"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the squash, soy sauce, sugar and stock. Cover, then simmer for 10 mins.",
      "timer_seconds": 600,
      "ingredients_used": [
        "482fb8b6-b113-5f5e-9fb3-f96c0123204e",
        "2cddd71a-5480-5edd-9582-4dc8a8a20341"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Remove the lid, add the green beans, then cook for 3 mins more until the squash and beans are tender. Stir the spring onions through at the last minute, then sprinkle with coriander and serve with rice.",
      "timer_seconds": 180,
      "ingredients_used": [
        "482fb8b6-b113-5f5e-9fb3-f96c0123204e",
