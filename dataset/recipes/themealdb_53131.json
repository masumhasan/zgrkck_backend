  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Crust"
    },
    {
      "step_number": 2,
      "instruction": "Mix together sugar, vanilla and butter until light and fluffy. Mix in the egg yolks. Add in the flour and baking powder and knead with hands until the dough is smooth.",
      "ingredients_used": [
        "17eeeaab-8699-5767-990c-862ce16b249a",
        "babca7ce-b7ec-5669-805c-5e964386a08a",
        "a1e693e6-d5db-5d9d-9b92-681265e154eb",
        "94d5acb4-7b32-5137-9c0a-fceb2029d15f",
        "a7e6f9c9-f227-5ef8-b9d3-1a5540f4f173",
        "b924f9bb-b862-5f9c-8702-47a123241ec3",
        "b1321b59-b947-5346-8990-fbb3b54730ca"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Pack the dough in plastic wrap and chill in refrigerator for at least 30 minutes.",
      "timer_seconds": 1800
    },
    {
      "step_number": 4,
      "instruction": "Almond filling"
    },
    {
      "step_number": 5,
      "instruction": "Run the almonds and sugar together in a food processor until the almonds are finely ground (you can decide for yourself how coarse or fine you want them).",
      "ingredients_used": [
        "6164827f-ed22-55e5-9d97-950f8cae16fd"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Stir in the butter, egg, cognac and/or almond extract (if using).",
      "ingredients_used": [
        "276f0899-5f45-52ac-bab1-f9e26a9fcff4",
        "17eeeaab-8699-5767-990c-862ce16b249a",
        "a7e6f9c9-f227-5ef8-b9d3-1a5540f4f173",
        "b924f9bb-b862-5f9c-8702-47a123241ec3",
        "338e0525-66fd-5591-a8d4-0d7d2083e535",
        "b1321b59-b947-5346-8990-fbb3b54730ca"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Assembly"
    },
    {
      "step_number": 8,
      "instruction": "Line the bottom of your cake form with baking paper and grease the sides of the form."
    },
    {
      "step_number": 9,
      "instruction": "Preheat oven to 350°F (175°C).",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 10,
      "instruction": "Cut 2/3 of the crust dough into slices and press down into the cake form. Cover the bottom of the cake form with the dough and bring the dough 2-3 cm (1 inch) up the sides of the form, pressing until even."
    },
    {
      "step_number": 11,
      "instruction": "Scoop the almond filling on top of the crust, spreading it evenly across the cake form."
    },
    {
      "step_number": 12,
      "instruction": "Roll out of the rest of the dough and slice into long strips. Lay the strips of dough across the cake in a grid. Don't worry of the strips break – simply press them back together on the cake."
    },
    {
      "step_number": 13,
      "instruction": "Gently brush the dough with egg wash.",
      "ingredients_used": [
        "b924f9bb-b862-5f9c-8702-47a123241ec3",
        "b1321b59-b947-5346-8990-fbb3b54730ca"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Bake for about 45 minutes. The top of the cake should be golden brown while the almond filling will remain soft.",
      "timer_seconds": 2700
    }
  ],
