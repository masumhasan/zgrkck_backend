  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Take kanfhe in a bowl and roughly cut them. Pour melted butter, yellow food color and mix well with your hands.",
      "ingredients_used": [
        "26b52108-a459-5ef2-85e8-15eb8ac43440"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a separate bowl mix milk, cream cheese, sugar, cornstarch well.",
      "ingredients_used": [
        "02d64c20-6720-53fb-aae5-1522599b4f57",
        "0e12efcb-d561-50e4-bb75-8f84e4129159",
        "cdb7df06-e633-5c81-b683-9ed631672216",
        "5d7049f5-ef58-5d5f-a8fd-6799b3f13ed3"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Turn on the flame and boil the liquid, when it gets thick turn off the flame let it cool down a little bit."
    },
    {
      "step_number": 4,
      "instruction": "Add mozzarella in it and mix it well.",
      "ingredients_used": [
        "2efe87ee-e7b9-558b-a299-5de2be536588"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Now make a base with half of the kanfhe in a dish, gently press it to level the dough well."
    },
    {
      "step_number": 6,
      "instruction": "Pour the cheese mixture on the top and level it with a spoon."
    },
    {
      "step_number": 7,
      "instruction": "Cover it with the other half of the kanfhe."
    },
    {
      "step_number": 8,
      "instruction": "Put the dish in a preheated oven at 200 degree for about 20-25 minutes.",
      "timer_seconds": 1500
    },
    {
      "step_number": 9,
      "instruction": "It's ready when kunafa is golden and crunchy in the surface."
    },
    {
      "step_number": 10,
      "instruction": "Boil water in a pan and dissolve sugar in it for 4–5 minutes. OR cook it until slightly thicken and keep on stirring. Add lemon juice with rose water, mix well.",
      "timer_seconds": 300,
      "ingredients_used": [
        "cdb7df06-e633-5c81-b683-9ed631672216",
        "5d7049f5-ef58-5d5f-a8fd-6799b3f13ed3",
        "406916aa-9093-5e6e-952a-8184741641b7",
        "259fc1cc-55d2-558e-b4ef-f3f844c196c3",
        "820d12e1-9371-5e13-930b-4a193d3a8af7"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Evenly pour the syrup over the kunafa as soon as it comes out of the oven."
    },
    {
      "step_number": 12,
      "instruction": "Your kunafa is ready to serve."
    }
  ],
