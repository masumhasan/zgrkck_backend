  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Season the salmon, then rub with oil. Mix the dressing ingredients together. Halve, stone, peel and slice the avocados. Halve and quarter the cucumber lengthways, then cut into slices. Divide salad, avocado and cucumber between four plates, then drizzle with half the dressing.",
      "ingredients_used": [
        "e0c1c281-2ef9-5d66-8986-ee71861a4b6b",
        "ef4de90f-cc14-536c-8b39-aa46c70fb7e8",
        "83d2ba7e-2b94-5f1c-a24d-8d97290c2f48"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat a non-stick pan. Add the salmon and fry for 3-4 mins on each side until crisp but still moist inside. Put a salmon fillet on top of each salad and drizzle over the remaining dressing. Serve warm.",
      "timer_seconds": 240,
