  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a large bowl, with an electric mixer, mix the butter and sugar till the mix is light.",
      "ingredients_used": [
        "fc32e140-964c-5a87-9806-f495bb917cd2",
        "328330cb-d503-59ba-ae76-d08a603df0a2",
        "701dc1cd-8ffd-5205-99f5-12cb1f0e1943"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add eggs and vanilla and mix.",
      "ingredients_used": [
        "8b942cd5-dfd7-56a6-99aa-bd2a2b93ba26"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In another bowl, mix flour and baking powder.",
      "ingredients_used": [
        "f1a56c89-adb4-5617-a92f-6e784e8fba70",
        "1e4e38ac-803f-5c97-bf18-07d7529362a2"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Alternate flour mix and milk to the butter mix.",
      "ingredients_used": [
        "fc32e140-964c-5a87-9806-f495bb917cd2",
        "f1a56c89-adb4-5617-a92f-6e784e8fba70",
        "667da5ba-4836-516c-8b04-f7594b069f97",
        "701dc1cd-8ffd-5205-99f5-12cb1f0e1943"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour into a 13 inch by 9 inch greased pan."
    },
    {
      "step_number": 6,
      "instruction": "MAPLE SAUCE."
    },
    {
      "step_number": 7,
      "instruction": "In a large casserole, bring to boil the syrup, brown sugar, cream and butter and constantly stir.",
      "ingredients_used": [
        "fc32e140-964c-5a87-9806-f495bb917cd2",
        "328330cb-d503-59ba-ae76-d08a603df0a2",
        "15c99f1c-059d-5f2f-8a7e-2987e3a1e4ad",
        "77b34226-97fb-5c91-b6f0-d141dcc63a61",
        "701dc1cd-8ffd-5205-99f5-12cb1f0e1943"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Reduce heat and and gently cook 2 minutes or till sauce has reduced a little bit.",
      "timer_seconds": 120
    },
    {
      "step_number": 9,
      "instruction": "Pour sauce gently over cake."
    },
    {
      "step_number": 10,
      "instruction": "Bake at 325°f (160°c) about 35 minutes or till cake is light brown and when toothpick inserted comes out clean.",
      "timer_seconds": 2100,
      "temperature": {
        "value": 325,
        "unit": "fahrenheit"
      }
    }
  ],
