  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Make the orange sauce:",
      "ingredients_used": [
        "535a5ebf-54fa-5ff5-865f-9d575f3fa2b6"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Whisk together sauce ingredients in a medium bowl. Set aside."
    },
    {
      "step_number": 3,
      "instruction": "Prep the chicken:"
    },
    {
      "step_number": 4,
      "instruction": "Cut chicken into about 1-inch cubes. Whisk eggs with salt and black pepper in a bowl and add chicken. Stir together.",
      "ingredients_used": [
        "95474b83-c82d-5045-ae8b-777f369c12ba",
        "97569116-0535-558f-bd1f-1f4cdac5ddbe"
      ]
    },
    {
      "step_number": 5,
      "instruction": "In a separate bowl, whisk together flour and cornstarch. Remove chicken from eggs with a slotted spoon or tongs, letting excess egg drain off, then transfer to cornstarch mixture and coat well.",
      "ingredients_used": [
        "46212bd0-5683-546e-9239-b97463c7f784",
        "d1c86290-af20-5ed5-9766-db4e3ae7c44f",
        "4733f8eb-e23f-5d5a-b697-9f657e9b1782"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Fry the chicken:"
    },
    {
      "step_number": 7,
      "instruction": "Add oil to a large 10- to 12-inch skillet. Heat over medium-high heat until it reaches 350°F. If you don’t have a thermometer, you can also test the temperature by sprinkling in some flour. If the oil is hot enough, it should fizzle immediately.",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 8,
      "instruction": "Once oil is hot, fry the chicken in two batches. The oil might not completely cover the chicken—that’s okay. Cook for 3 to 4 minutes. Flip the chicken pieces and cook until the chicken is cooked through, about 3 to 4 more minutes. Total cook time is about 6 to 8 minutes."
    },
    {
      "step_number": 9,
      "instruction": "Remove fried chicken cubes and transfer to a plate lined with paper towels, so the chicken can drain. Repeat until all the chicken is cooked."
    },
    {
      "step_number": 10,
      "instruction": "Simmer the chicken in the sauce:"
    },
    {
      "step_number": 11,
      "instruction": "Once chicken is done, pour out hot oil and wipe pan clean. Add a fresh tablespoon of oil along with chopped garlic and shallot. Cook for a minute and then add the sauce. Simmer the sauce until it starts to thicken.",
      "ingredients_used": [
        "df20d168-ef3d-563f-9c08-bec992ff918f"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Once the sauce is lightly bubbling, add fried chicken and toss together to coat. The sauce should continue to thicken and stick to the chicken. Let simmer for a minute or two more. Serve orange chicken over cooked white rice, garnished with sesame seeds and fresh scallions.",
      "ingredients_used": [
        "535a5ebf-54fa-5ff5-865f-9d575f3fa2b6",
        "c9e77474-eb6e-563e-a847-daebca05828c",
        "ab73146d-0f4b-51f4-b877-dc53807d98df",
        "1fa8ddab-29c6-5273-8eea-c6283abbcdad"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Did you love this recipe? Let us know with a rating and review!"
    },
    {
      "step_number": 14,
      "instruction": "LEFTOVERS! The orange chicken keeps well in the fridge for 5 days. Reheat in a skillet with a splash of water over low heat. Freeze the orange chicken for up to 3 months, but be sure to thaw it before reheating so the chicken doesn’t clump together.",
      "ingredients_used": [
        "535a5ebf-54fa-5ff5-865f-9d575f3fa2b6",
        "ce45997d-d567-575f-a5a6-f33a3e6f3cb1"
      ]
    }
  ],
