  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix butter with sugar until creamy.",
      "ingredients_used": [
        "babdf1fa-41e2-5be6-ab3f-3fc65a64354d"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add oil flour and semolina and mix.",
      "ingredients_used": [
        "6b16fccc-25ee-578f-8f7e-2f89683a2595"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add warm milk and don't knead too much",
      "ingredients_used": [
        "898d8d0b-be67-54d0-a19e-75326a2d7f45"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cover and leave aside for an hour or less until you prepare the filling"
    },
    {
      "step_number": 5,
      "instruction": "For the dates filling, fry some sesame in a pan then add butter. Add the dates paste and mixed well with sesame and butter. Then add a little bit of water until it's mushy. Be careful don't make it too mushy.",
      "ingredients_used": [
        "babdf1fa-41e2-5be6-ab3f-3fc65a64354d"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Take it of the pan, put in a plate until it's cool. Then start to shape balls that weigh 15 gm."
    },
    {
      "step_number": 7,
      "instruction": "Refrigerate for 1/2 an hour."
    },
    {
      "step_number": 8,
      "instruction": "Get back to the dough and shape it as balls that weigh 30 gm."
    },
    {
      "step_number": 9,
      "instruction": "Take the date filling out of the fridge and start to stuff each dough ball with dates ball."
    },
    {
      "step_number": 10,
      "instruction": "Then use the mamoul mold to give it this shape."
    },
    {
      "step_number": 11,
      "instruction": "In a preheated oven 180 degrees, put it for 20 minutes until golden from below and little bit golden from above.",
      "timer_seconds": 1200
    }
  ],
