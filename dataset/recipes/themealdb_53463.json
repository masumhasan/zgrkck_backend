  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Make the meatballs"
    },
    {
      "step_number": 2,
      "instruction": "Mix the minced meat with the onion, garlic, egg, breadcrumbs, mustard, parsley, salt, and pepper.",
      "ingredients_used": [
        "83e4bd80-c9cc-5467-ad87-33b8e1cd8a0f",
        "5008d7ee-424c-5fe6-9beb-79b658e2f537",
        "4cfb7fff-dc42-5a1c-a683-2dff0bee3e68",
        "7103baef-f623-5a8d-9aa2-e21f50896e46",
        "63559879-e2cb-5ce7-bcee-06a094af7f0e",
        "688a9a5e-5ca1-587e-94fb-b362760d7a07",
        "3317e537-2678-59c8-ad2c-14927e84a40d",
        "cc136ca0-e56d-5282-801b-8ca26af4e7e9",
        "bad203b5-d53c-53a1-acbf-4d2aa8a845a0",
        "72bd6bcf-d716-5e40-843b-fdc0e5556e6d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Shape into meatballs. Traditionally, Liège restaurants serve **one or two very large meatballs**, depending on appetite.",
      "ingredients_used": [
        "9ddc628e-41b9-5739-81e8-2a71d4e50242"
      ]
    },
    {
      "step_number": 4,
      "instruction": "For weeknight cooking, I keep mine smaller so they brown faster and cook through quickly."
    },
    {
      "step_number": 5,
      "instruction": "Brown the meatballs"
    },
    {
      "step_number": 6,
      "instruction": "Heat butter or oil in a large pan.",
      "ingredients_used": [
        "fc87d5ea-d4a5-57f5-91df-e44654d9ab17",
        "624ba1ee-a63e-5d8a-a4b6-1dd1dab1d164"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Brown the meatballs on all sides until they have a nice crust."
    },
    {
      "step_number": 8,
      "instruction": "Remove them from the pan and set aside."
    },
    {
      "step_number": 9,
      "instruction": "Start the sauce"
    },
    {
      "step_number": 10,
      "instruction": "In the same pan, melt 1 tbsp butter.",
      "ingredients_used": [
        "624ba1ee-a63e-5d8a-a4b6-1dd1dab1d164"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Add the sliced onions and cook until soft and lightly caramelized.",
      "ingredients_used": [
        "83e4bd80-c9cc-5467-ad87-33b8e1cd8a0f",
        "bad203b5-d53c-53a1-acbf-4d2aa8a845a0"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Sprinkle in the brown sugar and let it melt into the onions.",
      "ingredients_used": [
        "83e4bd80-c9cc-5467-ad87-33b8e1cd8a0f",
        "bad203b5-d53c-53a1-acbf-4d2aa8a845a0",
        "90bb5368-6288-572d-b38d-f4988c5ae7e4"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Deglaze and add the stock"
    },
    {
      "step_number": 14,
      "instruction": "Add the vinegar and scrape up all the browned bits from the pan."
    },
    {
      "step_number": 15,
      "instruction": "Stir in the mustard and Liège syrup.",
      "ingredients_used": [
        "63559879-e2cb-5ce7-bcee-06a094af7f0e",
        "72bd6bcf-d716-5e40-843b-fdc0e5556e6d",
        "9ddc628e-41b9-5739-81e8-2a71d4e50242"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Pour in the beef stock (and beer if using).",
      "ingredients_used": [
        "4415efc5-1c4a-5c36-9ac2-f662854a3e4d",
        "f9029e7c-7d13-5192-a09d-cff5cd3b6283",
        "d40e238f-7c9e-5b62-8ba2-c2ffac7ae395"
      ]
    },
    {
      "step_number": 17,
      "instruction": "Add the bay leaf.",
      "ingredients_used": [
        "9c0a0f8c-bee2-55ee-9e71-7ae5ff0020e0"
      ]
    },
    {
      "step_number": 18,
      "instruction": "Stir until the syrup dissolves and the sauce looks glossy."
    },
    {
      "step_number": 19,
      "instruction": "Simmer and adjust"
    },
    {
      "step_number": 20,
      "instruction": "Return the meatballs to the pan."
    },
    {
      "step_number": 21,
      "instruction": "Cover and simmer gently for 25–30 minutes (less if your meatballs are small, longer if they’re traditional large boulets). Stir occasionally and let the sauce thicken naturally.",
      "timer_seconds": 1800
    },
    {
      "step_number": 22,
      "instruction": "Taste and adjust: more syrup for sweetness, more vinegar for tang, more mustard for depth. The sauce should be sweet‑sour, rich, and velvety.",
      "ingredients_used": [
        "63559879-e2cb-5ce7-bcee-06a094af7f0e",
        "72bd6bcf-d716-5e40-843b-fdc0e5556e6d"
      ]
    },
    {
      "step_number": 23,
      "instruction": "Serve with fries or mashed potatoes."
    }
  ],
