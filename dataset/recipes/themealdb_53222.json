  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Fry onion and pepper together on medium heat until onion is soft"
    },
    {
      "step_number": 2,
      "instruction": "Add garlic granules, cook for a minute",
      "ingredients_used": [
        "e75f507e-e316-5ff0-a2ad-7099fad23e35"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add chopped tomatoes and remaining spices, stir well",
      "ingredients_used": [
        "abd04bac-d49f-5593-9d8c-bc392afa74a4"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Simmer for about 20 minutes",
      "timer_seconds": 1200
    },
    {
      "step_number": 5,
      "instruction": "Make indents for in the sauce and crack an egg into each one",
      "ingredients_used": [
        "a05671b5-2d29-5f3e-81fc-e4c6d9adb4be"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Once egg whites are cooked through, garnish and serve with toast",
      "ingredients_used": [
        "a05671b5-2d29-5f3e-81fc-e4c6d9adb4be",
        "9668f484-0400-5d60-936f-2799735a0dbc"
