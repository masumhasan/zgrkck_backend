  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Let the frog legs soak in the milk in the fridge for an hour (optional).",
      "ingredients_used": [
        "877ba0da-4013-5f34-bb64-1653249f06d9",
        "828662f5-d8df-5145-bf55-b43bdf3addd7"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Rinse the legs and pat them dry with kitchen paper.",
      "ingredients_used": [
        "877ba0da-4013-5f34-bb64-1653249f06d9"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the olive oil and half of the garlic butter to a large wok or frying pan. Place it over high heat until the butter starts to foam. Don't let it burn.",
      "ingredients_used": [
        "629794a2-f2d4-5183-b937-080f8737f027",
        "4f31303b-2660-5f15-9dbf-65739c8e4b13",
        "0f3b4b98-2c90-5ec1-a2ba-3d77c59f7ac2"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the frog legs to the pan. Pan fry them for about 10 minutes until they are golden brown on both sides. Turn the over regularly.",
      "timer_seconds": 600,
      "ingredients_used": [
        "877ba0da-4013-5f34-bb64-1653249f06d9"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the rest of the garlic butter right in the end together with the freshly chopped parsley. Season with a pinch of pepper and salt to taste.",
      "ingredients_used": [
        "4f31303b-2660-5f15-9dbf-65739c8e4b13",
        "0f3b4b98-2c90-5ec1-a2ba-3d77c59f7ac2",
        "4e6f74d9-50bf-5e97-9536-f1ef8217e8a7",
        "3902a9a6-eca1-53d2-836c-32a2ac8f457f",
        "2d9e3c6a-1544-53dc-9635-3e5af21eb615"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Divide the frog legs over plates. Serve with grilled bread and a green salad.",
      "ingredients_used": [
        "877ba0da-4013-5f34-bb64-1653249f06d9"
      ]
    }
  ],
