  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 200C/180C fan/gas 6, then roast the peanuts on a baking tray for 5 mins until golden brown. When cool enough to handle, roughly chop. Reduce oven to 180C/160C fan/gas 4.",
      "timer_seconds": 300,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "e9624505-155f-52c7-b03c-4df934ce6599"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat 2 tbsp coconut cream in a large casserole dish with a lid. Add the curry paste and fry for 1 min, then stir in the beef and fry until well coated and sealed. Stir in the rest of the coconut with half a can of water, the potatoes, onion, lime leaves, cinnamon, tamarind, sugar, fish sauce and most of the peanuts. Bring to a simmer, then cover and cook for 2 hrs in the oven until the beef is tender.",
      "ingredients_used": [
        "e9624505-155f-52c7-b03c-4df934ce6599",
        "b1761584-638b-5b95-af70-92e120c535bb",
        "12c58ad6-775b-5e52-94ee-962670d9bb12",
        "37814808-7f5b-5ca3-a517-6e41c9497ad4",
        "2fec4160-8ee3-539d-b3fe-e172f9f6ca6f",
        "c5c6bc77-2154-500e-9a5b-9487bdf50fa3",
        "f709e4b2-f16a-5f05-971e-eb742f2fbba3"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Sprinkle with sliced chilli and the remaining peanuts, then serve straight from the dish with jasmine rice.",
      "ingredients_used": [
        "e9624505-155f-52c7-b03c-4df934ce6599",
        "e7177e56-3409-5726-9191-3ec15d735b6d",
        "657ac61f-f1db-5b81-8e26-f069daab9063"
      ]
    }
  ],
