  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the flour, eggs, milk, 1 tbsp oil and a pinch of salt into a bowl or large jug, then whisk to a smooth batter. Set aside for 30 mins to rest if you have time, or start cooking straight away.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "6c58de4e-39aa-5a78-aaa8-b46ff2391597",
        "e02c7eb6-0ec1-567b-abb2-b591e78e46cf",
        "7c9d364e-36a2-5dc8-9562-36a2da28d457"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Set a medium frying pan or crêpe pan over a medium heat and carefully wipe it with some oiled kitchen paper. When hot, cook your pancakes for 1 min on each side until golden, keeping them warm in a low oven as you go.",
      "timer_seconds": 60
    },
    {
      "step_number": 3,
      "instruction": "Serve with lemon wedges and sugar, or your favorite filling. Once cold, you can layer the pancakes between baking parchment, then wrap in cling film and freeze for up to 2 months.",
      "ingredients_used": [
        "b35f747e-1844-5157-bbf4-87adaab43592"
      ]
    }
