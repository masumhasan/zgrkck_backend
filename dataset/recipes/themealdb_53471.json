  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a stand mixer bowl, combine the dry ingredients: flour, baking powder, salt, and sugar.",
      "ingredients_used": [
        "345780d8-eaa3-5164-b3d8-065b2b324cbb",
        "2ddc3ec2-3d8c-56d5-b806-3b24fc14d600",
        "6e77d077-7d42-5727-bea0-45b7a1708053",
        "76889285-135e-563b-8fb7-18ec49e1c982"
      ]
    },
    {
      "step_number": 2,
      "instruction": "With the dough hook on low, drizzle in the milk.",
      "ingredients_used": [
        "cc12e637-d03b-5680-82ac-ee9e93f5b843"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Continue to knead until a small ball of dough is formed."
    },
    {
      "step_number": 4,
      "instruction": "Remove the dough from the bowl, oil the bowl lightly, and return the ball of dough to the bowl. Cover and set aside to rest for 15-30 minutes.",
      "timer_seconds": 1800
    },
    {
      "step_number": 5,
      "instruction": "Divide the ball of dough into 12 portions, in roughly even lumps."
    },
    {
      "step_number": 6,
      "instruction": "Heat a small amount of oil in a large, flat skillet. Flatten a ball of dough with your palm and work it into a slightly larger round with the back of your hand, leaving it a thick round about 10cm (4\") in diameter. Place in the hot skillet. Repeat with as many rounds as will fit in your skillet."
    },
    {
      "step_number": 7,
      "instruction": "After 3-4 minutes, once the bottom is slightly browned in spots, flip and cook for another 1-2 minutes on the second side."
    }
  ],
