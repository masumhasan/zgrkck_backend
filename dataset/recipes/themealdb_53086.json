  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Crumble the bread into small pieces. Sprinkle with cold water, cover with a damp cloth and leave for 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "676fb184-3b84-5dc0-b102-1be7639a6963"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat 2 tsp of olive oil in a deep pan. Add the garlic cloves separated, skins on; just make a small cut with a knife to open them and keep frying for 5 minutes. Set the garlic aside.",
      "timer_seconds": 300,
      "ingredients_used": [
        "087e159e-35c7-5441-87c1-13a75e0d1571",
        "aa3f50c3-8e4b-544c-b4a8-bc40ee9f5fdc"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In the same oil, where we fried everything, simmer the bread, stirring constantly for 15 minutes and add a grinding of black pepper.",
      "timer_seconds": 900,
      "ingredients_used": [
        "676fb184-3b84-5dc0-b102-1be7639a6963"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the garlic, continue stirring for about 20 minutes. It will be ready when the bread is soft and golden.",
      "timer_seconds": 1200,
