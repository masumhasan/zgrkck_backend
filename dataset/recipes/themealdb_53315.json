  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Halve the cabbage, remove the tough stem and thinly slice. Place in a large pan with all the other ingredients apart from the sausages, then mix in 300ml water and some salt and pepper.",
      "ingredients_used": [
        "6a741e15-04f6-5d57-856c-1d2466f5b8df",
        "151db4d0-3cf0-5f72-a9dd-4f04daad74d9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Bring to a simmer, then reduce the heat, cover with a well-fitting lid and gently cook for 1½ hrs, stirring frequently. If too dry, you can add a little more water."
    },
    {
      "step_number": 3,
      "instruction": "Add the kabanos to the cabbage mixture, place a lid on the pan and gently simmer for 20 mins. Remove the lid and cook for a further 10 mins. Serve alongside some simple mash or boiled potatoes.",
      "ingredients_used": [
        "6a741e15-04f6-5d57-856c-1d2466f5b8df"
      ]
    }
  ],
