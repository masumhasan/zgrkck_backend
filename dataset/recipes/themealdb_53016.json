  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Wrap the chicken loosely between plastic wrap and pound gently with the flat side of a meat tenderizer until about 1/2 inch thick all around."
    },
    {
      "step_number": 2,
      "instruction": "Cut into two pieces, as even as possible."
    },
    {
      "step_number": 3,
      "instruction": "Marinate in the pickle juice for 30 minutes to one hour (add a teaspoon of Tabasco sauce now for a spicy sandwich).",
      "timer_seconds": 1800,
      "ingredients_used": [
        "ad0ef248-ca8f-5183-bd61-3a5a802e2f64"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Beat the egg with the milk in a bowl.",
      "ingredients_used": [
        "16f432a5-79f1-5708-b9cd-13c51a45ae54",
        "26e638b6-4f91-5510-885a-f1cc9c3c9265"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Combine the flour, sugar, and spices in another bowl.",
      "ingredients_used": [
        "3e20eac6-0254-5c62-9d90-47a4e7a63269"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Dip the chicken pieces each into the egg on both sides, then coat in flour on both sides.",
      "ingredients_used": [
        "16f432a5-79f1-5708-b9cd-13c51a45ae54",
        "3e20eac6-0254-5c62-9d90-47a4e7a63269"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Heat the oil in a skillet (1/2 inch deep) to about 345-350."
    },
    {
      "step_number": 8,
      "instruction": "Fry each cutlet for 2 minutes on each side, or until golden and cooked through.",
      "timer_seconds": 120
    },
    {
      "step_number": 9,
      "instruction": "Blot on paper and serve on toasted buns with pickle slices.",
      "ingredients_used": [
        "f3e4e219-25e8-5c6e-9557-ab48e2a1ab42"
      ]
    }
  ],
