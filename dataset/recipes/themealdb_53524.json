  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place 1 cup of milk in a small bowl, add the cornstarch and stir to dissolve it, then set aside.",
      "ingredients_used": [
        "7febd239-d60b-57ad-80af-8eb4731b181e",
        "107b35e7-7c8f-5fb3-9e23-e486956ffde1",
        "dc6bb87e-fe46-51ad-abd1-04bcc56b8bf7",
        "a31d68f4-6f25-5609-a58b-3773dfb705d0",
        "772bd0b3-8e87-5d63-9488-fd3b035dba80"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Place the coconut milk and grated coconut in the blender and blend until smooth and set aside.",
      "ingredients_used": [
        "7febd239-d60b-57ad-80af-8eb4731b181e",
        "a31d68f4-6f25-5609-a58b-3773dfb705d0",
        "b7166ea4-a2db-5d04-8d63-da733d83c0a8",
        "772bd0b3-8e87-5d63-9488-fd3b035dba80"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Place the rest of the milk and cinnamon sticks in a medium pot and bring the mixture to boil over medium-low heat. When the milk is a little warm, but not boiling, add the coconut mixture.",
      "ingredients_used": [
        "7febd239-d60b-57ad-80af-8eb4731b181e",
        "a31d68f4-6f25-5609-a58b-3773dfb705d0",
        "b7166ea4-a2db-5d04-8d63-da733d83c0a8",
        "f9ba0d18-0d8c-5694-bdaa-24975dbdeda4",
        "772bd0b3-8e87-5d63-9488-fd3b035dba80",
        "42de9eac-23d2-55b0-b0b4-9bce859049db"
      ]
    },
    {
      "step_number": 4,
      "instruction": "When the milk starts boiling, add the condensed milk, sugar and salt. Stir well with a wooden spoon. Add the milk and cornstarch mixture and continue stirring constantly.",
      "ingredients_used": [
        "7febd239-d60b-57ad-80af-8eb4731b181e",
        "107b35e7-7c8f-5fb3-9e23-e486956ffde1",
        "dc6bb87e-fe46-51ad-abd1-04bcc56b8bf7",
        "a31d68f4-6f25-5609-a58b-3773dfb705d0",
        "772bd0b3-8e87-5d63-9488-fd3b035dba80",
        "7eabbf00-cbf1-5f9a-bc0e-d9c58908f617",
        "0f9f5032-de2c-5ad8-884a-8628706ae45e"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the vanilla extract. Reduce the heat to low and continue stirring until the Natilla thickens, about 10 to 20 minutes. Add the butter, stir and remove from the heat. Discard the cinnamon sticks. Ladle into a serving dish or individual custard cups. Sprinkle cinnamon powder on top and let it cool at room temperature for at least 2 hours. Refrigerate until ready to serve.",
      "ingredients_used": [
        "f9ba0d18-0d8c-5694-bdaa-24975dbdeda4",
        "93731e57-5191-5948-82e0-4772c123f727",
        "d8518fc1-657f-5b9f-b3a4-616c5b0769a8",
        "42de9eac-23d2-55b0-b0b4-9bce859049db"
      ]
    }
  ],
