  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the olive oil in a large skillet over medium-high heat. Cook and stir the onions in the hot oil until translucent, about 5 minutes. Add the ginger-garlic paste and continue cooking another 5 minutes. Reduce heat to medium; stir the tomatoes into the mixture and cook until the tomatoes are pulpy, 5 to 10 minutes. Season with the cayenne pepper, curry powder, garam masala, turmeric, and cumin; cook and stir another 5 minutes.",
      "ingredients_used": [
        "694dbeaf-3120-5376-82ac-03a94d939239",
        "e49cbfe2-a9de-5875-b5c3-537e1bf96217",
        "2c079fbf-60df-56f4-8f65-d9d93a80f6d6",
        "88210917-c0c5-5053-80b6-780e5b2a983b",
        "98f9b407-65b9-5e8d-87e4-0c33d7bdb908",
        "9a212ddd-204b-565d-8391-b5be22b69096",
        "6b580f8e-2ab4-5e57-aea5-d60b8f7e3154",
        "3d5f7e32-f502-5faf-8667-21f68d6e9388"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the chicken and potatoes to the mixture in the skillet; simmer, stirring occasionally, until the potatoes are tender and the chicken is no longer pink in the center, about 20 minutes. Sprinkle the cilantro over the mixture and continue simmering another 10 minutes. Serve hot.",
      "ingredients_used": [
        "18b7974c-f9f0-5741-a694-199b5f8e698a",
        "b720c965-6ba1-5ff9-a452-40a1239989b4"
      ]
    }
