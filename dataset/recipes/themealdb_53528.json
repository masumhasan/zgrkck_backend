  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place the pork chops in a zip lock plastic bag. Add the mustard, cumin, garlic, salt and pepper.",
      "ingredients_used": [
        "f7eb4e2a-6ea3-5f75-a151-062261af9fc7",
        "238899e6-07aa-5e3e-a8f8-42c0302700f9",
        "69b65ba8-22f1-50c6-ae82-ff73ff44b88b",
        "cfd4241c-8938-5b56-9890-05770ebfcfc6",
        "b4f25b31-6297-590d-96d6-ed3816af6b01"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Refrigerate for 1 hour or overnight. Be sure the pork chops are evenly covered.",
      "timer_seconds": 3600,
      "ingredients_used": [
        "f7eb4e2a-6ea3-5f75-a151-062261af9fc7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In a large skillet, heat the oil over medium heat. Place the pork chops into the skillet and cook for 3 minutes per side. Remove the pork from the pan and keep aside on a warm plate.",
      "timer_seconds": 180,
      "ingredients_used": [
        "f7eb4e2a-6ea3-5f75-a151-062261af9fc7"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the onions and tomatoes to the same skillet where the pork was browned, adding an additional tablespoon of oil if needed. Cook over high heat for about 5-7 minutes or until browned and softened, stirring frequently to avoid burning. Add the reserved cooked pork chops and cover, reduce the heat to medium-low and simmer until the pork is tender and barely pink in the center, about 15 minutes. Divide the chops among plates, spoon the sauce over the top, add the cilantro and serve immediately.",
      "ingredients_used": [
        "f7eb4e2a-6ea3-5f75-a151-062261af9fc7",
        "c73de139-6158-503f-aa37-7c8ca51b6bec",
        "5d098fc1-21e8-56d6-8a0e-dc1f50c636b7",
        "da2f2baa-6559-5439-9968-9ff3dce302af"
      ]
    }
  ],
