  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix the self-rising flour, sugar, speculaas spice mix and salt. Add the butter and milk and knead into a firm ball of dough. Start with 6 tablespoons of milk, if the dough is too stiff you can add more milk.",
      "ingredients_used": [
        "7e571110-c21e-5782-a467-df894dc0f497",
        "c5c15400-0443-5c26-a6b5-7c1eb14b7f21",
        "fcfa0fd9-f507-5195-96e5-73b52ca20d27",
        "87bb0df1-9f19-5e5d-8968-0cf4b7b47a77",
        "011ec7f2-cc1d-5eba-aaa8-16ec3ffecde7"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Wrap the dough in plastic wrap and refrigerate overnight. You can process and bake it immediately, but the flavor will be much better if you let it rest."
    },
    {
      "step_number": 3,
      "instruction": "Mix the almond paste with half of the beaten egg and knead well. This makes it easier to work with and gives it a better and tastier texture.",
      "ingredients_used": [
        "6fe39ebc-e870-5874-8106-6266f93213cf",
        "57fda6d6-439b-5224-b9bf-bc6d5c175e2d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Take half of the dough and roll it out to 20 x 20 cm. Place in a baking pan lined with parchment paper. Spread the almond paste mixture evenly. Roll out the remaining dough and place on top of the almond paste.",
      "ingredients_used": [
        "6fe39ebc-e870-5874-8106-6266f93213cf"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Brush the top with the remaining beaten egg. Garnish with almonds and top with another layer of egg wash.",
      "ingredients_used": [
        "57fda6d6-439b-5224-b9bf-bc6d5c175e2d",
        "930982c0-2922-55fd-a686-919b168716e1"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Bake the filled speculaas for 40 minutes at 180°C/350℉ (conventional oven) or until done.",
      "timer_seconds": 2400,
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    }
  ],
