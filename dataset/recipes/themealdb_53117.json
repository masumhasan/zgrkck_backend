  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "To make the horseradish cream, mix the crème fraîche, grated horseradish, lemon juice, salt and white pepper in a bowl. Refrigerate until serving.",
      "ingredients_used": [
        "19b60225-b99f-5d93-a29e-79e26a1d1c7d",
        "c2889fbb-d9cc-5cd8-92df-642ba77bd17b",
        "f4f15e6a-26f9-5c70-a674-0f29094cd283",
        "ed8f0a97-7ba2-5a8e-9891-2a7f701440d3",
        "0f42d7e1-4345-5ba7-962c-017db1957585",
        "3a1b246c-4a63-52b6-9da9-c69c56274b79"
      ]
    },
    {
      "step_number": 2,
      "instruction": "To make the crispy shallots, heat some vegetable oil in a frying pan over a medium heat. Add the sliced shallots and fry until golden brown and crispy.",
      "ingredients_used": [
        "d42628d5-46dc-5262-bf83-1f2db7147559",
        "75f7adf4-fbf4-505c-8d9b-37b63fb8e772"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Remove with a slotted spoon and drain on a plate lined with kitchen paper. Season with a pinch of salt.",
      "ingredients_used": [
        "f4f15e6a-26f9-5c70-a674-0f29094cd283",
        "0f42d7e1-4345-5ba7-962c-017db1957585",
        "3a1b246c-4a63-52b6-9da9-c69c56274b79"
      ]
    },
    {
      "step_number": 4,
      "instruction": "To make the open sandwich, bring a large saucepan of salted water to the boil, then blanch half of the asparagus (four white and four green) until tender-crisp, about 2–3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "f4f15e6a-26f9-5c70-a674-0f29094cd283",
        "0f42d7e1-4345-5ba7-962c-017db1957585",
        "7ed1aca7-e852-5ba2-a054-6b447c429d91",
        "73d46235-58a0-5d0a-a000-494d6c11a7c4",
        "3a1b246c-4a63-52b6-9da9-c69c56274b79"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add ice to a bowl of cold water. Use a slotted spoon to remove the asparagus from the boiling water and immediately transfer to the iced water to stop cooking. Thinly slice the remaining asparagus lengthwise to serve raw.",
      "ingredients_used": [
        "7ed1aca7-e852-5ba2-a054-6b447c429d91",
        "73d46235-58a0-5d0a-a000-494d6c11a7c4"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Pre-heat the grill until hot. Spread the rye bread with butter and grill until golden and crisp.",
      "ingredients_used": [
        "a5b1dd1d-5a3c-5329-8f86-4a26480a64a8",
        "eb631f11-a09f-54db-a05b-49c14ec5328e"
      ]
    },
    {
      "step_number": 7,
      "instruction": "To serve, place the grilled bread slices on serving plates. Arrange both the blanched and raw asparagus on the bread. Drizzle with horseradish cream, then sprinkle grated cheese over the top. Garnish with the crispy shallots and some fresh dill to finish.",
      "ingredients_used": [
        "19b60225-b99f-5d93-a29e-79e26a1d1c7d",
        "75f7adf4-fbf4-505c-8d9b-37b63fb8e772",
        "7ed1aca7-e852-5ba2-a054-6b447c429d91",
        "73d46235-58a0-5d0a-a000-494d6c11a7c4",
        "a5b1dd1d-5a3c-5329-8f86-4a26480a64a8",
        "87aff5ca-24ac-55f9-b78e-3d5d53471645"
      ]
    }
  ],
