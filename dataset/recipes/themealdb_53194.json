  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Pour 1.3 liters water into a large saucepan over a high heat. Add the onion, tomato, chilli, galangal, lemongrass, prawn heads and chicken stock cube. Stir and bring to a boil, then reduce the heat to medium and simmer for 20 mins until the liquid has reduced.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "09cf21c0-ea6f-5b61-b714-48c96709f7d0",
        "74a2e30f-e2f5-5c98-b49b-4e279d1b2a6f",
        "bd694c60-78cb-550d-8d87-63e123b87bd1",
        "ab3a1e58-d481-5096-9866-2f9014c975e2",
        "4cb1b070-4ffa-59d4-9015-08a669bae06e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Carefully strain the hot broth into a large heatproof bowl or jug, then discard the prawn heads. Return the strained veg and herb mixture to the saucepan and pour over the broth. Stir through the mushrooms and lime leaves, then cook for 3 mins until the mushrooms are tender.",
      "timer_seconds": 180,
      "ingredients_used": [
        "f34f8df8-353d-55ac-85ae-810e3938ef07"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add 1 tbsp sugar, the fish sauce, lime juice, coconut milk and prawns. Bring to the boil and cook until the prawns are cooked through, about 1-2 mins. Remove from the heat. Remove the lemongrass, then stir in the Thai chilli jam, if using. Scatter over the coriander to finish, if you like, and serve.",
      "timer_seconds": 120,
      "ingredients_used": [
        "bd694c60-78cb-550d-8d87-63e123b87bd1",
        "e6c10b85-1e56-5357-a68c-d4baa3570058",
        "1423947c-a290-5c12-8197-5f7c847374f8",
