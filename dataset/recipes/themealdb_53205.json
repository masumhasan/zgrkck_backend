  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in a medium saucepan. Tip in the onion and ginger, then cook for a few mins until softened. Stir in the curry paste, then cook for 1 min more. Pour over the chopped tomatoes and coconut cream. Bring to the boil, then leave to simmer for 5 mins, adding a little boiling water if the mixture gets too thick.",
      "ingredients_used": [
        "24da2ce6-2bba-5b9b-90fd-149f831a5abc",
        "099451e5-60bc-501d-8929-93ab7c29690f",
        "23249444-43d6-5845-a579-0c06bdfc3831"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Tip in the prawns, then cook for 5-10 mins more, depending on how large they are. Serve alongside some plain rice and sprinkle with a little chopped coriander, if you like.",
      "timer_seconds": 600,
