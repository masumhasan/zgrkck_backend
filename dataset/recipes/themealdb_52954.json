  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "MAKING THE SOUP"
    },
    {
      "step_number": 2,
      "instruction": "In a wok add chicken broth and wait for it to boil."
    },
    {
      "step_number": 3,
      "instruction": "Next add salt, sugar, sesame seed oil, white pepper, hot pepper sauce, vinegar and soy sauce and stir for few seconds.",
      "ingredients_used": [
        "ad022ae3-7336-5859-bad1-4d9054b75fd4",
        "fe8eee95-1dc8-5a95-bd2a-41a665e3c187",
        "8d30afc9-362e-596a-bb99-934ce7d160dc",
        "1505e240-3225-50b2-8688-743ea81d4867",
        "f8c628df-18a2-5cd2-8453-3732b366a3e0",
        "0560c2b5-55b4-534d-af9f-6da3c3be0492"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add Tofu, mushrooms, black wood ear mushrooms to the wok.",
      "ingredients_used": [
        "1a7bd1ec-2df3-57ec-aebe-daec9641d23a",
        "9401ca2a-138d-5722-ab79-10846b847654",
        "c09dd0f5-016b-5d7a-bd07-8f05de60ba7d"
      ]
    },
    {
      "step_number": 5,
      "instruction": "To thicken the sauce, whisk together 1 Tablespoon of cornstarch and 2 Tablespoon of water in a bowl and slowly add to your soup until it's the right thickness.",
      "ingredients_used": [
        "d1a7660d-a6b1-5994-8b4a-f76a7713054a",
        "ea01bb90-a88c-5466-89ce-b9f7f0c1107c"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Next add 1 egg slightly beaten with a knife or fork and add it to the soup and stir for 8 seconds",
      "timer_seconds": 8
    },
    {
      "step_number": 7,
      "instruction": "Serve the soup in a bowl and add the bbq pork and sliced green onions on top.",
      "ingredients_used": [
        "da804d9f-b786-5ea4-a987-ea4719b594a7",
        "b6af811d-4ab9-5d94-8129-eb45b0967954"
      ]
    }
  ],
