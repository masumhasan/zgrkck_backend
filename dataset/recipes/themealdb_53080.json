  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a large bowl, whisk together 1/2 cup buckwheat flour, 2/3 cup all-purpose flour, 1/2 teaspoon salt, and 1 teaspoon yeast.",
      "ingredients_used": [
        "07f06636-585c-5826-83d0-a50c733b6057",
        "fa0112b7-50f2-5d73-a603-188680790be9",
        "96bcfe42-f535-5d55-933e-eb6546b1c97e",
        "745ea9e3-2b04-54ae-9073-c9605dcd4398"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Make a well in the center and pour in 1 cup warm milk, whisking until the batter is smooth.",
      "ingredients_used": [
        "b2fd234f-3489-57f9-b468-3c4c264e8937"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cover the bowl and let the batter rise until doubled, about 1 hour.",
      "timer_seconds": 3600
    },
    {
      "step_number": 4,
      "instruction": "Enrich and Rest the Batter"
    },
    {
      "step_number": 5,
      "instruction": "Stir 2 tablespoons melted butter and 1 egg yolk into the batter.",
      "ingredients_used": [
        "969205fd-5f44-5728-bd79-c827b908732c",
        "62c957cc-78fe-5de6-948d-46911363205e"
      ]
    },
    {
      "step_number": 6,
      "instruction": "In a separate bowl, whisk 1 egg white until stiff, but not dry.",
      "ingredients_used": [
        "62c957cc-78fe-5de6-948d-46911363205e"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Fold the whisked egg white into the batter.",
      "ingredients_used": [
        "62c957cc-78fe-5de6-948d-46911363205e"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Cover the bowl and let the batter stand 20 minutes.",
      "timer_seconds": 1200
    },
    {
      "step_number": 9,
      "instruction": "Pan-Fry the Blini"
    },
    {
      "step_number": 10,
      "instruction": "Heat butter in a large nonstick skillet over medium heat.",
      "ingredients_used": [
        "969205fd-5f44-5728-bd79-c827b908732c"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Drop quarter-sized dollops of batter into the pan, being careful not to overcrowd the pan. Cook for about 1 minute or until bubbles form.",
      "timer_seconds": 60
    },
    {
      "step_number": 12,
      "instruction": "Turn and cook for about 30 additional seconds."
    },
    {
      "step_number": 13,
      "instruction": "Remove the finished blini onto a plate and cover them with a clean kitchen towel to keep warm. Add more butter to the pan and repeat the frying process with the remaining batter.",
      "ingredients_used": [
        "969205fd-5f44-5728-bd79-c827b908732c"
      ]
    }
  ],
