  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare the Flour Batter",
      "ingredients_used": [
        "26a39620-d03f-50cc-ba34-cf9703ed4965"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Mix together the flour, water and salt ensuring all the lumps are dissolved. The mixture should be thick but still of a pouring consistency, add a little extra water if required. Put to one side.",
      "ingredients_used": [
        "26a39620-d03f-50cc-ba34-cf9703ed4965",
        "0eaa7e67-26aa-56ce-81c9-a96c2ec36336",
        "fa7843d5-5755-52c8-a4ca-1134a961a4ed"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Prepare the Batter Filling"
    },
    {
      "step_number": 4,
      "instruction": "Mix together the butter, oil and chosen yogurt / cream ensuring all the lumps are dissolved. The mixture should be runny, leave to rest for 10 minutes before given it another good mix. The consistency should be similar to custard. Put to one side.",
      "timer_seconds": 600,
      "ingredients_used": [
        "93136365-d63b-5d33-8542-9d55b467eddb",
        "99a9c9e1-0135-5a96-9ddc-020486a6bdc1",
        "761e53a6-0453-5a6b-a7bf-adb0c1cac231",
        "3b6f060f-5129-5011-b0f3-ac52fe7d6271"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Baking"
    },
    {
      "step_number": 6,
      "instruction": "Preheat the gill to a medium setting (I use mark 4 of 6). Take a large deep baking tray or pie pan and rub some olive oil over the base. Make the first layer of flour batter using a squirty bottle or laydel, don't try to pour the batter as it will be too thick in the pan. You need to make a star effect by leaving triangles between each line of batter layers. Place under the grill until golden brown. This will take between 3 - 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "26a39620-d03f-50cc-ba34-cf9703ed4965",
        "abceb1f0-b64b-54c9-a8f0-de1216ce8785"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Remove from under the grill and using a brush or the back of spoon rub over the whole pan (both battered and un-battered areas) a layer of the batter filling. Then, add a layer of the flour filling, use the same star effect this time placing the lines of batter through the gaps left from the previous layering. Also, leaving the same triangle shapes between each line. Place under the grill until golden brown. This will take between 3 - 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "26a39620-d03f-50cc-ba34-cf9703ed4965"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Repeat step 4 until all the mixture has been used and ensuring each triangle gap is filled with flour batter on each layer - this will take around 2 hours. After every couple of layers, use one layer just to fill up any spaces (large gaps between the batter stars) that may have started to show.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "26a39620-d03f-50cc-ba34-cf9703ed4965"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Serving"
    },
    {
      "step_number": 10,
      "instruction": "Once the Flija is ready serve straight away with honey or yogurt.",
      "ingredients_used": [
        "99a9c9e1-0135-5a96-9ddc-020486a6bdc1"
      ]
    }
  ],
