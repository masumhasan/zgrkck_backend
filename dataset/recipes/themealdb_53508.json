      ]
    },
    {
      "step_number": 3,
      "instruction": "Add hot coconut milk mixture and stir well. Mixture should be of a thick liquid texture.",
      "ingredients_used": [
        "f99a8baa-f175-54c9-9100-c5c84681bf4d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Use 1 tablespoons of coconut milk mixture to grease baking pan. Pour batter into prepared baking pan and bake at 350°F (basting occasionally with reserved coconut milk mixture) for 2 to 3 hours or until knife inserted in center comes out clean.",
