  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "For the topping, boil the potatoes in salted water until tender. Drain and push through a potato ricer, or mash thoroughly. Stir in the butter, cream and egg yolks. Season and set aside.",
      "ingredients_used": [
        "540c72bb-6d76-594b-91ea-b55ebcdf06eb",
        "d91ce979-60da-5646-9bb6-a4f7354dc5a8",
        "106dbf05-551b-59ac-9e1a-81e69f077bb9",
        "b2454ba8-5be3-5131-acbf-45a0041b2790"
      ]
    },
    {
      "step_number": 2,
      "instruction": "For the filling, melt the butter in a large pan. Add the shallots, carrots and celery and gently fry until soft, then add the garlic. Pour in the wine and cook for 1 minute. Stir in the tomato purée, chopped tomatoes and stock and cook for 10–15 minutes, until thickened. Add the shredded chicken, olives and parsley. Season to taste with salt and pepper.",
      "ingredients_used": [
        "d91ce979-60da-5646-9bb6-a4f7354dc5a8",
        "b2454ba8-5be3-5131-acbf-45a0041b2790",
        "020ff132-6169-51d6-b6f1-c3bb4cf5f61b",
        "b3cfc951-e3c3-524f-91f2-33342f07ee97",
        "f14c2a77-1ce1-5a32-9193-ebcd476433a5",
        "7a378365-9528-52e5-8148-035e961674d7",
        "47aba867-0105-5c1c-b3ab-155f860cc824",
        "5cb967a0-bf6e-5782-b399-337b0e032e2e",
        "7688c52a-1be3-5032-86e6-7bb5be314206"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Preheat the oven to 180C/160C Fan/Gas 4.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 4,
      "instruction": "Put the filling in a 20x30cm/8x12in ovenproof dish and top with the mashed potato. Grate over the Gruyère. Bake for 30–35 minutes, until piping hot and the potato is golden-brown.",
      "timer_seconds": 2100
    }
  ],
