  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Make the Dough: Mix flour and salt in a large bowl. Add butter, using your fingers to blend into a crumbly texture. Gradually add water, mixing until a dough forms. Wrap and chill for 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "0601bdb7-6e80-5153-83dd-39194ce96d5c",
        "b5538fdc-126e-554d-8c75-fb29a55f880e",
        "6b0d1375-3fe2-57a6-99af-4a7a91a8a44a",
        "82ed487e-abb0-5791-8908-bf4c94b5e1c4"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Prepare the Filling: Cook onions in a pan until translucent. Add ground beef, cooking until browned. Stir in spices, then remove from heat. Once cooled, mix in eggs and olives.",
      "ingredients_used": [
        "1b342514-575d-524a-88bd-200520202e76",
        "f8fded75-a940-5624-aefd-21584c91b2d2",
        "f033e14a-7c72-5e0a-b0ff-a47c2deba09d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Assemble: Roll out the dough and cut into circles. Place a spoonful of filling in each, fold over, and seal the edges."
    },
    {
      "step_number": 4,
      "instruction": "Cook: Bake at 200°C (400°F) for 20-25 minutes, or until golden.",
      "timer_seconds": 1500,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 5,
      "instruction": "Pro Tips:"
    },
    {
      "step_number": 6,
      "instruction": "For a flakier crust, incorporate a tablespoon of vinegar into the dough mixture. This helps prevent gluten formation."
    },
    {
      "step_number": 7,
      "instruction": "Seal the edges of the empanadas with a fork to ensure they do not open during baking or frying."
    }
  ],
