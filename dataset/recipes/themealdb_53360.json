  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add tamarind pulp and 1 cup granulated sugar to a bowl and mash together with a spoon or fork. Take small amounts of the tamarind and sugar mix and shape them into small balls by rolling them in your hands. Make them the size of a marble or slightly bigger, as you like.",
      "ingredients_used": [
        "ddae1e4f-f943-5c57-a50a-17346737acbb",
        "55d809c2-b552-5343-9b12-d7e9f58f09c9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the remaining sugar to a flat surface, like a plate or a sheet pan. Roll the tamarind balls in granulated sugar until they're well-coated.",
      "ingredients_used": [
        "55d809c2-b552-5343-9b12-d7e9f58f09c9"
      ]
    },
    {
      "step_number": 3,
      "instruction": "You can eat the tamarind balls immediately, or you can let them set for a few hours or overnight. Allowing them to set will give them a firmer texture and more crystallized sugar coating. Enjoy.",
      "ingredients_used": [
        "55d809c2-b552-5343-9b12-d7e9f58f09c9"
      ]
    }
  ],
