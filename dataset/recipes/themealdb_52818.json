        "0c09b9a5-4a55-5ae5-80a2-7d22aba7fbab"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add your cream, stock and macaroni.",
      "ingredients_used": [
        "4a0d3edd-f226-5afb-8b2b-f3f870249d64"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cook on low for 20 minutes. Add your cheeses, stir to combine.",
      "timer_seconds": 1200
    },
    {
      "step_number": 4,
      "instruction": "Top with roasted peppers and parsley.",
