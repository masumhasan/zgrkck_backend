  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Fry your onion, peppers and garlic in olive oil until nicely translucent. Make a well in your veg and add your chicken. Add your seasoning and salt. Allow to color slightly.",
      "ingredients_used": [
        "e7452c88-ccab-54f4-86b6-bca28f8aa6d4",
        "bcc9392f-b29a-5939-9dc8-ce9a68538cce",
        "c4d0f3d9-045f-5c2e-b273-8d5132de30ee",
