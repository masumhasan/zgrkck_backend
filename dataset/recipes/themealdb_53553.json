  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Finely chop onion and garlic.",
      "ingredients_used": [
        "42e8099b-ff9c-51fc-8402-9f163b77e880",
        "85ad736a-aa34-55be-ab1f-dbf715ce67ec"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Stir salt into minced meat. Add the dry ingredients, then onion and garlic, then the egg. and lastly the milk. Stir the meat mixture until it is firm. Refrigerate for at least 30 minutes. You can also make the mixture one day in advance and refrigerate.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "42e8099b-ff9c-51fc-8402-9f163b77e880",
        "85ad736a-aa34-55be-ab1f-dbf715ce67ec",
        "bffe7c62-99a1-586f-922f-b937975d6f4f",
        "1e34073a-d87c-5207-8928-6675fa699b84",
        "82ffb75e-597c-5aec-9bd6-ce7e88d640d5"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat a pan over medium heat. Add butter to the pan and use a spoon to form frikadeller (meatballs) in your preferred size. We recommend using about 2 tablespoons of mixture per frikadelle.",
      "ingredients_used": [
        "e46f22b5-289e-5e7c-8d8d-d997de112b73"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Fry until they develop a nice browned crust on both sides and are cooked all the way through."
    },
    {
      "step_number": 5,
      "instruction": "Serve hot with a classic potato salad on the side."
    }
  ],
