  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add chicken to a large Dutch oven or stock pot"
    },
    {
      "step_number": 2,
      "instruction": "Cover with water"
    },
    {
      "step_number": 3,
      "instruction": "Bring to a boil and simmer for 2 to 2 1/2 hours, skimming any impurities off the top to insure a clear broth",
      "timer_seconds": 7200
    },
    {
      "step_number": 4,
      "instruction": "If your pot is big enough, add the vegetables and spices for the last hour of the cooking time"
    },
    {
      "step_number": 5,
      "instruction": "My Dutch oven wasn’t big enough to hold everything, just the chicken and other bones filled the pot, so I cooked the meat/bones for the full cooking time, then removed them, and cooked the vegetables and spices separately"
    },
    {
      "step_number": 6,
      "instruction": "Strain everything out of the broth"
    },
    {
      "step_number": 7,
      "instruction": "Bone the chicken, pulling the meat into large chunks"
    },
    {
      "step_number": 8,
      "instruction": "Slice the carrots",
      "ingredients_used": [
        "31dafd3f-6a5d-59e8-a8dd-cfde272878d9"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Return the chicken and carrots to the broth",
      "ingredients_used": [
        "31dafd3f-6a5d-59e8-a8dd-cfde272878d9"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Cook noodles according to package instructions if you’re using them"
    },
    {
      "step_number": 11,
      "instruction": "Add noodles to bowl and then top with hot soup"
    }
  ],
