  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a wok add chicken broth and wait for it to boil."
    },
    {
      "step_number": 2,
      "instruction": "Next add salt, sugar, white pepper, sesame seed oil.",
      "ingredients_used": [
        "731bafb4-0f77-5455-98d3-4c1dd7765085",
        "d8a7e30a-af59-53f0-a19b-6cec959b39eb",
        "92705f3d-485f-55f1-a661-021e9f7ced51",
        "d6b32aa8-f5ed-54e3-9bbc-44bc4606f445"
      ]
    },
    {
      "step_number": 3,
      "instruction": "When the chicken broth is boiling add the vegetables to the wok."
    },
    {
      "step_number": 4,
      "instruction": "To thicken the sauce, whisk together 1 Tablespoon of cornstarch and 2 Tablespoon of water in a bowl and slowly add to your soup until it's the right thickness.",
      "ingredients_used": [
        "8d306e2b-2e34-5b24-bdcc-1286eb63f472",
        "11379f1c-9ac2-5cb2-b6c2-d94fae839cc9"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Next add 1 egg slightly beaten with a knife or fork and add it to the soup slowly and stir for 8 seconds",
      "timer_seconds": 8
    },
    {
      "step_number": 6,
      "instruction": "Serve the soup in a bowl and add the green onions on top.",
      "ingredients_used": [
        "1d40c735-ec4b-5979-8a38-4a2c5ff680bf"
      ]
    }
  ],
