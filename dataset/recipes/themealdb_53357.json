    },
    {
      "step_number": 3,
      "instruction": "Add rice, coconut milk, kidney beans, water, kosher salt, allspice, and black pepper to a large pot and stir until combined. Lay green onions, thyme and Scotch bonnet pepper on top. Bring mixture to a boil.",
      "ingredients_used": [
        "817320a7-193e-5da1-936c-2151ef50dfa5",
