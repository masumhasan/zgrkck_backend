  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Sift flour, baking powder, salt, and sugar together. In a separate bowl, beat 6 eggs, then blend in the butter and milk.",
      "ingredients_used": [
        "cefe4ace-4d5c-50c4-bdd4-c72a2258e750",
        "48e9efd8-9dd5-5f9f-a4b6-d6bf8fa07163",
        "ae2c75ec-b15b-563d-a01f-8a6e597c258f",
        "78d11556-3fd9-54a5-a426-296da6aece69",
        "e9e87468-17fc-5ddb-8ce2-e829626a6d92",
        "887e9926-2d37-5991-8b57-1f29e761c6f1",
        "fca4fed3-6a7e-5021-a0a1-0232b4b8fbd3"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Sprinkle one tablespoon of sev dzandig (black seeds) and all the mahleb on top of the dry ingredients. Make a hole in the center of the dry ingredients and pour the wet ingredients in all at once, mixing with a few strokes until the dough can be turned out onto a floured board. Add more flour if necessary; it shouldn't be too sticky.",
      "ingredients_used": [
        "cefe4ace-4d5c-50c4-bdd4-c72a2258e750",
        "6c7b2803-e980-560f-b0c8-8bfed3ec4d25"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Knead the mixture gently, just a few times, and then roll it out until it is ½\" thick. Cut it into diamond shapes, circles, or long strips which can be rolled and braided into loaves. Prick each piece several times with a fork."
    },
    {
      "step_number": 4,
      "instruction": "Beat the seventh egg with additional sev dzandig (black seeds) added. Brush each piece of koulenje with this glaze and place on cookie sheet covered with baking parchment.",
      "ingredients_used": [
        "2ec60e79-9e84-554d-a0ef-e8c65ae71c2c"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Bake at 400° for 12-15 minutes until slightly golden. Cool on a rack. These are best eaten warm. You can reheat them by wrapping in foil.",
      "timer_seconds": 900
    }
  ],
