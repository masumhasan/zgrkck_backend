  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 350 degrees F (175 degrees C). Grease a 9-inch pie dish.",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "Place the brown sugar and butter in a mixing bowl, and beat them together with an electric mixer until creamy and very well combined, without lumps. Beat in eggs, one at a time, incorporating the first egg before adding the next one. Add the vanilla extract and salt; beat the flour in, a little at a time, and then the milk, making a creamy batter. Pour the batter into the prepared pie dish.",
      "ingredients_used": [
        "ddca1baa-1361-548a-8caf-eddc2d214328",
        "401d81b8-2fc0-5863-afad-f7878ff01d7f",
        "dd69f147-ada3-5ffc-ac33-623ac6454bbf",
        "9af9d93f-97cb-5a49-b72a-8b9d0c67ebd1",
        "06c64ccc-a54a-5d09-aca9-440609f65a97",
        "78a6a10f-d561-514c-aab2-4aaf11a8749d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Bake in the preheated oven for 35 minutes; remove pie, and cover the rim with aluminum foil to prevent burning. Return to oven, and bake until the middle sets and the top forms a crusty layer, about 15 more minutes. Let the pie cool to room temperature, then refrigerate for at least 1 hour before serving."
    }
  ],
