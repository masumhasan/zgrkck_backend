  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat 1 tbsp of the oil in a wok, add the onion, garlic and chilli, and cook for 2-3 mins until golden. Add the prawns and cook for 1 min. Tip in the rice and peas, and keep tossing until very hot. Add the soy and fish sauce, then stir through the chopped coriander. Keep warm while you fry the eggs.",
      "ingredients_used": [
        "fe1fe7cb-2789-5360-90f7-bafb70ef7e07",
        "f854fb02-4cff-520d-bb76-580b5ae4e976",
        "af95126c-536a-5791-a886-d3453a9e6119",
        "597e6e1e-63b8-5ee9-8deb-2fa4c7ef09d1",
        "e2b3d117-b151-531d-a1ab-831febc55555",
        "a68793f5-b4c5-5db3-b7e8-bfabfb4956d0"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat the remaining oil in a frying pan and fry the eggs with some seasoning. Divide the fried rice mix between 4 bowls and top each with a fried egg. Serve scattered with coriander, with chilli sauce, if you like.",
      "ingredients_used": [
        "fe1fe7cb-2789-5360-90f7-bafb70ef7e07",
