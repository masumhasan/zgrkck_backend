  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat your oven to 375°F (190°C). Lightly grease a 9x13-inch baking dish or a similar-sized casserole dish.",
      "temperature": {
        "value": 375,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "Place the bell pepper halves in the prepared baking dish, cut side up. Bake for 15-20 minutes, or until slightly softened.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "5a8e82b3-e1fe-57d3-a162-b4572f43988a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "While the bell peppers are baking, prepare the filling. In a large skillet, heat the olive oil over medium heat. Add the chopped onion, and cook for 3-4 minutes, until softened. Add the garlic, and cook for another 1 minute, until fragrant.",
      "ingredients_used": [
        "f8655b6f-6181-53fa-86bf-4b347a008132",
        "87eb5dd6-5784-5b84-8e09-f41527c5235e",
        "ec435fc6-f216-55f4-8427-6935b4b67051"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Stir in the cooked quinoa, black beans, corn, diced tomatoes, ground cumin, chili powder, smoked paprika, salt, and pepper. Cook for 5-7 minutes, until heated through. Remove the skillet from heat, and stir in 1 cup of the shredded cheese, if using.",
      "timer_seconds": 420,
      "ingredients_used": [
        "31f577b5-fae7-501b-a235-2bbe6482c5c0",
        "ff9b7be4-ec91-51af-8b69-1ed762409543",
        "346b4567-e5f3-5196-99c9-c7b9b9836549",
        "1c0167fd-8bf5-503c-ade0-b244630b2d92",
        "e8cc3e49-96b0-50e4-a656-d5deb180b411",
        "7554a976-3392-5aa7-973d-9928df2b9f57",
        "76ed1d94-827f-5232-85ca-0f83fd0e383a",
        "5a8e82b3-e1fe-57d3-a162-b4572f43988a"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Remove the bell peppers from the oven, and carefully stuff each pepper half with the quinoa and black bean mixture. Top the stuffed peppers with the remaining 1/2 cup of shredded cheese, if using.",
      "ingredients_used": [
        "31f577b5-fae7-501b-a235-2bbe6482c5c0",
        "5a8e82b3-e1fe-57d3-a162-b4572f43988a"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Return the stuffed peppers to the oven, and bake for another 15-20 minutes, until the cheese is melted and the peppers are tender.",
      "timer_seconds": 1200
    },
    {
      "step_number": 7,
      "instruction": "Remove from the oven, and allow the stuffed peppers to cool for 5 minutes before serving. Garnish with fresh chopped cilantro.",
      "timer_seconds": 300,
      "ingredients_used": [
        "edfb2c2f-624d-5c8d-80cd-2d5763c21dfe"
      ]
    }
  ],
