  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mash bananas with fork in bowl.",
      "ingredients_used": [
        "808f728e-c6f8-597f-afb3-3bc0dbe6ad4f"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add brown sugar, vanilla, extract, cinnamon, nutmeg and a pinch of salt. Sift in flour and stir with spoon until fully combined.",
      "ingredients_used": [
        "89cc338f-8159-5318-be9d-a289e0d3e6a2",
        "d5071909-4f52-52ac-80cf-a8b229120630",
        "974d0fbd-9d71-5498-bc37-80ae1693bc3f",
        "7f596970-a346-5b54-a826-e4ae651f93f1",
        "65b3c9c4-36d2-591b-bbcc-2200afbf16ad"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add oil to a 10 inch skillet over medium-high heat. Once oil is hot, drop banana fritter batter in oil by the spoonful. Once one side is golden and bubbles appear on the top, flip fritter and cook until the other side is browned as well.",
      "ingredients_used": [
        "808f728e-c6f8-597f-afb3-3bc0dbe6ad4f",
        "d2e1ec1c-ecdd-5356-ba9e-d9fa77c3d53c"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Remove fritters and drain on paper towels. Enjoy"
    }
