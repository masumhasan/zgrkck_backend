  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place the noodles and beansprouts in a heatproof bowl and cover with boiling water. Leave for 4 mins, or until the noodles are tender. Drain, then cool under cold running water and drain again. Return to the bowl.",
      "timer_seconds": 240,
      "ingredients_used": [
        "30fc6a39-5a5c-522a-8ef6-e1d12b246d07"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Stir together the lime zest and juice, fish or soy sauce and sugar. Stir into the noodles with the red onion and lettuce.",
      "ingredients_used": [
        "30fc6a39-5a5c-522a-8ef6-e1d12b246d07",
        "66fbf1c9-1f35-5b7f-88ec-ad3058eebe0c",
        "ce95c6d8-3ca1-5fc9-98fc-bcae2609a389"
      ]
    },
    {
      "step_number": 3,
      "instruction": "To make with mince, heat a little oil in a non-stick frying pan and stir-fry 500g minced pork, a small knob of grated ginger and pinch cayenne pepper or chilli powder for 10 mins, until the mince is browned and cooked through. Mix into the noodles, divide between four bowls and serve warm.",
      "timer_seconds": 600,
      "ingredients_used": [
        "30fc6a39-5a5c-522a-8ef6-e1d12b246d07",
        "81ec9582-6efc-58c1-95a4-a8aba8e6eef1",
        "4d23e0a7-f2d8-5f08-a4e2-b12cc7b903c2",
        "4b622d50-2f4a-5251-856d-555d155d9443",
        "f334d703-b1c2-560b-abc8-6b5f652f541d",
        "4c4b40ca-e925-5db2-b245-115e0e9ea066"
      ]
    },
    {
      "step_number": 4,
      "instruction": "To make with steak, make the rice noodle salad. Heat 1 tsp sunflower oil in a frying pan. Tip 2 tbsp sesame seeds onto a plate. Rub 1 tsp oil into 4 x 175g sirloin steaks and press into sesame seeds. Fry for 5 mins for medium rare, turning halfway. Leave to rest for 5 mins, then thinly slice. Toss 1 deseeded and shredded red chilli, and a handful mint leaves into noodles. Top with steak to serve.",
      "ingredients_used": [
        "30fc6a39-5a5c-522a-8ef6-e1d12b246d07",
        "c1df708e-9516-5f69-b1e6-f2e4d5d22866",
        "fba7f163-4d83-5a93-be56-dfef34b1a9c1",
        "f334d703-b1c2-560b-abc8-6b5f652f541d",
        "0cf7b536-abb5-5fc0-8a74-e2d6f168a5d4",
        "4c4b40ca-e925-5db2-b245-115e0e9ea066"
      ]
    }
  ],
