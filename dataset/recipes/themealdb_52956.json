  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "MARINATING THE CHICKEN",
      "ingredients_used": [
        "3a2d110b-42c1-53f3-be1e-63eae585f395"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a bowl, add chicken, salt, white pepper, ginger juice and then mix it together well.",
      "ingredients_used": [
        "3a2d110b-42c1-53f3-be1e-63eae585f395",
        "e8b2b7c4-6c5b-538c-8d13-aed0201a7fe9",
        "da19479f-57cb-566e-8649-5e9788b6e7c7",
        "7780de7f-2528-54bc-a8aa-ec763a377fe4"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Set the chicken aside.",
      "ingredients_used": [
        "3a2d110b-42c1-53f3-be1e-63eae585f395"
      ]
    },
    {
      "step_number": 4,
      "instruction": "RINSE THE WHITE RICE",
      "ingredients_used": [
        "62162f7f-d4aa-503a-88d0-c61a9066932d"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Rinse the rice in a metal bowl or pot a couple times and then drain the water.",
      "ingredients_used": [
        "62162f7f-d4aa-503a-88d0-c61a9066932d",
        "514d9498-2bcd-5099-954b-a60c31b7100d"
      ]
    },
    {
      "step_number": 6,
      "instruction": "BOILING THE WHITE RICE",
      "ingredients_used": [
        "62162f7f-d4aa-503a-88d0-c61a9066932d"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Next add 8 cups of water and then set the stove on high heat until it is boiling. Once rice porridge starts to boil, set the stove on low heat and then stir it once every 8-10 minutes for around 20-25 minutes.",
      "ingredients_used": [
        "62162f7f-d4aa-503a-88d0-c61a9066932d",
        "514d9498-2bcd-5099-954b-a60c31b7100d"
      ]
    },
    {
      "step_number": 8,
      "instruction": "After 25 minutes, this is optional but you can add a little bit more water to make rice porridge to make it less thick or to your preference.",
      "timer_seconds": 1500,
      "ingredients_used": [
        "62162f7f-d4aa-503a-88d0-c61a9066932d",
        "514d9498-2bcd-5099-954b-a60c31b7100d"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Next add the marinated chicken to the rice porridge and leave the stove on low heat for another 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "3a2d110b-42c1-53f3-be1e-63eae585f395",
        "62162f7f-d4aa-503a-88d0-c61a9066932d"
      ]
    },
    {
      "step_number": 10,
      "instruction": "After an additional 10 minutes add the green onions, sliced ginger, 1 pinch of salt, 1 pinch of white pepper and stir for 10 seconds.",
      "ingredients_used": [
        "e8b2b7c4-6c5b-538c-8d13-aed0201a7fe9",
        "da19479f-57cb-566e-8649-5e9788b6e7c7",
        "7780de7f-2528-54bc-a8aa-ec763a377fe4",
        "756727d8-c1c0-5338-ad20-bbcfa705a8a1"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Serve the rice porridge in a bowl",
      "ingredients_used": [
        "62162f7f-d4aa-503a-88d0-c61a9066932d"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Optional: add Coriander on top of the rice porridge.",
      "ingredients_used": [
        "62162f7f-d4aa-503a-88d0-c61a9066932d",
        "bd679a20-d675-57f6-9e47-16737bc5a408"
      ]
    }
  ],
