  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cut steak into 4 rectangular pieces. Pat dry with paper towels; season all over with 1 1/2 teaspoons salt.",
      "ingredients_used": [
        "01c9d3b9-a2b5-5496-9325-f98652eeb084",
        "0d391fd5-c6bf-51ff-9781-14a74b69c835"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a large pot over medium-high heat, heat 2 tablespoons oil. Working in batches, cook steak until browned on both sides, 5 to 6 minutes. Transfer to a plate.",
      "timer_seconds": 360,
      "ingredients_used": [
        "01c9d3b9-a2b5-5496-9325-f98652eeb084"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In same pot over medium heat, heat remaining 2 tablespoons oil. Cook bell peppers, onion, and 1 1/2 teaspoons salt, stirring occasionally, until slightly softened, 4 to 5 minutes. Add garlic, tomato paste, paprika, cumin, and oregano and cook, stirring occasionally, until vegetables are softened and spices are aromatic, 1 to 2 minutes more.",
      "ingredients_used": [
        "0d391fd5-c6bf-51ff-9781-14a74b69c835",
        "58412532-294b-5957-ae7a-b6b2853dd4c8",
        "477d3093-e525-5f22-a376-ebe257b66828",
        "49a7b519-a29a-5192-8e8c-29a89c9ff78a",
        "50e9fce7-1c1f-5a32-ae93-9cbb1940a600",
        "ef2df876-2d6b-5bb1-ba45-f5a8c3e7cad5"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add wine, scraping any browned bits from bottom of pan, and cook, stirring occasionally, until reduced by half, about 2 minutes. Add tomatoes with their juices and bay leaves. Mash down on tomatoes to break up, then nestle beef into stew. Add water to cover beef, if needed, and bring to a simmer. Reduce heat to medium-low; cover and simmer until steaks are tender enough to shred, 2 1/2 to 3 hours. Transfer steaks to a plate and finely shred with 2 forks.",
      "ingredients_used": [
        "01c9d3b9-a2b5-5496-9325-f98652eeb084",
        "3b6185da-b8c1-57db-b4b1-2064abbf8ddf"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Stir shredded steak back into stew. Bring to a simmer and cook, stirring, until liquid has reduced to a sauce that coats steak, 5 to 10 minutes. Stir in olives; season with salt.",
      "timer_seconds": 600,
      "ingredients_used": [
        "01c9d3b9-a2b5-5496-9325-f98652eeb084",
        "0d391fd5-c6bf-51ff-9781-14a74b69c835",
        "0ea965c3-4ef9-510d-b8ee-dc455f4a6a20"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Spoon ropa vieja over rice and beans. Top with cilantro.",
      "ingredients_used": [
        "d8e1d2ff-5fe5-5cc3-8376-3e356e0cf8cf",
        "2f4a3b08-324d-54ac-a5e3-6d9e2c3edd42",
        "32832a1e-d865-59b9-adae-794214b26bf5"
      ]
    }
  ],
