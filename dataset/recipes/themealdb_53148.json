  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put the milk, cream, cinnamon stick and all the citrus zest in a saucepan set over a medium heat. Cook, stirring often, until the milk is just steaming but not boiling, about 3-5 mins. Remove from the heat, cover with a plate and leave to infuse for at least 30 mins.",
      "ingredients_used": [
        "51754c4a-4a98-53b9-9040-9b12f6684920",
        "77602fa1-78fc-57c7-a129-8bb061d864cd",
        "4278825e-8698-58c8-91a2-89280c29dcc0",
        "1ca5e554-509b-54fe-9586-0392f29032d5"
      ]
    },
    {
      "step_number": 2,
      "instruction": "When the cream mixture has infused, whisk the egg yolks, sugar and cornflour together in a separate bowl for 3-5 mins, or until light and pale in color. Pour the infused milk through a sieve into the egg mixture, whisking continuously. Return the mixture to the saucepan.",
      "timer_seconds": 300,
      "ingredients_used": [
        "51754c4a-4a98-53b9-9040-9b12f6684920",
        "b5f0a21a-7861-5539-822e-c3788b1ebb4d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Put the saucepan over a medium-high heat and whisk for around 10-12 mins. The mixture should start thickening to a custard-like consistency – you can tell it’s ready by dipping a wooden spoon in the mixture, then running a finger through the mixture on the back of the spoon. If the line holds, it's ready. Sieve the mixture into a jug to remove any froth.",
      "timer_seconds": 720
    },
    {
      "step_number": 4,
      "instruction": "Divide the custard between six 150ml ramekins or small terracotta dishes, then leave to cool for 1 hr at room temperature until set with a slight wobble. Chill overnight.",
      "timer_seconds": 3600
    },
    {
      "step_number": 5,
      "instruction": "Just before serving, sprinkle 1 tbsp caster sugar over the top of each ramekin and caramelize using a kitchen blowtorch. Alternatively, slide the ramekins under a hot grill until the sugar turns golden and starts to bubble. Serve straightaway.",
      "ingredients_used": [
        "740f7087-fbf4-5f2d-bae0-594f36c2998f",
        "7add9acb-34ce-5ce2-b162-f34a566c49dc"
      ]
    }
  ],
