  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat 1 tbsp vegetable oil in a large pot or Dutch oven over medium-high heat until it shimmers, about 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "75489a70-71bc-5fce-8a94-2a7d1952f846"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add 1 lb chicken pieces to the pot and cook until browned on all sides, approximately 5–7 minutes, stirring occasionally to prevent sticking.",
      "timer_seconds": 420
    },
    {
      "step_number": 3,
      "instruction": "Remove the chicken from the pot and set it aside on a plate, leaving any oil and juices in the pot."
    },
    {
      "step_number": 4,
      "instruction": "Reduce the heat to medium and add 1 sliced onion to the pot, cooking until softened and translucent, about 4 minutes.",
      "timer_seconds": 240,
      "ingredients_used": [
        "3af5c7a1-75fe-50b7-87f3-92e893c14b6d"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Stir in 3 cloves minced garlic and 1 tbsp grated ginger, cooking for 1 minute until fragrant to avoid burning.",
      "timer_seconds": 60,
      "ingredients_used": [
        "e115b628-1cb7-5d01-8a96-c06a573fa0a6",
        "9fe40c3d-645c-5cf1-9bd4-848f5d5510d4"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add 2 tbsp red curry paste to the pot and cook for 1 minute, stirring constantly to toast the spices and deepen the flavor.",
      "timer_seconds": 60,
      "ingredients_used": [
        "411eed23-7823-57c8-9c8e-df93ad46672e"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Pour in 1 can coconut milk and 1 cup chicken broth, scraping the bottom of the pot to incorporate any browned bits for extra richness.",
      "ingredients_used": [
        "b6d1c014-1699-5e97-aa6e-0a71d30a9c09"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Stir in 1 tbsp fish sauce and 1 tbsp palm sugar until fully dissolved, then return the browned chicken to the pot.",
      "ingredients_used": [
        "a9a3a76d-108f-5567-9fc4-fd0624c0a29e"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Bring the mixture to a gentle boil, then reduce the heat to low, cover, and simmer for 15 minutes to allow the flavors to meld.",
      "timer_seconds": 900
    },
    {
      "step_number": 10,
      "instruction": "Add 1 cup bamboo shoots and 1 sliced red bell pepper to the pot, simmering uncovered for an additional 5 minutes until the vegetables are tender-crisp.",
      "timer_seconds": 300,
      "ingredients_used": [
        "77ca3eb8-7c3b-5b7a-9f69-a10ec8b1be93"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Remove the pot from the heat and stir in 1 cup Thai basil leaves until just wilted, about 1 minute, to preserve their fresh aroma.",
      "timer_seconds": 60,
      "ingredients_used": [
        "b7b2aee3-d6fa-5579-9297-b3369e56ff4f"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Serve the curry hot, garnished with lime wedges for a bright, acidic finish.",
      "ingredients_used": [
        "6edb42c1-7b84-50d0-9c18-dc6784073a15"
      ]
    }
  ],
