  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "To make the pastry, rub 225g cold, diced butter into 350g plain flour, then mix in 100g golden caster sugar and a pinch of salt.",
      "ingredients_used": [
        "27070c9f-0f78-571e-a770-46c50321aa3b",
        "4086d699-1f29-56f7-b78b-85de4091a5f3",
        "b4b99a31-e8fc-510c-b228-b0775a80de40"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Combine the pastry into a ball – don’t add liquid – and knead it briefly. The dough will be fairly firm, like shortbread dough. You can use the dough immediately, or chill for later."
    },
    {
      "step_number": 3,
      "instruction": "Preheat the oven to 200C/gas 6/fan 180C. Line 18 holes of two 12-hole patty tins, by pressing small walnut-sized balls of pastry into each hole.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 4,
      "instruction": "Spoon 280g mincemeat into the pies.",
      "ingredients_used": [
        "cd7a344a-50f4-59d3-8db3-bf55a1d0a687"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Take slightly smaller balls of pastry than before and pat them out between your hands to make round lids, big enough to cover the pies."
    },
    {
      "step_number": 6,
      "instruction": "Top the pies with their lids, pressing the edges gently together to seal – you don’t need to seal them with milk or egg as they will stick on their own. (The pies may now be frozen for up to 1 month).",
      "ingredients_used": [
        "616ab15b-a23f-5a55-a015-ab3f7a076da6"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Beat 1 small egg and brush the tops of the pies. Bake for 20 mins until golden. Leave to cool in the tin for 5 mins, then remove to a wire rack.",
      "ingredients_used": [
        "616ab15b-a23f-5a55-a015-ab3f7a076da6"
      ]
    },
    {
      "step_number": 8,
      "instruction": "To serve, lightly dust with icing sugar.",
      "ingredients_used": [
        "b49c13d5-dc64-55f6-a10c-62cf8a66db30"
      ]
    }
  ],
