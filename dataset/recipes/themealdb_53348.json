  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Soak the craisins, raisins, and cherries in the 1 cup of beer. Set aside and allow to soak for 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "7ca071a4-485d-53e5-9265-d0ad93d4325b",
        "f00c38f4-067e-5c2c-bace-0d8deb1d440a",
        "a7e1af9a-2183-5ff0-900c-e40f58bc056e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Preheat the oven to 325 degrees Fahrenheit. Grease an 8x4 loaf pan. Set aside.",
      "temperature": {
        "value": 325,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 3,
      "instruction": "Combine all-purpose flour, baking powder, ground cinnamon, salt, in a large bowl and set aside.",
      "ingredients_used": [
        "edc45ec3-1477-52ac-b89b-fb38f8ebbb1b",
        "5cbbdf6e-20f8-505e-bf78-4db2d2210ab0",
        "ca4c07c7-f410-55b8-9298-f6b4e2686d57"
      ]
    },
    {
      "step_number": 4,
      "instruction": "In another bowl, combine brown sugar, egg, milk, honey, melted butter, molasses, browning, vanilla extract, and the beer that’s soaking the fruit. Do not pour the fruit in at this time, just the beer. Mix to combine.",
      "ingredients_used": [
        "898ba92d-1743-5189-a9ee-f9e0605166f2",
        "3d23a026-ee6c-5ed0-8408-e49482b83d30",
        "7ca071a4-485d-53e5-9265-d0ad93d4325b",
        "41fbe03a-587d-5633-a080-92a1ee7720c0",
        "2ca2d022-7418-5044-b6ff-9699074d084a",
        "044c52af-e099-5134-8167-f734db36e2cc",
        "b35ea55d-bd18-565c-82bb-c6d7478a6f60",
        "2dfe503b-fe5e-52d4-8f95-e465bc080699"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Remove 2 tablespoon of flour from the flour mixture and toss the fruit in it. Set aside."
    },
    {
      "step_number": 6,
      "instruction": "Make a well in the middle of the bowl of dry ingredients and pour in wet mixture, stirring until fully combined. And the fruits to the mixture and stir until incpororated."
    },
    {
      "step_number": 7,
      "instruction": "Pour mixture into prepared loaf pan and bake in the preheated oven for 50-60 minutes or until a toothpick comes out clean.",
      "timer_seconds": 3600
    },
    {
      "step_number": 8,
      "instruction": "Cool for 5 minutes in the pan and then move to a cooling rack to finish cooling. Serve with slices of cheddar cheese.",
      "timer_seconds": 300
    }
  ],
