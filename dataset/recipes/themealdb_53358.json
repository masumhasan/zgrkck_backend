  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Clean and cut the chicken; marinate briefly with salt, turmeric and a little oil.",
      "ingredients_used": [
        "0bc834e9-83b8-5705-b285-e936757342a4",
        "f6636c15-da8c-56f6-a638-d0737a980c62",
        "3808eee3-1c6c-53d4-9c4f-90ecb4cc3002"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Rinse and soak basmati rice 20–30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "0cd45159-6b51-59b2-854a-34690aabbd5e"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In a large pot, heat ghee/oil. Fry chopped onion until golden. Add minced garlic and green chillies and fry 1–2 min.",
      "timer_seconds": 120,
      "ingredients_used": [
        "e442a7de-19a8-5871-b3fc-b2af248d2380",
        "62b6b96f-4028-5b25-8b2a-c4e6f9445ad6",
        "d6c58aa7-9737-5526-a43d-e7ff72b3a241",
        "3808eee3-1c6c-53d4-9c4f-90ecb4cc3002"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add whole spices (cardamom, cloves, cinnamon, bay leaves) and ground spices (coriander, cumin). Stir until fragrant.",
      "ingredients_used": [
        "d4d54dbc-7b90-5c53-898e-5bb429b1911a",
        "653e8429-adc4-52e9-a357-1d38f92fc824",
        "f8d167bb-2aca-5c97-acd4-3c9e78bf70e4",
        "3da5b2b6-070c-57bb-bf4d-e3dee48449e9"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add chicken pieces, brown lightly and add enough water/chicken stock to cover. Simmer until chicken is nearly cooked.",
      "ingredients_used": [
        "0bc834e9-83b8-5705-b285-e936757342a4",
        "9560a809-5f8a-561e-b77e-d2e00354bb50"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Remove chicken; measure remaining liquid and add soaked rice. Bring to a boil, then reduce heat, cover and cook rice until almost done.",
      "ingredients_used": [
        "0bc834e9-83b8-5705-b285-e936757342a4",
        "0cd45159-6b51-59b2-854a-34690aabbd5e"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Return the chicken to the rice pot on top, cover tightly and steam on low for 10–15 min so flavors meld.",
      "timer_seconds": 900,
      "ingredients_used": [
        "0bc834e9-83b8-5705-b285-e936757342a4",
        "0cd45159-6b51-59b2-854a-34690aabbd5e"
      ]
    },
    {
      "step_number": 8,
      "instruction": "(Optional) For authentic smoky aroma: heat a small charcoal until red hot, place it on a small foil cup in the center of the pot, add a tsp of butter/oil on the coal then cover immediately to trap smoke for 5–10 minutes. Remove coal.",
      "timer_seconds": 600,
      "ingredients_used": [
        "3808eee3-1c6c-53d4-9c4f-90ecb4cc3002"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Garnish with fried onions, chopped coriander and serve with chutney or raita.",
      "ingredients_used": [
        "e442a7de-19a8-5871-b3fc-b2af248d2380",
        "d4d54dbc-7b90-5c53-898e-5bb429b1911a"
      ]
    }
  ],
