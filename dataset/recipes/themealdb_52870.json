  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 200C/180C fan/gas 6 and line a baking tray with foil. Drain the chickpeas, pat dry and tip onto the prepared baking tray. Add the oil and paprika, toss to coat, then roast for 20-25 mins until browned and crisp, shaking halfway through cooking.",
      "timer_seconds": 1500,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "eb9f13bd-e686-5a6a-bdf2-5b7b399d9f30",
        "b3960541-1aff-5b46-8da3-71b6d1dce5d3"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Meanwhile, put the tomatoes and onion in a small bowl with the vinegar and set aside to pickle. Put the avocado in another bowl and mash with a fork, leaving some larger chunks. Stir in the lime juice and season well. Mix the soured cream with the harissa and set aside until ready to serve.",
      "ingredients_used": [
        "a4f1b17a-5789-5cc0-9669-0d79303a05e4",
        "11d5d7c0-af34-5e0c-9e1c-92f34e04d9d7",
        "891ce4f8-a1cb-5835-a8fc-26e30bb5dd78",
        "3ea1faf7-2cc7-51c7-ae60-f97ce584c6c4"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat a griddle pan until nearly smoking. Add the tortillas , one at a time, charring each side until hot with griddle lines.",
      "ingredients_used": [
        "26daa104-ee31-50b6-8b3d-14060a9e8d4b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Put everything on the table and build the fajitas : spread a little of the harissa cream over the tortilla, top with roasted chickpeas, guacamole, pickled salsa and coriander, if you like. Serve with the lime wedges for squeezing over.",
      "ingredients_used": [
        "eb9f13bd-e686-5a6a-bdf2-5b7b399d9f30",
        "891ce4f8-a1cb-5835-a8fc-26e30bb5dd78",
        "3ea1faf7-2cc7-51c7-ae60-f97ce584c6c4",
        "b1ce527b-4725-55ff-b058-b5665d9f985c"
      ]
    }
  ],
