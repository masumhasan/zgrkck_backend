      ]
    },
    {
      "step_number": 2,
      "instruction": "Bake in the preheated oven until heated through, 8 to 10 minutes.",
      "timer_seconds": 600
    },
    {
      "step_number": 3,
      "instruction": "While falafel bake, whisk tahini, water, lemon juice, garlic, and paprika together in a bowl.",
      "ingredients_used": [
