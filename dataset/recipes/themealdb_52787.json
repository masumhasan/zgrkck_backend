  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Line an 8-inch-square baking pan with wax paper or foil, and coat with non-stick spray."
    },
    {
      "step_number": 2,
      "instruction": "In a microwave-safe bowl, combine the dark chocolate chips, heavy cream and half of the sweetened condensed milk. Microwave the dark chocolate mixture in 20-second intervals, stirring in between each interval, until the chocolate is melted.",
      "ingredients_used": [
        "a3e1d77d-acf0-5cbd-8d14-6742162e9bd7",
        "afc3ac9e-93f8-58f7-8c4a-beed6d037133",
        "6e94925b-4f2c-53fd-8127-b23c27517698",
        "997c29e8-fc71-55a7-9bd3-174186665c8d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the vanilla extract to the dark chocolate mixture and stir well until smooth.",
      "ingredients_used": [
        "ab3250c3-2c47-5773-8192-e8fa7785b398"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Transfer the dark chocolate mixture into the prepared pan and spread into an even layer."
    },
    {
      "step_number": 5,
      "instruction": "In a separate bowl, combine the white chocolate chips with the remaining half of the sweetened condensed milk. Microwave the white chocolate mixture in 20-second intervals, stirring in between each interval, until the chocolate is melted.",
      "ingredients_used": [
        "a3e1d77d-acf0-5cbd-8d14-6742162e9bd7",
        "6e94925b-4f2c-53fd-8127-b23c27517698",
        "997c29e8-fc71-55a7-9bd3-174186665c8d"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Evenly spread the white chocolate mixture on top of dark chocolate layer."
    },
    {
      "step_number": 7,
      "instruction": "Top the chocolate layers with the Mallow Bits or miniature marshmallows, and gently press them down.",
      "ingredients_used": [
        "f71c6e16-e517-57be-b912-4524d25ac4fd"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Refrigerate for 4 hours, or until set.",
      "timer_seconds": 14400
    },
    {
      "step_number": 9,
      "instruction": "Remove the fudge and wax paper from the pan. Carefully peel all of the wax paper from the fudge."
    },
    {
      "step_number": 10,
      "instruction": "Cut the fudge into bite-sized pieces and serve."
    }
  ],
