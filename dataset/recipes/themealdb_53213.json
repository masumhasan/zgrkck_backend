  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cook the noodles following pack instructions. Refresh in cold water and drain well.",
      "ingredients_used": [
        "2f98c9a8-fadc-5a5a-a44e-f6931b355131"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Put the stock in a large saucepan and stir in the curry paste, lime leaves, fish sauce and 250ml cold water. Bring to a simmer and cook for 5 mins.",
      "timer_seconds": 300,
      "ingredients_used": [
        "5e11f084-ea04-5751-b564-8e22586895e4",
        "c0a2a8a9-4c13-55e1-833f-3ec3111bb642",
        "7f752813-6b8c-5a85-b0ee-f4e9e7625a45"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cut the fish into roughly 3cm cubes and add to the pan. Return to a simmer, then cook for 2 mins uncovered.",
      "timer_seconds": 120,
      "ingredients_used": [
        "7f752813-6b8c-5a85-b0ee-f4e9e7625a45"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Stir in the noodles, prawns and pak choi, and simmer for 2-3 mins or until the fish and prawns are just cooked. Serve in bowls scattered with coriander.",
      "timer_seconds": 180,
      "ingredients_used": [
        "2f98c9a8-fadc-5a5a-a44e-f6931b355131",
