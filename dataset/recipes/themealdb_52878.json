  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Season the beef cubes with salt and black pepper. Heat a tablespoon of oil in the frying pan and fry the meat over a high heat. Do this in three batches so that you don’t overcrowd the pan, transferring the meat to a large flameproof casserole dish once it is browned all over. Add extra oil if the pan seems dry.",
      "ingredients_used": [
        "36d1dd2f-875f-5bd8-ad54-26714937298d",
        "a5dc0c48-ebf1-57a0-8c68-c4f74436afcc"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In the same pan, add another tablespoon of oil and cook the shallots for 4-5 minutes, then add the garlic and fry for 30 seconds. Add the bacon and fry until slightly browned. Transfer the onion and bacon mixture to the casserole dish and add the herbs.",
      "ingredients_used": [
        "0d55512d-75b5-5ce8-9280-128bb36f4b1c",
        "4ad767b2-4ae6-5d8f-9532-43c2009779ae",
        "9eb5046d-0481-5012-864c-f4b1e15e0706"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Preheat the oven to 180C/350F/Gas 4.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 4,
      "instruction": "Pour the stout into the frying pan and bring to the boil, stirring to lift any stuck-on browned bits from the bottom of the pan. Pour the stout over the beef in the casserole dish and add the stock. Cover the casserole and place it in the oven for 1½-2 hours, or until the beef is tender and the sauce is reduced.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "36d1dd2f-875f-5bd8-ad54-26714937298d",
        "49503805-2819-58ad-ae81-fb93d7cbcda4"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Skim off any surface fat, taste and add salt and pepper if necessary, then stir in the cornflour paste. Put the casserole dish on the hob – don’t forget that it will be hot – and simmer for 1-2 minutes, stirring, until thickened. Leave to cool.",
      "timer_seconds": 120,
      "ingredients_used": [
        "a5dc0c48-ebf1-57a0-8c68-c4f74436afcc"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Increase the oven to 200C/400F/Gas 6. To make the pastry, put the flour and salt in a very large bowl. Grate the butter and stir it into the flour in three batches. Gradually add 325ml/11fl oz cold water – you may not need it all – and stir with a round-bladed knife until the mixture just comes together. Knead the pastry lightly into a ball on a lightly floured surface and set aside 250g/9oz for the pie lid.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
      "ingredients_used": [
        "a5dc0c48-ebf1-57a0-8c68-c4f74436afcc",
        "87b54090-1045-5e3e-ae7a-088fb1f87d9d"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Roll the rest of the pastry out until about 2cm/¾in larger than the dish you’re using. Line the dish with the pastry then pile in the filling, tucking the oysters in as well. Brush the edge of the pastry with beaten egg.",
      "ingredients_used": [
        "c95f0364-8644-552f-b18b-62213baacc47"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Roll the remaining pastry until slightly larger than your dish and gently lift over the filling, pressing the edges firmly to seal, then trim with a sharp knife. Brush with beaten egg to glaze. Put the dish on a baking tray and bake for 25-30 minutes, or until the pastry is golden-brown and the filling is bubbling.",
      "timer_seconds": 1800
    }
  ],
