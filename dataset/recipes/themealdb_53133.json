  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare the Fire: Start a wood fire in your grill and let it burn down to coals."
    },
    {
      "step_number": 2,
      "instruction": "Season the Meat: Generously salt the beef cuts.",
      "ingredients_used": [
        "9da93cd9-da5d-5627-ac63-8ab5fc9cd32f",
        "d1664d82-79ee-5c66-a45f-124fbfc7ea60"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Grill the Meat: Place the beef on the grill, starting with the thickest cuts farthest from the coals. Add chorizo and morcilla after the beef has been cooking for a while.",
      "ingredients_used": [
        "9da93cd9-da5d-5627-ac63-8ab5fc9cd32f",
        "15a6a2c0-e9ba-5e0b-9699-244732054656",
        "55f2f024-bedc-5633-a435-17623cb7f0b2"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cook to Perfection: Cook the meat, turning occasionally, until it reaches your desired doneness. Typically, ribs may take up to 2 hours; thinner cuts will cook faster.",
      "timer_seconds": 7200,
      "ingredients_used": [
        "9da93cd9-da5d-5627-ac63-8ab5fc9cd32f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Rest and Serve: Let the meat rest for about 10 minutes before slicing. Serve with chimichurri sauce and grilled vegetables.",
      "timer_seconds": 600
    },
    {
      "step_number": 6,
      "instruction": "Pro Tips:"
    },
    {
      "step_number": 7,
      "instruction": "Use a mix of wood and charcoal for a consistent heat source. Wood adds flavor, while charcoal maintains temperature."
    },
    {
      "step_number": 8,
      "instruction": "Season the meat just before grilling to ensure it retains its moisture and flavor."
    },
    {
      "step_number": 9,
      "instruction": "Serving Suggestions:"
    },
    {
      "step_number": 10,
      "instruction": "Serve with a side of chimichurri sauce, a fresh tomato salad, and crusty bread. Pair with a robust Malbec wine to complement the rich flavors of the meat."
    }
