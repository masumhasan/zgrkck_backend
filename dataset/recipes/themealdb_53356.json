  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add flour, baking powder, and salt in a large bowl and stir to combine. Pour in the milk and stir until combined. Then roll the mixture into a ball and lightly knead until it comes together.",
      "ingredients_used": [
        "e4f99ea0-5d62-5efd-a1e1-18b78b271e0a",
        "7e93e174-b149-5465-a8af-fabd45059dc6",
        "aa437378-ff3e-5268-bcfb-99737e63d64a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Break off about 10 pieces of dough and form them into balls. Set them aside."
    },
    {
      "step_number": 3,
      "instruction": "In a 10-inch skillet, heat enough oil over medium heat to fry the dumplings, until the oil is about 350 degrees.",
      "ingredients_used": [
        "a76e4b3c-2b73-52c1-a793-490fc7401bfe"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Once the dumplings are browned on one side, flip them and cook until both sides are browned, about 2-3 minutes each.",
      "timer_seconds": 180
    },
    {
      "step_number": 5,
      "instruction": "Once done, remove the dumplings from the oil and place them on paper towels or a cooling rack to drain off any excess oil.",
      "ingredients_used": [
        "a76e4b3c-2b73-52c1-a793-490fc7401bfe"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Serve and enjoy."
    }
  ],
