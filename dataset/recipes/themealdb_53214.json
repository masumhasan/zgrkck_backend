  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in your largest pan, add the onion and fry for 3 mins to soften. Add the chicken and garlic, and cook until the chicken changes color.",
      "timer_seconds": 180,
      "ingredients_used": [
        "1f470082-7b89-5bab-9367-0c61c4139f21"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the curry paste, coconut milk, stock, lime leaves and fish sauce, then simmer for 12 mins. Add the chopped onion tops, green beans and bamboo shoots and cook for 4-6 mins, until the beans are just tender.",
      "ingredients_used": [
        "1f470082-7b89-5bab-9367-0c61c4139f21",
        "ee4e2efb-11a5-5675-b5d1-9e93a7fa4962",
        "11cc9689-8fca-510a-a76f-c0ca3dc01ff4",
        "8169b835-cadd-50ab-9eb7-1ec9cf467757",
        "2efb5c2b-e892-5ebd-9768-4f86045f7e77",
        "468abf05-0b37-5bdf-be8b-79c11d4871fd",
        "eba71f3d-daca-52e7-8017-a14d78bab97d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Meanwhile, put the lime juice and basil in a narrow jug and blitz with a hand blender to make a smooth green paste. Pour into the soup with the sliced spring onion and heat through. Serve with lime wedges for a light lunch or supper or as a make-ahead starter.",
      "ingredients_used": [
        "1f470082-7b89-5bab-9367-0c61c4139f21",
        "eba71f3d-daca-52e7-8017-a14d78bab97d",
        "54cd5867-8433-5367-a413-5e9d85bdfaf9"
      ]
    }
