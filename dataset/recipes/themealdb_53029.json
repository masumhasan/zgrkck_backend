  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Saute the onions in the 3-4 tablespoons olive oil",
      "ingredients_used": [
        "33e75884-510e-533a-ae6d-58cf12f2405a",
        "772ce0dd-84aa-5068-8fbe-1f18957b3ff8"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the beef cubes or the chicken cutlets, sear for 3-4 min on each side",
      "timer_seconds": 240,
      "ingredients_used": [
        "c350c6e5-6fb1-5099-8a8d-260f1a7d4834"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add 1 liter of water or just enough to cover the meat",
      "ingredients_used": [
        "cc7371bc-60c6-56f8-8f39-7a8f8b98b776"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cook over medium heat until the meat is done (I usually do this in the pressure cooker and press them for 5 min)",
      "timer_seconds": 300
    },
    {
      "step_number": 5,
      "instruction": "Add the frozen mulukhyia and stir until it thaws completely and then comes to a boil"
    },
    {
      "step_number": 6,
      "instruction": "In another pan add the 1/4 to 1/2 cup of olive oil and the cloves of garlic and cook over medium low heat until you can smell the garlic (don’t brown it, it will become bitter)",
      "ingredients_used": [
        "5af22bd7-db4e-5f45-ac4c-ec6552c8875b",
        "772ce0dd-84aa-5068-8fbe-1f18957b3ff8"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add the oil and garlic to the mulukhyia and lower the heat and simmer for 5-10 minutes",
      "timer_seconds": 600
    },
    {
      "step_number": 8,
      "instruction": "Add salt to taste",
      "ingredients_used": [
        "0406d78b-a820-5a77-b273-0c5ab81fa269"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Serve with a generous amount of lemon juice."
    },
    {
      "step_number": 10,
      "instruction": "You can serve it with some short grain rice or some pita bread"
    }
  ],
