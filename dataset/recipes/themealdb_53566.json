  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel plantains",
      "ingredients_used": [
        "148b1a43-d74d-5e24-b1f5-baaea77c281f"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Slice them in ¼ inch slices (horizontally)"
    },
    {
      "step_number": 3,
      "instruction": "Heat oil in the frying and add your plantain slices to the pan",
      "ingredients_used": [
        "148b1a43-d74d-5e24-b1f5-baaea77c281f"
      ]
    },
    {
      "step_number": 4,
      "instruction": "fried plantain rolls",
      "ingredients_used": [
        "148b1a43-d74d-5e24-b1f5-baaea77c281f"
      ]
    },
    {
      "step_number": 5,
      "instruction": "When they start getting golden brown, turn them over"
    },
    {
      "step_number": 6,
      "instruction": "Remove from the frying pan when both sides are brown, and place them on a plater lined with paper towel to absorb the oil"
    },
    {
      "step_number": 7,
      "instruction": "Place codfish bulljaw on the end of your plantain slice and roll it",
      "ingredients_used": [
        "148b1a43-d74d-5e24-b1f5-baaea77c281f",
        "ee192dd0-f038-51d4-91c8-50ab6265b3e9"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Secure the roll with the toothpick or skewer (I like using knotted bamboo)"
    },
    {
      "step_number": 9,
      "instruction": "Garnish and enjoy!"
    }
  ],
