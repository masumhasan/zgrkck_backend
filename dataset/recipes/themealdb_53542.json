  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Using a food processor or a blender, combine all the ingredients, don't overdo it, the mixture should be crumby."
    },
    {
      "step_number": 2,
      "instruction": "​"
    },
    {
      "step_number": 3,
      "instruction": "Heat a lightly oiled pan over medium-high heat. Pour 1/4 cup of the batter onto the pan. Cook until lightly brown on each side, just like making pancakes ;)"
    },
    {
      "step_number": 4,
      "instruction": "Traditionally you serve it with a spoon of sour cream on top. I just prefer to eat it plain."
    }
  ],
