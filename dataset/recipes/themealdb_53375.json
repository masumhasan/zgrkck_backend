  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "You can also use sugar snap peas for this recipe. Save prep time by prepping the peas, ginger, and garlic while the shrimp is marinating.",
      "ingredients_used": [
        "c4536055-ad8b-5d53-8f0b-e3a0a970aad6",
        "48a9e79a-37f2-5e2b-8866-44c5ddda50a4",
        "7c998465-32a3-5f0b-8430-e825ceb91a23",
        "ba17f599-d32f-53e8-9da1-dd2a506740fa"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Marinate the shrimp:",
      "ingredients_used": [
        "c4536055-ad8b-5d53-8f0b-e3a0a970aad6"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Mix all marinade ingredients in a large bowl, then add the shrimp. Toss to coat. Let sit for 15 to 20 minutes while you prep the peas, ginger, and garlic.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "c4536055-ad8b-5d53-8f0b-e3a0a970aad6",
        "48a9e79a-37f2-5e2b-8866-44c5ddda50a4",
        "7c998465-32a3-5f0b-8430-e825ceb91a23",
        "ba17f599-d32f-53e8-9da1-dd2a506740fa"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Stir-fry the ginger and garlic:",
      "ingredients_used": [
        "48a9e79a-37f2-5e2b-8866-44c5ddda50a4",
        "7c998465-32a3-5f0b-8430-e825ceb91a23"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Heat a wok or large sauté pan over high heat for 1 minute. Add the peanut oil and let it get hot, about 30 seconds. Add the ginger and garlic and toss to combine. Stir-fry for about 30 seconds.",
      "ingredients_used": [
        "6f9ab067-1dd9-534e-a6cf-8dcf1765ac35",
        "48a9e79a-37f2-5e2b-8866-44c5ddda50a4",
        "7c998465-32a3-5f0b-8430-e825ceb91a23"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Add the shrimp, snow peas, soy sauce, stock:",
      "ingredients_used": [
        "c4536055-ad8b-5d53-8f0b-e3a0a970aad6",
        "ba17f599-d32f-53e8-9da1-dd2a506740fa",
        "ae975887-d5fa-5263-af7e-2262e27184ff"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add the shrimp and all the marinade to the pan (scrape out all the marinade with a rubber spatula). Add the snow peas, soy sauce and chicken stock. Stir-fry until the shrimp turns pink, about 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "c4536055-ad8b-5d53-8f0b-e3a0a970aad6",
        "ba17f599-d32f-53e8-9da1-dd2a506740fa",
        "ae975887-d5fa-5263-af7e-2262e27184ff",
        "100294f4-f482-58f6-b581-5a3cb051efa9"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add the scallions and finish with sesame oil:",
      "ingredients_used": [
        "73c7b301-b4f4-5a00-ad30-7756c7802e75"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Add the scallions and stir-fry 1 more minute. Turn off the heat and add the sesame oil. Toss to combine once more and serve with steamed rice.",
      "ingredients_used": [
        "73c7b301-b4f4-5a00-ad30-7756c7802e75"
      ]
    }
  ],
