  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Drain the soaked glutinous rice thoroughly in a fine-mesh strainer.",
      "ingredients_used": [
        "9cc042d9-d9bf-51e4-9a1a-0cd604d9fc5a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a medium bowl, combine the coconut milk, palm sugar, and salt, stirring until the sugar dissolves completely.",
      "ingredients_used": [
        "f616f5b6-93ab-5f7e-8eca-ed6c3d39e27a",
        "03a95a34-41a3-5e6e-bfb0-ca2145091c0b"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the drained rice to the coconut milk mixture, mixing gently to coat every grain evenly. Let it sit for 15 minutes to absorb the liquid.",
      "timer_seconds": 900,
      "ingredients_used": [
        "9cc042d9-d9bf-51e4-9a1a-0cd604d9fc5a",
        "f616f5b6-93ab-5f7e-8eca-ed6c3d39e27a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Prepare a steamer by filling the bottom pot with 2 inches of water and bringing it to a boil over high heat."
    },
    {
      "step_number": 5,
      "instruction": "Lay a banana leaf square flat on your work surface, shiny side up. Spoon ¼ cup of the rice mixture into the center, spreading it into a 4-inch rectangle.",
      "ingredients_used": [
        "9cc042d9-d9bf-51e4-9a1a-0cd604d9fc5a"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Place 2 tablespoons of mung bean paste in a line down the middle of the rice rectangle.",
      "ingredients_used": [
        "9cc042d9-d9bf-51e4-9a1a-0cd604d9fc5a",
        "32adbbcc-eb71-5cc3-8aa5-02103dd2bc80"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Fold the banana leaf over the filling lengthwise, then fold in the sides to create a tight parcel. Tip: Press firmly to compact the rice, which helps it hold its shape during steaming.",
      "ingredients_used": [
        "9cc042d9-d9bf-51e4-9a1a-0cd604d9fc5a"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Secure the parcel with kitchen twine, tying it firmly but not too tight to allow for expansion."
    },
    {
      "step_number": 9,
      "instruction": "Repeat steps 5–8 with the remaining ingredients to make 8 parcels total."
    },
    {
      "step_number": 10,
      "instruction": "Arrange the parcels in a single layer in the steamer basket, leaving small gaps between them for steam circulation."
    },
    {
      "step_number": 11,
      "instruction": "Cover the steamer and steam over medium heat for 90 minutes, checking halfway to ensure the water hasn’t boiled dry—add more hot water if needed. Tip: The parcels are done when the banana leaves turn a deep green and the rice feels firm to the touch.",
      "timer_seconds": 5400,
      "ingredients_used": [
        "9cc042d9-d9bf-51e4-9a1a-0cd604d9fc5a",
        "ba5559f2-e0a4-5f97-abfb-32092d8b689f"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Carefully remove the parcels from the steamer and let them cool for 20 minutes before unwrapping. Tip: Cooling sets the texture, making slicing cleaner.",
      "timer_seconds": 1200
    },
    {
      "step_number": 13,
      "instruction": "Unwrap the banana leaves and slice each parcel into 1-inch thick rounds for serving.",
      "ingredients_used": [
        "ba5559f2-e0a4-5f97-abfb-32092d8b689f"
      ]
    }
  ],
