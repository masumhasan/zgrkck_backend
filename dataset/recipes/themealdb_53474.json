  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Mix the dough"
    },
    {
      "step_number": 2,
      "instruction": "In a stand mixer bowl. add the water, sugar, and yeast. Leave to get foamy, about 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "09a736d5-98d1-5c02-93e2-1a2f0f56d32f",
        "52f6bfea-0e2b-50fc-8d82-43d85b1af888"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add in the flour, salt, and vegetable oil.",
      "ingredients_used": [
        "b8420ada-fd07-52a4-8a6a-a24d745be59f",
        "0223437c-8068-5fa6-b714-2b7d23efec2b",
        "5b1de545-a4c8-59a6-9641-019391201ada"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Knead with a dough hook until a smooth dough forms, about 5 minutes.",
      "timer_seconds": 300
    },
    {
      "step_number": 5,
      "instruction": "Leave the dough to rise"
    },
    {
      "step_number": 6,
      "instruction": "Remove the dough from the mixer bowl and form into a ball. Lightly mist the bowl with oil and replace the ball of dough into it. Cover the bowl and let rise in a warm place, 1 to 1½ hours, until doubled."
    },
    {
      "step_number": 7,
      "instruction": "Shape and fry the doughnuts"
    },
    {
      "step_number": 8,
      "instruction": "Preheat about 5cm (2\") of vegetable oil in a pot to 180℃ / 350℉ – you can use a smaller pot needing less oil to fill but cooking less doughnuts at a time, or a larger one and cook more each batch. I also like to set up a drying rack set over a paper-towel-lined sheet pan to drain the doughnuts on, so they stay crispy. You can also prep a plate with paper towels if you don't want to bother.",
      "ingredients_used": [
        "0223437c-8068-5fa6-b714-2b7d23efec2b",
        "5b1de545-a4c8-59a6-9641-019391201ada"
      ]
    },
    {
      "step_number": 9,
      "instruction": "When the oil is at temperature, use a cookie scoop or two regular tablespoons to form a piece of dough into a rough ball shape and place in the oil. Repeat for as many doughnuts as will fit in your pot without overcrowding."
    },
    {
      "step_number": 10,
      "instruction": "Fry each doughnut for about a minute on each side, turning halfway through. Drain on prepared rack or paper towels."
    },
    {
      "step_number": 11,
      "instruction": "When the doughnuts have cooled slightly, sprinkle with powdered sugar.",
      "ingredients_used": [
        "09a736d5-98d1-5c02-93e2-1a2f0f56d32f"
      ]
    }
  ],
