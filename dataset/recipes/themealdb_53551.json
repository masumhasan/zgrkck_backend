  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel and cut the apples into cubes. Discard the cores. Transfer apple cubes to a saucepan with water, vanilla and lemon juice. Bring apples to a boil, cover and reduce heat to medium-low.",
      "ingredients_used": [
        "d8c434a6-9f0f-543a-b156-bac7cb6f5b47",
        "c67426c9-c805-5673-b861-28ad780ace38",
        "d7d381e1-fa19-5cc5-9c7d-2113c3c8a54b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the sugar to taste after the apples release their juices. The amount of sugar depends on the tartness of the apples and your preferred level of sweetness. Remember that the breadcrumb mixture and whipped cream are also sweet, so it is okay if the apple sauce is still a bit tart.",
      "ingredients_used": [
        "d8c434a6-9f0f-543a-b156-bac7cb6f5b47",
        "c860c308-5ec7-54b4-bf3f-75819644ac91",
        "e9810588-42bf-53fd-a341-2873f71f4f99"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cook the apples for about 15 minutes until you have a coarse apple sauce. If you prefer, cook the apples longer for a finer consistency.",
      "timer_seconds": 900,
      "ingredients_used": [
        "d8c434a6-9f0f-543a-b156-bac7cb6f5b47"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Refrigerate the applesauce.",
      "ingredients_used": [
        "d8c434a6-9f0f-543a-b156-bac7cb6f5b47"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Breadcrumbs mixture:",
      "ingredients_used": [
        "037b29c5-c5ca-55d4-a593-30716029e631"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Melt butter in a pan. The butter must not brown. Add breadcrumbs and sugar and stir to combine.",
      "ingredients_used": [
        "c860c308-5ec7-54b4-bf3f-75819644ac91",
        "c4ad1465-ea47-597d-96f2-cd846d493760",
        "037b29c5-c5ca-55d4-a593-30716029e631",
        "e9810588-42bf-53fd-a341-2873f71f4f99"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Slowly toast the mixture as you stir with a spatula. Do not heat the mixture for too long – it only takes a short time to make."
    },
    {
      "step_number": 8,
      "instruction": "Once the breadcrumbs are lightly golden, remove from the pan and cool on a sheet of baking paper.",
      "ingredients_used": [
        "037b29c5-c5ca-55d4-a593-30716029e631"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Assembling the apple trifle:"
    },
    {
      "step_number": 10,
      "instruction": "Do not assemble the trifle until right before serving. Otherwise, the rasp will become soggy. Serve the trifle in individual small glasses or a large glass bowl."
    },
    {
      "step_number": 11,
      "instruction": "Lightly whip the double cream.",
      "ingredients_used": [
        "faa21424-34ce-57ef-b370-376bf8f09152"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Layer the ingredients in the glasses or bowl, starting with breadcrumbs in the bottom, followed by chilled apple sauce and breadcrumbs again. You can make several layers of breadcrumbs and apple sauce, then top with a generous layer of whipped cream. Serve immediately.",
      "ingredients_used": [
        "037b29c5-c5ca-55d4-a593-30716029e631"
      ]
    }
  ],
