  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Wash and chop the runner beans. Place in a saucepan with salted water and bring to a boil.",
      "ingredients_used": [
        "de19146f-45a9-502a-a42a-53d60f4377fe",
        "9abc6751-804b-5266-aaba-e9ab4e156da2"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cook the beans for about 10 minutes or until al dente. Drain and set aside.",
      "timer_seconds": 600,
      "ingredients_used": [
        "de19146f-45a9-502a-a42a-53d60f4377fe"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Meanwhile, add the potatoes and cook until tender.",
      "ingredients_used": [
        "377897c3-bbe2-5bdf-8330-8078721b748e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Heat a small skillet with a little butter and sauté the onion until translucent. Add the garlic and cook briefly. Add the runner beans to the pan and stir-fry for a few minutes.",
      "ingredients_used": [
        "de19146f-45a9-502a-a42a-53d60f4377fe",
        "79ebf485-5404-517e-bec0-0c65ef7a0206",
        "adffaaf2-1849-5888-a1c8-37f9e57a0d24",
        "abb0bcab-4d2f-5696-8d5a-e77951df1373"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Meanwhile, mash the potatoes with a masher. Add a knob of butter and a splash of milk. Add the bean mixture and grated cheese. Season with salt, pepper and mustard.",
      "ingredients_used": [
        "377897c3-bbe2-5bdf-8330-8078721b748e",
        "abb0bcab-4d2f-5696-8d5a-e77951df1373",
        "e190229a-8d8c-51ed-a43f-a40dec69303e",
        "54932feb-1d95-5302-8de3-99a2b8c5f591",
        "490e518e-66fb-5112-816e-db6d533a3247",
        "9abc6751-804b-5266-aaba-e9ab4e156da2"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Fry the bacon and serve with the bean mash.",
      "ingredients_used": [
        "db64c29f-9197-5bb5-bf35-98951ef2bc7f"
      ]
    }
  ],
