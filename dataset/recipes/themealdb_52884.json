  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 160C/fan 140C/gas 3. Heat some dripping or butter in a large shallow casserole dish, brown the lamb in batches, lift to a plate, then repeat with the kidneys.",
      "temperature": {
        "value": 160,
        "unit": "celsius"
      },
      "ingredients_used": [
        "bcd07bb9-049e-59f6-8128-42a85e88c512",
        "c5fac441-1685-5cc7-9650-ef1d24778ff3",
        "586beb75-a834-54ac-a2c6-a95863b129d8"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Fry the onions and carrots in the pan with a little more dripping until golden. Sprinkle over the flour, allow to cook for a couple of mins, shake over the Worcestershire sauce, pour in the stock, then bring to the boil. Stir in the meat and bay leaves, then turn off the heat. Arrange the sliced potatoes on top of the meat, then drizzle with a little more dripping. Cover, then place in the oven for about 1½ hrs until the potatoes are cooked.",
      "ingredients_used": [
        "9ccb7a4f-43b7-5edd-b7e7-6e574ac56427",
        "e966f877-c357-5c6b-957a-429792708d00",
        "58b413e8-b1c0-5614-b8ae-b74dbdfaa43f",
        "5dd6d9ee-78d8-5164-aad8-c5c3bebec097",
        "809de88d-bb19-5847-9411-6b550886eab9"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Remove the lid, brush the potatoes with a little more dripping, then turn the oven up to brown the potatoes, or finish under the grill for 5-8 mins until brown.",
      "timer_seconds": 480,
      "ingredients_used": [
        "809de88d-bb19-5847-9411-6b550886eab9"
      ]
    }
  ],
