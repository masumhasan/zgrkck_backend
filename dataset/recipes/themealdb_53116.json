  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a small saucepan heat the butter, milk and salt until the butter is melted. Allow the mixture to cool until it is lukewarm.",
      "ingredients_used": [
        "bfadcd97-cbee-5c9e-aee7-b88564cb5c20",
        "4c2e766a-417e-51e3-8304-1208ae130c70",
        "5a9df174-3ee8-5b98-abed-5c3b622ec4b2",
        "80d663e2-ae9c-55e5-b481-b07f1a891b4c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a large bowl, stir together the flours, yeast, cardamom and sugar until combined.",
      "ingredients_used": [
        "3db9a094-bffa-5450-b3af-9fc84b75385e",
        "bfd9a83e-3d17-59c6-9392-345d6ab4626a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Make a well in the center and crack in the eggs. Pour in the lukewarm milk mixture and stir everything together to form a sticky dough. You may have to use your hands as the dough becomes stiffer.",
      "ingredients_used": [
        "4c2e766a-417e-51e3-8304-1208ae130c70"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Oil the work surface with a teaspoon of olive oil. Turn the dough out onto the oiled surface and knead vigorously for 5–8 minutes, using a plastic scraper as needed to prise the dough from the work surface. Don’t be tempted to add flour, as this will make the buns dry and tough. Keep kneading until the dough is considerably less sticky, smoother and more elastic.",
      "timer_seconds": 480,
      "ingredients_used": [
        "0adfdccc-2cd6-5532-9ec4-b0a633b2fb25",
        "a9582e7a-0aee-5904-b24d-0fbaa9c2b8c1"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Shape into a ball, and put into a large, greased bowl. Cover the bowl with a clean tea towel and set aside in a warm place to prove for an hour, or until doubled in size."
    },
    {
      "step_number": 6,
      "instruction": "Meanwhile, for the filling and topping, mix the softened butter in a bowl with half the sugar and 1 tablespoon cinnamon. Use a fork to mix the sugar and spice into the butter until it is completely combined.",
      "ingredients_used": [
        "bfadcd97-cbee-5c9e-aee7-b88564cb5c20",
        "80d663e2-ae9c-55e5-b481-b07f1a891b4c",
        "cbf49c86-359c-5957-8ed3-1910b92e9fe0"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Mix the remaining sugar and cinnamon in a separate bowl and set aside.",
      "ingredients_used": [
        "cbf49c86-359c-5957-8ed3-1910b92e9fe0"
      ]
    },
    {
      "step_number": 8,
      "instruction": "When the dough has risen, turn out onto a floured work surface and gently roll out into a 36x24cm/14x9½in rectangle. Spread the cinnamon-sugar-butter evenly over the dough with a table or palette knife.",
      "ingredients_used": [
        "bfadcd97-cbee-5c9e-aee7-b88564cb5c20",
        "80d663e2-ae9c-55e5-b481-b07f1a891b4c",
        "cbf49c86-359c-5957-8ed3-1910b92e9fe0"
      ]
    },
    {
      "step_number": 9,
      "instruction": "With the longest edge closest to you, roll the dough up into a cylinder. Cut into 12 even slices."
    },
    {
      "step_number": 10,
      "instruction": "Place each slice onto a flattened out paper cupcake case on a baking tray, or into a greased muffin tin. (Baking in a muffin tin will make your cinnamon buns taller and domed.)",
      "ingredients_used": [
        "cbf49c86-359c-5957-8ed3-1910b92e9fe0"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Cover with a clean tea towel and set aside to prove again for 30–45 minutes, or until risen.",
      "timer_seconds": 2700
    },
    {
      "step_number": 12,
      "instruction": "Preheat the oven to 200C/180C Fan/Gas 6.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 13,
      "instruction": "Brush the tops of the buns with beaten egg and dust liberally with the cinnamon sugar. Bake for 12 minutes until the buns are dark golden-brown. Enjoy warm with a cup of coffee.",
      "timer_seconds": 720,
      "ingredients_used": [
        "d877c18f-4811-58f4-83a1-a000daf7a88c",
        "cbf49c86-359c-5957-8ed3-1910b92e9fe0",
        "d9f60bf9-9a9c-535e-a84d-0204ec7a14fd"
      ]
    }
  ],
