  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 190 C / Gas 5. Grease a 23cm round springform tin.",
      "temperature": {
        "value": 190,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Cut off the hard bits from the top and bottom of the orange. Slice the orange and remove all seeds. Puree the orange with its peel in a food processor. Add one third of the sugar and the olive oil and continue to mix until well combined.",
      "ingredients_used": [
        "f3ac9f3d-0ba6-5912-8f5d-8e755d664e13",
        "dd30faa2-6aac-52c2-a878-54e210d1fdbe"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Sieve together flour and baking powder.",
      "ingredients_used": [
        "ae3da707-922d-5142-a26f-2b4894f3b097",
        "8211911f-f57b-5ecc-8f09-97429cb6238e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Beat the eggs and the remaining sugar with an electric hand mixer for at least five minutes until very fluffy. Fold in half of the flour mixture, then the orange and the vanilla, then fold in the remaining flour. Mix well but not for too long.",
      "ingredients_used": [
        "f3ac9f3d-0ba6-5912-8f5d-8e755d664e13",
        "ae3da707-922d-5142-a26f-2b4894f3b097",
        "57698ba3-9b58-5f99-872e-ab581a24fa44"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour cake mixture into prepared tin and smooth out. Bake in preheated oven for 20 minutes. Reduce the oven temperature to 160 C / Gas 2 and bake again for 30 minutes Bake until the cake is golden brown and a skewer comes out clean. Cool on a wire cake rack.",
      "temperature": {
        "value": 160,
        "unit": "celsius"
      }
    }
  ],
