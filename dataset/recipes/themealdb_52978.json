  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "If you order kumpir in Turkey, the standard filling is first, lots of butter mashed into the potato, followed by cheese. There’s then a row of other toppings that you can just point at to your heart’s content – sweetcorn, olives, salami, coleslaw, Russian salad, allsorts – and you walk away with an over-stuffed potato because you got ever-excited by the choices on offer.",
      "ingredients_used": [
        "9c227038-c8ff-5172-a070-c1e8768f9355",
        "4cc3db59-ad3b-5afd-b83d-b7b4f4b14d97"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Grate (roughly – you can use as much as you like) 150g of cheese.",
      "ingredients_used": [
        "4cc3db59-ad3b-5afd-b83d-b7b4f4b14d97"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Finely chop one onion and one sweet red pepper.",
      "ingredients_used": [
        "a4a67a97-1bd1-51f4-bcab-f19bd86db23f",
        "d8131f4b-5a8e-5a7b-ab90-e02834b4d432"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Put these ingredients into a large bowl with a good sprinkling of salt and pepper, chilli flakes (optional)."
    }
  ],
