  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "MARINATING THE BEEF",
      "ingredients_used": [
        "418a5499-f407-5e87-bfb4-cbe57d986af8"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a bowl, add the beef, salt, sesame seed oil, white pepper, egg white, 2 Tablespoon of corn starch and 1 Tablespoon of oil.",
      "ingredients_used": [
        "418a5499-f407-5e87-bfb4-cbe57d986af8",
        "fbd3ebf8-28ca-541a-ace7-d553b99a3ecc",
        "50116f15-7473-5400-878a-15774208ca53",
        "77af1705-ba33-54c5-8d2b-89ec24d60a88",
        "caf81b53-a179-515b-9b68-681e66a2b3a5",
        "4859edd9-e723-5fc8-8d3b-2099d3dbf308",
        "8d157573-2eda-5817-ad0e-6c3c917a3322"
      ]
    },
    {
      "step_number": 3,
      "instruction": "STIR FRY"
    },
    {
      "step_number": 4,
      "instruction": "First Cook the beef by adding 2 Tablespoon of oil until the beef is golden brown.",
      "ingredients_used": [
        "418a5499-f407-5e87-bfb4-cbe57d986af8",
        "8d157573-2eda-5817-ad0e-6c3c917a3322"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Set the beef aside",
      "ingredients_used": [
        "418a5499-f407-5e87-bfb4-cbe57d986af8"
      ]
    },
    {
      "step_number": 6,
      "instruction": "In a wok add 1 Tablespoon of oil, minced ginger, minced garlic and stir-fry for few seconds.",
      "ingredients_used": [
        "8d157573-2eda-5817-ad0e-6c3c917a3322",
        "57325e01-6bf9-5ab1-84a1-c68326d4898f",
        "5a934f5e-39e4-5806-9a49-25a8bf9c0bad"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Next add all of the vegetables and then add sherry cooking wine and 1 cup of water.",
      "ingredients_used": [
        "de6f3645-0c60-5c96-84ce-9ecbae4e8c38",
        "594ea4fc-3bbf-5b4d-bcbb-af7b36442c93"
      ]
    },
    {
      "step_number": 8,
      "instruction": "To make the sauce add oyster sauce, hot pepper sauce, and sugar.",
      "ingredients_used": [
        "77af1705-ba33-54c5-8d2b-89ec24d60a88",
        "613a07a9-0ad3-538c-ae3f-5401bd3587bb",
        "9af2c0b0-1c5b-5f61-9cbf-b44dabb7398f"
      ]
    },
    {
      "step_number": 9,
      "instruction": "add the cooked beef and 1 spoon of soy sauce",
      "ingredients_used": [
        "418a5499-f407-5e87-bfb4-cbe57d986af8",
        "1f39477a-d0e2-506d-af64-a944c5a3f5de"
      ]
    },
    {
      "step_number": 10,
      "instruction": "To thicken the sauce, whisk together 1 Tablespoon of cornstarch and 2 Tablespoon of water in a bowl and slowly add to your stir-fry until it's the right thickness.",
      "ingredients_used": [
        "594ea4fc-3bbf-5b4d-bcbb-af7b36442c93"
      ]
    }
  ],
