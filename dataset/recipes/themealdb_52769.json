  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cut the meat into strips. Heat oil in a pan and fry the strips for 6 minutes until it's ready.",
      "timer_seconds": 360,
      "ingredients_used": [
        "6089a763-c62b-5aef-a1a0-01d914f92ed9"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Bake the fries until golden brown in a deep fryrer. When ready transfer to a backing dish. Make sure the fries are spread over the whole dish.",
      "ingredients_used": [
        "54671730-03f9-5631-baa1-f23ee50f0942"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cover the fries with a new layer of meat and spread evenly.",
      "ingredients_used": [
        "54671730-03f9-5631-baa1-f23ee50f0942",
        "6089a763-c62b-5aef-a1a0-01d914f92ed9"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add a layer of cheese over the meat. You can also use grated cheese. When done put in the oven for a few minutes until the cheese is melted.",
      "ingredients_used": [
        "6089a763-c62b-5aef-a1a0-01d914f92ed9"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Chop the lettuce, tomato and cucumber in small pieces and mix together. for a basic salad. As extra you can add olives jalapenos and a red union.",
      "ingredients_used": [
        "6fd0e371-4f63-5591-90b9-04f7d5c665f9",
        "7f2a588e-d25e-57cf-8ff1-ad1ffdda0bb3",
        "2520362d-27cc-5b04-aece-f292765a6594"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Dived the salad over the dish and Serve with garlicsauce and hot sauce"
    }
