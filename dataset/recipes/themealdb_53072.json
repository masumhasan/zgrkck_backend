  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Slice eggplant into 1 cm (0.4-inch) slices. Place them in a bowl and sprinkle them with salt. allow them to sit for 30 minutes to render some of their liquid and bitterness.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "68fffb11-d826-5504-a3e7-c4a5935a3908"
      ]
    },
    {
      "step_number": 2,
      "instruction": "After 30 minutes wash eggplant slices from salt and pat dry with a kitchen towel.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "68fffb11-d826-5504-a3e7-c4a5935a3908"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In a large bowl/plate place breadcrumbs and sesame seeds. In another bowl beat 2 eggs with pinch salt and pepper.",
      "ingredients_used": [
        "76bc80b8-10cd-5bd0-8af3-281bd3d56a2b",
        "fdd52ee3-e7f3-5261-b1df-9ccae9de31b2",
        "d70fd6a3-5c90-5b05-a975-5b3ca80ab918",
        "68fffb11-d826-5504-a3e7-c4a5935a3908",
        "92731963-b233-5d45-80f3-ac1c60a8df74"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Heal oil in a large skillet over high heat."
    },
    {
      "step_number": 5,
      "instruction": "Dip eggplant slices in egg, then in crumbs, and place in hot oil. Fry 2 to 3 minutes on each side, or until golden brown. Drain on a paper towel.",
      "timer_seconds": 180
    }
  ],
