  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in a 12-inch skillet over high heat until shimmering. Add the eggplants and lower the heat to medium. Season with salt and pepper as you rotate the eggplants, browning them on all sides. Continue to cook, turning regularly, until a fork inserted into the eggplant meets no resistance (you may have to stand them up on their fat end to finish cooking the thickest parts), about 20 minutes, lowering the heat and sprinkling water into the pan as necessary if the eggplants threaten to burn or smoke excessively.",
      "timer_seconds": 1200
    },
    {
      "step_number": 2,
      "instruction": "Mix the harissa, chickpeas and tomatoes together, then add to the eggplants. Cook until the tomatoes have blistered and broken down, about 5 minutes more. Season with salt and pepper and add water as necessary to thin to a saucy consistency. Meanwhile, combine the yogurt and cumin in a serving bowl. Season with salt and pepper.",
      "timer_seconds": 300,
      "ingredients_used": [
        "79c90bda-d925-5bbd-826e-290f50caaa11",
        "79e6470d-ae4f-55cd-961c-8c3c6ff398e6",
        "3165e724-63ad-55a6-8e1c-5aa8b0ceb43d",
        "ca683197-48d0-5424-aee3-5dd329f834ef"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Top the eggplant mixture with the parsley, drizzle with more extra virgin olive oil, and serve with the yogurt on the side.",
      "ingredients_used": [
