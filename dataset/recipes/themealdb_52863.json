  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in a large, heavy-based pan. Add the onions and cook gently for 5 – 10 mins until softened.",
      "timer_seconds": 600,
      "ingredients_used": [
        "138d7ed0-5668-5a5c-9365-c27e85a837f8"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the garlic, spices, dried thyme, carrots, celery and peppers and cook for 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "06be5a7d-6a38-50ab-9dcb-b7069dd5dbcc",
        "30bcd8c2-ecff-5a89-a20a-7b99c8e92a5e",
