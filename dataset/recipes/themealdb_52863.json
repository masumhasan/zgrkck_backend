        "8ef7e5ca-acbf-59e0-97ca-bc085e6e2c7c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the tomatoes, stock, courgettes and fresh thyme and cook for 20 - 25 minutes.",
      "timer_seconds": 1500,
      "ingredients_used": [
        "30bcd8c2-ecff-5a89-a20a-7b99c8e92a5e",
        "1a3bf753-4edb-5edf-b455-0bb1f6789d3d",
