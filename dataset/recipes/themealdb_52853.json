  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Blend all the mousse ingredients together in your food processor until smooth. Add the cacao powder first and, as you blend, have all the ingredients to hand in order to adjust the ratios slightly as the size of avocados and bananas varies so much. The perfect ratio in order to avoid the dish tasting too much of either is to use equal amounts of both.",
      "ingredients_used": [
        "d3ec9130-e1f1-58c9-8cce-a24f62ce5d9e",
        "7680b3a9-a098-5688-bec7-ff95cd8dace0",
        "0b795195-337e-571f-b1f3-15ef1ac035ac"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Taste and add a few drops of stevia if you feel you need more sweetness."
    },
    {
      "step_number": 3,
      "instruction": "Fill little cups or shot glasses with the mousse, sprinkle with the cacao powder or nibs and serve.",
      "ingredients_used": [
        "7680b3a9-a098-5688-bec7-ff95cd8dace0"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Tip If you don’t have a frozen banana to hand you can just use a normal one and then chill the mousse before serving for a cooling dessert.",
      "ingredients_used": [
        "d3ec9130-e1f1-58c9-8cce-a24f62ce5d9e"
      ]
    }
  ],
