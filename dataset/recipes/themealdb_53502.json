  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Whisk together rice flour, cornstarch, coconut milk, water, and turmeric in a bowl until smooth, then let rest for 15 minutes—this hydrates the flour for better texture.",
      "timer_seconds": 900,
      "ingredients_used": [
        "178ae1f0-0221-53a1-bcd3-886dbf9e084a",
        "feace707-dd4a-57d3-bd7e-22e2a7314d2d",
        "265118b3-083a-5680-bd92-c585ccf8166b",
        "56c0109e-b0c1-542a-92fd-368dbba98192",
        "e2a5266a-fcc6-50e8-bc73-e1f233dd62ab"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat a 10-inch non-stick skillet over medium-high heat (375°F) and add 1/2 tablespoon of vegetable oil.",
      "temperature": {
        "value": 375,
        "unit": "fahrenheit"
      },
      "ingredients_used": [
        "745a04ee-a7af-5644-866a-565a8b9aafe2"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Sauté pork belly slices for 3–4 minutes until lightly browned, then push to one side of the skillet.",
      "timer_seconds": 240,
      "ingredients_used": [
        "df2d00a7-e4fc-5b11-abb0-c62158a6c523"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add onion slices and cook for 1 minute until slightly softened.",
      "timer_seconds": 60,
      "ingredients_used": [
        "df2d00a7-e4fc-5b11-abb0-c62158a6c523",
        "d9df1a5d-da6c-53e7-862d-694a4a9beb90"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Stir the batter briefly and pour about 1/2 cup into the skillet, immediately swirling to coat the bottom thinly."
    },
    {
      "step_number": 6,
      "instruction": "Scatter bean sprouts over half of the pancake and cover the skillet with a lid for 2 minutes to steam the sprouts.",
      "timer_seconds": 120,
      "ingredients_used": [
        "a0297e55-f733-5ea7-8dd7-aca0ee5d8372"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Uncover and cook for another 3–4 minutes until the edges curl and turn golden brown and crispy.",
      "timer_seconds": 240
    },
    {
      "step_number": 8,
      "instruction": "Fold the pancake in half over the bean sprouts using a spatula, then transfer to a plate.",
      "ingredients_used": [
        "a0297e55-f733-5ea7-8dd7-aca0ee5d8372"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Repeat steps 2–8 with remaining batter and ingredients, adding oil as needed to prevent sticking."
    },
    {
      "step_number": 10,
      "instruction": "Serve immediately with fish sauce for dipping.",
      "ingredients_used": [
        "361bc116-bad1-5606-9404-469b270bb991"
      ]
    }
  ],
