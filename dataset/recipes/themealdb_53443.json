  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "To make the marinade for the satee put in the container of an electric blender:"
    },
    {
      "step_number": 2,
      "instruction": "1 large onion, coarsely chopped 2 cloves of garlic",
      "ingredients_used": [
        "288590fc-0254-51da-84c2-9aef0e03fa55",
        "e78c49fb-18b3-564e-b1de-5234f521955a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Juice of 2 lemons",
      "ingredients_used": [
        "7afd4663-eea4-522a-9f61-ee6db7388848"
      ]
    },
    {
      "step_number": 4,
      "instruction": "2Tbs. of sugar 1 cup of soy sauce",
      "ingredients_used": [
        "cc4b2320-738a-5f53-89b9-e946cdea5266",
        "40bba988-11dd-515f-947b-3842bb1af450",
        "f193aa10-07b4-55cc-bb1d-874b0d8f66be"
      ]
    },
    {
      "step_number": 5,
      "instruction": "1 tsp. salt 1 tsp. ground coriander for beef (or chicken) or 1 tsp. ground ginger for pork",
      "ingredients_used": [
        "d4c31739-492f-5045-a7b3-b660ce68ef63",
        "22a39eb7-9af9-50c5-a7d0-9ec54f90c133",
        "3d400228-a09e-516a-8f30-4421986dc059"
      ]
    },
    {
      "step_number": 6,
      "instruction": "1 cup of oil",
      "ingredients_used": [
        "5c63a314-a8df-57cb-8c9a-c591d2558fce",
        "e2097bbc-2736-553f-b000-89619fe2062f"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Blend thoroughly and pour over:"
    },
    {
      "step_number": 8,
      "instruction": "5 lbs. of beef or pork tenderloin, cubed",
      "ingredients_used": [
        "3d400228-a09e-516a-8f30-4421986dc059"
      ]
    },
    {
      "step_number": 9,
      "instruction": "DO NOT marinate overnight, but only for a few hours."
    },
    {
      "step_number": 10,
      "instruction": "Place the meat on: 36 skewers"
    },
    {
      "step_number": 11,
      "instruction": "Blend well:"
    },
    {
      "step_number": 12,
      "instruction": "1 cup of oil",
      "ingredients_used": [
        "5c63a314-a8df-57cb-8c9a-c591d2558fce",
        "e2097bbc-2736-553f-b000-89619fe2062f"
      ]
    },
    {
      "step_number": 13,
      "instruction": "2 Tbs. Soy sauce",
      "ingredients_used": [
        "40bba988-11dd-515f-947b-3842bb1af450",
        "f193aa10-07b4-55cc-bb1d-874b0d8f66be"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Pour into a large shallow dish."
    },
    {
      "step_number": 15,
      "instruction": "To keep meat from becoming dry, roll each skewer in seasoned oil before frying.",
      "ingredients_used": [
        "5c63a314-a8df-57cb-8c9a-c591d2558fce",
        "e2097bbc-2736-553f-b000-89619fe2062f"
      ]
    },
    {
      "step_number": 16,
      "instruction": "Satee is also excellent when barbecued."
    }
  ],
