  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place flour in a bowl, and create a hole in the middle of the flour. Whisk eggs, and then pour whisked eggs into the well.",
      "ingredients_used": [
        "0a066a6f-b6d8-572e-bfe3-1b9f3d5d947a",
        "30475feb-585f-54a8-8637-0ee366b38d04"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add milk, and combine. Then, stir in the ground walnuts, baking powder and cardamom, and add to the mixture. Fold ingredients into the mixture until it forms an elastic dough consistency.",
      "ingredients_used": [
        "86e01573-a28e-51ef-8e75-96d438107ada",
        "ff7c5a4f-2e30-5493-bbad-e1550179d008",
        "0ba62558-c4fe-5291-b50d-9a9c359aa326",
        "718aff97-abef-58bf-b92f-9addb93b9b69"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Take dough and with a rolling pin, roll out into a thin rectangle on a clean surface. Then, from the longest side of the rectangle, fold the dough into 3cm-wide lines, until the dough is fully rolled in a long line. Cut folded dough horizontally into 3cm pieces"
    },
    {
      "step_number": 4,
      "instruction": "Heat a deep pan of the vegetable oil, and wait till it reaches frying temperature. Whilst you are waiting. Fill a deep pan with 1 liter of water, and bring to the boil.  Then, pour in the sugar, and stir gently until it becomes thick and syrup-like. Turn down the heat and leave to simmer.",
      "ingredients_used": [
        "0b05ae80-d424-5d94-a8e9-3f7367eff723",
        "6b210a5d-da7c-55f7-83b3-cebee21cd9b9",
        "4903cde3-e57f-5147-8e17-9b908be3d678"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Carefully lower each piece of dough into the frying oil. Fry until golden brown."
    },
    {
      "step_number": 6,
      "instruction": "When golden brown, take the Baghlaw pieces out of the oil, and place them into the sugar syrup to coat.",
      "ingredients_used": [
        "6b210a5d-da7c-55f7-83b3-cebee21cd9b9"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Remove from the syrup and whilst still warm, sprinkle with ground walnuts, so they stick to the Baghlaw.",
      "ingredients_used": [
        "0ba62558-c4fe-5291-b50d-9a9c359aa326"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Leave to cool. Then, enjoy with your friends and family!"
    }
  ],
