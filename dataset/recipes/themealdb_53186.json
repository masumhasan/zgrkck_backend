  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat a large frying pan on a high heat and season the chicken. Add the olive oil to the pan, then the chicken. Brown for about 5 mins on each side, remove onto a plate, then set aside.",
      "timer_seconds": 300,
      "ingredients_used": [
        "5f537f0a-25e0-51f6-ace6-63e9b27d470c",
        "43fb27b7-8d24-5110-9bf8-2ed0e995beb1"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Lower the heat to medium. In the remaining fat, fry the onions for 3 mins, then add the garlic and saffron. Cook for 3-4 mins more. Add the sherry, then simmer for 3-5 mins until syrupy.",
      "ingredients_used": [
        "31d63846-05cc-59c4-a127-530959d658e0",
        "996b76b6-3ccd-5bfa-80ae-60a38e5f554e",
        "1b46412c-fa98-5e23-aca1-4a80ec3c3ebe"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Put the chicken leg pieces back into the pan, tip in the stock, thyme and raisins, cover, then gently cook on a low heat for 20 mins. Add the breast meat and any juices left on the plate. Simmer for 10 mins more until cooked through and the sauce in the pan has reduced.",
      "ingredients_used": [
        "5f537f0a-25e0-51f6-ace6-63e9b27d470c",
        "a859be2a-b530-5ccb-9b34-e276bdaef968",
        "df2fccfa-6a9b-5af8-b1c0-fb2528f463ff"
      ]
    },
    {
      "step_number": 4,
      "instruction": "While the chicken is cooking, heat oven to 200C/180C fan/gas 6. Scatter the pine nuts over a baking sheet, then roast for 10 mins until golden and toasted. Once the chicken has cooked through, season to taste, scatter with pine nuts and parsley, then serve with rice.",
      "timer_seconds": 600,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
