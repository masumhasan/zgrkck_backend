  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 180°C/350°F/Gas Mark 4. Grease and line the base of an 8 in round spring form cake tin with baking parchment",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Break the chocolate into a heatproof bowl and place over a saucepan of gently simmering water and stir until it melts. (or melt in the microwave for 2-3 mins stirring occasionally)",
      "timer_seconds": 180,
      "ingredients_used": [
        "db2ba683-a7a1-5cb0-a5cb-c6f33a80da32"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Place the butter and sugar in a mixing bowl and cream together with a wooden spoon until light and fluffy. Gradually beat in the eggs, adding a little flour if the mixture begins to curdle. Fold in the remaining flour with the cooled, melted chocolate and milk. Mix until smooth.",
      "ingredients_used": [
        "db2ba683-a7a1-5cb0-a5cb-c6f33a80da32",
        "5c4efba3-d3fa-59d4-8a39-a84afdb380f8",
        "68f0c45f-fa13-5df6-9e74-5599cc6a81d9",
        "9374c15c-a26f-5aa6-b393-98912c5f7d31",
        "e2857f25-d1b1-5758-ab00-277f37de95cc"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Spread the mixture into the cake tin and bake for 50-55 mins or until firm in the center and a skewer comes out cleanly. Cool for 10 minutes, then turn out and cool completely."
    }
  ],
