  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preparation"
    },
    {
      "step_number": 2,
      "instruction": "In a mixing bowl mix together the summer squash, sugar, eggs and baking soda. Add the flour and continue to mix, you are looking for a thick sticky mixture. Add a bit more flour if the mixture is still thin and slightly runny.",
      "ingredients_used": [
        "1b7d39c6-cbd7-5ff8-be85-226fb9d33c14",
        "92b3b783-789d-5be7-9d24-ac7c9fe03938",
        "4849a5b0-6dc7-5741-a706-6a66d888ae64"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In a large round baking tray (about 2 inches deep) rub some olive oil over the base and edges.",
      "ingredients_used": [
        "cecb4c82-bab6-5850-b729-819f66bf1581"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Scoop the mixture onto the tray and spread out evenly, then pour a small amount of olive oil onto you hand and rub it in circles gently over the top of the mixture. This should flatten it and leave it with a slightly shiny glossing.",
      "ingredients_used": [
        "cecb4c82-bab6-5850-b729-819f66bf1581"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Cooking"
    },
    {
      "step_number": 6,
      "instruction": "Bake in the oven for 40 minutes on 180 degrees – the top should be a golden brown once cooked.",
      "timer_seconds": 2400
    },
    {
      "step_number": 7,
      "instruction": "Serving"
    },
    {
      "step_number": 8,
      "instruction": "Leave to cool before slicing into squares and serving."
    }
  ],
