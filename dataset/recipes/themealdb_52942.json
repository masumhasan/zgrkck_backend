  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "1 Put the fennel, aubergine, pepper and courgette in a roasting tray. Add a glug of olive oil, season with salt and pepper and toss around to coat the veggies in the oil. Roast in the oven for 20 minutes, turning a couple of times until the veg are pretty much cooked through and turning golden.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "1c039b74-487a-5ad5-a587-c529aa836449",
        "bc0c3cfe-8290-57ca-8e15-44622216579f",
        "bce72b7e-45cf-5e77-8f08-eeabc16baa5d"
      ]
    },
    {
      "step_number": 2,
      "instruction": "2 Meanwhile, heat a paella pan or large frying pan over a low– medium heat and add a glug of olive oil. Sauté the onion for 8–10 minutes until softened. Increase the heat to medium and stir in the rice, paprika and saffron. Cook for around 1 minute to start toasting the rice, then add the white wine. Reduce by about half before stirring in two-thirds of the stock. Reduce to a simmer and cook for 10 minutes without a lid, stirring a couple of times.",
      "ingredients_used": [
        "2346ae5f-a0ce-5f6d-9545-497822b7fb9b",
        "93771164-62ef-5b10-b1a0-a23447a081cd",
        "023a687b-8a0a-5754-842c-5a23758441c3",
        "9c1d77ae-b344-5e06-ac3b-fcf734de40f3",
        "adef6e92-2bff-5751-b3ef-a9dc75fe81e2"
      ]
    },
    {
      "step_number": 3,
      "instruction": "3 Stir in the peas, add some seasoning, then gently mix in the roasted veg. Pour over the remaining stock, arrange the lemon wedges on top and cover with a lid or some aluminum foil. Cook for a further 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "888918b4-0ee7-55b9-bd5a-9b275d071b34",
        "606d500d-d94e-5c6d-93a4-a732d700ab6e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "4 To ensure you get the classic layer of toasted rice at the bottom of the pan, increase the heat to high until you hear a slight crackle. Remove from the heat and sit for 5 minutes before sprinkling over the parsley and serving.",
      "timer_seconds": 300,
      "ingredients_used": [
        "93771164-62ef-5b10-b1a0-a23447a081cd",
        "4fb4b94a-a167-5fb4-872b-4a1176426af8"
      ]
    }
  ],
