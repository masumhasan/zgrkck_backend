  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "To prepare the dough, sift the flour with 1tsp of salt into a mixing bowl. Slowly mix in as much of the water is required, until a stiff dough is formed. Knead on a clean work surface for 5-10 minutes, until the dough is elastic and shiny. Cover with a damp cloth and set aside for about an hour.",
      "timer_seconds": 600,
      "ingredients_used": [
        "dcb63f67-e980-5c48-a140-0119821d5955"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Put the chopped lamb, onions, chilli, 1 tsp salt, ground pepper and spices in a bowl and mix thoroughly.",
      "ingredients_used": [
        "52f552fd-c89b-5361-bde3-aedc52020936",
        "7385b4f8-6383-53fa-98d6-3695a1792678",
        "ca286963-c1aa-526e-9535-79139ac76cd3"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Divide the dough into 4 small balls, and roll out to a thickness of 1.5mm, cutting into 10cm squares. Into each square, place 1 heaped teaspoon of the lamb mixture.",
      "ingredients_used": [
        "52f552fd-c89b-5361-bde3-aedc52020936"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Take two opposite corners and bring them to join in the center by nipping together firmly between your fingers, and then bring together to other two corners in the same manner. Note that the mantu should not be entirely closed, as the steam has to be penetrate and cook the filling!"
    },
    {
      "step_number": 5,
      "instruction": "Using fat to grease the shelves of the steamer, place your mantu so that there is a small space between each one. Steam for 30-45 minutes over a medium heat.",
      "timer_seconds": 2700
    },
    {
      "step_number": 6,
      "instruction": "Meanwhile, make the tomato sauce. Heat the oil in a pan, add tomato puree, and bring to the boil. Stir and simmer on a low heat until the mantu are ready.",
      "ingredients_used": [
        "8ca10b89-e944-56f5-83ed-ae29778edb84"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Remove the mantu carefully from the steamer and place on a large, warm dish. Spoon the tomato sauce over the top, followed by the strained yogurt, and sprinkle with chopped coriander to garnish.",
      "ingredients_used": [
        "ba1763ae-2fff-5e99-bb6c-82b9d6d274ed",
        "060d9f60-f738-5bb7-8b3c-97f69d7d6fd2"
      ]
    }
  ],
