  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a medium bowl, combine the coconut milk, red curry paste, fish sauce, palm sugar, and broth, whisking until smooth—this ensures no lumps in the sauce.",
      "ingredients_used": [
        "57e331b8-8638-528e-bf56-5aa11e1b1637",
        "7b7d1a12-b2ce-5246-9654-828383838810",
        "39da4e4e-d0bb-5e97-b40e-34508de2150b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat the vegetable oil in a large skillet over medium heat (about 350°F) for 30 seconds until shimmering.",
      "timer_seconds": 30,
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      },
      "ingredients_used": [
        "4ea9c809-8d25-5b17-8d94-0d653d6e9728"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Pour the coconut milk mixture into the skillet and bring it to a gentle simmer, stirring occasionally, which should take about 3-4 minutes.",
      "timer_seconds": 240,
      "ingredients_used": [
        "57e331b8-8638-528e-bf56-5aa11e1b1637"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the fish cubes and kaffir lime leaves to the skillet, submerging them fully in the sauce.",
      "ingredients_used": [
        "7b4bb050-e7b7-5cf9-a124-dbf5f84757e6",
        "88241a56-cd2a-58eb-af64-06750dd547c0"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Reduce the heat to low, cover the skillet, and let it cook for 10 minutes until the fish is opaque and flakes easily with a fork—avoid overcooking to keep it tender.",
      "timer_seconds": 600
    },
    {
      "step_number": 6,
      "instruction": "Stir in the beaten egg slowly, cooking for 2 more minutes until the sauce thickens slightly, which adds a rich, custard-like texture.",
      "ingredients_used": [
        "0cb6756f-91cc-57c1-8dbc-74e05389b883"
      ]
    },
    {
      "step_number": 7,
      "instruction": "While the curry simmers, prepare the banana leaves by briefly passing them over a gas flame for 10 seconds to make them pliable, or use parchment paper as a handy alternative.",
      "timer_seconds": 10,
      "ingredients_used": [
        "40f0d7a8-dc36-5884-a0ae-bf06c0979607"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Spoon the curry into the center of each banana leaf square, folding the edges to form a tight packet to trap steam."
    },
    {
      "step_number": 9,
      "instruction": "Place the packets in a steamer basket over boiling water and steam for 10 minutes until heated through and fragrant.",
      "timer_seconds": 600
    },
    {
      "step_number": 10,
      "instruction": "Carefully unwrap the packets and garnish with fresh cilantro and lime wedges before serving",
      "ingredients_used": [
        "2abdead5-b8f6-5a31-9adf-cdcb23b4f633",
        "88241a56-cd2a-58eb-af64-06750dd547c0"
      ]
    }
  ],
