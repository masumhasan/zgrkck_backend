  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place the dried yeast, milk and sugar in the bowl of your food processor. Mix and let stand for a few minutes until it begins to foam.",
      "ingredients_used": [
        "2e1d82fa-f83f-520c-a40d-d7cadcd6b9ae",
        "23daafda-70ba-56e9-98af-27176aa09b0a",
        "e8b9ce77-5721-5cb3-8825-cdbc8c4b7c8a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Then add the flour, egg, butter, salt, 1 tsp of cinnamon and cardamom and process until smooth.",
      "ingredients_used": [
        "0a2a7452-30dc-51d2-beb1-d21aecb557e2",
        "a8ae1108-3373-5f82-9c67-a7ca3c51b09a",
        "9262bafc-08a2-59ef-9aab-f27649729921",
        "b44226e9-5202-509f-8b0a-36b2ee20e16f",
        "d6015bbb-2f08-5603-801d-b0450a747252",
        "de0a68a9-b11e-565f-865f-055e68a1fbff"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Form the dough into a ball, cover the bowl and let it rise for 1 hour or until it has doubled in size.",
      "timer_seconds": 3600
    },
    {
      "step_number": 4,
      "instruction": "Mix the caster sugar with 1 tablespoon of cinnamon, pour over the dough and roll it in.",
      "ingredients_used": [
        "e8b9ce77-5721-5cb3-8825-cdbc8c4b7c8a",
        "d6015bbb-2f08-5603-801d-b0450a747252"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Form 10 equal balls (about 75 grams each) and let them “sweat” for a while. The sugar will dissolve a little. When you roll them again later, the rest of the dough will absorb the sugar better.",
      "ingredients_used": [
        "e8b9ce77-5721-5cb3-8825-cdbc8c4b7c8a"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Then roll the ball into a strand about 35-40 centimeters long while rolling through the powdered sugar.",
      "ingredients_used": [
        "e8b9ce77-5721-5cb3-8825-cdbc8c4b7c8a"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Fold the strand around one end and tuck the other end under the bolus. Push something between the roll to secure the end."
    },
    {
      "step_number": 8,
      "instruction": "Place on a baking sheet lined with a baking sheet, cover with plastic wrap and let them rise for ½-1 hour.",
      "timer_seconds": 3600
    },
    {
      "step_number": 9,
      "instruction": "Meanwhile, preheat the oven to 250 degrees Celsius/480 Fahrenheit top and bottom heat",
      "temperature": {
        "value": 250,
        "unit": "celsius"
      }
    },
    {
      "step_number": 10,
      "instruction": "Bake the Zeeland Boluses for about 8 minutes until done. Be careful – if you bake them too long, they will get dry and you will want something sticky 😉 .",
      "timer_seconds": 480
    },
    {
      "step_number": 11,
      "instruction": "Let them cool out of the oven for 1 minute, then turn them over and let them cool further (on a wire rack if necessary). Enjoy!",
      "timer_seconds": 60
    }
  ],
