  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Grill the eggplant until the color of skin turns almost black"
    },
    {
      "step_number": 2,
      "instruction": "Let the eggplant cool for a while then peel off the skin. Set aside."
    },
    {
      "step_number": 3,
      "instruction": "Crack the eggs and place in a bowl",
      "ingredients_used": [
        "d13802fa-4d84-56e6-95f8-0c7404d2bc41"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add salt and beat",
      "ingredients_used": [
        "9663e371-8c3b-5b8d-baaf-e874af50a591"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Place the eggplant on a flat surface and flatten using a fork."
    },
    {
      "step_number": 6,
      "instruction": "Dip the flattened eggplant in the beaten egg mixture"
    },
    {
      "step_number": 7,
      "instruction": "Heat the pan and pour the cooking oil"
    },
    {
      "step_number": 8,
      "instruction": "Fry the eggplant (that was dipped in the beaten mixture). Make sure that both sides are cooked. Frying time will take you about 3 to 4 minutes per side on medium heat.",
      "timer_seconds": 240
    }
