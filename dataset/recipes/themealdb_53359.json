  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Wash the beef and cut into large pieces. Season lightly with salt and turmeric.",
      "ingredients_used": [
        "95fb8fe4-0a99-5a8b-96d1-5760b99dc017"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat ghee/oil in a large pot. Add sliced onions and sauté until light golden.",
      "ingredients_used": [
        "30f3a843-73fd-5670-9e4e-d98dc286eade",
        "64d71266-dc15-550c-856b-d2569c3704c1"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add garlic, green chilies, and tomato; cook until softened.",
      "ingredients_used": [
        "0b998da7-c2e5-53cd-a9e0-8415e5f6b69d",
        "cf7601a4-97ea-50e1-83cd-0b807eef7615"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the mandi spice mix: coriander, cumin, black pepper, cinnamon, cardamom, cloves, and bay leaves.",
      "ingredients_used": [
        "f5eab06f-6f63-552a-a94d-3bb1c5758484",
        "970b284e-50b9-5b8f-b411-f0c132c0234d"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add beef pieces and stir on medium heat until the meat is well coated with spices."
    },
    {
      "step_number": 6,
      "instruction": "Pour in water or beef stock. Cover and simmer until beef is tender (about 1.5–2 hours depending on cut).",
      "timer_seconds": 7200,
      "ingredients_used": [
        "d7287cbb-535d-5f3b-b196-09f8d57aa771"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Remove beef carefully and set aside. Strain and measure the broth."
    },
    {
      "step_number": 8,
      "instruction": "Add washed, soaked basmati rice to the broth (usually 1 cup rice = 1.5–2 cups liquid). Adjust seasoning and bring to a boil.",
      "ingredients_used": [
        "cecb1cf0-3b82-530b-80a0-6ffa28cf9feb"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Lower heat, cover, and cook the rice until fluffy.",
      "ingredients_used": [
        "cecb1cf0-3b82-530b-80a0-6ffa28cf9feb"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Place the beef pieces over the rice and steam on low heat for 10 minutes so flavors combine.",
      "timer_seconds": 600,
      "ingredients_used": [
        "cecb1cf0-3b82-530b-80a0-6ffa28cf9feb"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Optional: For smoky flavor, place a small hot charcoal on foil in the pot, add 1 tsp butter/oil, immediately cover for 5 minutes. Remove coal before serving.",
      "timer_seconds": 300,
      "ingredients_used": [
        "64d71266-dc15-550c-856b-d2569c3704c1"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Fluff rice and serve beef mandi with salad or chutney.",
      "ingredients_used": [
        "cecb1cf0-3b82-530b-80a0-6ffa28cf9feb"
      ]
    }
  ],
