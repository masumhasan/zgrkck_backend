  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Add the butter to a large Dutch oven or other heavy-duty pot over medium heat. When the butter has melted, add the onion and sauté until translucent.",
      "ingredients_used": [
        "95ca9881-0019-585f-8bbc-dcfe2aee85cb",
        "78a7b769-0111-5fb9-952a-533c2aa9ea52"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the cabbage, carrot, and celery. Sauté until the vegetables begin to soften, stirring frequently, about 3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "10ed26d5-6df6-5366-97a7-18a0dc030790",
        "8be06bdf-05d1-5ff8-aa81-cf91eba15c65"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the bay leaf and vegetable stock and bring to a boil over high heat. Reduce the heat to low and simmer, covered, until the vegetables are crisp-tender, about 15 minutes.",
      "timer_seconds": 900,
      "ingredients_used": [
        "3975f795-c1ad-5022-b4db-18bd32642403",
        "9d5af913-ad9d-5cfe-a25f-776e5ef57129"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the potatoes and bring it back to a boil over high heat. Reduce the heat to low and simmer, covered, until the potatoes are tender, about 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "11e73e02-5de6-5be8-9ec9-44b3ccc7d7f6"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the tomatoes (or undrained canned tomatoes) and bring the soup back to a boil over high heat. Reduce the heat to low and simmer, uncovered, for 5 minutes. Season to taste with salt and pepper.",
      "timer_seconds": 300,
      "ingredients_used": [
        "adc1e128-79eb-5129-a07e-838c90f64de3"
      ]
    },
    {
      "step_number": 6,
      "instruction": "emove and discard the bay leaf from the pot.",
      "ingredients_used": [
        "3975f795-c1ad-5022-b4db-18bd32642403"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Serve topped with fresh sour cream and fresh dill.",
      "ingredients_used": [
        "dd9ecda2-5860-51d3-aa46-18f45404c242",
        "c7535b3f-50e0-506c-bd5f-887ca7022c3f"
      ]
    }
  ],
