  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Boil potatoes in lightly salted water for 10 to 12 minutes. Drain water when a potato speared with a fork and lifted out of the water easily glides off the fork and falls back into the pot. Let potatoes stand and cool.",
      "timer_seconds": 720,
      "ingredients_used": [
        "0ee4a516-80f6-5dad-8a77-e103fce87ffb",
        "0313bd6a-95b8-598c-a0aa-65eaea609128"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Break off and discard the stringy ends of the asparagus spears, then chop into small pieces. You can pour boiling water over the chopped asparagus and let it soak for 2 minutes if you prefer a less raw taste.",
      "timer_seconds": 120,
      "ingredients_used": [
        "3ef803d4-b4e2-58b5-a0f1-c6754ddc357c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Finely chop chives, red onion and radish.",
      "ingredients_used": [
        "f04b871e-6945-578f-a095-084368df5eb0",
        "6c008444-4d38-5b12-af71-3983fdfdf8dd"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Stir the dressing ingredients together and season with salt and pepper.",
      "ingredients_used": [
        "0313bd6a-95b8-598c-a0aa-65eaea609128",
        "2daeca62-343e-5891-ad73-73a4801ec2ca"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Reserve some of the chives for garnish and combine the rest of the vegetables with the dressing.",
      "ingredients_used": [
        "f04b871e-6945-578f-a095-084368df5eb0"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Season with salt and pepper, garnish with chives and serve as a side dish.",
      "ingredients_used": [
        "f04b871e-6945-578f-a095-084368df5eb0",
        "0313bd6a-95b8-598c-a0aa-65eaea609128",
        "2daeca62-343e-5891-ad73-73a4801ec2ca"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Tip"
    },
    {
      "step_number": 8,
      "instruction": "When in season, you can add fresh peas to this potato salad"
    }
  ],
