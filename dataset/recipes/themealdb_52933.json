  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 400 degrees F (200 degrees C). Grease a 10x14x2-inch baking pan.",
      "temperature": {
        "value": 400,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "Heat margarine in a skillet over medium heat; stir in onion. Cook and stir until onion has softened and turned translucent, about 5 minutes. Reduce heat to low and continue to cook and stir until onion is very tender and dark brown, about 40 minutes more."
    },
    {
      "step_number": 3,
      "instruction": "Bring chicken broth to a boil in a large pot; stir in chicken breasts, reduce heat, and simmer until chicken is no longer pink at the center, about 20 minutes. Remove from heat. Remove chicken breasts to a plate using a slotted spoon; reserve broth.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "43670c2d-826b-53a7-848d-419ccc60b9cb"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Juice potatoes with an electric juicer; place dry potato flesh into a bowl and discard juice. Stir salt and pepper into potatoes; stir in enough reserved broth to make the mixture the consistency of oatmeal. Set remaining broth aside.",
      "ingredients_used": [
        "bb84a173-a128-55bb-b23f-61de990a7b18",
        "cf022702-321b-503f-80aa-b937f52e7f50"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Spread half of potato mixture evenly into the prepared pan. Lay cooked chicken breast evenly over potatoes; scatter caramelized onion evenly over chicken. Spread remaining potato mixture over onions and chicken to cover.",
      "ingredients_used": [
        "a9cc03b5-355c-59f6-9d83-1b5a0c47ccde",
        "43670c2d-826b-53a7-848d-419ccc60b9cb",
        "bb84a173-a128-55bb-b23f-61de990a7b18"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Bake in the preheated oven until golden brown, about 1 hour. Reheat chicken broth; pour over individual servings as desired.",
      "timer_seconds": 3600
    }
  ],
