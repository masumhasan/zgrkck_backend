  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 180C/fan 160C/gas 4. Put the oats, coconut, flour and sugar in a bowl. Melt the butter in a small pan and stir in the golden syrup. Add the bicarbonate of soda to 2 tbsp boiling water, then stir into the golden syrup and butter mixture.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
