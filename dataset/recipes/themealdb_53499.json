  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat 2 tbsp vegetable oil in a large skillet over medium-high heat until shimmering, about 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "3dcd20c1-c24c-54a2-97b9-4d58829bb63b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add 4 cloves minced garlic and 2 finely chopped shallots to the skillet, stirring constantly until fragrant and lightly golden, 2-3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "ccf4be93-ff00-58e9-ae32-abff398fcd3b",
        "5aa96896-c077-5aef-8bf6-97f19a564323"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Tip: Keep the heat medium to prevent burning—garlic can turn bitter if overcooked.",
      "ingredients_used": [
        "ccf4be93-ff00-58e9-ae32-abff398fcd3b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add 1 lb ground pork to the skillet, breaking it up with a spoon, and cook until no pink remains, 5-7 minutes.",
      "timer_seconds": 420,
      "ingredients_used": [
        "4923c559-d30f-5e77-b0c8-e14037928eb3"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Stir in 3 tbsp prahok and cook for 1 minute to blend the flavors, mashing it slightly into the pork.",
      "timer_seconds": 60,
      "ingredients_used": [
        "4923c559-d30f-5e77-b0c8-e14037928eb3",
        "9201718e-58a0-5ad5-bd93-48f16af6a751"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Pour in 1 cup coconut milk, stirring to combine, then reduce heat to medium-low and simmer for 10 minutes until the mixture thickens slightly.",
      "timer_seconds": 600,
      "ingredients_used": [
        "dbae7430-c812-517a-bd08-14ad7469a620"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Tip: Simmer gently to avoid curdling the coconut milk—a steady bubble is ideal.",
      "ingredients_used": [
        "dbae7430-c812-517a-bd08-14ad7469a620"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add 2 tbsp fish sauce, 1 tbsp palm sugar, and 2 minced Thai chilies, stirring until the sugar dissolves, about 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "88da2112-6ab8-5a8a-808e-3f5aeed158b0"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Remove the skillet from heat and stir in 2 tbsp lime juice, mixing thoroughly.",
      "ingredients_used": [
        "57602764-5f4c-5626-8169-b975e453e4a3"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Tip: Add lime juice off the heat to preserve its fresh, tangy flavor without cooking it out.",
      "ingredients_used": [
        "57602764-5f4c-5626-8169-b975e453e4a3"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Transfer the dip to a serving bowl and garnish with ¼ cup chopped fresh cilantro.",
      "ingredients_used": [
        "1efa9ac3-42de-5d2a-85a4-4e1713d33d54"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Let the dip cool for 5 minutes before serving to allow the flavors to meld.",
      "timer_seconds": 300
    }
  ],
