  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Wash chicken with lemon"
    },
    {
      "step_number": 2,
      "instruction": "Drain and season chicken"
    },
    {
      "step_number": 3,
      "instruction": "Using shears, cut through the meat at the tip of the drumettes"
    },
    {
      "step_number": 4,
      "instruction": "Add all seasoning ingredients to the drumettes"
    },
    {
      "step_number": 5,
      "instruction": "Pour oil into a deep fryer, or saucepan to the level of about 5 inches so that the chicken will be submerged"
    },
    {
      "step_number": 6,
      "instruction": "Fry until medium brown, add your favorite sauce (I used honey garlic barbecue sauce) to place in the oven",
      "ingredients_used": [
        "7e648067-1eb5-5426-be8b-e32f01f8400a"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Or fry until golden brown if you're not putting it in the oven"
    },
    {
      "step_number": 8,
      "instruction": "Using a silicon brush add sauce to chicken and place in the oven"
    }
  ],
