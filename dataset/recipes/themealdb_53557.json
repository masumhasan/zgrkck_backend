        "7f987891-3cca-5967-b763-79ce91b2526f"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Place wings in pan on medium heat, until light brown.",
      "ingredients_used": [
        "fc701049-f7e1-5cda-a831-6b7ca252a689"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Drain on a paper towel, and let the wings rest for at least 10 minutes, then return the wings to the hot pan on high heat and fry until golden brown.",
      "timer_seconds": 600,
      "ingredients_used": [
        "fc701049-f7e1-5cda-a831-6b7ca252a689"
      ]
