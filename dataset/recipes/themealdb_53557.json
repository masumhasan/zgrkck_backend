  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Wash chicken and pat dry"
    },
    {
      "step_number": 2,
      "instruction": "Place in a large bowl"
    },
    {
      "step_number": 3,
      "instruction": "Season with garlic, salt, pepper and turmeric (you can expand your seasoning options if you'd like.",
