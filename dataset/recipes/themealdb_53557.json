      ]
    },
    {
      "step_number": 4,
      "instruction": "Marinate for at least an hour"
    },
    {
      "step_number": 5,
      "instruction": "Pour some tapioca flour on a plate"
    },
    {
      "step_number": 6,
      "instruction": "Coat the wings with the cassava flour and place them on a rack or plater to set. Leave them for at least 30minutes to an hour.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "fc701049-f7e1-5cda-a831-6b7ca252a689",
        "2d1759e0-a1fd-58ed-89cb-c7c23b1ce6c7"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Heat the oil in the saucepan until it’s hot.",
