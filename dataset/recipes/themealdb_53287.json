      ]
    },
    {
      "step_number": 2,
      "instruction": "Place raisins in a small bowl and cover with hot water; let soak for 10 minutes. Drain.",
      "timer_seconds": 600,
      "ingredients_used": [
        "660675b6-56bb-5b4d-930b-881ffa36d8b4"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Preheat oven to 400 degrees F (200 degrees C).",
      "temperature": {
        "value": 400,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 4,
      "instruction": "Transfer chicken mixture into an oven-safe tagine or casserole dish. Add sweet potato and carrots. Cover with lid or aluminum foil.",
      "ingredients_used": [
        "c9470e51-9d3c-5cae-b662-0ae4fad95b73"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Bake in the preheated oven until sweet potato is soft, about 40 minutes. Add drained raisins and prunes. Continue baking, covered, until raisins and prunes are heated through, about 10 minutes.",
      "ingredients_used": [
        "660675b6-56bb-5b4d-930b-881ffa36d8b4",
        "cd7f393f-d7d6-5ace-b736-9ad625c4dc3e"
      ]
    }
