  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in a saucepan over a medium heat and cook the curry paste for 1 min before adding the stir-fry veg and prawns. Cook for 3 mins until the prawns are mostly pink, then add the coconut milk, veg stock and noodles.",
      "ingredients_used": [
        "f16cebcd-d968-599e-aaf8-9d6f3c54906d",
        "372b1439-426c-55da-88be-62daf85bf87a",
        "4d1db0a4-6c1d-5476-97bb-cda00cefba85"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Bring to the boil, then reduce the heat to a simmer and cook for 5 mins until the noodles are cooked through and the veg is tender but still has a bite. Divide between two bowls and sprinkle over the herbs, chilli and spring onion.",
      "timer_seconds": 300,
      "ingredients_used": [
        "4d1db0a4-6c1d-5476-97bb-cda00cefba85",
        "2e168a5d-e449-5db6-9ba5-be818d29e9cc"
      ]
    }
