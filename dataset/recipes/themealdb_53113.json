  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the 2 tablespoons of oil in a large skillet or pot over medium heat until shimmering. Add the onions and cook, stirring occasionally, until softened, 5 to 7 minutes.",
      "timer_seconds": 420,
      "ingredients_used": [
        "ab1bcdf4-42da-58fa-b7af-f431e1823e5e",
        "105af1bc-e5fe-5e4f-995d-0725e71f12a4"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add the shredded kale to the onions and mix well. Turn the heat to medium-low, cover and cook for 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "105af1bc-e5fe-5e4f-995d-0725e71f12a4",
        "1f592511-9c4f-58b5-b421-5778b28cbfbc"
      ]
    },
    {
      "step_number": 3,
      "instruction": "After 5 minutes, remove the lid, add salt to taste, and stir in the cream. Continue cooking for another 5 minutes, uncovered, stirring occasionally. The cream will thicken slightly, making for a deliciously rich creamed kale and onions. Yumm!",
      "ingredients_used": [
        "105af1bc-e5fe-5e4f-995d-0725e71f12a4",
        "1f592511-9c4f-58b5-b421-5778b28cbfbc",
        "3d18acd4-8789-5afa-98a7-3a1939b8e2fc"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Serve it up with your favorite Kenyan stew, and a side of ugali!"
    }
  ],
