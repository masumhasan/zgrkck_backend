  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place the corn, water, chicken or vegetable bouillon, garlic, salt, pepper, cilantro, potatoes and scallions in a large pot and bring to a boil. Reduce heat to medium low and simmer for approximately 4 minutes or until the corn is tender.",
      "timer_seconds": 240,
      "ingredients_used": [
        "2b981324-8f8a-5247-ad78-ddcfc6d438f5",
        "29657794-33b2-56b9-964e-85a55484e5b8",
        "f548d205-46c3-57f9-b981-452193cb8ffc",
        "2d9aac5b-d605-50e2-9514-13429326adf9",
        "7b263fcb-6efd-5b69-af51-6ec9282978ac",
        "31356d85-4490-5c7e-83b1-33c0d2a6cd80",
        "0b3568a6-6078-5586-b225-b89a5a62035e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Remove from the heat. Puruée the soup in a blender and return to the pot, add the cream and heat over medium heat for 15 minutes, stirring occasionally.",
      "timer_seconds": 900
    },
    {
      "step_number": 3,
      "instruction": "Pour into bowls, garnish with cilantro and potato sticks.",
      "ingredients_used": [
        "7b263fcb-6efd-5b69-af51-6ec9282978ac"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Notes"
    },
    {
      "step_number": 5,
      "instruction": "*Fresh corn or frozen corn will work for this soup recipe. I usually use fresh corn, but I use organic corn kernels in the winter to make this soup."
    },
    {
      "step_number": 6,
      "instruction": "*To store: Place cooled corn soup in an airtight container and store in the fridge for up to 3 days."
    }
  ],
