  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Clean and peel the potatoes and cut them into even size chunks. Boil them in salted water for about 10 min and then add the cleaned and chopped apples into the boiling water. Add the cinnamon stick as well. Leave to boil for another 10 minutes or until both apples and potatoes are to your liking. I like mine to be fairly chunky but that is a personal preference",
      "ingredients_used": [
        "1b227971-44a6-5f1a-a2e5-e6ec1f4d9f1c",
        "0fd082d3-47ea-59d9-ab9d-1f86256fee59",
        "aeec6424-7cc3-5359-8c83-28adff57897c",
        "a80078dd-c282-516b-9cd0-26f8a4bced9d",
        "bb1694a9-b51c-587c-b68d-f9145c8ecdbb"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In the mean time bake the streaky bacon in a dry frying pan until crispy and set aside to drain on paper towels.",
      "ingredients_used": [
        "bdd089e0-1af5-57f2-b522-b3abfc90c211"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Slice a few apple pieces and melt a little butter in a fryin pan. Add the apple slices to it and add a bit of maple syrup into the pan as well as some cinnamon. Let it simmer until the apple is soft.",
      "ingredients_used": [
        "a9a17f4f-0bbf-5d8d-b233-ac7c3876eeff",
        "a80078dd-c282-516b-9cd0-26f8a4bced9d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Prepare a plate with one whisked egg and one plate with sesame seeds. Cut your cheese into the required size. The smaller it is, the easier it is too handle.",
      "ingredients_used": [
        "35ed90ad-337d-54a1-8b88-91b5da485afd",
        "00c963c4-485c-5880-b37d-2b6618ea227c",
        "49723c0b-1212-5d71-b450-3a1610bf65fa"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Dip the cheese into the egg and make sure it coats all sides. Then dip the cheese into the sesame seeds and make sure it is covered everywhere.",
      "ingredients_used": [
        "35ed90ad-337d-54a1-8b88-91b5da485afd",
        "00c963c4-485c-5880-b37d-2b6618ea227c",
        "49723c0b-1212-5d71-b450-3a1610bf65fa"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Heat a non stick frying pan on high until nice and hot. Put the cheese slice in and bake until the sesame seeds are brown. You have to do this rather quickly or the cheese will melt completely. Turn and bake the other side.",
      "ingredients_used": [
        "aeec6424-7cc3-5359-8c83-28adff57897c",
        "35ed90ad-337d-54a1-8b88-91b5da485afd",
        "49723c0b-1212-5d71-b450-3a1610bf65fa"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Drain the apples and potatoes and mash them together. Taste and add cinnamon and salt where needed. Remove the cinnamon stick before mashing",
      "ingredients_used": [
        "1b227971-44a6-5f1a-a2e5-e6ec1f4d9f1c",
        "0fd082d3-47ea-59d9-ab9d-1f86256fee59",
        "aeec6424-7cc3-5359-8c83-28adff57897c",
        "a80078dd-c282-516b-9cd0-26f8a4bced9d",
        "bb1694a9-b51c-587c-b68d-f9145c8ecdbb"
      ]
    }
  ],
