  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 180C/fan 160C/gas 4. Butter and line the base of a 20cm square baking tin. Beat together the butter and sugar until pale and creamy, then beat in the eggs. Add 1 tbsp of the flour if the mix starts to curdle.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
      "ingredients_used": [
        "5fd0b0f3-c116-5759-9b89-d82604e38ff4",
        "c3358a62-12d1-52e2-bfe5-34c73a9484e4"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Sieve in the flour, baking powder and cocoa and fold in with a metal spoon. Stir in the milk. Scrape mix into the tin and level the top. Bake for 18-20 mins or until the cake springs back when pressed. Allow to cool in the tin.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "e77901ed-3e7f-5aa5-9be6-955484222140",
        "2afdcb74-9587-523b-b9de-8a2e2f8903d2"
      ]
    },
    {
      "step_number": 3,
      "instruction": "To make the icing, put the chocolate, butter and 4 tbsp water in a pan and gently heat until melted. Allow to cool slightly, then beat in the icing sugar.",
      "ingredients_used": [
        "5fd0b0f3-c116-5759-9b89-d82604e38ff4",
        "cab38a9d-c9f9-5be6-8087-b314cce3ee2f",
        "c3358a62-12d1-52e2-bfe5-34c73a9484e4",
        "78ab61bc-1335-5e04-ad91-3d69c7d74a6e"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Remove cake from tin and peel away paper. Cut into 16 squares. Dip the squares into the icing, then roll in the coconut. Allow to set on cooling rack.",
      "ingredients_used": [
        "5a50ec6f-468e-520b-b10f-77ac5f2e4704"
      ]
    }
  ],
