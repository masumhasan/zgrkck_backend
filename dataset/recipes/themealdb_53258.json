  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat a griddle pan. Rub the lamb steaks with the oil, cumin and some seasoning. Griddle for about 3-4 mins on each side or until cooked to your liking. Place to one side on a plate to rest.",
      "timer_seconds": 240,
      "ingredients_used": [
        "8991e16d-9533-5a74-adfb-2a49243cce8e"
      ]
    },
    {
      "step_number": 2,
      "instruction": "In a large bowl, stir the sugar into the vinegar until dissolved. Add the carrots, spring onions, cabbage and some seasoning, and toss together.",
      "ingredients_used": [
        "fc307f9a-8691-56c4-ba43-820ea3621aad",
        "61b2e970-0e0e-584b-8f2b-f9c178c2fcc2",
        "faada69b-d34d-5044-bf5b-2ad953f99fcd",
        "d128fa02-c5f8-5804-b175-58db688d13f7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Blitz the whole peppers and the mayo in a food processor. Add a heap of the salad to each flatbread. Slice the lamb, trimming off any excess fat and lay on top of the salad, drizzling with the resting juices. Spoon over the mayo and scatter with a few of the sliced peppers. Roll up and eat. If using pitta, split and stuff. Serve any extra salad on the side.",
      "ingredients_used": [
        "f761f45e-7cae-57a5-84bf-77c9d3a59241"
      ]
    }
  ],
