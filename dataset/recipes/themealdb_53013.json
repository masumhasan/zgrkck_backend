  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "For the Big Mac sauce, combine all the ingredients in a bowl, season with salt and chill until ready to use.",
      "ingredients_used": [
        "973792b0-ca08-5861-a032-0810f301b3d6"
      ]
    },
    {
      "step_number": 2,
      "instruction": "To make the patties, season the mince with salt and pepper and form into 4 balls using about 1/3 cup mince each. Place each onto a square of baking paper and flatten to form into four x 15cm circles. Heat oil in a large frypan over high heat. In 2 batches, cook beef patties for 1-2 minutes each side until lightly charred and cooked through. Remove from heat and keep warm. Repeat with remaining two patties.",
      "timer_seconds": 120,
      "ingredients_used": [
        "10344f55-44fd-5497-b1a5-fd16757735a7",
        "79ea7a8a-f048-5b81-a91f-30945413a8ba",
        "973792b0-ca08-5861-a032-0810f301b3d6"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Carefully slice each burger bun into three acrossways, then lightly toast."
    },
    {
      "step_number": 4,
      "instruction": "To assemble the burgers, spread a little Big Mac sauce over the bottom base. Top with some chopped onion, shredded lettuce, slice of cheese, beef patty and some pickle slices. Top with the middle bun layer, and spread with more Big Mac sauce, onion, lettuce, pickles, beef patty and then finish with more sauce. Top with burger lid to serve.",
      "ingredients_used": [
        "10344f55-44fd-5497-b1a5-fd16757735a7",
        "ae8085e6-ad12-5b7b-9b09-37b30f72fed9",
        "4096bf5f-4ba1-5672-b861-c42ff5e51690",
        "213a1e90-1f6a-5e29-ba09-b1f3e933667d",
        "9770814c-149f-5bc8-aa48-00ac9a63d381"
      ]
    },
    {
      "step_number": 5,
      "instruction": "After waiting half an hour for your food to settle, go for a jog."
    }
  ],
