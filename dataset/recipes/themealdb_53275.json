  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 200C/180C fan/gas 6. Toss the sweet potato chunks with the olive oil and some seasoning, and spread on a baking parchment-lined baking sheet. Roast for 30 - 35 mins until tender and golden. Cool at room temperature.",
      "timer_seconds": 2100,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      },
