  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Slice the onion and shallots thinly. Let them soak in a ice water bath while preparing the rest of the meal.",
      "ingredients_used": [
        "f411ea93-8de9-55f6-be94-1a0f51cac499",
        "de75721e-5859-5010-965c-447061122085"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Grate the coconut. Put in a large bowl.",
      "ingredients_used": [
        "39dbb959-f4c3-57e7-aa42-ac2523cd0c7a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the coconut in a large bowl. Add the rice. Using your hands, mix the coconut and rice together.",
      "ingredients_used": [
        "aff5c5c0-513c-5f23-b284-79f5594ee3db",
        "39dbb959-f4c3-57e7-aa42-ac2523cd0c7a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Roll the mixture to form 2-inch rice ball croquettes.",
      "ingredients_used": [
        "aff5c5c0-513c-5f23-b284-79f5594ee3db"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Heat up the cooking oil in a pot or pan.",
      "ingredients_used": [
        "4174622b-97f1-5ade-9c93-ae3d468c549d"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Beat two eggs and a large bowl. Dip the balls into the egg mixture. Then, drop the balls into the cooking oil.",
      "ingredients_used": [
        "4174622b-97f1-5ade-9c93-ae3d468c549d"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Allow the balls to turn a dark amber brown color. Deep fry until crispy, crunchy, and golden. Remove and set on paper towel to drain excess oil.",
      "ingredients_used": [
        "4174622b-97f1-5ade-9c93-ae3d468c549d"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Once cooled, break apart the rice balls and add into a larger bowl.",
      "ingredients_used": [
        "aff5c5c0-513c-5f23-b284-79f5594ee3db"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Drain the onion and the shallots.",
      "ingredients_used": [
        "f411ea93-8de9-55f6-be94-1a0f51cac499",
        "de75721e-5859-5010-965c-447061122085"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Make sure you tear the pork sausage up into small pieces. You can use a knife too, but the traditional method is tearing.",
      "ingredients_used": [
        "5891b8bd-68d7-5f2e-bf5d-84845eda618e"
      ]
    },
    {
      "step_number": 11,
      "instruction": "In the large bowl, add in the onion, shallots, sour pork sausage, pickled garlic, lime juice, fish sauce, sugar, cilantro, hot mint, regular mint.",
      "ingredients_used": [
        "5891b8bd-68d7-5f2e-bf5d-84845eda618e",
        "b62dcd30-c7ba-5dc3-b080-cf65cbc6a9f4",
        "61602368-a45b-54d0-b52d-f0e6572d34fa",
        "c4267fec-c1df-5d81-86d2-cd7b3495ad2a",
        "f411ea93-8de9-55f6-be94-1a0f51cac499",
        "de75721e-5859-5010-965c-447061122085",
        "de12d023-4caf-571e-b456-9a75c9c1b64c",
        "0fa47784-09f3-582f-aa34-1c9ec0bfd245",
        "6bfcaae8-84a2-5535-be49-f9cf7099d76e"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Top with peanuts. Serve with Lettuce, dry chilli, and other fresh vegetables.",
      "ingredients_used": [
        "52ca6446-c8f4-5fd7-959a-51a5f64ea917",
        "8a0b46f5-7171-5e8f-a4f0-b352cb4b55df",
        "38094592-e40b-5624-89dd-0c660f385ca1"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Preserving Naem Khao Recipe"
    },
    {
      "step_number": 14,
      "instruction": "Naem Khao can be kept in the refrigerator for 4 days. It can then be served chilled."
    },
    {
      "step_number": 15,
      "instruction": "It should not be frozen."
    },
    {
      "step_number": 16,
      "instruction": "Serving Naem Khao"
    },
    {
      "step_number": 17,
      "instruction": "Nam Khao is generally served with lettuce leaves and a variety of different herbs like hot mint, mint, basil, and perilla.",
      "ingredients_used": [
        "0fa47784-09f3-582f-aa34-1c9ec0bfd245",
        "6bfcaae8-84a2-5535-be49-f9cf7099d76e",
        "38094592-e40b-5624-89dd-0c660f385ca1"
      ]
    }
  ],
