  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cooking"
    },
    {
      "step_number": 2,
      "instruction": "Add some olive oil to a saute pan or saucepan (one with a lid). One heated add in the onions, diced beef, red peppers and fry for 5 minutes stirring occasionally. The meat should be fully browned.",
      "timer_seconds": 300,
      "ingredients_used": [
        "da0c1467-48a8-51c8-a61e-61ebccf9c0ff",
        "95bc8933-c953-5afc-aff8-960b340e001a",
        "8e680217-4aeb-5e54-a168-7a6ed76b0eec"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the paprika, tomato puree, chilli flakes and season with salt and pepper. Mix together and continue to fry for 2 minutes.",
      "timer_seconds": 120,
      "ingredients_used": [
        "7fa0ed68-c8a4-5b16-b7af-62ac56f84f11",
        "a47c0eaf-56cd-5943-a8da-68f4cd67e529",
        "9a7e2ae2-3480-529d-93f7-d8105cba77d9",
        "3339f915-a71a-5932-9286-825194f63b8c",
        "72e3a367-9b50-504f-9f03-f08156d1277d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the cabbage and stir the mixture together. Fry the mixture while stirring occasionally for 3-5 minutes. Most of the oil should have burned away.",
      "timer_seconds": 300,
      "ingredients_used": [
        "31ead592-7f35-57f6-ba05-8fb605d94e1e"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour the boiling water into the pan, ensuring that the water level completely covers the cabbage, plus about 1 inch above it. Put on the lid and bring to the boil.",
      "ingredients_used": [
        "31ead592-7f35-57f6-ba05-8fb605d94e1e",
        "0dd9c826-bfb5-5f2a-bd7d-69b6ed3e5b16"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Leave to simmer for 2.5 hours. The stew is ready when the cabbage is soft and meat tender.",
      "timer_seconds": 9000,
      "ingredients_used": [
        "31ead592-7f35-57f6-ba05-8fb605d94e1e"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Serving"
    },
    {
      "step_number": 8,
      "instruction": "Serve into wide bowls and leave to cool for 5 minutes.",
      "timer_seconds": 300
    }
  ],
