  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "To make the dough, rub the butter into the flour and then add the egg white and half the yolk (keep the rest), vinegar, a pinch of salt and enough cold water to make a soft dough. Knead on a floured surface until smooth and then wrap and rest for 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "8d3b7ad8-cb3e-5bf5-82aa-4cf0ee9c7f0f",
        "df2f3766-69d4-5f7a-aae2-9b2205c3cf4d"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat the oven to 180c/fan 160c/gas 4. Trim the green ends of the spring onions and then finely slice the rest. Heat a little oil in a pan and fry them gently until soft but not browned. Add the chilli and garlic, stir and then add the prawns and cook until they are opaque. Season well. Scoop out the prawns and bubble the juices until they thicken, then add back the prawns.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      },
      "ingredients_used": [
        "dc10cf54-6298-579e-817c-80420dba1982",
        "276ec4ee-adb2-5f98-96e0-8447d81819eb",
        "c57f9029-1760-5a0a-a456-6e6eb8f5a38d",
        "007b1f05-61dd-5719-a53b-12be4cf9a924"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Divide the empanada dough into eight balls and roll out to thin circles on a floured surface. Put some filling on one half of the dough, sprinkle the feta on top and fold the other half over. Trim the edge and then fold and crimp the dough together so the empanada is tightly sealed, put it on an oiled baking sheet either on its side or sitting on its un-crimped edge like a cornish pasty. Repeat with the remaining dough and mixture. Mix the leftover egg yolk with a splash of water and brush the top of the empanadas.",
      "ingredients_used": [
        "0f7a3ab9-2b25-5e92-8e63-43b2778795d7",
        "df2f3766-69d4-5f7a-aae2-9b2205c3cf4d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Bake for 30 minutes or until golden and slightly crisp around the edges.",
      "timer_seconds": 1800
    }
  ],
