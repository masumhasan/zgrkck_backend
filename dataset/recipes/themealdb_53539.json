      ]
    },
    {
      "step_number": 3,
      "instruction": "Add to the pot, the shredded meat, green beans, thyme, salt and pepper, and mix well. Add the water, cover and cook for 15 minutes, uncover and cook for 5 more minutes or until the green beans are soft.",
