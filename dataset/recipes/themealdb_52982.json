  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put a large saucepan of water on to boil."
    },
    {
      "step_number": 2,
      "instruction": "Finely chop the 100g pancetta, having first removed any rind. Finely grate 50g pecorino cheese and 50g parmesan and mix them together.",
      "ingredients_used": [
        "eb7cd975-ebeb-5769-8dd3-2b194702f4dd"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Beat the 3 large eggs in a medium bowl and season with a little freshly grated black pepper. Set everything aside.",
      "ingredients_used": [
        "b5d68a91-8bfc-5414-ab10-e0b21b1d79f2"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add 1 tsp salt to the boiling water, add 350g spaghetti and when the water comes back to the boil, cook at a constant simmer, covered, for 10 minutes or until al dente (just cooked).",
      "timer_seconds": 600,
      "ingredients_used": [
        "a50aeabd-56c2-540f-9149-d54fdefa3882",
        "84182697-a47f-588d-9db6-caba3d7f23fd"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Squash 2 peeled plump garlic cloves with the blade of a knife, just to bruise it."
    },
    {
      "step_number": 6,
      "instruction": "While the spaghetti is cooking, fry the pancetta with the garlic. Drop 50g unsalted butter into a large frying pan or wok and, as soon as the butter has melted, tip in the pancetta and garlic.",
      "ingredients_used": [
        "a50aeabd-56c2-540f-9149-d54fdefa3882"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Leave to cook on a medium heat for about 5 minutes, stirring often, until the pancetta is golden and crisp. The garlic has now imparted its flavor, so take it out with a slotted spoon and discard.",
      "timer_seconds": 300
    },
    {
      "step_number": 8,
      "instruction": "Keep the heat under the pancetta on low. When the pasta is ready, lift it from the water with a pasta fork or tongs and put it in the frying pan with the pancetta. Don’t worry if a little water drops in the pan as well (you want this to happen) and don’t throw the pasta water away yet."
    },
    {
      "step_number": 9,
      "instruction": "Mix most of the cheese in with the eggs, keeping a small handful back for sprinkling over later."
    },
    {
      "step_number": 10,
      "instruction": "Take the pan of spaghetti and pancetta off the heat. Now quickly pour in the eggs and cheese. Using the tongs or a long fork, lift up the spaghetti so it mixes easily with the egg mixture, which thickens but doesn’t scramble, and everything is coated.",
      "ingredients_used": [
        "a50aeabd-56c2-540f-9149-d54fdefa3882"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Add extra pasta cooking water to keep it saucy (several tablespoons should do it). You don’t want it wet, just moist. Season with a little salt, if needed.",
      "ingredients_used": [
        "84182697-a47f-588d-9db6-caba3d7f23fd"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Use a long-pronged fork to twist the pasta on to the serving plate or bowl. Serve immediately with a little sprinkling of the remaining cheese and a grating of black pepper. If the dish does get a little dry before serving, splash in some more hot pasta water and the glossy sauciness will be revived.",
      "ingredients_used": [
        "b5d68a91-8bfc-5414-ab10-e0b21b1d79f2"
      ]
    }
  ],
