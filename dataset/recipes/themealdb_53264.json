  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "You need 15 skewers: if wooden, soak in water for 10 mins. Cut chicken into 3cm pieces and place in a bowl. Add 1 tbsp olive oil, the spices, garlic and vinegar, toss well and season. You can do this up to a day before and refrigerate.",
      "timer_seconds": 600,
      "ingredients_used": [
        "20d7d7ee-e825-5f0d-a752-5f6f1716bfec",
        "073ceff9-c040-5903-b767-626d7dcab5c0"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Thread 2-3 pieces on each skewer. Pour remaining oil in a frying pan or rub onto a griddle pan. Get the pan hot and sear the chicken for 3-4 mins on each side – you may have to do this in batches, keeping the cooked skewers warm in a low oven. Serve with smoky aïoli if you like.",
      "timer_seconds": 240,
      "ingredients_used": [
        "440e19ba-272c-51cc-88a3-0deae7ecd30d"
      ]
    }
  ],
