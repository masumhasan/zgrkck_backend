  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Line the bottom of a springform of 20-2cm (8-9inches) with parchment paper, I usually leave some overhang as the batter is very liquid and may spill a bit. Preheat oven to 220 degrees Celsius.",
      "temperature": {
        "value": 220,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Grate the cheese and take out the ham.",
      "ingredients_used": [
        "9246d093-ecf0-594d-95a3-f0c3ef131c44"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Mix all remaining ingredients in a large bowl for about one to two minutes."
    },
    {
      "step_number": 4,
      "instruction": "Pour half the batter into the prepared pan, it is going to be very liquid. Then place ham and cheese on top and pour the remaining batter on top.",
      "ingredients_used": [
        "9246d093-ecf0-594d-95a3-f0c3ef131c44"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Bake for about 20-25 minutes or until top is golden. Wait for a few minutes before releasing from the pan and enjoy either hot or cold with some fresh herbs.",
      "timer_seconds": 1500
    }
  ],
