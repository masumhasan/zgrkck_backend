  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the butter in a casserole dish until sizzling, then fry the pork for 2-3 mins on each side until browned. Remove from the pan.",
      "timer_seconds": 180,
      "ingredients_used": [
        "cc377b6f-79f4-583e-a978-2567597a34c1"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Tip the bacon, carrot, potatoes and swede into the pan, then gently fry until slightly colored. Stir in the cabbage, sit the chops back on top, add the bay leaf, then pour over the cider and stock. Cover the pan, then leave everything to gently simmer for 20 mins until the pork is cooked through and the vegetables are tender.",
      "timer_seconds": 1200,
      "ingredients_used": [
