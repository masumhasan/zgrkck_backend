  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 180 degrees celcius."
    },
    {
      "step_number": 2,
      "instruction": "Boil vegetables for 5-7 minutes, until soft. Add lentils and bring to a gentle simmer, adding a stock cube if desired. Continue cooking and stirring until the lentils are soft, which should take about 20 minutes.",
      "ingredients_used": [
        "b5f0ef9c-1084-52ff-847f-722a6c25cb3d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Blanch spinach leaves for a few minutes in a pan, before removing and setting aside.",
      "ingredients_used": [
        "658b4f4c-9f1e-5ea5-95dd-ae21e7baea21"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Top up the pan with water and cook the lasagne sheets. When cooked, drain and set aside.",
      "ingredients_used": [
        "c600b241-dd33-5c63-af69-2434a0d9d9bc"
      ]
    },
    {
      "step_number": 5,
      "instruction": "To make the sauce, melt the butter and add the flour, then gradually add the soya milk along with the mustard and the vinegar. Cook and stir until smooth and then assemble the lasagne as desired in a baking dish.",
      "ingredients_used": [
        "09cfdb6e-bdf3-5488-a4cb-47b70f4f12c3",
        "702550e1-889c-5ba8-ad21-24e522966612",
        "47d6d224-105a-514f-aecc-d04ef6644151",
        "c0f332ad-f8a8-52da-ab7b-ccafe858e968",
        "39a62720-1faa-5e1c-a0ba-72cefd58e64d"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Bake in the preheated oven for about 25 minutes.",
      "timer_seconds": 1500
    }
