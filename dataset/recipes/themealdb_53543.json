  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 325ºF.",
      "temperature": {
        "value": 325,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "Place cookies in bowl of food processor. Pulse 30 seconds, or until finely ground. (Or, crush them by hand by placing cookies in zip-top bag and using the bottom of a heavy skillet, pound cookies until finely crushed); transfer cookie crumbs to bowl.",
      "timer_seconds": 30,
      "ingredients_used": [
        "767091d7-e67f-5f73-bd25-95a62a8222a1"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add softened butter, stirring until combined.",
      "ingredients_used": [
        "ea52d67b-554e-5a7f-a8b4-4e523812bd58"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Transfer cookie mixture to 9” spring form pan. Using your fingers, press cookie crumbs evenly onto bottom and sides of pan. Bake until firm and fragrant, about 10 minutes.",
      "timer_seconds": 600
    },
    {
      "step_number": 5,
      "instruction": "Allow to cool."
    },
    {
      "step_number": 6,
      "instruction": "Set electric mixer on medium speed, beat cream cheese until fluffy, about 3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "23eabcda-1069-56d6-8dd3-05a8421cfdc5",
        "85d199db-b597-53f9-bcad-9f77d238ab12"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add condensed milk; beat until smooth, 1 minute.",
      "timer_seconds": 60,
      "ingredients_used": [
        "c1108a04-f85f-5d0a-af62-cad7eaecfb02"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Beat in eggs, vanilla and 3 tbsp. dulce de leche (caramel) until combined, 3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "3cd0a1c3-16eb-5641-9257-11ce78917b2f",
        "30cc29f1-d5fc-59fe-a881-0702a358060d"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Pour filling into prepared crust. Bake until golden brown and set, but still a little wiggly in the middle, 45 – 55 minutes.",
      "timer_seconds": 3300
    },
    {
      "step_number": 10,
      "instruction": "Turn off oven; partially open oven door."
    },
    {
      "step_number": 11,
      "instruction": "Let cheesecake sit in oven until it come to room temperature, about 1 hour.",
      "timer_seconds": 3600
    },
    {
      "step_number": 12,
      "instruction": "Transfer cheesecake to refrigerator; cool completely, at least 4 hours.",
      "timer_seconds": 14400
    },
    {
      "step_number": 13,
      "instruction": "Remove cooled cheesecake from sprigform pan."
    },
    {
      "step_number": 14,
      "instruction": "Place remaining dulce de leche in ziplock bag.",
      "ingredients_used": [
        "30cc29f1-d5fc-59fe-a881-0702a358060d"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Using scissors, snip small hole in corner of bag. Applying even pressure on “pastry bag,” paint stripes on your finished cheesecake."
    }
  ],
