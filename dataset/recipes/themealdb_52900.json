  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Pre-heat the oven to 180C/350F/Gas 4. Grease an 18cm/7in round cake tin, line the base with greaseproof paper and grease the paper.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Cream the butter and sugar together in a bowl until pale and fluffy. Beat in the eggs, one at a time, beating the mixture well between each one and adding a tablespoon of the flour with the last egg to prevent the mixture curdling.",
      "ingredients_used": [
        "b66dccee-5bac-5737-be9c-3052701c0fbd",
        "5efc2bb6-6589-50c2-815a-dcd19e596bfc"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Sift the flour and gently fold in, with enough milk to give a mixture that falls slowly from the spoon. Fold in the lemon zest.",
      "ingredients_used": [
        "a20f476c-2c49-5b7b-9329-d8350c2a05d5",
        "349d0ac1-b95a-5e2b-9ce6-4d7dda81810b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Spoon the mixture into the prepared tin and lightly level the top. Bake on the middle shelf of the oven for 30-40 minutes, or until golden-brown on top and a skewer inserted into the center comes out clean.",
      "timer_seconds": 2400
    },
    {
      "step_number": 5,
      "instruction": "Remove from the oven and set aside to cool in the tin for 10 minutes, then turn it out on to a wire rack and leave to cool completely.",
      "timer_seconds": 600
    },
    {
      "step_number": 6,
      "instruction": "To serve, decorate the cake with the candied peel.",
      "ingredients_used": [
        "8bff4abd-f30d-5e4b-9840-049526267181"
      ]
    }
  ],
