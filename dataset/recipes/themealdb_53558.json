  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel and wash plantains",
      "ingredients_used": [
        "1098d4fe-5088-5adb-bd6c-eb35abf89603"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Pat them dry"
    },
    {
      "step_number": 3,
      "instruction": "Cut them into one and a half inch slices"
    },
    {
      "step_number": 4,
      "instruction": "Heat oil to deep fry plantains",
      "ingredients_used": [
        "1098d4fe-5088-5adb-bd6c-eb35abf89603"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Toss in plantains into hot oil so they are submerged",
      "ingredients_used": [
        "1098d4fe-5088-5adb-bd6c-eb35abf89603"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Fry them for about 7 minutes",
      "timer_seconds": 420
    },
    {
      "step_number": 7,
      "instruction": "Place them on paper towel for about five minutes. You don't want them to be too dry"
    },
    {
      "step_number": 8,
      "instruction": "Using your citrus squeezer, press the plantain slices into cups",
      "ingredients_used": [
        "1098d4fe-5088-5adb-bd6c-eb35abf89603"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Place on paper towel or tray"
    },
    {
      "step_number": 10,
      "instruction": "Then place cups in the deep fryer or sauce pan with enough oil to submerge them"
    },
    {
      "step_number": 11,
      "instruction": "Remove when golden brown"
    },
    {
      "step_number": 12,
      "instruction": "Stuff with your favorite filling"
    },
    {
      "step_number": 13,
      "instruction": "Enjoy!"
    }
