        "03df5652-5cfe-5272-b5ff-19fd6ab0719a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Steps for Ugali:"
    },
    {
      "step_number": 4,
      "instruction": "Bring the water and salt to a boil in a heavy-bottomed saucepan. Stir in the cornmeal slowly, letting it fall through the fingers of your hand.",
      "ingredients_used": [
        "03df5652-5cfe-5272-b5ff-19fd6ab0719a"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Reduce heat to medium-low and continue stirring regularly, smashing any lumps with a spoon, until the mush pulls away from the sides of the pot and becomes very thick, about 10 minutes.",
      "timer_seconds": 600
    },
    {
      "step_number": 6,
      "instruction": "4.Remove from heat and allow to cool."
    },
    {
      "step_number": 7,
      "instruction": "Place the ugali into a large serving bowl. Wet your hands with water, form a ball and serve."
    },
    {
      "step_number": 8,
      "instruction": "Steps for Kachumbari: Mix the tomatoes, onions, chili and coriander leaves in a bowl.",
