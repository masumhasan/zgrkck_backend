  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Put a pan of water on over a high heat to boil. Meanwhile, snip the chorizo into strips with scissors, and chop the parsley and peppers (check for stray seeds first).",
      "ingredients_used": [
        "ea439f48-0ba5-5a21-bb81-d1e5307aa68b",
        "31fcfe53-3d82-5817-8877-a4d13b80b13b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "When the water is boiling briskly, add the spaghetti with a good measure of salt, stir and return to the boil. Cook for 3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "26b74d5e-f78b-53a3-9b4a-0094e7c9be01"
      ]
    },
    {
      "step_number": 3,
      "instruction": "In a large frying pan, heat the oil, add the chorizo and peppers and plenty of black pepper. Cook for a minute or so, until heated through and the juices are stained red from the paprika in the chorizo. Scoop half a mugful of pasta water from the pan, drain the remainder and tip the spaghetti into the frying pan.",
      "ingredients_used": [
        "ea439f48-0ba5-5a21-bb81-d1e5307aa68b",
        "26b74d5e-f78b-53a3-9b4a-0094e7c9be01"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the parsley and parmesan, toss well and splash in the pasta water, to moisten. Hand round extra parmesan at the table.",
      "ingredients_used": [
        "31fcfe53-3d82-5817-8877-a4d13b80b13b"
      ]
    }
  ],
