  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oven to 140C/120C fan/gas 1. Put a large ovenproof pan (with a tight-fitting lid) on a high heat. Add your fat and diced meat, cook for a few mins to seal the edges, giving it a quick stir to cook evenly. Reduce the heat to low, add the sliced onion, whole garlic cloves, carrot and fennel seeds, and cook gently to soften the veg for a few mins.",
      "temperature": {
        "value": 140,
        "unit": "celsius"
      },
      "ingredients_used": [
        "7a8a0d89-164c-506c-9081-549897b541a4",
        "10a0aa2b-a541-5039-9a98-ee8dcd2c0bae",
        "68e26eb3-7e47-5b95-aa71-3ee8bb3c0a84"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Pour over the red wine vinegar, scraping any meaty bits off the bottom of the pan. Add the stock, tomato purée, and half the rosemary and parsley. Bring to the boil and simmer for 10 mins, then season, cover with a lid and put into the oven for 2 hrs, removing the lid for the final hour of cooking. Stir occasionally and add the beans with 30 mins to go.",
      "ingredients_used": [
        "4fbb5844-c875-58cf-9b02-890c16e40edf",
        "f37d6d13-3100-5572-b78b-3eeab13843dd",
        "a5bec1ab-03fc-58b5-9fd9-f8c61e139d50",
        "7702949f-e113-532c-940e-46f064c91910"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Remove the pan from the oven and heat the grill. Scatter the top with the remaining herbs and breadcrumbs, drizzle a little oil over the top, and return to the oven for 5-10 mins, until the breadcrumbs are golden. Serve with crusty bread and green veg.",
      "timer_seconds": 600,
      "ingredients_used": [
        "6a596b9f-f5d0-5904-98bb-c1038acec409",
        "c48ac17f-e431-5d9f-9e73-b9cd32e641ca",
        "08025449-4d2f-5629-bbb5-a94b6ac63c24"
      ]
    }
  ],
