  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place beans in a large pot and cover with cold water. Soak for at least 4 hours or overnight. Drain and rinse, before you use in the soup.",
      "timer_seconds": 14400,
      "ingredients_used": [
        "bec40548-68e4-58a4-9500-a2948ecdd782",
        "3112a1ed-9a81-526d-9b4d-9632cb4203e4"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Chop one of the onions and leave the other one whole. Chop carrots.",
      "ingredients_used": [
        "8295016b-5c80-57e2-88d1-ca066096b62c",
        "7276de70-ad4a-5052-aac0-4cbb384f6990"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat oil on a large pot over medium heat. Add the onion and carrots. Cook for 2 minutes. Add beans, water, peppers, head of onion, salt, pepper, summer savory, mint, thyme, Vegeta and tomato puree. Stir, bring to a boil, then reduce to a simmer and cook for 2 hours, or until the beans are tender.",
      "ingredients_used": [
        "bec40548-68e4-58a4-9500-a2948ecdd782",
        "260d8aaf-1543-57f8-aa95-efe3ce142c3a",
        "7276de70-ad4a-5052-aac0-4cbb384f6990",
        "3112a1ed-9a81-526d-9b4d-9632cb4203e4",
        "daa23fc7-39b0-5e79-b7c4-64e9719ad106",
        "fb531134-6b3b-51ec-812f-76a3bb8c58b5",
        "36417dfe-5e94-57f8-bbd5-46a101479391"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Remove the peppers and whole onion. Mash the onion. Peel peppers and chop. Return to the pot."
    },
    {
      "step_number": 5,
      "instruction": "Add more salt and pepper, if needed. Garnish with chopped parsley. Serve.",
      "ingredients_used": [
        "36417dfe-5e94-57f8-bbd5-46a101479391",
        "651e1a5b-7ac4-5b81-b38a-084b0c8d2d59"
      ]
    }
  ],
