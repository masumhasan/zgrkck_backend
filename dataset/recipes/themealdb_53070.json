  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat oil in a cooking pot. Saute onion and garlic until onion softens",
      "ingredients_used": [
        "3559c7e9-1f96-5009-aa72-96aabce897a4",
        "1f78af2c-1b79-59b1-8b1b-f4ad45905bd1"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Add beef. Saute until the outer part turns light brown.",
      "ingredients_used": [
        "f6bb38bd-1e0d-5a75-a623-c90f82c0a71c"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add soy sauce. Pour tomato sauce and water. Let boil.",
      "ingredients_used": [
        "8aa3bc3f-16e9-5d52-a64a-2ee1382e0a40",
        "8283a543-e71e-5dfb-8061-3d26700eea1b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add Knorr Beef Cube. Cover the pressure cooker. Cook for 30 minutes.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "f6bb38bd-1e0d-5a75-a623-c90f82c0a71c"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pan-fry carrot and potato until it browns. Set aside."
    },
    {
      "step_number": 6,
      "instruction": "Add chili pepper, liver spread and peanut butter. Stir.",
      "ingredients_used": [
        "18072af5-7c7d-5d21-87b6-c4ef44f415c2"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add bell peppers, fried potato and carrot. Cover the pot. Continue cooking for 5 to 7 minutes.",
      "timer_seconds": 420
    },
    {
      "step_number": 8,
      "instruction": "Season with salt and ground black pepper. Serve."
    }
  ],
