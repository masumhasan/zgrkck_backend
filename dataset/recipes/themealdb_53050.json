  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a blender, add the ingredients for the spice paste and blend until smooth."
    },
    {
      "step_number": 2,
      "instruction": "Over medium heat, pour the spice paste in a skillet or pan and fry for 10 minutes until fragrant. Add water or oil 1 tablespoon at a time if the paste becomes too dry. Don't burn the paste. Lower the fire slightly if needed.",
      "timer_seconds": 600,
      "ingredients_used": [
        "e330efaa-6ed5-53ca-aa23-512cbb53c37f"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the cloves, cardamom, tamarind pulp, coconut milk, water, sugar and salt. Turn the heat up and bring the mixture to boil. Turn the heat to medium low and simmer for 10 minutes. Stir occasionally. It will reduce slightly. This is the marinade/sauce, so taste and adjust seasoning if necessary. Don't worry if it's slightly bitter. It will go away when roasting.",
      "timer_seconds": 600,
      "ingredients_used": [
        "0245525c-99e9-53b0-88ba-ca2404873b7a",
        "59908892-bdd8-54a6-80e7-72fe40f22d04",
        "d50bb8ce-ef49-578e-9333-92f4b816c1b1",
        "e330efaa-6ed5-53ca-aa23-512cbb53c37f"
      ]
    },
    {
      "step_number": 4,
      "instruction": "When the marinade/sauce has cooled, pour everything over the chicken and marinate overnight to two days."
    },
    {
      "step_number": 5,
      "instruction": "Preheat the oven to 425 F.",
      "temperature": {
        "value": 425,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 6,
      "instruction": "Remove the chicken from the marinade. Spoon the marinade onto a greased (or aluminum lined) baking sheet. Lay the chicken on top of the sauce (make sure the chicken covers the sauce and the sauce isn't exposed or it'll burn) and spread the remaining marinade on the chicken. Roast for 35-45 minutes or until internal temp of the thickest part of chicken is at least 175 F.",
      "timer_seconds": 2700,
      "temperature": {
        "value": 175,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 7,
      "instruction": "Let chicken rest for 5 minutes. Brush the chicken with some of the oil. Serve chicken with the sauce over steamed rice (or coconut rice).",
      "timer_seconds": 300
    }
  ],
