  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Combine rye grain and water in a saucepan and bring to a boil. Cover and simmer for 2 to 3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "f21fa13e-f4e3-5a9c-8f7b-d4f18c62ba47",
        "9d5654c4-1d1e-53e1-a222-f8b46fd592f1"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Transfer the boiled rye grain to a mixing bowl and combine with beer, buttermilk and salt.",
      "ingredients_used": [
        "f21fa13e-f4e3-5a9c-8f7b-d4f18c62ba47",
        "75a18dd6-ee55-586e-b3d8-2f9a4ce758fb",
        "daee672a-2ace-56fa-8ec9-d963439597e8",
        "b464f2e5-750c-5744-b7a2-8e9ee78a3441"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Dissolve the fresh yeast in this mixture and then add the seeds.",
      "ingredients_used": [
        "175d8a6a-e44e-5f16-84fe-367757c301f3",
        "0c288ac7-6fcf-5da1-8302-ce8ce23226ca"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add all-purpose flour and rye flour, and knead for about 10 minutes. You can also use a kitchen mixer to knead the dough.",
      "timer_seconds": 600,
      "ingredients_used": [
        "5bd6fc41-4bd9-5e93-848a-ddc00e3a4e71"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Transfer the dough to an oiled loaf pan (2.5 l) and smooth out with a spatula."
    },
    {
      "step_number": 6,
      "instruction": "Poke holes in the surface with a fork and cover loaf pan with plastic wrap. Let the dough rise for 1½ hours at room temperature, or for 24 hours in the refrigerator.",
      "timer_seconds": 86400
    },
    {
      "step_number": 7,
      "instruction": "Pre-heat oven to 200°C / 392℉ (175°C / 347℉ on fan setting) and bake bread on the bottom rack for about 75 minutes. Test to make sure dry in center, or if using an oven thermometer, set it to turn off when center reaches 98°C / 208℉",
      "timer_seconds": 4500,
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 8,
      "instruction": "Allow the bread to cool completely before slicing."
    },
    {
      "step_number": 9,
      "instruction": "TIP"
    },
    {
      "step_number": 10,
      "instruction": "If you refrigerate the dough while rising, let it stand at room temperature for 1 hour before baking.",
      "timer_seconds": 3600
    }
  ],
