  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cut the fish fillets in cubes or strips. Crush or chop the garlic. Rinse the vegetables and cut into thin strips.",
      "ingredients_used": [
        "cc32e75a-9efa-5a71-bdd8-95525a1cca6f",
        "d1be3c03-102f-5cfd-8c0e-2e94ada6dca6"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat the butter in a pot and add the garlic. Once the garlic starts to turn golden add the flour, whisking well.",
      "ingredients_used": [
        "d1be3c03-102f-5cfd-8c0e-2e94ada6dca6",
        "9c3410fa-fc71-5b02-a5bf-2e2010acfee6",
        "17cddc66-4bd6-58a9-b886-3904ee4507c8"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the fish stock and continue to whisk until there are no lumps.",
      "ingredients_used": [
        "b4129180-d046-5b10-a188-034e73b08928"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the vegetables and milk and bring to a boil. Cook for about 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "ae6651de-693e-596a-91fc-8b78b51539c2"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the crème fraîche (or sour cream). Bring the soup back to a simmer and once the soup begins to bubble again turn off the heat. Keep the soup on the burner and add the fish. Let the fish cook in the hot soup for 5 minutes. If using shrimp, add right before serving.",
      "timer_seconds": 300,
      "ingredients_used": [
        "e25d4855-ee09-50ba-bc1e-7cd7ea23b694"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Sprinkle with chives (or dill or parsley) before serving.",
      "ingredients_used": [
        "b156149a-806f-5502-9c51-bdd5415a62e2"
      ]
    }
  ],
