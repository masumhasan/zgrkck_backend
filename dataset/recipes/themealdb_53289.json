  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place freekeh in a small bowl and cover with cold water. Set aside.",
      "ingredients_used": [
        "bfee2dbd-2728-50c3-adae-ef45dc0e8b86",
        "388c9d32-ce70-596b-b2c4-873c28dfb683"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Combine lamb, onion, black pepper, paprika, cinnamon, and salt in a pot. Stir in oil, 1/2 the cilantro, 1/2 the mint, and celery stalk until combined. Simmer over low heat for 15 minutes. Stir in chickpeas; pour in just enough water to cover, and return to a simmer. Stir in zucchini, carrot, and tomato paste.",
      "timer_seconds": 900,
      "ingredients_used": [
        "852ce078-b54d-5ba6-ac69-02e592b8e1c7",
        "516c8586-6b23-509a-9885-40d723c05c7d",
        "10a0da59-e0d2-50ef-b160-3068bf026771",
        "e2865d72-7787-5111-b292-c1f41aa64933",
        "25b6cbbb-ea88-575a-ac7e-bb29e56fd881",
        "d576ae91-f793-5800-910d-375134b4b7ba",
        "35aca4b5-a70e-5270-b0c1-02832582ee06",
        "d2c313aa-7a55-5f30-a9df-989d57fff43e",
        "39c014ef-316c-5bd5-948f-00c6ddd1a36b",
        "b0b8890b-c7ea-5e83-9781-2f54ae8d5030",
        "388c9d32-ce70-596b-b2c4-873c28dfb683",
        "4b5aa5b7-2983-556e-93ca-5750fc457acc",
        "045a1ec2-c450-599c-9e75-7dffca54b442"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Set a steamer over the pot; add tomatoes. Cover and steam tomatoes until soft, about 5 minutes. Crush tomatoes using a wooden spoon, so pulp drips into soup. Remove the steamer and discard leftover tomato peels.",
      "timer_seconds": 300,
      "ingredients_used": [
        "045a1ec2-c450-599c-9e75-7dffca54b442"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add potato to soup and just enough water to cover. Simmer until potato is soft, about 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "388c9d32-ce70-596b-b2c4-873c28dfb683"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Drain freekeh and add to soup. Simmer until soft, about 15 minutes. Remove celery stalk and discard. Sprinkle soup with remaining 1/2 cilantro and remaining 1/2 mint before serving.",
      "timer_seconds": 900,
      "ingredients_used": [
        "bfee2dbd-2728-50c3-adae-ef45dc0e8b86",
        "35aca4b5-a70e-5270-b0c1-02832582ee06",
