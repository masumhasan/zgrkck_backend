  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Sift the flour and salt into a large bowl. Make a well in the middle and add the yeast.",
      "ingredients_used": [
        "26504baa-5235-52c1-9832-e5d99483299a",
        "8253b58a-4820-5bf7-8136-a00da57cd31a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Meanwhile, warm the milk and butter in a saucepan until the butter melts and the mixture is lukewarm.",
      "ingredients_used": [
        "4dada9b3-b97d-5865-8113-099d1b62e209",
        "3d1d9148-c4b4-5789-8b8c-e651ab38f645",
        "bef7226e-3341-5934-9adf-9e8158a57dbc",
        "c03fd54d-e309-529a-8cee-7d82fc48ed5d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add the milk mixture and egg to the flour mixture and stir until the contents of the bowl come together as a soft dough. (You may need to add a little extra flour.)",
      "ingredients_used": [
        "4dada9b3-b97d-5865-8113-099d1b62e209",
        "c03fd54d-e309-529a-8cee-7d82fc48ed5d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Tip the dough onto a generously floured work surface. Knead for five minutes, adding more flour if necessary, until the dough is smooth and elastic and no longer feels sticky."
    },
    {
      "step_number": 5,
      "instruction": "Lightly oil a bowl with a little of the vegetable oil. Place the dough into the bowl and turn until it is covered in the oil. Cover the bowl with cling film and set aside in a warm place for one hour, or until the dough has doubled in size.",
      "ingredients_used": [
        "01090ca1-95d6-5d08-a457-9647fc44736b"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Lightly grease a baking tray."
    },
    {
      "step_number": 7,
      "instruction": "For the filling, knock the dough back to its original size and turn out onto a lightly floured work surface. Roll the dough out into a rectangle 0.5cm/¼in thick. Brush all over with the melted butter, then sprinkle over the brown sugar, cinnamon and dried fruit.",
      "ingredients_used": [
        "3d1d9148-c4b4-5789-8b8c-e651ab38f645",
        "bef7226e-3341-5934-9adf-9e8158a57dbc",
        "4ee94814-118d-5dd1-ae06-aeb52c4743d2",
        "1fcd32e4-c6a8-52b9-84e9-a7c102123e4c",
        "29f55fa7-de93-51e1-8b70-76994e3f8915"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Roll the dough up into a tight cylinder , cut ten 4cm/1½in slice and place them onto a lightly greased baking sheet, leaving a little space between each slice. Cover with a tea towel and set aside to rise for 30 minutes.",
      "timer_seconds": 1800
    },
    {
      "step_number": 9,
      "instruction": "Preheat oven to 190C/375F/Gas 5.",
      "temperature": {
        "value": 190,
        "unit": "celsius"
      }
    },
    {
      "step_number": 10,
      "instruction": "Bake the buns in the oven for 20-25 minutes, or until risen and golden-brown.",
      "timer_seconds": 1500
    },
    {
      "step_number": 11,
      "instruction": "Meanwhile, for the glaze, heat the milk and sugar in a saucepan until boiling. Reduce the heat and simmer for 2-3 minutes.",
      "timer_seconds": 180,
      "ingredients_used": [
        "4dada9b3-b97d-5865-8113-099d1b62e209",
        "c03fd54d-e309-529a-8cee-7d82fc48ed5d"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Remove the buns from the oven and brush with the glaze, then set aside to cool on a wire rack."
    }
  ],
