  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Gather the ingredients."
    },
    {
      "step_number": 2,
      "instruction": "In a large soup pot, bring water, split peas, pork belly or bacon, pork chop, and bouillon cube to a boil. Reduce the heat to a simmer, cover and let cook for 45 minutes, stirring occasionally and skimming off any foam that rises to the top.",
      "timer_seconds": 2700,
      "ingredients_used": [
        "bfc139d1-44af-507d-9b00-cc5bdd7681cf",
        "1833cb95-b9ab-5ee7-b283-eca91ba99ab2",
        "85365fb2-e3bf-51fd-95c8-8a66de06ce6f",
        "d79e18d4-a1c5-5de3-8e82-21ce27f14c13"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Remove the pork chop, debone, and thinly slice the meat. Set aside.",
      "ingredients_used": [
        "85365fb2-e3bf-51fd-95c8-8a66de06ce6f"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Add the celery, carrots, potato, onion, leek, and celeriac to the soup. Return to the boil, reduce the heat to a simmer and let cook, uncovered, for another 30 minutes, adding a little extra water if the ingredients start to stick to the bottom of the pot.",
      "timer_seconds": 1800,
      "ingredients_used": [
        "bfc139d1-44af-507d-9b00-cc5bdd7681cf",
        "102b6440-cbd5-595b-bfb5-6d82042936a9",
        "78916a69-492e-5a85-b460-bd30f1f5b1ba",
        "32df4fb0-93d4-5e41-8b7a-16a26d99d126",
        "c22b81b6-60ac-52d4-a62f-a783180c2bee",
        "a2f38b8f-0b40-5109-b021-cb5f084a26ab"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the smoked sausage for the last 15 minutes of cooking time. When the vegetables are tender, remove the bacon and smoked sausage, slice thinly and set aside.",
      "timer_seconds": 900
    },
    {
      "step_number": 6,
      "instruction": "If you prefer a smooth consistency, purée the soup with a stick blender. Season to taste with salt and pepper. Add the meat back to the soup, setting some slices of rookworst aside."
    },
    {
      "step_number": 7,
      "instruction": "Serve in heated bowls or soup plates, garnished with slices of rookworst and chopped celery leaf.",
      "ingredients_used": [
        "102b6440-cbd5-595b-bfb5-6d82042936a9"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Enjoy!"
    }
  ],
