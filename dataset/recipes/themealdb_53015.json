  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Dissolve yeast in warm water in 2 1/2-quart bowl. Add milk, sugar, salt, eggs, shortening and 2 cups flour. Beat on low for 30 seconds, scraping bowl constantly. Beat on medium speed for 2 minutes, scraping bowl occasionally. Stir in remaining flour until smooth. Cover and let rise until double, 50-60 minutes. (Dough is ready when indentation remains when touched.) Turn dough onto floured surface; roll around lightly to coat with flour. Gently roll dough 1/2-inch thick with floured rolling pin. Cut with floured doughnut cutter. Cover and let rise until double, 30-40 minutes.",
      "ingredients_used": [
        "9b629a6e-9171-5dd9-ab92-4689309a288f",
        "d1949ec1-c19f-5e5a-a504-86a4e2bedda9",
        "e02f6e87-64b5-5f0a-a941-283cf4395f09",
        "cf087ddb-75e2-539f-8220-b87d6b68917d",
        "08f7d730-3e73-5496-82e5-e33c78a6d78a",
        "7be62331-1214-5aa0-bad5-1261c9afd0b6",
        "7e85ad60-a028-5fcd-bce7-0efab47ff6a6",
        "e9380eeb-238a-5cd2-9ae6-631891b8c5be",
        "e56dc6dc-4640-595a-91d4-295754b0b089",
        "38b018b9-d985-575c-a4f6-5abcb357a4cb"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat vegetable oil in deep fryer to 350°. Slide doughnuts into hot oil with wide spatula. Turn doughnuts as they rise to the surface. Fry until golden brown, about 1 minute on each side. Remove carefully from oil (do not prick surface); drain. Dip the doughnuts into creamy glaze set on rack.",
      "timer_seconds": 60
    },
    {
      "step_number": 3,
      "instruction": "Glaze:"
    },
    {
      "step_number": 4,
      "instruction": "Heat butter until melted. Remove from heat. Stir in powdered sugar and vanilla until smooth. Stir in water, 1 tablespoon at a time, until desired consistency.",
