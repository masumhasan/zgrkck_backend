  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel potatoes and cut into 5cm cubes.",
      "ingredients_used": [
        "0f7a2028-4292-52a8-b7a1-48af9adf8f73"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Pour 1-2 cm of olive oil into a large pan and heat up very hot. Fry potatoes until golden brown for 20 minutes, turning from time to time. Place on kitchen paper to drain.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "0f7a2028-4292-52a8-b7a1-48af9adf8f73",
        "b3c0af82-6433-56e7-bfca-e82829aa756a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cut the peppers in half and remove seeds. Rub a little olive oil on them and place the cut side down on a baking tray. Place them under the grill. Grill until the skin is dark and bubbly. While the peppers are still hot, put them into a plastic sandwich bag and seal it. Take them out after 15 minutes and remove skins.",
      "timer_seconds": 900,
      "ingredients_used": [
        "b3c0af82-6433-56e7-bfca-e82829aa756a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "In the meantime, heat more olive oil another pan. Peel the onions and cut into thin rings. Fry for 15 minutes until golden brown, turning them often. Add the Ras el hanout at the end.",
      "timer_seconds": 900,
      "ingredients_used": [
        "b3c0af82-6433-56e7-bfca-e82829aa756a",
        "a171ce43-c690-5622-bc95-ab8b50d357a7",
        "3b9e77a3-dae8-52e9-93b8-c8bcd14ba8bc"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Cut the pumpkin into 5cm cubes and fry in the same pan you used for the potatoes for 10-15 minutes until it is soft and slightly browned. Place on kitchen paper.",
      "timer_seconds": 900,
      "ingredients_used": [
        "0f7a2028-4292-52a8-b7a1-48af9adf8f73",
        "4a64e954-9f4e-567e-af2f-aa0777c37ea5"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Pour the remaining olive oil out of the pan and put all the cooked vegetables into the pan and mix. Whisk eggs and pour them over the vegetables. Put the lid on the pan so that the eggs cook. Put the contents of the pan onto a large chopping board, add salt and pepper and chopped and mix everything with a big knife.",
      "ingredients_used": [
        "b3c0af82-6433-56e7-bfca-e82829aa756a",
        "c5a999dd-6ed7-569f-b4ff-e5618e26bfdd",
        "456a18ac-bd8e-51df-af71-e2900ec0e0ba",
        "5dde0765-8f16-5bef-bdbc-4ad4b848ef64"
      ]
    }
  ],
