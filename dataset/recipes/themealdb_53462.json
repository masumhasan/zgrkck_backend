  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a large bowl, combine the butter and caster sugar until creamy. Add the egg and a pinch of salt.",
      "ingredients_used": [
        "d49a7c43-f68e-5530-b0bb-196ec40e47dc",
        "ddd9ccc0-aba7-5c65-9fa3-f663c0881ded",
        "835e9aea-06c6-51cc-b377-9289e4a7a602",
        "e3d42db2-943e-5d0f-b04c-934c9fa73e7d"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Stir into a buttery mixture. Add the sifted flour.",
      "ingredients_used": [
        "d49a7c43-f68e-5530-b0bb-196ec40e47dc"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Whisk well. You should end up with a smooth dough. Cover it with a piece of plastic wrap and put the dough in the fridge for 15 minutes to chill and set.",
      "timer_seconds": 900
    },
    {
      "step_number": 4,
      "instruction": "In the meantime combine the cassonade (or brown sugar) and the cinnamon.",
      "ingredients_used": [
        "bf4217ae-aa23-5116-abf9-2e7430443a58",
        "fdfde4f8-58be-576d-9f66-3c6a57a5e907"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Transfer the dough onto a floured surface and knead it for a minute. Add extra flour if necessary. Roll the dough out gently into a nice rectangle. It should be about ⅕-inch (5 mm) thick. Sprinkle with the sugary cinnamon mixture.",
      "ingredients_used": [
        "bf4217ae-aa23-5116-abf9-2e7430443a58"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Carefully start rolling the dough up. If it is too sticky, put it in the fridge again for a couple of minutes. Wrap it up tightly in plastic wrap."
    },
    {
      "step_number": 7,
      "instruction": "Put it in the fridge for 30 minutes to chill and set. After that, remove the cling film and cut the dough roll into even slices.",
      "timer_seconds": 1800
    },
    {
      "step_number": 8,
      "instruction": "Place the slices on a baking paper lined baking tray. Bake the cookies in a preheated oven at 356°F (180°C) for 14 to 16 minutes.",
      "timer_seconds": 960,
      "temperature": {
        "value": 356,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 9,
      "instruction": "Let the baked cinnamon roll cookies cool down fully before eating or wrapping them up.",
      "ingredients_used": [
        "bf4217ae-aa23-5116-abf9-2e7430443a58"
      ]
    }
  ],
