  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oil in a pan and fry the onion for about 5 mins until softened. Add the garlic, chopped tomatoes, tomato purée, sweet paprika, chilli powder, sugar and a pinch of salt, then bring to the boil, stirring occasionally. Lower to a simmer and cook for 10 mins until pulpy. Can be kept chilled for up to 24 hrs.",
      "ingredients_used": [
        "5a329b8c-b302-52cb-91ed-e2744621a35c",
        "e5bb42de-ab89-52e4-a3a0-cde511a68dde",
        "bbca4f37-f28e-5a1b-9ee8-ebe55282ce9d",
        "0fead4cb-7e73-5b97-8fb9-2cec55014c0c",
        "e8dddc07-fa2d-5a23-a5c8-303122e83834"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat oven to 200C/180C fan/gas 6. Pat the potatoes dry with kitchen paper, then tip into a roasting tin and toss in the olive oil and some seasoning. Roast for 40-50 mins until crisp and golden. Tip the potatoes into serving dishes and spoon over the tomato sauce. Sprinkle with some fresh parsley to serve.",
      "timer_seconds": 3000,
