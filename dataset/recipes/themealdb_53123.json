  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cut the lamb into large pieces.",
      "ingredients_used": [
        "72d334a9-1747-5022-ac4e-37d257562519"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Slice the cabbage into large wedges, keeping the core attached.",
      "ingredients_used": [
        "251d3845-8f22-5823-864a-00e18a24b423"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Add a layer of lamb pieces to the bottom of a large pot, fatty side down. Sprinkle with peppercorns and salt. Add a layer of cabbage wedges on top. Repeat with more layers of lamb, peppercorns, and cabbage, ending with cabbage on top.",
      "ingredients_used": [
        "72d334a9-1747-5022-ac4e-37d257562519",
        "251d3845-8f22-5823-864a-00e18a24b423",
        "201d8ff6-f2cc-54c5-abb2-e0c9e004ce83",
        "1daf5a99-4b40-5445-9784-d820bbeea873"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Optional: Sprinkle a couple of tablespoons on top of the lamb for a thicker stew.",
      "ingredients_used": [
        "72d334a9-1747-5022-ac4e-37d257562519"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add water to the pot and bring to a boil. Cover and reduce heat. Cook on low heat for 2 – 3 hours, until the lamb gently falls away from the bone.",
      "timer_seconds": 10800,
      "ingredients_used": [
        "72d334a9-1747-5022-ac4e-37d257562519",
        "59771543-ef81-59e8-a78e-ee7dbefefc20"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Serve with boiled potatoes and fresh parsley, covering generously with the fårikål broth."
    }
  ],
