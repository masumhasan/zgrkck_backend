  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "For the saltfish, soak the salt cod overnight, changing the water a couple of times.",
      "ingredients_used": [
        "59b7c752-94a7-5a6a-bf56-3378c435f24e",
        "5bee3924-d1b1-5d70-8a41-7d53b07606c6",
        "85f18c15-5aa1-5164-9fb2-02153dd29ceb"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Drain, then put the cod in a large pan of fresh water and bring to the boil. Drain again, add fresh water and bring to the boil again."
    },
    {
      "step_number": 3,
      "instruction": "Simmer for about five minutes, or until cooked through, then drain and flake the fish into large pieces. Discard any skin or bones."
    },
    {
      "step_number": 4,
      "instruction": "For the dumplings, mix the flour and suet with a pinch of salt and 250ml/9fl oz water to make a dough.",
      "ingredients_used": [
        "5bee3924-d1b1-5d70-8a41-7d53b07606c6",
        "ff24a671-4671-5ec1-b9c2-a827eb6558f5",
        "85f18c15-5aa1-5164-9fb2-02153dd29ceb"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Wrap the mixture in clingfilm and leave in the fridge to rest."
    },
    {
      "step_number": 6,
      "instruction": "Open the can of ackee, drain and rinse, then set aside.",
      "ingredients_used": [
        "597812bf-2f5d-5c2b-9d93-5b9be2c379b2"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Heat a tablespoon of olive oil in a pan and fry the onion until softened but not brown.",
      "ingredients_used": [
        "33e19d67-f418-540b-bc44-b6efee2dab75",
        "1304c5c5-1862-5b3d-bd70-92b2f67d9d17"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Add the spices, seasoning, pepper sauce and sliced peppers and continue to fry until the peppers are tender.",
      "ingredients_used": [
        "096a8b6a-6210-5fa8-8564-8db0697eb87c"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Add the chopped tomatoes, then the salt cod and mix together. Lastly stir in the ackee very gently and leave to simmer until ready to serve.",
      "ingredients_used": [
        "59b7c752-94a7-5a6a-bf56-3378c435f24e",
        "597812bf-2f5d-5c2b-9d93-5b9be2c379b2",
        "6608596d-9c9b-5b65-bcb8-6fb63f68bd1e",
        "5bee3924-d1b1-5d70-8a41-7d53b07606c6",
        "85f18c15-5aa1-5164-9fb2-02153dd29ceb"
      ]
    },
    {
      "step_number": 10,
      "instruction": "When you’re almost ready to eat, heat about 1cm/½in vegetable oil in a frying pan and heat until just smoking."
    },
    {
      "step_number": 11,
      "instruction": "Shape the dumpling mix into plum-size balls and shallow-fry until golden-brown. (CAUTION: hot oil can be dangerous. Do not leave the pan unattended.)"
    },
    {
      "step_number": 12,
      "instruction": "Drain the dumplings on kitchen paper and serve with the saltfish and ackee.",
      "ingredients_used": [
        "597812bf-2f5d-5c2b-9d93-5b9be2c379b2",
        "5bee3924-d1b1-5d70-8a41-7d53b07606c6",
        "85f18c15-5aa1-5164-9fb2-02153dd29ceb"
      ]
    }
  ],
