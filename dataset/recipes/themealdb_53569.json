  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel mangoes and slice",
      "ingredients_used": [
        "2dc2e3ee-9d7a-5d78-9121-011cc0843fa6"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cut two of the mangoes into chunks",
      "ingredients_used": [
        "2dc2e3ee-9d7a-5d78-9121-011cc0843fa6"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Blend all ingredients until smooth and creamy"
    },
    {
      "step_number": 4,
      "instruction": "Pour in a glass"
    },
    {
      "step_number": 5,
      "instruction": "Mango rose",
      "ingredients_used": [
        "2dc2e3ee-9d7a-5d78-9121-011cc0843fa6"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Cut two of the largest opposite slices"
    },
    {
      "step_number": 7,
      "instruction": "Lay them down on a cutting board"
    },
    {
      "step_number": 8,
      "instruction": "Using a sharp knife, create small ¼ inch slices. Cut the mango slightly diagonally to get longer pieces.",
      "ingredients_used": [
        "2dc2e3ee-9d7a-5d78-9121-011cc0843fa6"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Create a circular bud with one slice, build around it with the other slices, placing them individually the previous row to take on the form of a rose."
    },
    {
      "step_number": 10,
      "instruction": "Repeat this until you've arrived at your desired size."
    }
