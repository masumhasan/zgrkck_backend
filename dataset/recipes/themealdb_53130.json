  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Almond base"
    },
    {
      "step_number": 2,
      "instruction": "Preheat oven to 345°F (175°C) and grease cake form (I use a 27 cm spring form) – you can line the bottom with baking paper if you like.",
      "temperature": {
        "value": 345,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 3,
      "instruction": "Grind almonds in an almond grinder or food processor. I like to keep them a bit coarse.",
      "ingredients_used": [
        "caff2f58-f1d3-50b1-a68b-202c62d41f8c"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Gently whisk the eggs and sugar together until combined (no longer). Stir in the ground almonds, flour, and baking powder.",
      "ingredients_used": [
        "caff2f58-f1d3-50b1-a68b-202c62d41f8c",
        "eb19c4ad-dc99-5490-8dac-303a085f8cdb",
        "d4ba633e-d35c-51bc-8a67-740c760557de"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Pour batter into cake form and bake for about 45 – 50 minutes, monitoring to make sure the top doesn't burn.",
      "timer_seconds": 3000
    },
    {
      "step_number": 6,
      "instruction": "Yellow egg cream",
      "ingredients_used": [
        "4644f20d-c829-5306-ab25-ca06bef94e5d"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add egg yolks, heavy cream, sugar, and vanilla to a saucepan. Heat over low/medium heat while stirring constantly until the mixture thickens – about 15 minutes. Turn up the heat if the mixture doesn't thicken, but be careful not to boil.",
      "timer_seconds": 900,
      "ingredients_used": [
        "4644f20d-c829-5306-ab25-ca06bef94e5d",
        "0a2aa2db-1353-52fb-84ea-1ccddf0c70d6",
        "e673a394-d5ca-56d3-b880-71d8d93ee761"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Let the mixture cool to room temperature and then add the butter. You can use an electric mixer for a fluffy egg cream.",
      "ingredients_used": [
        "4644f20d-c829-5306-ab25-ca06bef94e5d",
        "8970161a-9069-5f7e-9851-0a8916037950"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Assembly"
    },
    {
      "step_number": 10,
      "instruction": "Wait for the cake to cool completely before removing from form and frosting."
    }
  ],
