  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Whizz together all of the marinade ingredients in a small food processor. Rub the marinade onto the chicken and leave for 1 hour at room temperature.",
      "timer_seconds": 3600,
      "ingredients_used": [
        "256bebda-7f4e-5da0-af62-f20a2a2bd88f"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat the oven to 190C/fan 170C/gas 5. Put the chicken in a roasting tray and cook for 1 hour 20 minutes. Rest under loose foil for 20 minutes. While the chicken is resting, mix together the slaw ingredients and season. Serve the chicken with slaw, fries and condiments.",
      "temperature": {
        "value": 190,
