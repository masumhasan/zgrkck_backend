  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "This recipe requires a stew to steam the dumplings on top of, at abour 180℃ or 350℉, give or take (it doesn't have to be specific, but can't be very high or very love heat). You will add the dumplings in during the last thirty minutes of your stew's cooking time, They need to steam covered, so the stew should be in a lidded pot that is oven-proof."
    },
    {
      "step_number": 2,
      "instruction": "Mix the dumpling dough"
    },
    {
      "step_number": 3,
      "instruction": "In a measuring cup, combine the warm water, sugar, and yeast. Leave until foamy, about 5 minutes.",
      "timer_seconds": 300,
      "ingredients_used": [
        "eb2caa23-efdc-5268-8d8f-2e864772b0b1",
        "16fe8963-87ef-5c52-b972-b090d477945e",
        "ff54361c-2fba-5ba3-930d-71a1e482520c"
      ]
    },
    {
      "step_number": 4,
      "instruction": "To a stand mixer bowl, or a large bowl if mixing by hand, add the flour and salt. Stream in the water-yeast mixture while kneading.",
      "ingredients_used": [
        "ff54361c-2fba-5ba3-930d-71a1e482520c",
        "e6cf0bce-d7b5-5571-a3ca-8c8c511da79a"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Knead for several minutes after the dough comes together, until a smooth ball of dough forms."
    },
    {
      "step_number": 6,
      "instruction": "Leave the dumpling dough to rise"
    },
    {
      "step_number": 7,
      "instruction": "Place the ball of dough in an oiled dough, cover, and leave to rise until doubled, about 1 hour.",
      "timer_seconds": 3600
    },
    {
      "step_number": 8,
      "instruction": "Shape the dumplings"
    },
    {
      "step_number": 9,
      "instruction": "Divide the risen ball of dough into 10 equal portions for large dumplings, or 12-14 portions for smaller dumplings."
    },
    {
      "step_number": 10,
      "instruction": "Shape each portion of dough into a smooth, round ball."
    },
    {
      "step_number": 11,
      "instruction": "Steam the dumplings"
    },
    {
      "step_number": 12,
      "instruction": "In the last thirty minutes of cooking a stew, place the shaped dumplings right atop the stew. Push them down gently into the stew. Cover tightly and return to the oven for 25-30 minutes. The dumplings are done when they're risen and light golden.",
      "timer_seconds": 1800
    }
  ],
