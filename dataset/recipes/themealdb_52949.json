  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preparation"
    },
    {
      "step_number": 2,
      "instruction": "Crack the egg into a bowl. Separate the egg white and yolk.",
      "ingredients_used": [
        "920f7670-d2f0-55ab-8d45-dc671d8ca976"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Sweet and Sour Pork",
      "ingredients_used": [
        "d593c057-39b6-52fe-bca2-096dfda76341"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Slice the pork tenderloin into strips.",
      "ingredients_used": [
        "d593c057-39b6-52fe-bca2-096dfda76341"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Prepare the marinade using a pinch of salt, one teaspoon of starch, two teaspoons of light soy sauce, and an egg white.",
      "ingredients_used": [
        "920f7670-d2f0-55ab-8d45-dc671d8ca976",
        "c51e65de-5eac-530d-86c0-eedbc9818e2b",
        "7315b573-db95-5785-881d-cea17e0c02bd",
        "53d3073f-01fc-5288-9934-0a59e377235b"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Marinade the pork strips for about 20 minutes.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "d593c057-39b6-52fe-bca2-096dfda76341"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Put the remaining starch in a bowl. Add some water and vinegar to make a starchy sauce.",
      "ingredients_used": [
        "8fc1da60-1ccb-5dcf-8f85-83d011a64a5d",
        "53d3073f-01fc-5288-9934-0a59e377235b",
        "274a1b31-1c83-57b1-baa9-10033f298e6d"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Sweet and Sour Pork",
      "ingredients_used": [
        "d593c057-39b6-52fe-bca2-096dfda76341"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Cooking Instructions"
    },
    {
      "step_number": 10,
      "instruction": "Pour the cooking oil into a wok and heat to 190°C (375°F). Add the marinated pork strips and fry them until they turn brown. Remove the cooked pork from the wok and place on a plate.",
      "temperature": {
        "value": 190,
        "unit": "celsius"
      },
      "ingredients_used": [
        "d593c057-39b6-52fe-bca2-096dfda76341"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Leave some oil in the wok. Put the tomato sauce and white sugar into the wok, and heat until the oil and sauce are fully combined.",
      "ingredients_used": [
        "673e64b7-e79c-5709-abad-112fe8af4ce7"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Add some water to the wok and thoroughly heat the sweet and sour sauce before adding the pork strips to it.",
      "ingredients_used": [
        "d593c057-39b6-52fe-bca2-096dfda76341",
        "8fc1da60-1ccb-5dcf-8f85-83d011a64a5d"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Pour in the starchy sauce. Stir-fry all the ingredients until the pork and sauce are thoroughly mixed together.",
      "ingredients_used": [
        "d593c057-39b6-52fe-bca2-096dfda76341",
        "53d3073f-01fc-5288-9934-0a59e377235b"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Serve on a plate and add some coriander for decoration.",
      "ingredients_used": [
        "72bf5993-838f-5cf9-9d35-fe1696c39b11"
      ]
    }
  ],
