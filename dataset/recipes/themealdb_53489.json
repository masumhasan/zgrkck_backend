  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat oven to 350 F.",
      "temperature": {
        "value": 350,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 2,
      "instruction": "Heat oil in a skillet. Add the ground meat and cook, breaking it down with a wooden spoon for 6-7 minutes, until browned. Add onion and garlic. Add carrots (optional).Add salt, black pepper, dried mint, summer savory, thyme (optional), tomato sauce and tomato paste. Cook for 2-3 minutes, stirring frequently.",
      "ingredients_used": [
        "05413749-3a82-593b-be26-506154fdb266",
        "3f19c114-fa74-54f3-9393-40698486087a",
        "52b2e11a-4707-5fc6-8794-1e1cdd4e2876",
        "ea355660-3c43-59ec-8894-631fdbafde53",
        "1e4cbd0c-7757-5141-9a3e-65ba0394e649",
        "226fe5b8-9e85-544e-97dc-170a1d11cbae",
        "f94dbe66-6bcc-53b5-b249-b4a4ebee237e",
        "7edbed31-f727-5776-a61f-b3e67b1faed2"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Grease a 9×9 or 9×13 baking dish with oil."
    },
    {
      "step_number": 4,
      "instruction": "Add in the drained potatoes and meat mixture. Stir to evenly distribute the meat into the potatoes.",
      "ingredients_used": [
        "f0abc1eb-bd64-558f-878d-f16a79799f04"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add cold water to the baking dish, so it just covers the top of the potatoes.",
      "ingredients_used": [
        "7eb78c1b-13f5-5925-8b59-7f4330a349ef",
        "f0abc1eb-bd64-558f-878d-f16a79799f04"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Bake for 40-50 minutes, until the water is absorbed by the potatoes and they are fully cooked.",
      "timer_seconds": 3000,
      "ingredients_used": [
        "7eb78c1b-13f5-5925-8b59-7f4330a349ef",
        "f0abc1eb-bd64-558f-878d-f16a79799f04"
      ]
    },
    {
      "step_number": 7,
      "instruction": "In the mean time prepare the Bechamel sauce (or the Bulgarian Style Topping)."
    },
    {
      "step_number": 8,
      "instruction": "For the Bechamel:"
    },
    {
      "step_number": 9,
      "instruction": "In a bowl, swish egg yolks. Set aside.",
      "ingredients_used": [
        "9d55a833-e6f2-52fa-9396-38c7b121a346"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Melt butter in a saucepan. add flour. Cook for 3 minutes on medium heat, stirring frequently.",
      "timer_seconds": 180,
      "ingredients_used": [
        "ec3b9eb2-e634-545f-8f4e-2ff862618050",
        "e2b4458e-fa50-53c6-a015-62bfb2368271"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Slowly add the milk, whisking to incorporate. Add salt and nutmeg. Cook for 3 minutes, until thickened. Let the mixture cool for 5 minutes. Add in the egg yolks (with feta). Let the sauce stand at room temperature, while the potatoes and meat are cooking.",
      "ingredients_used": [
        "ea355660-3c43-59ec-8894-631fdbafde53",
        "f0abc1eb-bd64-558f-878d-f16a79799f04",
        "d2aff00f-e85d-5001-be0d-14beebf231eb",
        "7edbed31-f727-5776-a61f-b3e67b1faed2",
        "9d55a833-e6f2-52fa-9396-38c7b121a346",
        "eba7eee8-f319-5b55-b9e9-2e7878313256",
        "3c1f7df9-af6b-59e7-a7f8-329547952d97"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Pour the sauce over the cooked potatoes. Top with cheese. Bake for 15 minutes, until golden. You can broil for 1-2 minutes, if the top is not getting to the desired golden color.",
      "ingredients_used": [
        "f0abc1eb-bd64-558f-878d-f16a79799f04"
      ]
    },
    {
      "step_number": 13,
      "instruction": "For the Bulgarian Moussaka topping:"
    },
    {
      "step_number": 14,
      "instruction": "In a bowl beat together eggs, yogurt, milk, flour, then add salt and baking soda.",
      "ingredients_used": [
        "ea355660-3c43-59ec-8894-631fdbafde53",
        "d2aff00f-e85d-5001-be0d-14beebf231eb",
        "e2b4458e-fa50-53c6-a015-62bfb2368271",
        "7edbed31-f727-5776-a61f-b3e67b1faed2"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Pour over the moussaka . Top with cheese. Bake for 10-15 minutes, until golden.",
      "timer_seconds": 900
    }
  ],
