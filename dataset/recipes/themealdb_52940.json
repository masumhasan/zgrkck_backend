  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Squeeze lime over chicken and rub well. Drain off excess lime juice.",
      "ingredients_used": [
        "ba9a41a9-c290-50cb-be11-d3bbfef456dc",
        "ba5c15a5-f2be-5092-b31f-9290c4ce9d0d"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Combine tomato, scallion, onion, garlic, pepper, thyme, pimento and soy sauce in a large bowl with the chicken pieces. Cover and marinate at least one hour.",
      "ingredients_used": [
        "ba9a41a9-c290-50cb-be11-d3bbfef456dc",
        "7f1c0a98-3631-5132-a9fd-c52007204a7d",
        "17b5f4fd-a212-597c-9d0b-81223e2d81e7",
        "62e8ba38-362b-5730-a252-785a70934966"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Heat oil in a dutch pot or large saucepan. Shake off the seasonings as you remove each piece of chicken from the marinade. Reserve the marinade for sauce.",
      "ingredients_used": [
        "ba9a41a9-c290-50cb-be11-d3bbfef456dc"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Lightly brown the chicken a few pieces at a time in very hot oil. Place browned chicken pieces on a plate to rest while you brown the remaining pieces.",
      "ingredients_used": [
        "ba9a41a9-c290-50cb-be11-d3bbfef456dc"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Drain off excess oil and return the chicken to the pan. Pour the marinade over the chicken and add the carrots. Stir and cook over medium heat for 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "ba9a41a9-c290-50cb-be11-d3bbfef456dc",
        "775956bc-703b-5232-a0b4-281cdea13234"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Mix flour and coconut milk and add to stew, stirring constantly. Turn heat down to minimum and cook another 20 minutes or until tender.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "7a6385be-38fe-533c-a708-962c54fa33ee"
      ]
    }
  ],
