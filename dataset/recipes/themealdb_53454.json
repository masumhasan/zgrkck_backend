  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Captain William Bligh was chosen to lead an expedition to the South Seas to bring the breadfruit to the Caribbean.",
      "ingredients_used": [
        "c2eaffa9-b0a4-515d-be83-a6d4a3ad4f26"
      ]
    },
    {
      "step_number": 2,
      "instruction": "His devotion to the breadfruit saplings and neglect of his crew’s water needs lead to the famous “Mutiny on the Bounty” on his first attempt. Cast overboard; Captain Bligh made his way hundreds of miles to safety in an open boat.",
      "ingredients_used": [
        "c2eaffa9-b0a4-515d-be83-a6d4a3ad4f26",
        "bc49d848-c50e-50e4-95f3-09bf7bf04a2d"
      ]
    },
    {
      "step_number": 3,
      "instruction": "On his second attempt in 1793, he sailed into Jamaica’s Port Royal Harbor with a ship so crowded with beautiful leafy breadfruit saplings that the Jamaicans rowed out toward “the ship that has bush.”",
      "ingredients_used": [
        "c2eaffa9-b0a4-515d-be83-a6d4a3ad4f26"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Today large, lush breadfruit trees grow throughout the Caribbean, bearing the football-like starchy staple that has kept hunger away from many a door. Breadfruit may be difficult to find outside the Caribbean.",
      "ingredients_used": [
        "c2eaffa9-b0a4-515d-be83-a6d4a3ad4f26"
      ]
    },
    {
      "step_number": 5,
      "instruction": "You will need the following ingredients:"
    },
    {
      "step_number": 6,
      "instruction": "1/2 medium breadfruit",
      "ingredients_used": [
        "c2eaffa9-b0a4-515d-be83-a6d4a3ad4f26"
      ]
    },
    {
      "step_number": 7,
      "instruction": "1/2 small onion",
      "ingredients_used": [
        "dc86c199-9e28-50b4-ae89-51db0179b78e",
        "4e5e99c9-eae0-556e-9984-95ce81eadebb"
      ]
    },
    {
      "step_number": 8,
      "instruction": "1 tablespoon olive oil",
      "ingredients_used": [
        "aa0bd9f4-1341-5c87-ae23-49cbdba5ef43"
      ]
    },
    {
      "step_number": 9,
      "instruction": "4 oz/125g butter",
      "ingredients_used": [
        "4872aa35-8b5a-5d34-9fea-5fafb582887e"
      ]
    },
    {
      "step_number": 10,
      "instruction": "3 medium onions, cut into rings",
      "ingredients_used": [
        "dc86c199-9e28-50b4-ae89-51db0179b78e",
        "4e5e99c9-eae0-556e-9984-95ce81eadebb"
      ]
    },
    {
      "step_number": 11,
      "instruction": "1 tablespoon garlic finely chopped",
      "ingredients_used": [
        "cbd567e1-3bd8-58ff-be77-b610b1c9af0f"
      ]
    },
    {
      "step_number": 12,
      "instruction": "1 medium 16floz/500ml tin whole tomatoes, drained and sliced"
    },
    {
      "step_number": 13,
      "instruction": "1/4 cup or 3 tablespoons parsley, diced",
      "ingredients_used": [
        "e5deb93d-f494-5282-a0e1-50b520aeace4",
        "e441fdc7-6a71-58f0-bd8c-3f02450d5713"
      ]
    },
    {
      "step_number": 14,
      "instruction": "1 tablespoon lime juice",
      "ingredients_used": [
        "3f3627ab-fde1-5645-ab7d-5deef0de75d2"
      ]
    },
    {
      "step_number": 15,
      "instruction": "Salt and pepper to taste",
      "ingredients_used": [
        "96207429-f994-5037-907f-5a0da69fdcc5",
        "004d3d99-331b-5f6e-9b51-fbfbce4e0ca8"
      ]
    },
    {
      "step_number": 16,
      "instruction": "1 cup 8oz or 250ml water",
      "ingredients_used": [
        "bc49d848-c50e-50e4-95f3-09bf7bf04a2d"
      ]
    },
    {
      "step_number": 17,
      "instruction": "Red pepper sauce to taste.",
      "ingredients_used": [
        "004d3d99-331b-5f6e-9b51-fbfbce4e0ca8"
      ]
    },
    {
      "step_number": 18,
      "instruction": "Garnish: fresh parsley, chopped.",
      "ingredients_used": [
        "e5deb93d-f494-5282-a0e1-50b520aeace4",
        "e441fdc7-6a71-58f0-bd8c-3f02450d5713"
      ]
    },
    {
      "step_number": 19,
      "instruction": "Instructions:"
    },
    {
      "step_number": 20,
      "instruction": "Cut the breadfruit, remove the seeds in the core, and peel. Boil in salted water with a little onion and oil, over high heat until tender and drain.",
      "ingredients_used": [
        "c2eaffa9-b0a4-515d-be83-a6d4a3ad4f26",
        "dc86c199-9e28-50b4-ae89-51db0179b78e",
        "4e5e99c9-eae0-556e-9984-95ce81eadebb",
        "96207429-f994-5037-907f-5a0da69fdcc5",
        "bc49d848-c50e-50e4-95f3-09bf7bf04a2d"
      ]
    },
    {
      "step_number": 21,
      "instruction": "Meanwhile, melt the butter in a frying pan and lightly brown the onion rings. Add the garlic, tomatoes, parsley, lime juice, salt, and pepper. Continue to sauté for a couple of minutes. Add the water, bring to the boil and simmer for 5-10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "dc86c199-9e28-50b4-ae89-51db0179b78e",
        "4872aa35-8b5a-5d34-9fea-5fafb582887e",
        "4e5e99c9-eae0-556e-9984-95ce81eadebb",
        "cbd567e1-3bd8-58ff-be77-b610b1c9af0f",
        "e5deb93d-f494-5282-a0e1-50b520aeace4",
        "3f3627ab-fde1-5645-ab7d-5deef0de75d2",
        "96207429-f994-5037-907f-5a0da69fdcc5",
        "004d3d99-331b-5f6e-9b51-fbfbce4e0ca8",
        "bc49d848-c50e-50e4-95f3-09bf7bf04a2d",
        "e441fdc7-6a71-58f0-bd8c-3f02450d5713"
      ]
    },
    {
      "step_number": 22,
      "instruction": "Slice the cooled breadfruit and place it in a serving dish. Pour the butter sauce over the breadfruit.",
      "ingredients_used": [
        "c2eaffa9-b0a4-515d-be83-a6d4a3ad4f26",
        "4872aa35-8b5a-5d34-9fea-5fafb582887e"
      ]
    },
    {
      "step_number": 23,
      "instruction": "Garnish with chopped fresh parsley.",
      "ingredients_used": [
        "e5deb93d-f494-5282-a0e1-50b520aeace4",
        "e441fdc7-6a71-58f0-bd8c-3f02450d5713"
      ]
    },
    {
      "step_number": 24,
      "instruction": "Serves 4"
    }
  ],
