  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Season 6 sea bass fillets with salt and pepper, then slash the skin 3 times.",
      "ingredients_used": [
        "8005dd80-b9e9-5877-af6a-28e10c484d2c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Heat a heavy-based frying pan and add 1 tbsp sunflower oil.",
      "ingredients_used": [
        "79eab4c5-9646-5bd6-a33d-37ce5e3c6b25"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Once hot, fry the sea bass fillets, skin-side down, for 5 mins or until the skin is very crisp and golden. The fish will be almost cooked through.",
      "timer_seconds": 300,
      "ingredients_used": [
        "8005dd80-b9e9-5877-af6a-28e10c484d2c"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Turn over, cook for another 30 seconds - 1 minute, then transfer to a serving plate and keep warm. You’ll need to fry the sea bass fillets in 2 batches.",
      "ingredients_used": [
        "8005dd80-b9e9-5877-af6a-28e10c484d2c"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Heat 2 tbsp sunflower oil, then fry the large knob of peeled ginger, cut into matchsticks, 3 thinly sliced garlic cloves and 3 thinly shredded red chillies for about 2 mins until golden.",
      "timer_seconds": 120,
      "ingredients_used": [
        "79eab4c5-9646-5bd6-a33d-37ce5e3c6b25",
        "75156aa6-00e2-5dbb-b687-a3b47444c0e3",
        "3048cbc0-e557-5223-8df1-5e3f1944de43",
        "01227ed8-8c02-596c-8498-c39721b5b387"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Take off the heat and toss in the bunch of shredded spring onions. Splash the fish with 1 tbsp soy sauce and spoon over the contents of the pan.",
      "ingredients_used": [
        "d0a549d2-aee1-594d-8806-9b55924adc88",
        "65f1cad9-f869-5b6a-a608-dea8e616683a"
      ]
    }
  ],
