  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Roll the pastry",
      "ingredients_used": [
        "15229daf-93cd-5649-8cd2-eec7e461cc5a"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Mix the flour and icing sugar, and use this to dust the work surface. Roll the pastry out to make a 45 x 30cm rectangle. Roll up lengthways to create a long sausage shape.",
      "ingredients_used": [
        "17fbf747-65e5-593b-88af-7ad1ba37fd0f",
        "15229daf-93cd-5649-8cd2-eec7e461cc5a"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cutting pastry into rounds",
      "ingredients_used": [
        "15229daf-93cd-5649-8cd2-eec7e461cc5a"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Cut the pastry into 24 wheels, about 1-2cm thick.",
      "ingredients_used": [
        "15229daf-93cd-5649-8cd2-eec7e461cc5a"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Roll out each pastry portion",
      "ingredients_used": [
        "15229daf-93cd-5649-8cd2-eec7e461cc5a"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Roll each wheel lightly with the rolling pin to fit 2 x 12-hole non-stick fairy cake tins."
    },
    {
      "step_number": 7,
      "instruction": "Press pastry into the tin",
      "ingredients_used": [
        "15229daf-93cd-5649-8cd2-eec7e461cc5a"
      ]
    },
    {
      "step_number": 8,
      "instruction": "Press the pastry circles into the tins and mold into the tins to make thin cases. Chill until needed.",
      "ingredients_used": [
        "15229daf-93cd-5649-8cd2-eec7e461cc5a"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Make the infused syrup"
    },
    {
      "step_number": 10,
      "instruction": "Heat the oven to 220C/fan 200C/gas 7. Make a sugar syrup by bringing the sugar, 200ml water, lemon zest and cinnamon stick to the boil. Reduce until syrupy, allow to cool, then remove the cinnamon and lemon. Whisk the eggs, egg yolks and cornflour until smooth in another large pan.",
      "temperature": {
        "value": 220,
        "unit": "celsius"
      },
      "ingredients_used": [
        "f0f37ffa-2dd6-5826-a679-a7d11f46c3e8",
        "99428c24-a18f-5d6c-bb71-113d3297a8a8",
        "2e41b2f7-d638-5e35-bc7e-90aa8206c554",
        "7b349212-cbe3-5fef-aad3-6ba4df664558",
        "5d1a3662-78d7-5cc5-850f-5cc06f6ece83"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Making custard"
    },
    {
      "step_number": 12,
      "instruction": "Heat the milk and vanilla pod seeds in a separate pan until just below the boil. Gradually pour the hot milk over the eggs and cornflour, then cook on a low heat, continually whisking.",
      "ingredients_used": [
        "2e41b2f7-d638-5e35-bc7e-90aa8206c554",
        "d2aa62cc-3c12-5bc4-8f69-904b854e961a",
        "eb9a0b79-71e3-59c1-aab2-2fb955ac0838"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Add syrup to custard"
    },
    {
      "step_number": 14,
      "instruction": "Add the cooled sugar syrup to the custard and whisk until thickened slightly."
    },
    {
      "step_number": 15,
      "instruction": "Pour custard into the tins"
    },
    {
      "step_number": 16,
      "instruction": "Pour the custard through a sieve. Pour into the pastry cases and bake for 15 minutes until the pastry is golden and the custard has darkened.",
      "timer_seconds": 900,
      "ingredients_used": [
        "15229daf-93cd-5649-8cd2-eec7e461cc5a"
      ]
    },
    {
      "step_number": 17,
      "instruction": "cool and dust with icing sugar",
      "ingredients_used": [
        "17fbf747-65e5-593b-88af-7ad1ba37fd0f"
      ]
    },
    {
      "step_number": 18,
      "instruction": "Cool completely in the tins then sift over icing sugar and ground cinnamon to serve.",
      "ingredients_used": [
        "17fbf747-65e5-593b-88af-7ad1ba37fd0f",
        "99428c24-a18f-5d6c-bb71-113d3297a8a8",
        "5d1a3662-78d7-5cc5-850f-5cc06f6ece83"
      ]
    }
  ],
