  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Cut leaves and soft stems from the kale branches, them soak in a bowl of cold water for about 5-10 minutes or until finish with prep.",
      "timer_seconds": 600,
      "ingredients_used": [
        "ffe989c0-8724-56f4-a8b5-0916605a460b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Proceed to slicing the onions, mincing the garlic and dicing the tomatoes. Set aside",
      "ingredients_used": [
        "4e0c9702-50ca-5323-966e-e28e44c4caa8",
        "ad102ca4-640f-57d8-86b9-629ae28c90f0",
        "dea196c0-9df8-591e-a0e6-e6b42e479ac4"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Remove kale from water cut in chunks.",
      "ingredients_used": [
        "ffe989c0-8724-56f4-a8b5-0916605a460b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Place bacon on saucepan and cook until crispy. Then add onions, garlic, thyme, stir for about a minute or more",
      "ingredients_used": [
        "3d788c64-de33-5178-98f0-5e64bd4bb243",
        "4e0c9702-50ca-5323-966e-e28e44c4caa8",
        "ad102ca4-640f-57d8-86b9-629ae28c90f0",
        "a3251b69-e847-559b-9215-fc49981c3bfc"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add tomatoes; scotch bonnet pepper, smoked paprika. Sauté for about 2-3 more minutes.",
      "ingredients_used": [
        "96a62ca7-f7dc-5bdf-8e31-3b3008dcc4b9",
        "dea196c0-9df8-591e-a0e6-e6b42e479ac4"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Finally add vegetable, salt, mix well, and steamed for about 6-8 minutes or until leaves are tender. Add a tiny bit of water as needed. Adjust seasonings and turn off the heat.",
      "timer_seconds": 480
    },
    {
      "step_number": 7,
      "instruction": "Using a sharp knife cut both ends off the plantain. This will make it easy to grab the skin of the plantains. Slit a shallow line down the long seam of the plantain; peel only as deep as the peel. Remove plantain peel by pulling it back."
    },
    {
      "step_number": 8,
      "instruction": "Slice the plantain into medium size lengthwise slices and set aside."
    },
    {
      "step_number": 9,
      "instruction": "Coat a large frying pan with cooking oil spray. Spray the tops of the plantains with a generous layer of oil spray and sprinkle with salt, freshly ground pepper."
    },
    {
      "step_number": 10,
      "instruction": "Let the plantains \"fry\" on medium heat, shaking the frying pan to redistribute them every few minutes."
    },
    {
      "step_number": 11,
      "instruction": "As the plantains brown, continue to add more cooking oil spray, salt and pepper (if needed) until they have reached the desired color and texture."
    },
    {
      "step_number": 12,
      "instruction": "Remove and serve with kale",
      "ingredients_used": [
        "ffe989c0-8724-56f4-a8b5-0916605a460b"
      ]
    }
  ],
