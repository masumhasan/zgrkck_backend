  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Preheat the oven to 200C/180C Fan/Gas 6.",
      "temperature": {
        "value": 200,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Put the biscuits in a large re-sealable freezer bag and bash with a rolling pin into fine crumbs. Melt the butter in a small pan, then add the biscuit crumbs and stir until coated with butter. Tip into the tart tin and, using the back of a spoon, press over the base and sides of the tin to give an even layer. Chill in the fridge while you make the filling.",
      "ingredients_used": [
        "1d3aead7-4ac3-5ec3-b995-3855bb25a3aa",
        "81ec4b91-2a59-5c80-ae88-304bc6d664e2",
        "a91d4035-b0bd-51d4-8a94-e74f064a47b7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cream together the butter and sugar until light and fluffy. You can do this in a food processor if you have one. Process for 2-3 minutes. Mix in the eggs, then add the ground almonds and almond extract and blend until well combined.",
      "timer_seconds": 180,
      "ingredients_used": [
        "81ec4b91-2a59-5c80-ae88-304bc6d664e2",
        "a91d4035-b0bd-51d4-8a94-e74f064a47b7",
        "2c995efd-d9f0-5abf-a3fb-88bf5ba101bc",
        "8dc366df-7ac7-5fb7-9fa9-36bb43b224b0",
        "080e953d-328d-5d41-a7b0-3943c80c0f09"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Peel the apples, and cut thin slices of apple. Do this at the last minute to prevent the apple going brown. Arrange the slices over the biscuit base. Spread the frangipane filling evenly on top. Level the surface and sprinkle with the flaked almonds.",
      "ingredients_used": [
        "56c50def-7bdd-55c7-8220-92ab6456a68e",
        "2c995efd-d9f0-5abf-a3fb-88bf5ba101bc",
        "080e953d-328d-5d41-a7b0-3943c80c0f09"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Bake for 20-25 minutes until golden-brown and set.",
      "timer_seconds": 1500
    },
    {
      "step_number": 6,
      "instruction": "Remove from the oven and leave to cool for 15 minutes. Remove the sides of the tin. An easy way to do this is to stand the tin on a can of beans and push down gently on the edges of the tin.",
      "timer_seconds": 900
    },
    {
      "step_number": 7,
      "instruction": "Transfer the tart, with the tin base attached, to a serving plate. Serve warm with cream, crème fraiche or ice cream."
    }
  ],
