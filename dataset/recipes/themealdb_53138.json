  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Make the Dough: Cream butter and sugar. Add egg yolks and lemon zest. Gradually mix in flour and cornstarch to form a dough. Chill for 1 hour.",
      "timer_seconds": 3600,
      "ingredients_used": [
        "5ed66d91-88a5-51d4-a521-3e997a7ce0e5",
        "d05d87bb-528a-5275-a7eb-fb9e086c6c0f",
        "e3eae6a0-c287-54aa-a0fd-9a31d72a368f",
        "63ce9b70-5fdc-5fde-97b7-37e84da97c8f",
        "27c492c4-403d-512a-b432-d847de59db78"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Bake the Cookies: Roll out the dough, cut into circles, and bake at 180°C (350°F) for 12-15 minutes. Let cool.",
      "timer_seconds": 900,
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 3,
      "instruction": "Assemble: Spread dulce de leche on one cookie, then sandwich with another. Roll the edges in coconut flakes.",
      "ingredients_used": [
        "8d761aa1-84bd-5bb6-8e3b-e80f750ebbf3",
        "48abd91a-1804-5ccf-9317-a88519f6fd77"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Pro Tips:"
    },
    {
      "step_number": 5,
      "instruction": "Chill the dough before rolling it out to make it easier to handle and to prevent the cookies from spreading too much while baking."
    },
    {
      "step_number": 6,
      "instruction": "Dip the alfajores in melted chocolate and let them set on a wire rack for an extra decadent treat."
    }
  ],
