  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Beat the eggs, sugar and vanilla sugar until light and fluffy. I beat this in a stand mixer on medium-high speed for about 10 minutes.",
      "timer_seconds": 600,
      "ingredients_used": [
        "e2314824-a352-5321-85ba-3b5a838dc7b2",
        "cc8cf643-4b6f-5d5f-b378-67d394177528",
        "b3b798e1-c023-5087-a6dd-36b1d197b187",
        "c362ac50-4ac5-581a-9bba-598f13509663"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Sift the flour and cornstarch and add to the mixture. Fold this gently into the mixture; you don’t want all the air you whipped in to disappear.",
      "ingredients_used": [
        "73a56bd0-9a71-5e6a-aa2d-5498a8d8f7f6",
        "985e4b18-4fca-56d6-b0a4-7d00c9157b49"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Pour the batter into a greased baking pan. Bake the cake base at 180°C/350°F (conventional oven) for 30 minutes. The cake is done when you press lightly on the top and it springs back. Allow the cake to cool in the pan for a few minutes before removing it to a cake rack.",
      "timer_seconds": 1800,
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 4,
      "instruction": "Meanwhile, prepare the nougatine and jam according to the recipe if you haven’t already.",
      "ingredients_used": [
        "0f34fc84-5174-578b-b1be-7c24e09da3af",
        "3d013a69-4737-5113-97d4-67c32b0c26cd"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Let the cake cool completely before you cut it. If, like me, you used a 20 cm/8 inch spring form pan, cut the cake into three layers."
    }
  ],
