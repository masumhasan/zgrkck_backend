  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Prepare the dish"
    },
    {
      "step_number": 2,
      "instruction": "Fry the leeks in a small dash of olive oil for a few minutes until they start to brown.",
      "ingredients_used": [
        "ea82f869-a6e7-528b-9fa2-8dd2d1a3eae9",
        "95e184a2-ccf2-5987-b9f9-ecac22e7b254"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Prepare the Dish"
    },
    {
      "step_number": 4,
      "instruction": "Add the roasted red peppers, garlic, stock, herbs, salt, pepper and paprika. Give it a good stir, add the rice and stir again.",
      "ingredients_used": [
        "f7a38c69-fe2f-5a55-9fa5-719e83057cdf",
        "aaf27a07-a9cb-5cac-85d0-feb0f77f214c",
        "a08a1367-2719-5216-a56c-b435a30376ab",
        "22851b99-db2b-528d-ba1b-f0dca0818032",
        "51fc2ef8-4482-5fc3-8453-9605c8cecf69"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Leave it to come to the boil. Leave to simmer for 2 minutes.",
      "timer_seconds": 120
    },
    {
      "step_number": 6,
      "instruction": "Pour the mixture into a baking tray with a depth of 2 inches or more. Mix thoroughly and ensure equally leveled out."
    },
    {
      "step_number": 7,
      "instruction": "Cooking"
    },
    {
      "step_number": 8,
      "instruction": "Place on the bottom self of a preheated oven at 180 degrees. Leave to bake for 1 hour.",
      "timer_seconds": 3600
    },
    {
      "step_number": 9,
      "instruction": "Serving"
    },
    {
      "step_number": 10,
      "instruction": "Once cooked turn off the oven and keeping the door open leave the leek bake to cool for 10 minutes before serving.",
      "timer_seconds": 600,
      "ingredients_used": [
        "ea82f869-a6e7-528b-9fa2-8dd2d1a3eae9"
      ]
    }
  ],
