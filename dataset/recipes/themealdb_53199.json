  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat a wok or large frying pan until smoking hot. Pour in the oil and swirl around the pan, then tip in the beef strips and chilli.",
      "ingredients_used": [
        "63ec944f-6228-5ca2-9304-593d2276e7eb",
        "d1c33024-ff15-5f14-aab0-66bc8118251c"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Cook, stirring all the time, until the meat is lightly browned, about 3 mins, then pour over the oyster sauce. Cook until heated through and the sauce coats the meat. stir in the basil leaves and serve with plain rice.",
