  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "SOAK THE RICE NOODLES",
      "ingredients_used": [
        "5d70e1cf-8d09-5237-b766-c83f9fab3e1b"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Soak the rice noodles overnight untill they are soft",
      "ingredients_used": [
        "5d70e1cf-8d09-5237-b766-c83f9fab3e1b"
      ]
    },
    {
      "step_number": 3,
      "instruction": "BOIL THE RICE NOODLES",
      "ingredients_used": [
        "5d70e1cf-8d09-5237-b766-c83f9fab3e1b"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Boil the noodles for 10-15 minutes and then rinse with cold water to stop the cooking process of the noodles.",
      "timer_seconds": 900,
      "ingredients_used": [
        "5d70e1cf-8d09-5237-b766-c83f9fab3e1b"
      ]
    },
    {
      "step_number": 5,
      "instruction": "MARINATING THE SHRIMP"
    },
    {
      "step_number": 6,
      "instruction": "In a bowl add the shrimp, egg, 1 pinch of white pepper, 1 Teaspoon of sesame seed oil, 1 Tablespoon corn starch and 1 tablespoon of oil",
      "ingredients_used": [
        "22123cf8-5463-564d-af79-a789c6509ba9",
        "e201cc3d-ceec-5d72-99da-10c4c9b0756f",
        "ce558be2-ee8b-537f-ac95-f817ee497dc1",
        "8da1a819-b1f6-5446-b5e4-2a49b2f23fed"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Mix together well"
    },
    {
      "step_number": 8,
      "instruction": "STIR FRY"
    },
    {
      "step_number": 9,
      "instruction": "In a wok add 2 Tablespoons of oil, shrimp and stir fry them until it is golden brown",
      "ingredients_used": [
        "8da1a819-b1f6-5446-b5e4-2a49b2f23fed"
      ]
    },
    {
      "step_number": 10,
      "instruction": "Set the shrimp aside"
    },
    {
      "step_number": 11,
      "instruction": "Add 1 Tablespoon of oil to the work and then add minced garlic, ginger and all of the vegetables.",
      "ingredients_used": [
        "8da1a819-b1f6-5446-b5e4-2a49b2f23fed",
        "8ba9be12-6c33-5954-813c-7bd6c77d3b5f",
        "01bfb106-d863-5679-9add-a2bb84415698"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Add the noodles to the wok",
      "ingredients_used": [
        "5d70e1cf-8d09-5237-b766-c83f9fab3e1b"
      ]
    },
    {
      "step_number": 13,
      "instruction": "Next add sherry cooking wine, oyster sauce, sugar, vinegar, sesame seed oil, 1 pinch white pepper, and soy sauce",
      "ingredients_used": [
        "e201cc3d-ceec-5d72-99da-10c4c9b0756f",
        "ce558be2-ee8b-537f-ac95-f817ee497dc1",
        "8da1a819-b1f6-5446-b5e4-2a49b2f23fed",
        "1c1625b0-7c1a-5d7b-942e-49b34e57e83e",
        "91d88f77-1ac8-5b07-8de2-fcde99129f35",
        "24ca4c10-afc7-5137-974b-3721994c030c",
        "24723704-d6da-586f-9d94-657f1fbc831d",
        "243f086e-95a2-57d1-8777-119764cd44b6"
      ]
    },
    {
      "step_number": 14,
      "instruction": "Add back in the shrimp"
    },
    {
      "step_number": 15,
      "instruction": "To thicken the sauce, whisk together 1 Tablespoon of corn starch and 2 Tablespoon of water in a bowl and slowly add to your stir-fry until it's the right thickness."
    }
  ],
