  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Oil and line a 20cm round loose- bottomed cake tin with cling film, making it as smooth as possible. Melt the butter in a pan. Crush the biscuits by bashing them in a bag with a rolling pin, then stir them into the butter until very well coated. Press the mixture firmly into the base of the tin and chill.",
      "ingredients_used": [
        "9bee2d15-6999-56c0-a586-4f5f4775e969",
        "74e0fcc2-21d2-5b40-a61e-f603050ecbd5"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Soak the gelatine in water while you make the filling. Tip the ricotta into a bowl, then beat in the peanut butter and syrup. Ricotta has a slightly grainy texture so blitz until smooth with a stick blender for a smoother texture if you prefer.",
      "ingredients_used": [
        "9bee2d15-6999-56c0-a586-4f5f4775e969",
        "8ea0f4fe-cb35-55c5-be79-19ebf90d7f59",
        "74e0fcc2-21d2-5b40-a61e-f603050ecbd5",
        "b6c1a967-d869-5207-b90c-a4067a0e8da9"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Take the soaked gelatine from the water and squeeze dry. Put it into a pan with the milk and heat very gently until the gelatine dissolves. Beat into the peanut mixture, then tip onto the biscuit base. Chill until set.",
      "ingredients_used": [
        "5221e2ce-f489-57a7-b5e3-aad6579302af"
      ]
    },
    {
      "step_number": 4,
      "instruction": "To freeze, leave in the tin and as soon as it is solid, cover the surface with cling film, then wrap the tin with cling film and foil."
    },
    {
      "step_number": 5,
      "instruction": "To defrost, thaw in the fridge overnight."
    },
    {
      "step_number": 6,
      "instruction": "To serve, carefully remove from the tin. Whisk the cream with the sugar until it holds its shape, then spread on top of the cheesecake and scatter with the peanut brittle.",
      "ingredients_used": [
        "0cd2e408-15e5-5093-aa12-89c44480bc21"
      ]
    }
  ],
