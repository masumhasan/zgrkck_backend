  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "In a bowl of warm water, add tapioca pearls and allow them to soak for 20 minutes.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "456fe4fa-f02e-5ab5-8920-917fdae05d56",
        "4ab35f2a-4656-574a-949b-5a6873b83591",
        "fec6858c-5737-51ba-b11e-fb9deb49e649",
        "a649c8a9-7b30-5c31-98f5-f25f8576d8e7"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Prepare bananas by peeling them and cutting them into ½ inch slices. Set the slices aside",
      "ingredients_used": [
        "cb567a4e-7f53-5be1-87ad-b63e9b789bd7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "On a stove, pour in 4 cups of water and bring it to a boil. Add in the banana slices.",
      "ingredients_used": [
        "4ab35f2a-4656-574a-949b-5a6873b83591",
        "cb567a4e-7f53-5be1-87ad-b63e9b789bd7",
        "a649c8a9-7b30-5c31-98f5-f25f8576d8e7"
      ]
    },
    {
      "step_number": 4,
      "instruction": "After 20 minutes, drain the tapioca pearls in cold water to allow the pearls to separate from each other.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "4ab35f2a-4656-574a-949b-5a6873b83591",
        "fec6858c-5737-51ba-b11e-fb9deb49e649",
        "a649c8a9-7b30-5c31-98f5-f25f8576d8e7"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the tapioca pearls into the the pot. Allow to simmer for 3 minutes or until the tapioca pearls turn clear.",
      "timer_seconds": 180,
      "ingredients_used": [
        "fec6858c-5737-51ba-b11e-fb9deb49e649"
      ]
    },
    {
      "step_number": 6,
      "instruction": "Next, add in sugar and pour in the coconut cream. Stir the ingredients gently for 3 minutes to incorporate the flavors.",
      "timer_seconds": 180,
      "ingredients_used": [
        "1e18a0e3-2b2e-58f1-bd00-ca75fb072045"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Add salt to taste.",
      "ingredients_used": [
        "1c5232e4-4d65-5631-b4b9-75579484b9b6"
      ]
    }
  ],
