  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Place each piece of steak in between two large pieces of plastic and using a mallet, pound it until it is about ¼″ to ½″ thick. Place the pounded steak in a glass container, add the aliños sauce and let it rest for about 3 hours or overnight in the fridge.",
      "timer_seconds": 10800
    },
    {
      "step_number": 2,
      "instruction": "Add the flour, bread crumbs, spices and parsley to a plate or bowl.",
      "ingredients_used": [
        "0b42dbf8-ad3d-55e2-968d-8876cb65a60e"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Cover the steak on all sides with the flour mixture, then the eggs, and finally the flour mixture again.",
      "ingredients_used": [
        "60535ea5-0947-5491-b072-f0d0dc08793d"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Once the pieces of steak are coated, you can either add them right to a pan with oil for cooking or layer them on parchment paper until ready to fry.",
      "ingredients_used": [
        "584e0a91-ad7f-59ec-b7b7-522345d7d4bf"
      ]
    },
    {
      "step_number": 5,
      "instruction": "Add the oil to a large skillet over medium heat. As soon as it begins to smoke lightly, add the breaded steak and cook it for about 3 to 4 minutes per side or until golden brown. Take them out of the oil and place on a plate lined with paper towels to drain off any excess oil and serve.",
      "timer_seconds": 240,
      "ingredients_used": [
        "584e0a91-ad7f-59ec-b7b7-522345d7d4bf"
      ]
    }
  ],
