  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Heat the oven to 180C/160C fan/gas 4. Make the latkes by combining all of the ingredients.",
      "temperature": {
        "value": 180,
        "unit": "celsius"
      }
    },
    {
      "step_number": 2,
      "instruction": "Heat the oil in a large non-stick pan. Spoon in the mixture to make six round latkes. Fry for 4-5 mins on each side, then transfer to a baking sheet and bake for 10 mins."
    },
    {
      "step_number": 3,
      "instruction": "Combine the yogurt and mint in a small bowl. Toss the salad leaves and tomatoes together, then serve the latkes with the mint yogurt and salad.",
