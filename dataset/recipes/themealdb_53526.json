  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Peel the potatoes and cut them into chunks, put them in a medium pot and cover with water and ¼ teaspoon of salt.",
      "ingredients_used": [
        "ed3e545d-89b2-5f5b-9cb4-a1c8972f71c7",
        "091f9749-2107-525a-af2a-d8825fded08e",
        "8ea71e2a-ad8f-51ab-b075-a326e4bd11b5",
        "e93f9dfa-827e-5958-9a6f-2cb4413364c7"
      ]
    },
    {
      "step_number": 2,
      "instruction": "Bring the potatoes to a boil over medium high heat, then reduce the heat to medium and cook until fork tender about 20 minutes.",
      "timer_seconds": 1200,
      "ingredients_used": [
        "ed3e545d-89b2-5f5b-9cb4-a1c8972f71c7"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Drain the potatoes and mash with a fork or masher and set aside.",
      "ingredients_used": [
        "ed3e545d-89b2-5f5b-9cb4-a1c8972f71c7"
      ]
    },
    {
      "step_number": 4,
      "instruction": "Filling:"
    },
    {
      "step_number": 5,
      "instruction": "In a large sauce pan, heat 1 tablespoon olive oil over medium heat and add the onion, tomato, scallions, garlic, cumin, azafran, pepper and salt. Cook for 5 minutes or until the onions are translucent, add the beef and cook stirring occasionally about 10 – 15 minutes. Set aside to cool.",
      "ingredients_used": [
        "091f9749-2107-525a-af2a-d8825fded08e",
        "c80323fc-c985-57c7-a520-73e4ae6710f5",
        "aecd58b9-2ada-50b3-8461-da813fa88898",
        "f23ac01c-b5fe-5ded-b43a-4a13052e1ab1",
        "bf3794bb-38cf-592a-b917-df476fa6ca1f",
        "3c0544fe-85e4-5e5c-b009-ab07b62aa4a5",
        "c773c2e1-a040-58e8-8d4b-914af10db63c",
        "0dc1c836-0457-55e8-bc8c-bbadd460b9d8",
        "8ea71e2a-ad8f-51ab-b075-a326e4bd11b5",
        "de3db087-13e7-5f84-b86a-9dc5e85bf859",
        "e93f9dfa-827e-5958-9a6f-2cb4413364c7",
        "21b13a42-ea6c-5158-83fe-983d8dcac62f"
      ]
    },
    {
      "step_number": 6,
      "instruction": "To make the batter:"
    },
    {
      "step_number": 7,
      "instruction": "In a medium bowl place all the batter ingredients and whisk until smooth and set aside."
    },
    {
      "step_number": 8,
      "instruction": "To Form the Stuffed Potatoes",
      "ingredients_used": [
        "ed3e545d-89b2-5f5b-9cb4-a1c8972f71c7"
      ]
    },
    {
      "step_number": 9,
      "instruction": "Divide the potato mash into 10 equal sized portions, about ⅓ cup each, and form each portion into a ball by rolling between the palms of your hands. Flatten into patties and place 1 ½ tablespoons of the filling in the center of each one. Shape the potato mixture with the filling into balls to enclose the filling completely."
    },
    {
      "step_number": 10,
      "instruction": "Fill a large heavy pot with vegetable oil and heat over medium-high heat to 360° F.",
      "temperature": {
        "value": 360,
        "unit": "fahrenheit"
      },
      "ingredients_used": [
        "6d22ab92-3fd8-500e-b829-d2ab921b5c82"
      ]
    },
    {
      "step_number": 11,
      "instruction": "Dip the stuffed potato into the batter and carefully place them in the hot oil and fry for about 4 minutes or until golden, turning over halfway through. Remove the potatoes from the oil using a slotted spoon and drain in a plate with paper towels. Transfer to a serving plate and serve with Ají.",
      "timer_seconds": 240,
      "ingredients_used": [
        "ed3e545d-89b2-5f5b-9cb4-a1c8972f71c7"
      ]
    },
    {
      "step_number": 12,
      "instruction": "Notes"
    },
    {
      "step_number": 13,
      "instruction": "For a vegetarian version:Use the same ingredients in the meat filling except the beef and add 1 cup frozen carrots and peas",
      "ingredients_used": [
        "de3db087-13e7-5f84-b86a-9dc5e85bf859"
      ]
    }
  ],
