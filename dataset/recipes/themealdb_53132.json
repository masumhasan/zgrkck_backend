  "instruction_steps": [
    {
      "step_number": 1,
      "instruction": "Shells"
    },
    {
      "step_number": 2,
      "instruction": "Combine the flour and powdered sugar in a food processor. Add the butter and pulse until it's evenly distributed. Add the egg and pulse until the dough comes together.",
      "ingredients_used": [
        "8ee3885e-a2cf-551a-bf46-01ef9e870a5b",
        "9c5a71ae-3cb6-594c-a043-338184510851",
        "91c30a7e-5c88-55b0-ba9a-a763b0b1f466",
        "2c3e5f15-4d6c-534e-9dba-d3cb2bd16358",
        "7e2a2542-576a-565b-9c62-361bc7cf32d6",
        "392b0079-32ee-569e-84bd-19bc447b92fb",
        "1a193253-09d7-5b50-aa0d-2c7de04714fb",
        "37e0d1a4-c284-5e37-9335-eb2e15fa2910",
        "78cac372-9f93-5d15-90df-da795b6813d1"
      ]
    },
    {
      "step_number": 3,
      "instruction": "Roll out the dough on a floured surface. Cut the dough in circles with a large mug. Press the circles down into a greased muffin pan. Put the pan of shells in the fridge while you prepare the almond filling."
    },
    {
      "step_number": 4,
      "instruction": "Almond filling"
    },
    {
      "step_number": 5,
      "instruction": "Preheat oven to 355°F (180°C).",
      "temperature": {
        "value": 355,
        "unit": "fahrenheit"
      }
    },
    {
      "step_number": 6,
      "instruction": "Whisk the egg and powdered sugar together until thick and airy. Melt the butter and stir it into the egg mixture. Stir in the vanilla, flour, and almond extract. Stir in the almond flour.",
      "ingredients_used": [
        "8ee3885e-a2cf-551a-bf46-01ef9e870a5b",
        "9c5a71ae-3cb6-594c-a043-338184510851",
        "91c30a7e-5c88-55b0-ba9a-a763b0b1f466",
        "2c3e5f15-4d6c-534e-9dba-d3cb2bd16358",
        "7e2a2542-576a-565b-9c62-361bc7cf32d6",
        "392b0079-32ee-569e-84bd-19bc447b92fb",
        "1a193253-09d7-5b50-aa0d-2c7de04714fb",
        "d93ccced-dc79-5c74-945d-77475b507496",
        "37e0d1a4-c284-5e37-9335-eb2e15fa2910",
        "5c829c60-6427-5863-8c93-037e4680de4d",
        "e585d597-8b52-5e1b-bb88-1f71176283dd",
        "78cac372-9f93-5d15-90df-da795b6813d1",
        "c40e5ac2-0212-5a94-a573-760956fc75d6"
      ]
    },
    {
      "step_number": 7,
      "instruction": "Pipe or spoon the almond filling onto the shells, filling the shells about 3/4 full."
    },
    {
      "step_number": 8,
      "instruction": "Bake the mazariner for 20 – 25 minutes, until light golden brown. Cool on a wire rack.",
      "timer_seconds": 1500
    },
    {
      "step_number": 9,
      "instruction": "Glaze"
    },
    {
      "step_number": 10,
      "instruction": "Mix together the powdered sugar and liquid until you get a spreadable glaze. Spread the glaze on top of the mazariner and if you wish, decorate with sprinkles, or anything you like.",
      "ingredients_used": [
        "9c5a71ae-3cb6-594c-a043-338184510851",
        "392b0079-32ee-569e-84bd-19bc447b92fb",
        "78cac372-9f93-5d15-90df-da795b6813d1"
      ]
    }
  ],
